{
	"name": "texpile-editor",
	"version": "1.6.2",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:web": "vite build --mode web --outDir dist-web && node -e \"require('fs').copyFileSync('web/_headers','dist-web/_headers')\"",
		"preview": "vite preview",
		"sync": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && node scripts/sync-themes.mjs",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"testonce": "vitest run",
		"release": "node scripts/release.mjs",
		"grammar": "lezer-generator src/lib/languages/latex/syntax/latex.grammar -o src/lib/languages/latex/syntax/parser.ts --typeScript"
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@cspell/dict-de-de": "4.1.3",
		"@cspell/dict-es-es": "3.0.9",
		"@cspell/dict-fr-fr": "2.3.2",
		"@cspell/dict-it-it": "3.1.7",
		"@cspell/dict-nl-nl": "2.4.2",
		"@cspell/dict-pl_pl": "3.0.8",
		"@cspell/dict-pt-br": "2.4.4",
		"@cspell/dict-pt-pt": "3.0.8",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@lezer/common": "^1.5.4",
		"@lezer/generator": "^1.8.1",
		"@lezer/highlight": "^1.2.5",
		"@lezer/lr": "^1.4.11",
		"@playwright/test": "^1.64.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.13.3",
		"cspell-trie-lib": "10.4.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.12.0",
		"jsdom": "^30.1.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vite-plugin-wasm": "^3.6.0",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/language-data": "^6.4.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/lsp-client": "^6.3.0",
		"@codemirror/merge": "^6.12.3",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@inlang/paraglide-js": "2.29.1",
		"@lucide/svelte": "^0.522.0",
		"@replit/codemirror-emacs": "^6.1.0",
		"@replit/codemirror-vim": "^6.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"cspell-dictionary": "10.4.0",
		"diff": "^9.0.0",
		"esm-env": "^1.2.2",
		"harper.js": "^2.13.0",
		"lib0": "^0.2.119",
		"linebreak": "^1.1.0",
		"markdown-it": "^15.0.3",
		"mathlive": "workspace:*",
		"opentype.js": "^2.0.0",
		"pdfjs-dist": "^6.3.289",
		"prosemirror-changeset": "2.4.1",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-dropcursor": "^1.8.4",
		"prosemirror-flat-list": "^0.7.3",
		"prosemirror-gapcursor": "^1.4.0",
		"prosemirror-history": "^1.5.1",
		"prosemirror-inputrules": "^1.4.0",
		"prosemirror-keymap": "^1.2.2",
		"prosemirror-model": "^1.25.12",
		"prosemirror-proofread": "^0.4.0-beta.1",
		"prosemirror-state": "^1.4.3",
		"prosemirror-tables": "^1.4.0",
		"prosemirror-transform": "^1.12.4",
		"prosemirror-view": "^1.42.7",
		"texpile-typst-syntax-wasm": "workspace:*",
		"vscode-uri": "^3.2.0",
		"y-codemirror.next": "^0.3.6",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33",
		"zod": "^3.25.67"
	},
	"type": "module"
}
