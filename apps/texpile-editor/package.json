{
	"name": "texpile-editor",
	"version": "1.2.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:web": "vite build --mode web --outDir dist-web && node -e \"require('fs').copyFileSync('web/_headers','dist-web/_headers')\"",
		"preview": "vite preview",
		"sync": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && node scripts/sync-themes.mjs",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"testonce": "vitest run",
		"release": "node scripts/release.mjs"
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@lezer/common": "^1.5.3",
		"@lezer/highlight": "^1.2.4",
		"@playwright/test": "^1.63.0",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24.13.3",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.2.0",
		"jsdom": "^29.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vite-plugin-wasm": "^3.6.0",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.18.7",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.4.1",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/lsp-client": "^6.3.0",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@inlang/paraglide-js": "2.25.4",
		"@lucide/svelte": "^0.522.0",
		"@replit/codemirror-emacs": "^6.1.0",
		"@replit/codemirror-vim": "^6.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@unified-latex/unified-latex-ctan": "1.8.4",
		"@unified-latex/unified-latex-types": "^1.8.0",
		"@unified-latex/unified-latex-util-arguments": "^1.8.3",
		"@unified-latex/unified-latex-util-macros": "^1.8.3",
		"@unified-latex/unified-latex-util-match": "^1.8.0",
		"@unified-latex/unified-latex-util-parse": "^1.8.0",
		"@unified-latex/unified-latex-util-print-raw": "^1.8.0",
		"@unified-latex/unified-latex-util-trim": "1.8.4",
		"@unified-latex/unified-latex-util-visit": "^1.8.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"diff": "^8.0.2",
		"esm-env": "^1.2.2",
		"harper.js": "^2.10.0",
		"lib0": "^0.2.117",
		"linebreak": "^1.1.0",
		"markdown-it": "^15.0.2",
		"mathlive": "workspace:*",
		"opentype.js": "^2.0.0",
		"pdfjs-dist": "^5.4.394",
		"prosemirror-changeset": "^2.4.3",
		"prosemirror-commands": "^1.7.2",
		"prosemirror-dropcursor": "^1.8.4",
		"prosemirror-flat-list": "^0.7.1",
		"prosemirror-gapcursor": "^1.4.0",
		"prosemirror-history": "^1.4.1",
		"prosemirror-inputrules": "^1.4.0",
		"prosemirror-keymap": "^1.2.2",
		"prosemirror-model": "^1.25.12",
		"prosemirror-proofread": "^0.4.0-beta.1",
		"prosemirror-search": "^0.1.0",
		"prosemirror-state": "^1.4.3",
		"prosemirror-tables": "^1.4.0",
		"prosemirror-transform": "^1.12.1",
		"prosemirror-view": "^1.42.5",
		"texpile-typst-syntax-wasm": "workspace:*",
		"unified": "^11.0.5",
		"y-codemirror.next": "^0.3.6",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.33",
		"zod": "^3.25.67"
	},
	"type": "module"
}
