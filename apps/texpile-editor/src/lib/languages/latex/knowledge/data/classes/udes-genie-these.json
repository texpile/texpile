	"macros": [
		{"name":"Auteur","args":[{"kind":"m","placeholder":"first name"},{"kind":"m","placeholder":"last name"}],"doc":"L’auteure ou l’auteur du document sur la page titre est spécifié avec cette macro."},
		{"name":"Codirecteur","args":[{"kind":"m","placeholder":"first name"},{"kind":"m","placeholder":"last name"}]},
		{"name":"Codirectrice","args":[{"kind":"m","placeholder":"first name"},{"kind":"m","placeholder":"last name"}],"doc":"Les codirectrices et les codirecteurs de recherche sont spécifiés avec ces macros."},
		{"name":"ConfigurationDocument","args":[{"kind":"m","placeholder":"configuration keys"}]},
