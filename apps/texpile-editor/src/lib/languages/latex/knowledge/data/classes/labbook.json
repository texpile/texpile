{
	"version": 1,
	"deps": [
		{"id":"classes/scrbook"},
		{"id":"packages/scrkbase"},
		{"id":"packages/scrbase"},
		{"id":"packages/scrlfile"},
		{"id":"packages/scrlfile-hook"},
		{"id":"packages/scrlogo"},
		{"id":"packages/keyval"},
		{"id":"packages/tocbasic"},
