	"macros": [
		{"name":"cuaddkeys","args":[{"kind":"m"},{"kind":"m"}],"doc":"\\cuaddkeys takes the already defined key {⟨unit-key-1⟩} as a “basis”, and adds ⟨unit-key-2⟩, ⟨unit-key-3⟩, etc. to its values."},
