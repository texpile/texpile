{
	"version": 1,
	"deps": [
		{"id":"packages/keyval"},
		{"id":"packages/ifpdf"},
		{"id":"packages/iftex"}
	],
	"macros": [
		{"name":"hyperlinkmovie","args":[{"kind":"o","keys":["packages/multimedia#keyval:multimedia"]},{"kind":"m"},{"kind":"m"}],"doc":"Causes the ⟨text⟩ to become a movie hyperlink."},
		{"name":"hyperlinkmute","args":[{"kind":"m"}],"doc":"Causes the ⟨text⟩ to become a hyperlink that, when clicked, stops the playback of all sounds."},
		{"name":"hyperlinksound","args":[{"kind":"o","keys":["packages/multimedia#keyval:multimedia"]},{"kind":"m"},{"kind":"m"}],"doc":"Causes the ⟨text⟩ to become a sound hyperlink."},
		{"name":"movie","args":[{"kind":"o","keys":["packages/multimedia#keyval:multimedia"]},{"kind":"m"},{"kind":"m"}],"doc":"This command will insert the movie with the filename ⟨movie filename⟩ into the pdf file."},
		{"name":"sound","args":[{"kind":"o","keys":["packages/multimedia#keyval:multimedia"]},{"kind":"m"},{"kind":"m"}],"doc":"This command will insert the sound with the filename ⟨sound filename⟩ into the pdf file."}
	],
