{
	"version": 1,
	"deps": [
		{"id":"packages/verbatim"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/shellesc"}
	],
	"macros": [
		{"name":"mpostdisplaylabel","args":[{"kind":"m","placeholder":"label"}]},
		{"name":"mpostdone"},
		{"name":"mpostfigurename"},
