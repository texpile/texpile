	"deps": [
		{"id":"packages/makeidx"},
		{"id":"packages/xesearch"}
	],
	"macros": [
		{"name":"IndexList","args":[{"kind":"s"},{"kind":"m","placeholder":"list name"},{"kind":"m","placeholder":"list of entries"}]},
