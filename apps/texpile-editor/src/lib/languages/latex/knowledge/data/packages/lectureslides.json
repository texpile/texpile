		{"name":"lecture","args":[{"kind":"m","placeholder":"title"},{"kind":"o","placeholder":"first page"},{"kind":"o","placeholder":"last page"},{"kind":"m","placeholder":"file name"}],"doc":"Inserts one set of lecture slides."},
		{"name":"lectureslides","args":[{"kind":"o","placeholder":"first page"},{"kind":"o","placeholder":"last page"},{"kind":"m","placeholder":"file name"}],"doc":"Inserts a set of slides from a given PDF."},
		{"name":"lecturetitle","args":[{"kind":"m","placeholder":"title"}],"doc":"Declares a new set of slides, but doesn’t insert any PDF pages yet."},
		{"name":"tocline","args":[{"kind":"m","placeholder":"title"}],"doc":"Determines how the lecture title appears in the table of contents (ToC)."}
	],
	"keys": {
		"packages/lectureslides#options": [{"key":"landscape","bare":true},{"key":"portrait","bare":true}]
