		{"name":"hanging","args":[{"kind":"o","placeholder":"options"}]},
		{"name":"midparachap","args":[{"kind":"o","placeholder":"options"}]},
		{"name":"narrow","args":[{"kind":"o","placeholder":"options"}],"doc":"Environment for typesetting narrow sections of scripture quotations."},
		{"name":"poetry","args":[{"kind":"o","placeholder":"options"}]},
		{"name":"scripture","args":[{"kind":"o","placeholder":"reference"},{"kind":"o","placeholder":"options"}]}
