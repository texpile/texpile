{
	"version": 1,
	"deps": [
		{"id":"packages/keyval"},
		{"id":"packages/hyperref"},
		{"id":"packages/iftex"},
		{"id":"packages/kvsetkeys"},
		{"id":"packages/pdfescape"},
		{"id":"packages/nameref"},
		{"id":"packages/refcount"},
		{"id":"packages/gettitlestring"},
		{"id":"packages/kvoptions"},
		{"id":"packages/etoolbox"},
		{"id":"packages/stringenc"},
		{"id":"packages/intcalc"},
		{"id":"packages/url"},
		{"id":"packages/bitset"},
		{"id":"packages/bigintcalc"},
		{"id":"packages/rerunfilecheck"},
		{"id":"packages/uniquecounter"},
		{"id":"packages/hyperxmp","if":"!hyperxmp=false"},
		{"id":"packages/ifthen","if":"!hyperxmp=false"},
