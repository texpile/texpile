		{"id":"packages/luatexbase","if":"!hyperxmp=false","engines":["lualatex"]}
	],
	"macros": [
		{"name":"metaaddsep","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"separator"},{"kind":"m","placeholder":"value"}],"doc":"\\metaaddsep is designed to compose lists with separators, it appends the separator sep and the value def unless the register is clean, in which case it is set to def without the separator sep."},
		{"name":"metaappend","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"value"}]},
		{"name":"metacomma","hidden":true},
		{"name":"metacompose","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"prefix"},{"kind":"m","placeholder":"postfix"},{"kind":"m","placeholder":"empty"}]},
		{"name":"metacopyright","args":[{"kind":"m","placeholder":"preset"}]},
		{"name":"metadef","args":[{"kind":"m","placeholder":"register"}]},
		{"name":"metaget","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"}]},
		{"name":"metaif","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"true"},{"kind":"m","placeholder":"false"}],"doc":"If the register reg is filled, return true otherwise false."},
		{"name":"metaifpick","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"true"},{"kind":"m","placeholder":"false"}]},
		{"name":"metalicense","args":[{"kind":"m","placeholder":"preset"}]},
		{"name":"metalicensecc","args":[{"kind":"m","placeholder":"license"}]},
		{"name":"metapick","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"}],"doc":"This macro tests whether the variant var, the language variant ln specified through \\metasetlang{ln}, the generic (empty) variant or a fallback language variant have been specified. If so, their value is returned (in this order of preference)."},
		{"name":"metaprepend","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"value"}]},
		{"name":"metaset","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"value"}],"doc":"This command defines the register reg in variant var as def."},
		{"name":"metasetlang","args":[{"kind":"s"},{"kind":"m","placeholder":"language"}]},
		{"name":"metasetterm","args":[{"kind":"o","placeholder":"language"},{"kind":"m","placeholder":"register"},{"kind":"m","placeholder":"value"}],"doc":"The macro \\metasetterm declares and fills a term register term (in a particular language ln)."},
		{"name":"metasetup","args":[{"kind":"m","placeholder":"options"}]},
		{"name":"metaterm","args":[{"kind":"m","placeholder":"term"}],"doc":"The macro \\metaterm obtains the term term in the default language (it invokes \\metapick[] with empty variant), while \\metatranslate uses any other language ln."},
		{"name":"metatilde","hidden":true},
		{"name":"metatitleline","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"}]},
		{"name":"metatitlelinetwo","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"},{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"}]},
		{"name":"metatranslate","args":[{"kind":"o","placeholder":"language"},{"kind":"m","placeholder":"term"}]},
		{"name":"metaunset","args":[{"kind":"o","placeholder":"variant"},{"kind":"m","placeholder":"register"}]},
		{"name":"metawritepdf"},
		{"name":"metawritepdfaux"},
		{"name":"metawritepdfcontact"},
		{"name":"metawritepdfinfo","doc":"The basic metadata registers are written out by \\metawritepdfinfo using hyperref."},
		{"name":"metawritepdfpreamble"},
		{"name":"metawritepdfrights"}
	]
