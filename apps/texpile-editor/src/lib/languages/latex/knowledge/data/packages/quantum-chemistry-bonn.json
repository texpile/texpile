{
	"version": 1,
	"deps": [
		{"id":"packages/xcolor"},
		{"id":"packages/siunitx"},
		{"id":"packages/translations"},
		{"id":"packages/etoolbox"},
		{"id":"packages/pdftexcmds"},
		{"id":"packages/iftex"},
		{"id":"packages/amstext"},
		{"id":"packages/array"},
		{"id":"packages/xparse"},
		{"id":"packages/acronym"},
		{"id":"packages/suffix"},
		{"id":"packages/xstring"}
	],
	"macros": [
		{"name":"atm","hidden":true},
		{"name":"calorie","hidden":true},
		{"name":"censo"},
		{"name":"colb","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"colg","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"colr","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"coly","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"crest","doc":"Renders “CREST” in small caps."},
		{"name":"DeclareMethod","args":[{"kind":"m","placeholder":"key"},{"kind":"m","placeholder":"formatted text"}]},
		{"name":"DeclareMethods","args":[{"kind":"m","placeholder":"key1,key2,..."},{"kind":"m","placeholder":"formatted text"}]},
		{"name":"dgsolv","doc":"Renders “∆solv G” (solvation free energy)."},
		{"name":"draco","doc":"Renders “Draco” in small caps."},
		{"name":"eg"},
		{"name":"eqeqref","args":[{"kind":"m","placeholder":"label"}],"doc":"Renders “Eq. \\ref{<label>}”."},
		{"name":"etal"},
		{"name":"figref","args":[{"kind":"m","placeholder":"label"}]},
		{"name":"ie"},
		{"name":"kcalpmol","doc":"Renders “kcal mol−1 ” using siunitx."},
		{"name":"kjpmol","doc":"Renders “kJ mol−1 ” using siunitx."},
		{"name":"logkab","doc":"Renders “log K α/β ” (α/β partition coefficient)."},
		{"name":"logkaw","doc":"Renders “log K a/w ” (air/water partition coefficient)."},
		{"name":"logkow","doc":"Renders “log K o/w ” (octanol/water partition coefficient)."},
		{"name":"logpl","doc":"Renders “log P L ” (liquid-phase vapor pressure)."},
		{"name":"logunits","doc":"Renders “log units” using siunitx."},
		{"name":"method","args":[{"kind":"m","placeholder":"method"}],"doc":"If the method key is recognized, the properly formatted version is returned; otherwise the raw input is echoed back."},
		{"name":"orca"},
		{"name":"pka"},
		{"name":"siref","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"tabref","args":[{"kind":"m","placeholder":"label"}]},
		{"name":"tblite","doc":"Renders “tblite” in a \\texttt font."},
		{"name":"xtb","doc":"Renders “xTB” in a \\texttt (typewriter) font."}
	]
}
