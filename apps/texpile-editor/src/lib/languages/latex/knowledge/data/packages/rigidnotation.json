		{"name":"Pose","args":[{"kind":"o","placeholder":"accent"},{"kind":"m","placeholder":"subject"},{"kind":"m","placeholder":"basis"},{"kind":"m","placeholder":"coordinate system"}]},
		{"name":"Rot","args":[{"kind":"o","placeholder":"accent"},{"kind":"m","placeholder":"subject"},{"kind":"m","placeholder":"basis"},{"kind":"m","placeholder":"coordinate system"}]},
