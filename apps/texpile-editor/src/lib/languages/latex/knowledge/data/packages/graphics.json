{
	"version": 1,
	"deps": [
		{"id":"packages/trig"}
	],
	"macros": [
		{"name":"DeclareGraphicsExtensions","args":[{"kind":"m"}],"doc":"This specifies the behavior of the system when the filename argument to \\includegraphics does not have an extension specified."},
		{"name":"DeclareGraphicsRule","args":[{"kind":"m"},{"kind":"m"},{"kind":"m"},{"kind":"m"}],"doc":"Declare what actions should be taken for a particular file extension."},
		{"name":"graphicspath","args":[{"kind":"m","role":"dir","list":true}],"doc":"User level command to set the input path for graphics files."},
		{"name":"includegraphics","args":[{"kind":"s"},{"kind":"o","placeholder":"llx,lly"},{"kind":"o","placeholder":"urx,ury"},{"kind":"m","placeholder":"file","role":"graphic"}],"doc":"Include a graphics file."},
		{"name":"reflectbox","args":[{"kind":"m","placeholder":"text","role":"text","mode":"text"}],"doc":"Just an abbreviation for the appropriate scale to get reflection."},
		{"name":"resizebox","args":[{"kind":"s"},{"kind":"m","placeholder":"width"},{"kind":"m","placeholder":"height"},{"kind":"m","placeholder":"text"}],"doc":"Scale text so that the width is h-length."},
		{"name":"rotatebox","args":[{"kind":"m"},{"kind":"m"}]},
		{"name":"scalebox","args":[{"kind":"m","placeholder":"h-scale"},{"kind":"o","placeholder":"v-scale"},{"kind":"m","placeholder":"text"}],"doc":"Scale text by the specified amounts."}
	],
	"keys": {
