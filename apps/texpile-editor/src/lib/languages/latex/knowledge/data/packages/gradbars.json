{
	"version": 1,
	"deps": [
		{"id":"packages/tikz"},
		{"id":"packages/pgf"},
		{"id":"packages/pgfrcs"},
		{"id":"packages/pgfcore"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/pgfsys"},
		{"id":"packages/xcolor"},
		{"id":"packages/pgfcomp-version-0-65"},
		{"id":"packages/pgfcomp-version-1-18"},
		{"id":"packages/pgffor"},
		{"id":"packages/pgfkeys"},
		{"id":"packages/pgfmath"},
		{"id":"packages/xparse"},
		{"id":"packages/collcell"},
		{"id":"packages/array"},
		{"id":"packages/etoolbox"},
		{"id":"packages/booktabs"},
		{"id":"packages/colortbl"},
		{"id":"packages/longtable"}
	],
	"macros": [
		{"name":"gradbar","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"value"}]},
		{"name":"gradbarcsv","args":[{"kind":"o"},{"kind":"m"},{"kind":"m"},{"kind":"m"}]},
		{"name":"gradbarscategory","args":[{"kind":"m"},{"kind":"m"},{"kind":"m"}]},
		{"name":"gradbarscolumn","args":[{"kind":"m"},{"kind":"m"}]},
		{"name":"gradbarscsvcell","args":[{"kind":"m"},{"kind":"m"},{"kind":"m"}]},
		{"name":"gradbarscsvstyle","args":[{"kind":"m"},{"kind":"m"},{"kind":"m"}]},
		{"name":"gradbarscsvtable","args":[{"kind":"o"},{"kind":"m"},{"kind":"m"},{"kind":"m"}]},
		{"name":"gradbarslegend","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"gradbarsloadcsv","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"file"}]},
		{"name":"gradbarssetup","args":[{"kind":"m","placeholder":"keys"}]},
		{"name":"gradbarsstyle","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"keys"}],"doc":"`\\gradbarsstyle{name}{keys}` defines or replaces a named style in the current TeX scope. `style=name` applies it to `\\gradbar`, `\\gradstack`, or setup."},
		{"name":"gradbullet","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"value"}],"doc":"\\gradbullet {value} draws an actual value over explicit background grades."},
		{"name":"gradcolumn","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"header"}]},
		{"name":"gradcompare","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"reference"},{"kind":"m","placeholder":"current"}],"doc":"`\\gradcompare[options]{reference}{current}` draws a full-height reference layer and a centered current layer. `compare ratio=.45` must lie strictly between 0 and 1; `compare color=black!20` sets the reference color."},
		{"name":"graddumbbell","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"from"},{"kind":"m","placeholder":"to"}]},
		{"name":"gradgroup","args":[{"kind":"m","placeholder":"title"}],"doc":"\\gradgroup {title} inserts a full-width group heading."},
		{"name":"gradheader","args":[{"kind":"m","placeholder":"header"}],"doc":"\\gradheader {...} adds a header layer."},
		{"name":"gradintervals","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"records"}]},
		{"name":"gradrange","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"lower"},{"kind":"m","placeholder":"upper"}],"doc":"`\\gradrange[options]{lower}{upper}` draws only the given interval, with optional `range point` inside the original endpoints."},
		{"name":"gradrow","args":[{"kind":"m","placeholder":"cells"}]},
		{"name":"gradspan","args":[{"kind":"m","placeholder":"columns"},{"kind":"m","placeholder":"text"}]},
		{"name":"gradspark","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"list"}]},
		{"name":"gradstack","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"list"}],"doc":"`\\gradstack[keys]{a,b,c}` accumulates positives to the right and negatives to the left of zero."},
		{"name":"gradtableschema","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"body"}],"doc":"\\gradtableschema {name}{body} saves column and header declarations."},
		{"name":"gradtablestyle","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"keys"}],"doc":"\\gradtablestyle {name}{keys} saves table appearance."},
		{"name":"graduseschema","args":[{"kind":"m","placeholder":"name"}]}
	],
	"envs": [
		{"name":"gradtable","args":[{"kind":"o"}]}
	]
}
