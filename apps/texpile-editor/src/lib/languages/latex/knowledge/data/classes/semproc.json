	"macros": [
		{"name":"globaltoc","doc":"\\globaltoc typesets a global table of contents consisting of the various talks and its speakers."},
		{"name":"localbib","doc":"\\localbib typesets a bibliography for the current talk."},
		{"name":"localtoc","doc":"\\localtoc typesets a local table of contents consisting of the sections and subsections in the current talk."},
		{"name":"localtocheadingname","hidden":true},
		{"name":"nonumchapter","args":[{"kind":"m","placeholder":"title"}],"doc":"\\nonumchapter {⟨title⟩} starts a new unnumbered \\chapter* with ⟨title⟩ but makes sure the chapter occurs in the global table of contents."},
		{"name":"nospeakername","hidden":true},
		{"name":"notesname","hidden":true},
		{"name":"summaryname","hidden":true},
		{"name":"talk","args":[{"kind":"o","placeholder":"speaker and notes","keys":["classes/semproc#talk"]},{"kind":"m","placeholder":"title"}]},
		{"name":"talkautorefname","hidden":true},
		{"name":"talkname","hidden":true},
		{"name":"thetalk","hidden":true},
		{"name":"theHsection","hidden":true},
		{"name":"thesection"}
	],
	"envs": [
		{"name":"summary","doc":"The summary environment is a drop-in replacement for the abstract environment."}
	],
	"keys": {
		"classes/semproc#talk": [{"key":"speaker","bare":true,"placeholder":""},{"key":"notes","bare":true,"placeholder":""}]
	},
	"provides": {
		"counterForms": [
			{"name":"part","form":"[Roman]"},
			{"name":"chapter","form":"[arabic]","appendix":"[Alph]"},
			{"name":"section","form":"[arabic]"},
			{"name":"subsection","form":"{section}.[arabic]"},
			{"name":"subsubsection","form":"{subsection}.[arabic]","numbered":false},
			{"name":"paragraph","form":"{subsubsection}.[arabic]","numbered":false},
			{"name":"subparagraph","form":"{paragraph}.[arabic]","numbered":false},
			{"name":"equation","form":"{section}.[arabic]"},
			{"name":"figure","form":"{chapter}.[arabic]"},
			{"name":"table","form":"{chapter}.[arabic]"},
			{"name":"footnote","form":"[arabic]"},
			{"name":"mpfootnote","form":"[alph]"}
		],
		"counters": [
			{"name":"equation","within":"chapter"},
			{"name":"equation","within":"section"},
			{"name":"footnote","within":"chapter"}
		]
	},
	"passOptions": ["classes/scrreprt"]
}
