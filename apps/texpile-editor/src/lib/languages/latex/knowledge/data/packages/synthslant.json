		{"name":"textsynthuprightitalic","args":[{"kind":"m"}],"doc":"Backward slant italic ⟨text⟩ ."}
	],
	"envs": [
		{"name":"negslantenvironment","doc":"Wrapper around \\synthslantbox when slanting backward with \\textsynthuprightitalic."},
		{"name":"slantenvironment","doc":"Wrapper around \\synthslantbox when slanting forward with \\textsynthslant."}
	]
