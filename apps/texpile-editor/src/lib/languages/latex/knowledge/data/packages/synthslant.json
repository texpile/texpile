	"macros": [
		{"name":"negslantcontext","doc":"Name of the microtype context used when typesetting backward slanted text."},
		{"name":"slantcontext","doc":"Name of the microtype context used when typesetting forward slanted text."},
		{"name":"synthnegslant","doc":"Slant value used by \\textsynthuprightitalic."},
		{"name":"synthslant","doc":"Slant value used by \\textsynthslant."},
		{"name":"synthslantbox","args":[{"kind":"m"},{"kind":"m"}],"doc":"Slant ⟨text⟩ (forward or backward) by ⟨slant⟩ ."},
