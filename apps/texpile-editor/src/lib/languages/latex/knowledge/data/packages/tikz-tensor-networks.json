		{"id":"packages/pgfmath"}
	],
	"macros": [
		{"name":"tn","args":[{"kind":"o","placeholder":"object keys"},{"kind":"m","placeholder":"label"}]},
		{"name":"tnbond","args":[{"kind":"o","placeholder":"wire keys"},{"kind":"m","placeholder":"end"},{"kind":"m","placeholder":"end"}]},
		{"name":"tndeclare","args":[{"kind":"m","placeholder":"class"},{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"keys"}]},
		{"name":"tndeclareatom","args":[{"kind":"m","placeholder":"command","role":"macro","defines":"provide"},{"kind":"m","placeholder":"keys"}]},
		{"name":"tnfuse","args":[{"kind":"o","placeholder":"object keys"},{"kind":"m","placeholder":"label"}]},
		{"name":"tngroup","args":[{"kind":"o","placeholder":"picture keys"},{"kind":"m","placeholder":"body"}]},
