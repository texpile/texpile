{
	"version": 1,
	"deps": [
		{"id":"packages/tikz"},
		{"id":"packages/pgf"},
		{"id":"packages/pgfrcs"},
		{"id":"packages/pgfcore"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/pgfsys"},
		{"id":"packages/xcolor"},
		{"id":"packages/pgfcomp-version-0-65"},
		{"id":"packages/pgfcomp-version-1-18"},
		{"id":"packages/pgffor"},
		{"id":"packages/pgfkeys"},
		{"id":"packages/pgfmath"},
		{"id":"packages/xparse"},
		{"id":"packages/etoolbox"}
	],
	"macros": [
		{"name":"hfsetbordercolor","args":[{"kind":"m","placeholder":"color"}],"if":"customcolors"},
		{"name":"hfsetfillcolor","args":[{"kind":"m","placeholder":"color"}],"if":"customcolors"},
		{"name":"tikzmarkend","args":[{"kind":"o","placeholder":"tikz code"},{"kind":"m","placeholder":"marker-id"}]},
		{"name":"tikzmarkin","args":[{"kind":"o","placeholder":"options","keys":["packages/tikz#tikz","packages/pgfsys#pgf","packages/tikz#scope","packages/tikz#graphic","packages/tikz#shape"],"role":"color"},{"kind":"m","placeholder":"marker-id"},{"kind":"d()","placeholder":"below right offset"},{"kind":"d()","placeholder":"above left offset"}]}
	],
	"keys": {
		"packages/hf-tikz#options": [{"key":"beamer","bare":true},{"key":"customcolors","bare":true},{"key":"markings","bare":true},{"key":"nofill","bare":true},{"key":"norndcorners","bare":true},{"key":"shade","bare":true}],
		"packages/tikz#tikz": [{"key":"above offset","bare":true,"placeholder":""},{"key":"left offset","bare":true,"placeholder":""},{"key":"above left offset","bare":true,"placeholder":""},{"key":"below offset","bare":true,"placeholder":""},{"key":"right offset","bare":true,"placeholder":""},{"key":"below right offset","bare":true,"placeholder":""},{"key":"not use rounded corners","values":["false","true"]},{"key":"disable rounded corners","bare":true,"default":"false"}]
	}
}
