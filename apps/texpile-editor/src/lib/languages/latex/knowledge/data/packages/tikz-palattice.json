{
	"version": 1,
	"deps": [
		{"id":"packages/tikz"},
		{"id":"packages/pgf"},
		{"id":"packages/pgfrcs"},
		{"id":"packages/pgfcore"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/pgfsys"},
		{"id":"packages/xcolor"},
		{"id":"packages/pgfcomp-version-0-65"},
		{"id":"packages/pgfcomp-version-1-18"},
		{"id":"packages/pgffor"},
		{"id":"packages/pgfkeys"},
		{"id":"packages/pgfmath"},
		{"id":"packages/ifthen"},
		{"id":"packages/siunitx"},
		{"id":"packages/translations"},
		{"id":"packages/etoolbox"},
		{"id":"packages/pdftexcmds"},
		{"id":"packages/iftex"},
		{"id":"packages/amstext"},
		{"id":"packages/array"},
		{"id":"packages/xargs"},
		{"id":"packages/xkeyval"},
		{"id":"packages/iflang"}
	],
	"macros": [
		{"name":"addlegendentry","args":[{"kind":"m"},{"kind":"m"}],"doc":"adds a custom entry to the legend."},
		{"name":"beamdump","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"cavity","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"completelegend","args":[{"kind":"m","placeholder":"position"},{"kind":"o","placeholder":"scale"}]},
		{"name":"corrector","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"dipole","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"arc length"},{"kind":"m","placeholder":"bending angle"},{"kind":"o","placeholder":"type"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"drawrule","args":[{"kind":"m","placeholder":"position"},{"kind":"o","placeholder":"tick distance"},{"kind":"o","placeholder":"scale"},{"kind":"o","placeholder":"height"}],"doc":"draws a rule to visualize the size of the lattice."},
		{"name":"drift","args":[{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"name"}]},
		{"name":"goto","args":[{"kind":"m"}],"doc":"sets current position and angle to values saved with \\savecoordinate (section 4.7)."},
		{"name":"kicker","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"legend","args":[{"kind":"m","placeholder":"position"},{"kind":"o","placeholder":"scale"}],"doc":"draws a legend with all element types that occur in the lattice before this command."},
		{"name":"marker","args":[{"kind":"m","placeholder":"name"},{"kind":"o","placeholder":"length"}]},
		{"name":"northlabels"},
		{"name":"quadrupole","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"resetelementcolor","args":[{"kind":"m"}]},
		{"name":"resetlabeldistance"},
		{"name":"resetlinecolor","args":[{"kind":"m"}]},
		{"name":"rotate","args":[{"kind":"m"}],"doc":"bends the beamline by the given angle."},
		{"name":"rotatelabels","args":[{"kind":"m","placeholder":"angle"},{"kind":"o","placeholder":"anchor"}],"doc":"allows rotation of element labels."},
		{"name":"savecoordinate","args":[{"kind":"m","placeholder":"name"},{"kind":"o","placeholder":"position"}],"doc":"saves the coordinate of the previous element to access it later."},
		{"name":"screen","args":[{"kind":"m","placeholder":"name"},{"kind":"o","placeholder":"length"}]},
		{"name":"setangle","args":[{"kind":"m"}],"doc":"sets the beamline angle to the given angle."},
		{"name":"setelementcolor","args":[{"kind":"m","placeholder":"type"},{"kind":"m","placeholder":"color"},{"kind":"o","placeholder":"gradient color"}]},
		{"name":"setlabelcolor","args":[{"kind":"m"}]},
		{"name":"setlabeldistance","args":[{"kind":"m"}]},
		{"name":"setlabelfont","args":[{"kind":"m"}],"doc":"sets the text label font size."},
		{"name":"setlegendtext","args":[{"kind":"m"},{"kind":"m"}]},
		{"name":"setlinecolor","args":[{"kind":"m"},{"kind":"m"}]},
		{"name":"sextupole","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"solenoid","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"source","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"length"},{"kind":"o","placeholder":"thickness"}]},
		{"name":"southlabels"},
		{"name":"start","args":[{"kind":"m"}],"doc":"sets starting point of the lattice."},
		{"name":"turnlabels"},
		{"name":"valve","args":[{"kind":"m","placeholder":"name"},{"kind":"o","placeholder":"length"}]}
	],
	"envs": [
		{"name":"fade","args":[{"kind":"o"}],"doc":"reduces the opacity of all elements within the environment and sets all colors to gray."},
		{"name":"labeldistance","args":[{"kind":"m"}],"doc":"sets the distance of text labels to the element center for all elements within this environment."},
		{"name":"lattice","args":[{"kind":"o","placeholder":"scale"},{"kind":"o","placeholder":"tikz options"}],"doc":"The lattice environment contains a tikzpicture environment in which the lattice is drawn using usual tikz commands."}
	]
}
