{
	"version": 1,
	"deps": [
		{"id":"packages/pgfplots"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/tikz"},
		{"id":"packages/pgf"},
		{"id":"packages/pgfrcs"},
		{"id":"packages/pgfcore"},
		{"id":"packages/pgfsys"},
		{"id":"packages/xcolor"},
		{"id":"packages/pgfcomp-version-0-65"},
		{"id":"packages/pgfcomp-version-1-18"},
		{"id":"packages/pgffor"},
		{"id":"packages/pgfkeys"},
		{"id":"packages/pgfmath"},
		{"id":"packages/array"}
	],
	"macros": [
		{"name":"ifpgfplotstableuserow","hidden":true,"conditional":true},
		{"name":"pgfplotsrevision"},
		{"name":"pgfplotsrevisiondate"},
		{"name":"pgfplotsrevisiondatetime"},
		{"name":"pgfplotstableclear","args":[{"kind":"m","placeholder":"table"}]},
		{"name":"pgfplotstablenew","args":[{"kind":"s"},{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"row count"},{"kind":"m","placeholder":"table"}],"doc":"Creates a new table from scratch. The new table will contain all columns listed in the columns key."},
		{"name":"pgfplotstablesave","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"macro or input file name","role":"listing","ext":".tex","appends":"missing"},{"kind":"m","placeholder":"output file name"}],"doc":"This command takes a table and writes it to a new data file (without performing any typesetting)."},
		{"name":"pgfplotstablesort","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"table"}],"doc":"Sorts ⟨\\table or filename⟩ according to ⟨options⟩ and writes the sorted table to ⟨\\resulttable⟩."},
		{"name":"pgfplotstabletranspose","args":[{"kind":"s"},{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"outtable","role":"macro","defines":"provide"},{"kind":"m","placeholder":"table or filename","role":"listing","ext":".tex","appends":"missing"}],"doc":"Defines ⟨\\outtable⟩ to be the transposed of ⟨\\table or filename⟩."},
		{"name":"pgfplotstableuserowfalse","hidden":true},
		{"name":"pgfplotstablevertcat","args":[{"kind":"m","placeholder":"table"},{"kind":"m","placeholder":"table or filename","role":"listing","ext":".tex","appends":"missing"}],"doc":"Appends the contents of ⟨\\table2⟩ to ⟨\\table1⟩ (“vertical concatenation”)."},
		{"name":"pgfplotsversion"},
		{"name":"pgfplotsversiondate"},
		{"name":"pgfplotsversiondatetime"}
	],
	"ctan": "pgfplots"
}
