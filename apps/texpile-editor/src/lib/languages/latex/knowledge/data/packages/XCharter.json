		{"name":"textsup","args":[{"kind":"m","role":"text","mode":"text"}]},
		{"name":"textth","args":[{"kind":"m","placeholder":"text","role":"text"}],"in":"text"},
		{"name":"textthit","args":[{"kind":"m","role":"text"}],"in":"text"},
