{
	"version": 1,
	"deps": [
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/verbatim"}
	],
	"macros": [
		{"name":"fmpaddtoscriptpostamble","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"fmpaddtoscriptpreamble","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"fmpaddtosourcepostamble","args":[{"kind":"m","placeholder":"text"}]},
