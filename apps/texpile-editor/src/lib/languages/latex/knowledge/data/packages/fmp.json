		{"name":"fmpfigure","args":[{"kind":"o","placeholder":"graphicx options"},{"kind":"m","placeholder":"figure name"}],"doc":"You include a figure into your LaTeX document by using the \\fmpfigure macro."},
		{"name":"fmpfigurebasename","args":[{"kind":"m","placeholder":"base name"}]},
		{"name":"fmpscriptfilename","args":[{"kind":"m","placeholder":"file name"}]},
