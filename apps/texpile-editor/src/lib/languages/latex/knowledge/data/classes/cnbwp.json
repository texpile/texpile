	"keys": {
		"classes/cnbwp#options": [{"key":"10pt","bare":true},{"key":"11pt","bare":true},{"key":"12pt","bare":true},{"key":"a4paper","bare":true},{"key":"a5paper","bare":true},{"key":"b5paper","bare":true},{"key":"centeredcaptions","bare":true},{"key":"executivepaper","bare":true},{"key":"hierarchicalnumbering","bare":true},{"key":"landscape","bare":true},{"key":"legalpaper","bare":true},{"key":"letterpaper","bare":true},{"key":"oneside","bare":true},{"key":"simplenumbering","bare":true},{"key":"standardcaptions","bare":true},{"key":"twoside","bare":true}]
	},
