		{"name":"RenewTasksEnvironment","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"name"},{"kind":"o","placeholder":"separator"},{"kind":"d()","placeholder":"cols"}],"doc":"Renew environment previously defined with \\NewTasksEnvironment."},
