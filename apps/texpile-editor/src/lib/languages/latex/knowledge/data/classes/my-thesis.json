{
	"version": 1,
	"deps": [
		{"id":"classes/amsbook"},
		{"id":"packages/amsmath"},
		{"id":"packages/amstext"},
		{"id":"packages/amsbsy"},
		{"id":"packages/amsopn"},
		{"id":"packages/amsfonts"},
		{"id":"packages/my-title"}
	],
	"macros": [
		{"name":"listoffigures"},
		{"name":"listoftables"},
		{"name":"section","args":[{"kind":"s"},{"kind":"o","placeholder":"short title"},{"kind":"m","placeholder":"title"}]},
		{"name":"subsection","args":[{"kind":"s"},{"kind":"o","placeholder":"short title"},{"kind":"m","placeholder":"title"}]},
		{"name":"subsubsection","args":[{"kind":"s"},{"kind":"o","placeholder":"short title"},{"kind":"m","placeholder":"title"}]},
		{"name":"theHsection","hidden":true},
		{"name":"thesection"}
	],
	"envs": [
		{"name":"abstract"},
		{"name":"thebibliography","args":[{"kind":"m","placeholder":"widest label"}],"item":["bibitem"]},
		{"name":"theindex"}
	],
	"provides": {
		"counterForms": [
			{"name":"part","form":"[arabic]"},
			{"name":"chapter","form":"[arabic]","appendix":"[Alph]"},
			{"name":"section","form":"{chapter}.[arabic]"},
			{"name":"subsection","form":"{section}.[arabic]"},
			{"name":"subsubsection","form":"{subsection}.[arabic]"},
			{"name":"paragraph","form":"{subsubsection}.[arabic]","numbered":false},
			{"name":"subparagraph","form":"{paragraph}.[arabic]","numbered":false},
			{"name":"equation","form":"[arabic]"},
			{"name":"figure","form":"[arabic]"},
			{"name":"table","form":"[arabic]"},
			{"name":"footnote","form":"[arabic]"},
			{"name":"mpfootnote","form":"[alph]"}
		],
		"counters": [
			{"name":"footnote","within":"chapter"}
		]
	},
	"passOptions": ["classes/amsbook"],
	"ctan": "uaclasses"
}
