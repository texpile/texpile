{
	"version": 1,
	"deps": [
		{"id":"classes/article"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/url"},
		{"id":"packages/geometry"},
		{"id":"packages/ifvtex"},
		{"id":"packages/iftex"},
		{"id":"packages/color","if":"dummy"}
	],
	"macros": [
		{"name":"gallerySetup","args":[{"kind":"m","placeholder":"keys","keys":["classes/image-gallery#IG"]}]},
		{"name":"makeGallery","args":[{"kind":"m","placeholder":"list file","role":"listing","ext":".tex","appends":"missing"}]}
	],
	"keys": {
		"classes/image-gallery#options": [{"key":"dummy","bare":true},{"key":"nocaption","bare":true}],
		"classes/image-gallery#IG": [{"key":"columns","placeholder":""},{"key":"left","placeholder":""},{"key":"rows","placeholder":""},{"key":"height","placeholder":""},{"key":"bottom","placeholder":""},{"key":"top","placeholder":""},{"key":"autorotate","bare":true,"placeholder":""},{"key":"right","placeholder":""},{"key":"width","placeholder":""}]
	},
	"provides": {
		"counterForms": [
			{"name":"part","form":"[Roman]"},
			{"name":"section","form":"[arabic]","appendix":"[Alph]"},
			{"name":"subsection","form":"{section}.[arabic]"},
			{"name":"subsubsection","form":"{subsection}.[arabic]"},
			{"name":"paragraph","form":"{subsubsection}.[arabic]","numbered":false},
			{"name":"subparagraph","form":"{paragraph}.[arabic]","numbered":false},
			{"name":"equation","form":"[arabic]"},
			{"name":"figure","form":"[arabic]"},
			{"name":"table","form":"[arabic]"},
			{"name":"footnote","form":"[arabic]"},
			{"name":"mpfootnote","form":"[alph]"}
		]
	},
	"passOptions": ["classes/article"]
}
