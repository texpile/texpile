		{"name":"incluirsimbolos","args":[{"kind":"m","placeholder":"path"}],"if":"simbolos","doc":"Inclusão do arquivo para a lista de símbolos."},
		{"name":"listofquadros","args":[{"kind":"s"}],"doc":"Estende o conteúdo da macro \\listofquadros para criar o bookmark no PDF automaticamente."},
