	"macros": [
		{"name":"computemodel","args":[{"kind":"o","placeholder":"keys","keys":["packages/numodel#numodel-cmd"]}],"doc":"\\computemodel iterates the rules forward in time using Euler integration with step size \\ballDt, stopping when \\mstop’s condition becomes true (or when the maxiter safety limit is reached, see Section 3)."},
		{"name":"copymodel","args":[{"kind":"o","placeholder":"keys"},{"kind":"m","placeholder":"source"},{"kind":"m","placeholder":"copy"}],"doc":"\\copymodel[<keys>]{<source>}{<copy>} creates the model ⟨copy⟩ with all declarations of ⟨source⟩; references in rules are renamed (\\sprongV becomes \\foutV)."},
		{"name":"diagrammodel","args":[{"kind":"o","placeholder":"keys","keys":["packages/numodel#numodel-cmd"]},{"kind":"m","placeholder":"xvar"},{"kind":"m","placeholder":"yvar"},{"kind":"o","placeholder":"extra"},{"kind":"m","placeholder":"label"}],"doc":"Convenience wrapper that produces a complete figure with caption and label."},
		{"name":"graphicmodel","args":[{"kind":"o","placeholder":"keys","keys":["packages/numodel#numodel-cmd"]}],"doc":"Renders the Forrester stock-and-flow diagram."},
		{"name":"mcoords","args":[{"kind":"m","placeholder":"xvar"},{"kind":"m","placeholder":"yvar"}],"doc":"Returns a comma-separated PGFPlots coordinate list of the simulated series for two variables."},
		{"name":"mcoordsp","args":[{"kind":"m","placeholder":"prefix"},{"kind":"m","placeholder":"xvar"},{"kind":"m","placeholder":"yvar"}]},
		{"name":"mremoverule","args":[{"kind":"o","placeholder":"keys","keys":["packages/numodel#numodel-pos"]},{"kind":"m","placeholder":"Name"}],"doc":"\\mremoverule[⟨prefix=...⟩]{⟨Name⟩} removes every rule for ⟨Name⟩."},
		{"name":"mrule","args":[{"kind":"s"},{"kind":"o","placeholder":"keys","keys":["packages/numodel#numodel-pos","packages/numodel#numodel-mvar"]},{"kind":"m","placeholder":"LHS"},{"kind":"m","placeholder":"expr"}],"doc":"Adds a rule of the form ⟨LHS⟩ ← ⟨expr⟩."},
		{"name":"mruletext","args":[{"kind":"o","placeholder":"keys","keys":["packages/numodel#numodel-pos","packages/numodel#numodel-cmd"]},{"kind":"m","placeholder":"text"}],"doc":"Inserts a free-text row in the rule table without registering a rule with the simulator."},
		{"name":"mstep","args":[{"kind":"m","placeholder":"Name"},{"kind":"m","placeholder":"i"}],"doc":"Returns the value of one variable at a chosen iteration."},
		{"name":"mstepat","args":[{"kind":"m","placeholder":"Name"},{"kind":"m","placeholder":"Var"},{"kind":"m","placeholder":"value"}],"doc":"Returns the value of a variable at the first step where another variable – usually the time – has reached a given value, so the text does not depend on the time step."},
