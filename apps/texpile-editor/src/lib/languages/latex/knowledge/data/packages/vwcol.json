{
	"version": 1,
	"deps": [
		{"id":"packages/calc"},
		{"id":"packages/color"},
		{"id":"packages/environ"},
		{"id":"packages/keyval"},
		{"id":"packages/ragged2e"}
	],
	"macros": [
		{"name":"vwcolsetup","args":[{"kind":"m","placeholder":"options","keys":["packages/vwcol#keyval:vwcol"]}],"doc":"This macro may be used to set the default values for the options (described subsequently) of the vwcol environment."}
	],
	"envs": [
