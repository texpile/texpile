{
	"version": 1,
	"deps": [
		{"id":"packages/xkeyval"},
		{"id":"packages/etoolbox"},
		{"id":"packages/aliascnt"},
		{"id":"packages/amsmath"},
		{"id":"packages/amstext"},
		{"id":"packages/amsbsy"},
		{"id":"packages/amsopn"},
		{"id":"packages/amsthm"},
		{"id":"packages/amssymb","if":"!resetstyle"},
		{"id":"packages/amsfonts","if":"!resetstyle"}
	],
	"macros": [
		{"name":"claimname"},
		{"name":"conjecturename"},
		{"name":"corollaryname"},
		{"name":"definitionname"},
		{"name":"ideaname"},
		{"name":"lemmaname"},
		{"name":"noproofref","doc":"The command \\noproofref temporarily disables the proof-ref mechanism (and restores \\label to LaTeX’s original meaning) for the current theorem."},
		{"name":"observationname"},
		{"name":"phfLoadThmSet","args":[{"kind":"m","placeholder":"theorem options"},{"kind":"m","placeholder":"definition options"},{"kind":"m","placeholder":"theorem set"}],"doc":"The macro \\phfLoadThmSet loads a theorem set."},
		{"name":"phfMakeProofEnv","args":[{"kind":"o","placeholder":"key-value options"},{"kind":"m","placeholder":"environment name"}],"doc":"This defines a new environment with the given name, which may be used to display proofs to theorems."},
		{"name":"phfMakeTheorem","args":[{"kind":"o","placeholder":"key-value options"},{"kind":"m","placeholder":"environment name"},{"kind":"m","placeholder":"theorem name"}],"doc":"This command defines a new environment (given as the first mandatory argument) which behaves as a theorem and is displayed as given by the second mandatory argument."},
		{"name":"phfMakeThmheadingEnvironment","args":[{"kind":"o","placeholder":"key-value options"},{"kind":"m","placeholder":"environment name"}],"doc":"Creates a new environment \\begin{thmheading}{Title}...\\end{thmheading} for customizing the heading on-the-fly (see documentation in section 6)."},
		{"name":"phfPinProofAnchor","hidden":true},
		{"name":"phfProofrefPageAheadTolerance"},
		{"name":"phfProofrefPageBackTolerance"},
		{"name":"phfthmLoadThmSet","args":[{"kind":"m"},{"kind":"m"},{"kind":"m"}],"hidden":true},
		{"name":"phfthmMakeThmheadingEnvironment","args":[{"kind":"o"},{"kind":"m"}],"hidden":true},
		{"name":"problemname"},
		{"name":"proofofname","args":[{"kind":"m","placeholder":"theorem title"}],"doc":"The globally defined macro \\proofofname specifies the default way of displaying “Proof of Theorem 5.”"},
		{"name":"proofonname","args":[{"kind":"m"},{"kind":"m"}],"hidden":true},
		{"name":"proofrefsize","hidden":true},
		{"name":"propositionname"},
		{"name":"questionname"},
		{"name":"remarkname"},
		{"name":"theoremname"},
		{"name":"thephfthmheadingcounter","hidden":true},
		{"name":"thephfthmInternalProofrefCounter","hidden":true}
	],
	"envs": [
		{"name":"claim","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=rich"},
		{"name":"conj","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=shortnames"},
		{"name":"conjecture","star":{},"args":[{"kind":"o","placeholder":"title"}]},
		{"name":"cor","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=shortnames"},
		{"name":"corollary","star":{},"args":[{"kind":"o","placeholder":"title"}]},
		{"name":"definition","star":{},"args":[{"kind":"o","placeholder":"title"}]},
		{"name":"defn","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=shortnames"},
		{"name":"idea","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=rich"},
		{"name":"lem","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=shortnames"},
		{"name":"lemma","star":{},"args":[{"kind":"o","placeholder":"title"}]},
		{"name":"observation","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=rich"},
		{"name":"problem","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=rich"},
		{"name":"proof","args":[{"kind":"o","placeholder":"*label"}],"doc":"By default, the phfthm package overrides the proof environment with a the package’s own enhanced version."},
		{"name":"prop","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=shortnames"},
		{"name":"proposition","star":{},"args":[{"kind":"o","placeholder":"title"}]},
		{"name":"question","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=rich"},
		{"name":"rem","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=shortnames"},
		{"name":"remark","star":{},"args":[{"kind":"o","placeholder":"title"}]},
		{"name":"theorem","star":{},"args":[{"kind":"o","placeholder":"title"}]},
		{"name":"thm","star":{},"args":[{"kind":"o","placeholder":"title"}],"if":"thmset=shortnames"},
		{"name":"thmheading","args":[{"kind":"m","placeholder":"title"}]}
	]
}
