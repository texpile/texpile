{
	"version": 1,
	"macros": [
		{"name":"disableindex","args":[{"kind":"m","placeholder":"tags"}]},
		{"name":"ifproofmode","hidden":true,"conditional":true},
		{"name":"index","args":[{"kind":"s"},{"kind":"o","placeholder":"tag"},{"kind":"m","placeholder":"entry"}]},
		{"name":"indexproofstyle","args":[{"kind":"m","placeholder":"font commands"}],"register":"token","value":"\\footnotesize \\reset@font \\ttfamily "},
		{"name":"newindex","args":[{"kind":"s"},{"kind":"o","placeholder":"counter command"},{"kind":"m","placeholder":"tag"},{"kind":"m","placeholder":"raw ext"},{"kind":"m","placeholder":"processed ext"},{"kind":"m","placeholder":"title"}]},
