	"macros": [
		{"name":"PSTtoEPS","args":[{"kind":"o","placeholder":"parameters","keys":["packages/pst-eps#pst-eps:options"]},{"kind":"m","placeholder":"filename","role":"listing","ext":".tex","appends":"missing"},{"kind":"m","placeholder":"graphic object"}],"doc":"With PSTtoEPS the PSTricks environment can be saved in an external file without detours."}
	],
	"envs": [
