		{"id":"packages/pstricks"},
		{"id":"packages/iftex"},
		{"id":"packages/xcolor"},
		{"id":"packages/xkeyval"},
		{"id":"packages/pgffor"},
		{"id":"packages/pgfrcs"},
		{"id":"packages/pgfkeys"},
