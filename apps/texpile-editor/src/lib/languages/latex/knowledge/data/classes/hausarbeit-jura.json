{
	"version": 1,
	"deps": [
		{"id":"packages/ifthen"},
		{"id":"packages/iftex"},
		{"id":"classes/jurabook"},
		{"id":"packages/jurabase"},
		{"id":"packages/xspace"},
		{"id":"packages/calc"},
		{"id":"packages/fancyhdr"},
		{"id":"packages/multicol"},
		{"id":"classes/book"},
		{"id":"packages/ifpdf"},
		{"id":"packages/inputenc"},
		{"id":"packages/tgtermes","if":"!oldfonts"},
		{"id":"packages/kvoptions","if":"!oldfonts"},
		{"id":"packages/keyval"},
		{"id":"packages/kvsetkeys","if":"!oldfonts"},
		{"id":"packages/tgheros","if":"!oldfonts"},
		{"id":"packages/tgcursor","if":"!oldfonts"},
		{"id":"packages/textcomp"},
		{"id":"packages/eurosym"},
		{"id":"packages/babel"},
		{"id":"packages/geometry"},
		{"id":"packages/ifvtex"},
		{"id":"packages/ellipsis"},
		{"id":"packages/csquotes"},
		{"id":"packages/etoolbox"},
		{"id":"packages/microtype"},
		{"id":"packages/jurabib"},
		{"id":"packages/url"},
		{"id":"packages/array"},
		{"id":"packages/mathptmx","if":"oldfonts"},
		{"id":"packages/helvet","if":"oldfonts"},
		{"id":"packages/varioref","if":"varioref"}
	],
	"macros": [
		{"name":"author","args":[{"kind":"o","placeholder":"short author"},{"kind":"m","placeholder":"author"}]},
		{"name":"matrikelnummer","args":[{"kind":"m","placeholder":"matriculation number"}]},
		{"name":"prof","args":[{"kind":"m","placeholder":"supervisor"}]},
		{"name":"sectionafter","hidden":true},
		{"name":"sectionbefore","hidden":true},
		{"name":"semester","args":[{"kind":"o","placeholder":"semester of study"},{"kind":"m","placeholder":"semester"}]},
		{"name":"setpg","args":[{"kind":"o"},{"kind":"m"}],"hidden":true},
		{"name":"setpgfront","args":[{"kind":"m","placeholder":"geometry options"}]},
		{"name":"setpgmain","args":[{"kind":"m","placeholder":"geometry options"}],"doc":"Möchte man den Satzspiegel ändern, so sollte man hierfür die Befehle \\setpgfront{hMaße für Vorspanni} bzw. \\setpgmain{hMaße für Hauptteili} nutzen."},
		{"name":"setspaceafterchapter","args":[{"kind":"m","placeholder":"length"}]},
		{"name":"setspaceaftersection","args":[{"kind":"m","placeholder":"length"}]},
		{"name":"setspacebeforechapter","args":[{"kind":"m","placeholder":"length"}]},
		{"name":"setspacebeforesection","args":[{"kind":"m","placeholder":"length"}]}
	],
	"passOptions": ["classes/jurabook"]
}
