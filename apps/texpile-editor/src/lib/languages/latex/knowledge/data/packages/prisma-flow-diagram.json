		{"name":"prismaflowarrow","args":[{"kind":"m","placeholder":"source"},{"kind":"m","placeholder":"destination"}],"doc":"Manually connects two nodes with an arrow. - `<source>`: The ID of the source node. - `<destination>`: The ID of the destination node."},
		{"name":"prismaflowend","doc":"Ends the PRISMA flow diagram."},
		{"name":"prismaflownode","args":[{"kind":"m","placeholder":"id"},{"kind":"m","placeholder":"position"},{"kind":"m","placeholder":"text"},{"kind":"m","placeholder":"arrow source"}]},
		{"name":"prismaflowstart","doc":"Starts the PRISMA flow diagram."},
		{"name":"prismalabel","args":[{"kind":"m","placeholder":"size"},{"kind":"m","placeholder":"position"},{"kind":"m","placeholder":"text"}],"doc":"Adds a vertical label to the left of the diagram. - `<size>`: Size of the label box, typically `1.3*\\mh`. - `<position>`: Position relative to a node."}
