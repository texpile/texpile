		{"name":"HTMLchapHook","args":[{"kind":"m"}],"hidden":true},
		{"name":"HTMLsecHook","args":[{"kind":"m"},{"kind":"m"}],"hidden":true},
		{"name":"jrnlday","args":[{"kind":"o","placeholder":"options","keys":["classes/scrjrnl#jrnlday"]},{"kind":"m","placeholder":"title"}],"doc":"In order to typeset a single journal entry, use the \\jrnlday command."},
		{"name":"jrnldayafterskip","hidden":true},
		{"name":"jrnldaysepskip","hidden":true},
		{"name":"jrnlformatdate","args":[{"kind":"m","placeholder":"day"},{"kind":"m","placeholder":"month"},{"kind":"m","placeholder":"year"}],"hidden":true},
		{"name":"jrnlformatindexdate","args":[{"kind":"m","placeholder":"day"},{"kind":"m","placeholder":"month"},{"kind":"m","placeholder":"year"}],"hidden":true},
		{"name":"jrnlmonth","args":[{"kind":"o","placeholder":"options","keys":["classes/scrjrnl#jrnlmonth"]}],"doc":"The \\jrnlmonth command starts a new month."},
		{"name":"monthheadfont","hidden":true},
		{"name":"thejrnlday","hidden":true},
		{"name":"thejrnlmonth","hidden":true},
		{"name":"thejrnlmonthstartday","hidden":true},
		{"name":"thejrnlstartday","hidden":true},
		{"name":"thejrnlstartmonth","hidden":true},
		{"name":"thejrnltotalday","hidden":true},
		{"name":"thejrnlyear","hidden":true}
	],
	"envs": [
		{"name":"journal","args":[{"kind":"o","placeholder":"options","keys":["classes/scrjrnl#jrnl"]}],"doc":"The journal environment is the main addition of this class. It provides an environment in which to typeset journal entries."}
	],
	"keys": {
		"classes/scrjrnl#options": [{"key":"cleardaypages","bare":true},{"key":"fancytabs","bare":true},{"key":"monthpages","bare":true},{"key":"scrartcl","bare":true},{"key":"scrbook","bare":true},{"key":"scrreprt","bare":true}],
		"classes/scrjrnl#jrnlday": [{"key":"ante","placeholder":""},{"key":"post","placeholder":""},{"key":"day","placeholder":""}],
		"classes/scrjrnl#jrnlmonth": [{"key":"startday","placeholder":"number"},{"key":"month","placeholder":"number"}],
		"classes/scrjrnl#jrnl": [{"key":"startmonth","placeholder":"number"},{"key":"startday","placeholder":"number"},{"key":"bleed","placeholder":"length"}]
	},
	"provides": {
		"counterForms": [
			{"name":"part","form":"[Roman]"},
			{"name":"chapter","form":"[arabic]","appendix":"[Alph]"},
			{"name":"section","form":"{chapter}.[arabic]"},
			{"name":"subsection","form":"{section}.[arabic]"},
			{"name":"subsubsection","form":"{subsection}.[arabic]","numbered":false},
			{"name":"paragraph","form":"{subsubsection}.[arabic]","numbered":false},
			{"name":"subparagraph","form":"{paragraph}.[arabic]","numbered":false},
			{"name":"equation","form":"{chapter}.[arabic]"},
			{"name":"figure","form":"{chapter}.[arabic]"},
			{"name":"table","form":"{chapter}.[arabic]"},
			{"name":"footnote","form":"[arabic]"},
			{"name":"mpfootnote","form":"[alph]"}
		],
		"counters": [
			{"name":"equation","within":"chapter"},
			{"name":"footnote","within":"chapter"}
		]
