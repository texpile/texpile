{
	"version": 1,
	"deps": [
		{"id":"classes/scrbook","if":"!scrartcl+!scrreprt"},
		{"id":"packages/scrkbase"},
		{"id":"packages/scrbase"},
		{"id":"packages/scrlfile"},
		{"id":"packages/scrlfile-hook"},
		{"id":"packages/scrlogo"},
		{"id":"packages/keyval"},
		{"id":"packages/tocbasic"},
		{"id":"packages/typearea"},
		{"id":"packages/titlesec"},
		{"id":"packages/fancytabs"},
		{"id":"packages/tikz"},
