		{"name":"printglossary","args":[{"kind":"o","placeholder":"label width"}],"if":"compatible","hidden":true},
		{"name":"printnomenclature","args":[{"kind":"o","placeholder":"label width"}]},
		{"name":"setnomtableformat","args":[{"kind":"m","placeholder":"column format"}]}
