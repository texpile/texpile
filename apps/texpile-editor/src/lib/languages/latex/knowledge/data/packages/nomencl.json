		{"name":"nomlabelwidth","register":"length","value":"28.45274pt"},
		{"name":"nomname","value":"Nomenclature"},
		{"name":"nomnorefeq"},
		{"name":"nomnorefeqpage"},
		{"name":"nomnorefpage"},
		{"name":"nompageref","args":[{"kind":"m"}],"hidden":true},
