		{"name":"nomGname","hidden":true,"value":"Greek Letters"},
		{"name":"nomgroup","args":[{"kind":"m","placeholder":"group"}]},
		{"name":"nomitemsep","doc":"The skip between two items is adjustable by changing \\nomitemsep.","register":"skip","value":"4.0pt plus 2.0pt minus 1.0pt"},
