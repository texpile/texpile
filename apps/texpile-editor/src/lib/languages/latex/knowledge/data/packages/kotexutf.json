		{"name":"nobreakafterasciichar"},
		{"name":"nobreakafterinlinemath"},
		{"name":"PrerenderUnicode","args":[{"kind":"m"}],"hidden":true},
		{"name":"rieul"},
		{"name":"SetAdhocFonts","args":[{"kind":"m","placeholder":"hangul font"},{"kind":"m","placeholder":"hanja font"}]},
		{"name":"SetHangulFonts","args":[{"kind":"m","placeholder":"serif font"},{"kind":"m","placeholder":"sans font"},{"kind":"m","placeholder":"mono font"}],"doc":"기본 글꼴을 설정한다. 세 개의 인자는 각각 명조/고딕/타자에 해당한다."},
		{"name":"SetHanjaFonts","args":[{"kind":"m","placeholder":"serif font"},{"kind":"m","placeholder":"sans font"},{"kind":"m","placeholder":"mono font"}],"doc":"기본 글꼴을 설정한다. 세 개의 인자는 각각 명조/고딕/타자에 해당한다."},
