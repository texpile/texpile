		{"name":"unihangulchar","args":[{"kind":"m"}],"hidden":true},
		{"name":"usehangulfontspec","args":[{"kind":"m","placeholder":"font spec name","role":"text"}]}
	],
	"keys": {
		"packages/kotexutf#options": [{"key":"finemath","bare":true},{"key":"hangul","bare":true},{"key":"hanja","bare":true},{"key":"nojosa","bare":true},{"key":"nonfrench","bare":true},{"key":"strictcharcheck","bare":true}]
