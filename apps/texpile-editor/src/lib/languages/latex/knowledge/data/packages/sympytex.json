{
	"version": 1,
	"deps": [
		{"id":"packages/verbatim"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"},
		{"id":"packages/makecmds"},
		{"id":"packages/ifpdf"},
		{"id":"packages/iftex"},
		{"id":"packages/ifthen"}
	],
	"macros": [
