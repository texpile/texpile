		{"name":"paperident","args":[{"kind":"m","placeholder":"paper identifier"}],"doc":"The command \\paperident allows you to declare some text which appears at the bottom of each page of the exam."},
		{"name":"part","args":[{"kind":"o","placeholder":"part number"}],"doc":"Questions may be subdivided into parts, such as (a), (b), (c)..., or (i), (ii), (iii), and so on. Precede each of these with this \\part command."},
		{"name":"Partial","args":[{"kind":"s"},{"kind":"o","placeholder":"order"},{"kind":"m","placeholder":"function"},{"kind":"m","placeholder":"variable"}]},
		{"name":"partmarks","args":[{"kind":"s"},{"kind":"o","placeholder":"category"},{"kind":"m","placeholder":"marks"}]},
		{"name":"QuestionNumberChecksOff"},
		{"name":"questionpreamble","args":[{"kind":"m"}],"doc":"If \\questionpreamble is called, then its contents are displayed just before the start of the next question."},
