	"macros": [
		{"name":"answer"},
		{"name":"author","args":[{"kind":"m","placeholder":"author name"}],"doc":"The \\author command is a convenience. Used within a {question} environment – most naturally just after the \\begin{question} – it creates a comment with the author’s name."},
