		{"name":"e","doc":"the exponential is typeset in an upright rather than italic shape, as in $\\e^{i\\pi}=-1$."},
		{"name":"exambanner","args":[{"kind":"m","placeholder":"banner text"}],"doc":"The \\exambanner macro supplies text like ‘Examination for the degrees of...’."},
		{"name":"examdate","args":[{"kind":"m","placeholder":"exam date"}],"doc":"Give the date and time of the exam with \\examdate and \\examtime."},
		{"name":"examtime","args":[{"kind":"m","placeholder":"exam time"}],"doc":"Give the date and time of the exam with \\examdate and \\examtime."},
