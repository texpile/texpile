		{"name":"rubric","args":[{"kind":"m","placeholder":"rubric text"}]},
		{"name":"schoolcoursecode","args":[{"kind":"m","placeholder":"school course code"}]},
		{"name":"section","args":[{"kind":"s"},{"kind":"o","placeholder":"short title"},{"kind":"m","placeholder":"title"}]},
		{"name":"shout","args":[{"kind":"m"}],"doc":"If there is part of a question which is, for example, incomplete, and which needs a more prominent callout than ‘comment’, then you should \\shout{...} it. Shouts appear in all modes (including final) and appear whether or not the class is showing solutions."},
		{"name":"StylePartNumber","args":[{"kind":"m"}],"hidden":true},
		{"name":"subsection","args":[{"kind":"s"},{"kind":"o","placeholder":"short title"},{"kind":"m","placeholder":"title"}]},
