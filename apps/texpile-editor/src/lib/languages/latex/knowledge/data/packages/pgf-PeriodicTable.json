	"keys": {
		"packages/pgf-PeriodicTable#options": [{"key":"beamer","bare":true},{"key":"beamer*","bare":true},{"key":"beamer**","bare":true},{"key":"br","bare":true},{"key":"de","bare":true},{"key":"dvnnumerals","bare":true},{"key":"en","bare":true},{"key":"es","bare":true},{"key":"extdash","bare":true},{"key":"fr","bare":true},{"key":"hyperref","bare":true},{"key":"it","bare":true},{"key":"pt","bare":true},{"key":"zhnumerals","bare":true}]
	}
