	"macros": [
		{"name":"pgfPT","args":[{"kind":"o","placeholder":"options list"}]},
		{"name":"pgfPTbuildcell","args":[{"kind":"d()","placeholder":"nrows,ncolumns"},{"kind":"o","placeholder":"entries"}],"doc":"With \\pgfPTbuildcell it is possible to customize the elementar cell of the Periodic Table."},
		{"name":"pgfPTbuildcellstyle","args":[{"kind":"m","placeholder":"name"},{"kind":"d()","placeholder":"nrows,ncolumns"},{"kind":"o","placeholder":"entries"}]},
		{"name":"pgfPTcellht","hidden":true},
		{"name":"pgfPTcellwd","hidden":true},
		{"name":"pgfPTCScombine","args":[{"kind":"o","placeholder":"prop1:prop2,mode"},{"kind":"m","placeholder":"color scheme names"}]},
		{"name":"pgfPTCSwrite","args":[{"kind":"o","placeholder":"filename"},{"kind":"m","placeholder":"color scheme names"}],"doc":"This command writes the provided Color Schemes to a file for later use without loading this library."},
		{"name":"pgfPTdvnfont","args":[{"kind":"o","placeholder":"font options"},{"kind":"m","placeholder":"font name"}]},
		{"name":"pgfPTendfittowidth","doc":"This command stops adjusting the entire Periodic Table to fit the width of the text."},
		{"name":"pgfPTfittowidth","args":[{"kind":"o","placeholder":"font size"}],"doc":"This command starts adjusting the entire Periodic Table to fit the text width, assuming the text width of the base LaTeX classes, meaning that the page layout has not been altered in any other way."},
		{"name":"pgfPTGroupColors","args":[{"kind":"o","placeholder":"default group color"},{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"list of colors,options"}]},
		{"name":"pgfPTnewColorScheme","args":[{"kind":"o","placeholder":"trailing color"},{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"color list"}],"doc":"Use this command to create a color scheme for cells in the Periodic Table."},
		{"name":"pgfPTnewZlist","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"list"}],"doc":"This command makes a user defined atomic numbers’ list with the provided name."},
		{"name":"pgfPToverrideacros","args":[{"kind":"o","placeholder":"language flag"},{"kind":"m","placeholder":"override list"}],"doc":"This command can be used to override the acronyms – defined at package level – used in the legend of the contents of the Periodic Table cells."},
		{"name":"pgfPToverridenames","args":[{"kind":"o","placeholder":"language flag"},{"kind":"m","placeholder":"override list"}],"doc":"This command can be used to override the names – defined at package level – of the elements in the Periodic Table."},
		{"name":"pgfPTPeriodColors","args":[{"kind":"o","placeholder":"default period color"},{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"list of colors,options"}]},
		{"name":"pgfPTpreviewcell","args":[{"kind":"o","placeholder":"scale factor"}],"doc":"With \\pgfPTpreviewcell you can preview the last unnamed built cell with an optional scale factor."},
		{"name":"pgfPTpreviewcellstyle","args":[{"kind":"o","placeholder":"scale factor"},{"kind":"m","placeholder":"name"}]},
		{"name":"pgfPTresetcell","doc":"The \\pgfPTresetcell resets the cell to its default layout."},
		{"name":"pgfPTresetstyle"},
		{"name":"pgfPTrestoreacros","args":[{"kind":"o","placeholder":"language flag"},{"kind":"m","placeholder":"restore list"}],"doc":"This command restores the acronyms used in the legend to the default ones, defined at package level."},
		{"name":"pgfPTrestorenames","args":[{"kind":"o","placeholder":"language flag"},{"kind":"m","placeholder":"restore list"}],"doc":"This command restores the names of the elements to the default ones, defined at package level."},
		{"name":"pgfPTsetLanguage","args":[{"kind":"m","placeholder":"language flag"}],"doc":"This command globally changes the default language of the Periodic Table."},
		{"name":"pgfPTstyle","args":[{"kind":"o"}]},
		{"name":"pgfPTzhfont","args":[{"kind":"o","placeholder":"font options"},{"kind":"m","placeholder":"font name"}],"hidden":true},
		{"name":"pgfPTzhFontFeatures","args":[{"kind":"m","placeholder":"font features"}]},
