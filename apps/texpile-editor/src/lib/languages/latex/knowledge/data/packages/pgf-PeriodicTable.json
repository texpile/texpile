		{"name":"pgfPTzhnumberfont","args":[{"kind":"o","placeholder":"font options"},{"kind":"m","placeholder":"font name"}]},
		{"name":"pgfPTzhtextfontLv","args":[{"kind":"m","placeholder":"font name"}]},
		{"name":"pgfPTzhtextfontSS","args":[{"kind":"m","placeholder":"font name"}]},
		{"name":"pgfPTzhtextfontSSB","args":[{"kind":"m","placeholder":"font name"}]},
		{"name":"usepgfPTlibrary","args":[{"kind":"m","placeholder":"library names"}]}
