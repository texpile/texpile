	"macros": [
		{"name":"bakingtemperature","args":[{"kind":"m","keys":["packages/xcookybooky#keyval:bakingtemperature"]}],"doc":"This macro allows you to enter some bakingtemperatures."},
		{"name":"graph","args":[{"kind":"m","keys":["packages/xcookybooky#keyval:picture"]}],"doc":"It is possible to set two pictures by using the macro graph."},
		{"name":"hint","args":[{"kind":"m"}],"doc":"This command allows the user to insert an optional hint at the bottom of the recipe."},
		{"name":"ingredients","args":[{"kind":"o","placeholder":"number of lines"},{"kind":"m","placeholder":"ingredients"}],"doc":"The command is used to insert the ingredients, which are displayed as a table."},
		{"name":"introduction","args":[{"kind":"m"}]},
		{"name":"portion","args":[{"kind":"o","placeholder":"unit"},{"kind":"m","placeholder":"value"}],"doc":"This macro is for inserting the portions correctly."},
		{"name":"postingredients","args":[{"kind":"m"}]},
		{"name":"postpreparation","args":[{"kind":"m"}]},
		{"name":"pregraph","args":[{"kind":"m"}]},
		{"name":"preingredients","args":[{"kind":"m"}]},
		{"name":"preparation","args":[{"kind":"m"}],"doc":"This command enables the user to insert the preparation steps."},
		{"name":"prepreparation","args":[{"kind":"m"}]},
		{"name":"prerecipeoverview","args":[{"kind":"m"}]},
		{"name":"pretitle","args":[{"kind":"m"}]},
		{"name":"recipesection","args":[{"kind":"o","placeholder":"short title"},{"kind":"m","placeholder":"title"}],"doc":"The macro recipesection allows to modify the entry in the table of contents."},
		{"name":"setBackgroundPicture","args":[{"kind":"o","placeholder":"keys","keys":["packages/xcookybooky#keyval:background"]},{"kind":"m","placeholder":"picture"}]},
		{"name":"setHeadlines","args":[{"kind":"m","keys":["packages/xcookybooky#keyval:headlines"]}],"doc":"This allows you to modify the headlines for the recipe parts."},
		{"name":"setRecipeColors","args":[{"kind":"m","keys":["packages/xcookybooky#keyval:colorManagement"]}],"doc":"If you want to change the default colors, you can use setRecipeColors. The colors are set by <key = value> as known by the xkeyval package."},
		{"name":"setRecipeLengths","args":[{"kind":"m","keys":["packages/xcookybooky#keyval:recipelengths"]}],"doc":"By using the command setRecipeLengths it is possible to change the (default) values for the picture widths and the text column widths."},
		{"name":"setRecipenameFont","args":[{"kind":"m","placeholder":"family"},{"kind":"m","placeholder":"encoding"},{"kind":"m","placeholder":"series"},{"kind":"m","placeholder":"shape"}]},
		{"name":"setRecipeSizes","args":[{"kind":"m","keys":["packages/xcookybooky#keyval:sizeManagement"]}],"doc":"The macro setRecipeSizes enables you to modify the font size of many parts of the recipe."},
		{"name":"step","doc":"The command is used for numbering the steps of preparation."},
		{"name":"suggestion","args":[{"kind":"o","placeholder":"headline"},{"kind":"m","placeholder":"text"}],"doc":"The command is intended to insert some suggestions after the preparation and ingredients part."},
		{"name":"thestep","hidden":true}
	],
	"envs": [
		{"name":"recipe","args":[{"kind":"o","placeholder":"options","keys":["packages/xcookybooky#keyval:recipe"]},{"kind":"m","placeholder":"recipe name"}]}
	],
	"keys": {
		"packages/xcookybooky#keyval:background": [{"key":"height","bare":true},{"key":"width","bare":true},{"key":"x","bare":true},{"key":"y","bare":true},{"key":"orientation","values":["default","pagecenter","textcenter","stockcenter"]}],
		"packages/xcookybooky#keyval:bakingtemperature": [{"key":"bottomheat","bare":true},{"key":"fanoven","bare":true},{"key":"gasstove","bare":true},{"key":"topbottomheat","bare":true},{"key":"topheat","bare":true}],
		"packages/xcookybooky#keyval:colorManagement": [{"key":"hint","bare":true},{"key":"hinthead","bare":true},{"key":"hintline","bare":true},{"key":"ing","bare":true},{"key":"inghead","bare":true},{"key":"intro","bare":true},{"key":"numeration","bare":true},{"key":"prep","bare":true},{"key":"prephead","bare":true},{"key":"recipename","bare":true},{"key":"separationgraph","bare":true},{"key":"suggestion","bare":true},{"key":"suggestionhead","bare":true}],
