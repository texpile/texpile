		"packages/xcookybooky#keyval:picture": [{"key":"big","bare":true},{"key":"bigpicturewidth","bare":true},{"key":"small","bare":true},{"key":"smallpicturewidth","bare":true}],
		"packages/xcookybooky#keyval:recipe": [{"key":"bakingtemperature","bare":true},{"key":"bakingtime","bare":true},{"key":"calory","bare":true},{"key":"portion","bare":true},{"key":"preparationtime","bare":true},{"key":"source","bare":true}],
		"packages/xcookybooky#keyval:recipelengths": [{"key":"bigpicturewidth","bare":true},{"key":"ingredientswidth","bare":true},{"key":"introductionwidth","bare":true},{"key":"pictureheight","bare":true},{"key":"preparationwidth","bare":true},{"key":"smallpicturewidth","bare":true}],
		"packages/xcookybooky#keyval:sizeManagement": [{"key":"hint","bare":true},{"key":"hinthead","bare":true},{"key":"ing","bare":true},{"key":"inghead","bare":true},{"key":"intro","bare":true},{"key":"prep","bare":true},{"key":"prephead","bare":true},{"key":"recipename","bare":true},{"key":"suggestion","bare":true}],
		"packages/xcookybooky#options": [{"key":"handwritten","bare":true},{"key":"myconfig","bare":true},{"key":"nowarnings","bare":true}]
	}
}
