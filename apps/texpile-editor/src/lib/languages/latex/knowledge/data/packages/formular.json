		{"name":"setFRMdescription","args":[{"kind":"o","placeholder":"field"},{"kind":"m","placeholder":"content"}]},
		{"name":"setFRMdfontencoding","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMdfontfamily","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMdfontseries","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMdfontshape","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMdfontsize","args":[{"kind":"o"},{"kind":"m"}]},
