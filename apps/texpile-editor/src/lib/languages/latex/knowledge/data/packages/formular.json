		{"name":"setFRMfontfamily","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMfontseries","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMfontshape","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMfontsize","args":[{"kind":"o"},{"kind":"m"}]},
		{"name":"setFRMinlinestyle","args":[{"kind":"o","placeholder":"field"}]},
