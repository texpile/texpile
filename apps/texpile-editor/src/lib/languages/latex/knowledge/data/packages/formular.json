{
	"version": 1,
	"deps": [
		{"id":"packages/xspace"}
	],
	"macros": [
		{"name":"filedate","hidden":true},
		{"name":"fileversion","hidden":true},
		{"name":"newFRMcontainer","args":[{"kind":"m","placeholder":"cid"},{"kind":"m","placeholder":"init code"},{"kind":"m","placeholder":"apply code"}]},
		{"name":"newFRMenvironment","args":[{"kind":"m","placeholder":"envid"},{"kind":"m","placeholder":"description"},{"kind":"m","placeholder":"default lines"}]},
		{"name":"newFRMfield","args":[{"kind":"m","placeholder":"field id"},{"kind":"m","placeholder":"width"},{"kind":"o","placeholder":"description"},{"kind":"o","placeholder":"default content"}]},
		{"name":"renewFRMfield","args":[{"kind":"m","placeholder":"field id"},{"kind":"m","placeholder":"width"},{"kind":"o","placeholder":"description"},{"kind":"o","placeholder":"default content"}],"doc":"The macro \\renewFRMfield is nearly the same as \\newFRMfield, but it changes an existing field rather than defining a new one."},
		{"name":"setFRMbaselineskip","args":[{"kind":"o","placeholder":"field"},{"kind":"m","placeholder":"dimen"}],"doc":"sets the baselineskip of the content of multi-line FRMenvironments (default: 18pt)."},
