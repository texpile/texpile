{
	"version": 1,
	"deps": [
		{"id":"classes/scrbook"},
		{"id":"packages/scrkbase"},
		{"id":"packages/scrbase"},
		{"id":"packages/scrlfile"},
		{"id":"packages/scrlfile-hook"},
		{"id":"packages/scrlogo"},
		{"id":"packages/keyval"},
		{"id":"packages/tocbasic"},
		{"id":"packages/typearea"},
		{"id":"packages/fhjcommon"},
		{"id":"packages/xstring"},
		{"id":"packages/ifthen"},
		{"id":"packages/calc"},
		{"id":"packages/hyperref"},
		{"id":"packages/iftex"},
		{"id":"packages/kvsetkeys"},
		{"id":"packages/pdfescape"},
		{"id":"packages/pdftexcmds"},
		{"id":"packages/nameref"},
		{"id":"packages/refcount"},
		{"id":"packages/gettitlestring"},
		{"id":"packages/kvoptions"},
		{"id":"packages/etoolbox"},
		{"id":"packages/stringenc"},
		{"id":"packages/intcalc"},
		{"id":"packages/url"},
		{"id":"packages/bitset"},
		{"id":"packages/bigintcalc"},
		{"id":"packages/rerunfilecheck"},
		{"id":"packages/uniquecounter"},
		{"id":"packages/array"},
		{"id":"packages/supertabular"},
		{"id":"packages/bookmark"}
	],
	"macros": [
		{"name":"authorinfo","args":[{"kind":"m","placeholder":"gender"},{"kind":"m","placeholder":"mat-nr"},{"kind":"m","placeholder":"year"}]},
		{"name":"cosupervisor","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"gender"}]},
		{"name":"FHJAbstractDE","args":[{"kind":"m","placeholder":"abstract text"},{"kind":"m","placeholder":"keywords"}]},
		{"name":"FHJAbstractEN","args":[{"kind":"m","placeholder":"abstract text"},{"kind":"m","placeholder":"keywords"}]},
		{"name":"FHJLocation","args":[{"kind":"m","placeholder":"location"}]},
		{"name":"FHJMakeAbstract","doc":"The macro \\FHJMakeAbstract is used to typeset the abstract of the thesis including keywords in both languages."},
		{"name":"FHJMakeTitlePage","doc":"The macro \\FHJMakeTitlePage is used to typeset the title page of the thesis."},
		{"name":"FHJThesisFrontMatter","doc":"The macro \\FHJThesisFrontMatter is used to typeset the front matter of the thesis."},
		{"name":"supervisor","args":[{"kind":"m","placeholder":"name"},{"kind":"m","placeholder":"gender"}]}
	],
	"provides": {
		"counterForms": [
			{"name":"part","form":"[Roman]"},
			{"name":"chapter","form":"[arabic]","appendix":"[Alph]"},
			{"name":"section","form":"{chapter}.[arabic]"},
			{"name":"subsection","form":"{section}.[arabic]"},
			{"name":"subsubsection","form":"{subsection}.[arabic]","numbered":false},
			{"name":"paragraph","form":"{subsubsection}.[arabic]","numbered":false},
			{"name":"subparagraph","form":"{paragraph}.[arabic]","numbered":false},
			{"name":"equation","form":"{chapter}.[arabic]"},
			{"name":"figure","form":"{chapter}.[arabic]"},
			{"name":"table","form":"{chapter}.[arabic]"},
			{"name":"footnote","form":"[arabic]"},
			{"name":"mpfootnote","form":"[alph]"}
		],
		"counters": [
			{"name":"equation","within":"chapter"},
			{"name":"footnote","within":"chapter"}
		]
	},
	"passOptions": ["classes/scrbook"],
	"ctan": "fhj-script"
}
