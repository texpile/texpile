{
	"version": 1,
	"deps": [
		{"id":"packages/datenumber"}
	],
	"macros": [
		{"name":"calendarOffset","args":[{"kind":"o","placeholder":"year"}]},
		{"name":"Easter","args":[{"kind":"s"},{"kind":"o","placeholder":"year"}]},
		{"name":"EasterGregorian","args":[{"kind":"s"},{"kind":"o","placeholder":"year"}]},
		{"name":"EasterJulian","args":[{"kind":"s"},{"kind":"o","placeholder":"year"}]},
		{"name":"printDate","args":[{"kind":"m","placeholder":"feast"}],"doc":"Any date may be recalled and printed by the command \\printDate{feast}, taking the feast’s name as a mandatory argument."},
		{"name":"selectComputus","args":[{"kind":"m","placeholder":"julian or gregorian"}],"doc":"Computus can also be selected manually with \\selectComputus command. It takes one mandatory argument, julian or gregorian, and set \\Easter accordingly."},
		{"name":"thecalendaroffset","hidden":true},
		{"name":"theEasterDay","hidden":true},
		{"name":"theEasterMonth","hidden":true},
		{"name":"theEasterYear","hidden":true},
		{"name":"toGregorian","args":[{"kind":"m","placeholder":"year"},{"kind":"m","placeholder":"month"},{"kind":"m","placeholder":"day"}]},
		{"name":"toJulian","args":[{"kind":"m","placeholder":"year"},{"kind":"m","placeholder":"month"},{"kind":"m","placeholder":"day"}]}
	],
	"keys": {
		"packages/easter#options": [{"key":"gregorian","bare":true},{"key":"julian","bare":true}]
	}
}
