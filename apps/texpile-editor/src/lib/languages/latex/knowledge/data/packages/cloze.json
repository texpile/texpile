{
	"version": 1,
	"deps": [
		{"id":"packages/setspace"},
		{"id":"packages/luakeys"}
	],
	"macros": [
		{"name":"cloze","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"some text"}]},
		{"name":"clozeextend","args":[{"kind":"o","placeholder":"spaces"}]},
		{"name":"clozefil","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"some text"}],"doc":"\\clozefil fills out all available horizontal space with a line."},
		{"name":"clozefix","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"some text"}]},
		{"name":"clozefont"},
		{"name":"clozehide"},
		{"name":"clozeline","args":[{"kind":"o","placeholder":"options"}]},
		{"name":"clozelinefil","args":[{"kind":"o","placeholder":"options"}]},
		{"name":"clozenol","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"some text"}],"doc":"\\clozenol is a convenient abbreviation for \\cloze[thickness=0pt]{text}."},
		{"name":"clozeparcapture"},
