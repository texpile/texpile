	"version": 1,
	"deps": [
		{"id":"packages/ifthen"}
	],
	"macros": [
		{"name":"cvbibname","value":"Publications"},
		{"name":"cvheadingfont","declares":"font","in":"text"},
		{"name":"cvlabelfont","doc":"The labels of the cvlist environments are typeset in the normal size of the current font."},
		{"name":"cvlabelsep","doc":"The default width of the distance between the labels and the items itself is equal to 1em.","register":"skip","value":"10.0pt"},
		{"name":"cvlabelskip","register":"skip","value":"18.0pt plus 3.0pt minus 3.0pt"},
		{"name":"cvlabelwidth","register":"skip","value":"75.0pt"},
