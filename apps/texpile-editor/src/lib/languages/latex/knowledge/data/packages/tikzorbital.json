		"packages/tikzorbital#tikzorbital-satom": [{"key":"pos","bare":true,"default":"(0,0)"},{"key":"name","bare":true,"default":"X"},{"key":"color","bare":true,"default":"green","role":"color"},{"key":"scale","bare":true,"default":"1."},{"key":"opacity","bare":true,"default":".8"}]
