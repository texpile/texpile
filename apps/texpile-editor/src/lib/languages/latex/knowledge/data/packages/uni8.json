		{"id":"packages/lmodern","if":"!font=old-times+!font=oldtimes+!font=tg+!font=times"},
		{"id":"packages/babel"},
		{"id":"packages/soul"},
		{"id":"packages/soul-ori"},
		{"id":"packages/iftex"},
		{"id":"packages/mathptmx","if":"font=old-times|font=oldtimes|font=tg|font=times"},
		{"id":"packages/kvoptions","if":"font=tg|font=times"},
		{"id":"packages/keyval","if":"font=tg|font=times"},
		{"id":"packages/kvsetkeys","if":"font=tg|font=times"},
		{"id":"packages/luainputenc","engines":["lualatex"]},
		{"id":"packages/luatexbase","engines":["lualatex"]}
