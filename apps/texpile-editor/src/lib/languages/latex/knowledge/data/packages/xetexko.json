		{"name":"hangulhyphens"},
		{"name":"hangulmarks"},
		{"name":"hangulnums","hidden":true},
		{"name":"hangulparens"},
		{"name":"hangulpuncts"},
		{"name":"hangulquotes","hidden":true},
		{"name":"hanjaalphs"},
