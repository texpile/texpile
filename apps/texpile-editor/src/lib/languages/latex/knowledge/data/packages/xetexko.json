		{"name":"hanjanums","hidden":true},
		{"name":"hanjaparens"},
		{"name":"hanjapuncts"},
		{"name":"hanjaquotes","hidden":true},
		{"name":"hellipsis","hidden":true},
		{"name":"inhibitglue"},
		{"name":"jong"},
		{"name":"jung"},
		{"name":"latinalphs"},
		{"name":"latincjksymbols"},
		{"name":"latincolons"},
		{"name":"latinhyphens"},
		{"name":"latinmarks"},
		{"name":"latinnums","hidden":true},
		{"name":"latinparens"},
		{"name":"latinpuncts"},
		{"name":"latinquotes","hidden":true},
		{"name":"newhangulfontface","args":[{"kind":"m","placeholder":"command"},{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
		{"name":"newhangulfontfamily","args":[{"kind":"m","placeholder":"command"},{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
		{"name":"newhanjafontface","args":[{"kind":"m","placeholder":"command"},{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
		{"name":"newhanjafontfamily","args":[{"kind":"m","placeholder":"command"},{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
		{"name":"nocompresspunctuations"},
		{"name":"prevfontalphs"},
		{"name":"prevfontcjksymbols"},
		{"name":"prevfontcolons"},
		{"name":"prevfonthyphens"},
		{"name":"prevfontmarks"},
		{"name":"prevfontnums","hidden":true},
		{"name":"prevfontparens"},
		{"name":"prevfontpuncts"},
		{"name":"prevfontquotes","hidden":true},
		{"name":"removeclassicspaces"},
		{"name":"rieul"},
		{"name":"sethangingratio"},
