{
	"version": 1,
	"deps": [
		{"id":"packages/fontspec"},
		{"id":"packages/fontspec-xetex"},
		{"id":"packages/kolabels-utf"},
		{"id":"packages/konames-utf","if":"hangul|hanja"}
	],
	"macros": [
		{"name":"addhangulfontfeature","args":[{"kind":"m","placeholder":"font features"}]},
		{"name":"addhangulfontfeatures","args":[{"kind":"m","placeholder":"font features"}]},
		{"name":"addhanjafontfeature","args":[{"kind":"m","placeholder":"font features"}]},
		{"name":"addhanjafontfeatures","args":[{"kind":"m","placeholder":"font features"}]},
		{"name":"adhochangulfont","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
