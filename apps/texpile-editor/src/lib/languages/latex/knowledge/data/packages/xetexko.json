		{"name":"setmainhanjafont","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}],"doc":"Same as \\setmainfont etc. except that these affect only Hanja characters."},
