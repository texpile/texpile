	"envs": [
		{"name":"chinese"},
		{"name":"horizontal","args":[{"kind":"m","placeholder":"width"}]},
		{"name":"japanese"},
		{"name":"Schinese"},
		{"name":"Tchinese"},
		{"name":"typesetclassic"},
		{"name":"typesetmodern"},
		{"name":"vertical","args":[{"kind":"m","placeholder":"height"}],"doc":"This environment makes a vbox vertically typeset. <dimen> is an argument to indicate the box height."},
		{"name":"verticaltypesetting"}
	],
	"engines": ["xelatex"]
