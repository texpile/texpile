		{"name":"setmathhangulfont","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
		{"name":"setmonohangulfont","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
		{"name":"setmonohanjafont","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}],"doc":"Same as \\setmainfont etc. except that these affect only Hanja characters."},
		{"name":"setsanshangulfont","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}]},
		{"name":"setsanshanjafont","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"font name"},{"kind":"o","placeholder":"options"}],"doc":"Same as \\setmainfont etc. except that these affect only Hanja characters."},
		{"name":"typesethorizontal","hidden":true},
		{"name":"typesetvertical","hidden":true},
		{"name":"unsethangingratio"},
		{"name":"vertlatin","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"xetexkofontregime","args":[{"kind":"o","placeholder":"options"},{"kind":"m","placeholder":"regime"},{"kind":"o","placeholder":"options"}]},
		{"name":"xetexkoposthanjaspacing"},
		{"name":"xetexkoprehanjaspacing"},
		{"name":"xetexkostretchshrink","args":[{"kind":"m","placeholder":"stretch and shrink"}]},
		{"name":"xetexkoulemsupport"},
		{"name":"XKinterhangulbreak","hidden":true},
		{"name":"XKinterhanjabreak","hidden":true}
