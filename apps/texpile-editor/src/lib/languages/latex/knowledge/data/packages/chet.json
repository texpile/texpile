{
	"version": 1,
	"deps": [
		{"id":"packages/kvoptions"},
		{"id":"packages/keyval"},
		{"id":"packages/kvsetkeys"},
		{"id":"packages/xparse"},
		{"id":"packages/xspace"},
		{"id":"packages/amsmath"},
		{"id":"packages/amstext"},
		{"id":"packages/amsbsy"},
		{"id":"packages/amsopn"},
		{"id":"packages/datetime","if":"!macrosonly"},
		{"id":"packages/etoolbox","if":"!macrosonly"},
		{"id":"packages/fmtcount","if":"!macrosonly"},
		{"id":"packages/ifthen","if":"!macrosonly"},
		{"id":"packages/xkeyval","if":"!macrosonly"},
		{"id":"packages/fcprefix","if":"!macrosonly"},
		{"id":"packages/datetime-defaults","if":"!macrosonly"},
		{"id":"packages/caption","if":"!macrosonly"},
		{"id":"packages/caption3","if":"!macrosonly"},
		{"id":"packages/tocloft","if":"!macrosonly"},
		{"id":"packages/cite","if":"!macrosonly"},
		{"id":"packages/color","if":"!macrosonly"},
		{"id":"packages/microtype","if":"!macrosonly"},
		{"id":"packages/manyfoot","if":"!macrosonly"},
		{"id":"packages/nccfoots","if":"!macrosonly"},
		{"id":"packages/footmisc","if":"!macrosonly"},
		{"id":"packages/geometry","if":"!macrosonly"},
		{"id":"packages/ifvtex","if":"!macrosonly"},
		{"id":"packages/iftex","if":"!macrosonly"},
		{"id":"packages/hyperref","if":"!macrosonly"},
		{"id":"packages/pdfescape","if":"!macrosonly"},
		{"id":"packages/nameref","if":"!macrosonly"},
		{"id":"packages/refcount","if":"!macrosonly"},
		{"id":"packages/gettitlestring","if":"!macrosonly"},
		{"id":"packages/stringenc","if":"!macrosonly"},
		{"id":"packages/intcalc","if":"!macrosonly"},
		{"id":"packages/url","if":"!macrosonly"},
		{"id":"packages/bitset","if":"!macrosonly"},
		{"id":"packages/bigintcalc","if":"!macrosonly"},
		{"id":"packages/rerunfilecheck","if":"!macrosonly"},
		{"id":"packages/uniquecounter","if":"!macrosonly"},
		{"id":"packages/mciteplus","if":"mcite"}
	],
	"macros": [
		{"name":"abstract","args":[{"kind":"m","placeholder":"abstract"}]},
		{"name":"ack","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"affiliation","args":[{"kind":"m","placeholder":"affiliation"}]},
		{"name":"draftmode"},
		{"name":"email","args":[{"kind":"m","placeholder":"address"}]},
		{"name":"emails","args":[{"kind":"m","placeholder":"addresses"}]},
		{"name":"emailV","args":[{"kind":"m","placeholder":"address"}],"doc":"The command \\emailV{} is also available to be used when emails are to be displayed as vertically justified footnotes (one below the other) rather than in the same line."},
		{"name":"eqn","args":[{"kind":"m","placeholder":"equation"},{"kind":"o","placeholder":"label"}]},
		{"name":"eqna","args":[{"kind":"m","placeholder":"equation"},{"kind":"o","placeholder":"label"}],"doc":"For aligned equations with one number in the vertical middle use the command \\eqna{}[]."},
		{"name":"foot","args":[{"kind":"o","placeholder":"number"},{"kind":"m","placeholder":"text"}]},
		{"name":"fourseqn","args":[{"kind":"m","placeholder":"equation 1"},{"kind":"o","placeholder":"label 1"},{"kind":"m","placeholder":"equation 2"},{"kind":"o","placeholder":"label 2"},{"kind":"m","placeholder":"equation 3"},{"kind":"o","placeholder":"label 3"},{"kind":"m","placeholder":"equation 4"},{"kind":"o","placeholder":"label 4"},{"kind":"o","placeholder":"overall label"}]},
		{"name":"newsec","args":[{"kind":"m","placeholder":"title"},{"kind":"o","placeholder":"label"}],"doc":"Sections start with the command \\newsec{}[]. The first argument is the name of the section, while the second provides the label."},
		{"name":"preprint","args":[{"kind":"m","placeholder":"id"}]},
		{"name":"rcite","args":[{"kind":"o","placeholder":"text"},{"kind":"m","placeholder":"keys"}],"doc":"To cite a paper use the command \\rcite{}."},
		{"name":"subsec","args":[{"kind":"m","placeholder":"title"},{"kind":"o","placeholder":"label"}]},
		{"name":"subsubsec","args":[{"kind":"m","placeholder":"title"},{"kind":"o","placeholder":"label"}]},
		{"name":"threeseqn","args":[{"kind":"m","placeholder":"equation 1"},{"kind":"o","placeholder":"label 1"},{"kind":"m","placeholder":"equation 2"},{"kind":"o","placeholder":"label 2"},{"kind":"m","placeholder":"equation 3"},{"kind":"o","placeholder":"label 3"},{"kind":"o","placeholder":"overall label"}]},
		{"name":"titlemath","args":[{"kind":"m","placeholder":"math"}]},
		{"name":"toc"},
		{"name":"twoseqn","args":[{"kind":"m","placeholder":"equation 1"},{"kind":"o","placeholder":"label 1"},{"kind":"m","placeholder":"equation 2"},{"kind":"o","placeholder":"label 2"},{"kind":"o","placeholder":"overall label"}]}
	],
	"envs": [
		{"name":"acknowledgments","hidden":true},
		{"name":"appendices"}
	],
	"provides": {
		"bibStyles": [
			{"name":"chetref"}
		]
	}
}
