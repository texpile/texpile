	"macros": [
		{"name":"froufrou","args":[{"kind":"s"},{"kind":"o","placeholder":"ornament"}],"doc":"After \\usepackage{froufrou}, just call \\froufrou to create a subdivision. By default, the separator behaves like \\section, suppressing indentation in the following paragraph."},
		{"name":"frufru","args":[{"kind":"s"},{"kind":"o","placeholder":"ornament"}],"hidden":true},
		{"name":"setfroufrou","args":[{"kind":"m","placeholder":"ornament"}],"doc":"You may select a different separator appearance either by supplying the name of a predefined ornament as a package option (\\usepackage[ornament]{froufrou}) or by calling \\setfroufrou{ornament} anywhere in the document."}
	],
	"keys": {
		"packages/froufrou#options": [{"key":"asterism","bare":true},{"key":"closing","bare":true},{"key":"dinkus","bare":true},{"key":"fleuron","bare":true},{"key":"simplefleuron","bare":true},{"key":"tightasterism","bare":true},{"key":"trueasterism","bare":true}]
	}
