{
	"version": 1,
	"deps": [
		{"id":"packages/amsmath"},
		{"id":"packages/amstext"},
		{"id":"packages/amsbsy"},
		{"id":"packages/amsopn"},
		{"id":"packages/amssymb","if":"!noamssymb"},
		{"id":"packages/amsfonts","if":"!noamssymb"},
		{"id":"packages/graphicx"},
		{"id":"packages/keyval"},
		{"id":"packages/graphics"},
		{"id":"packages/trig"}
	],
	"macros": [
