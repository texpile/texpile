{
	"version": 1,
	"deps": [
		{"id":"packages/inputenc","engines":["pdflatex"]},
		{"id":"packages/lmodern"},
		{"id":"packages/hyperref","if":"black|color|gray"},
		{"id":"packages/iftex","if":"black|color|gray","engines":["pdflatex","xelatex"]},
		{"id":"packages/iftex","engines":["lualatex"]},
		{"id":"packages/keyval","if":"black|color|gray","engines":["pdflatex","lualatex"]},
		{"id":"packages/keyval","engines":["xelatex"]},
		{"id":"packages/kvsetkeys","if":"black|color|gray"},
		{"id":"packages/pdfescape","if":"black|color|gray"},
		{"id":"packages/nameref","if":"black|color|gray"},
		{"id":"packages/refcount","if":"black|color|gray"},
		{"id":"packages/gettitlestring","if":"black|color|gray"},
		{"id":"packages/kvoptions","if":"black|color|gray"},
		{"id":"packages/etoolbox","if":"black|color|gray","engines":["pdflatex","xelatex"]},
		{"id":"packages/etoolbox","if":"black|color|gray|italian","engines":["lualatex"]},
		{"id":"packages/stringenc","if":"black|color|gray"},
		{"id":"packages/intcalc","if":"black|color|gray"},
		{"id":"packages/url","if":"black|color|gray"},
		{"id":"packages/bitset","if":"black|color|gray"},
		{"id":"packages/bigintcalc","if":"black|color|gray"},
		{"id":"packages/rerunfilecheck","if":"black|color|gray"},
		{"id":"packages/uniquecounter","if":"black|color|gray"},
		{"id":"packages/luainputenc","engines":["lualatex"]},
		{"id":"packages/luatexbase","engines":["lualatex"]},
		{"id":"packages/babel","if":"english|french|german|italian","engines":["lualatex"]},
		{"id":"packages/scalefnt","if":"french","engines":["lualatex"]},
		{"id":"packages/graphicx","engines":["xelatex"]},
		{"id":"packages/graphics","engines":["xelatex"]},
		{"id":"packages/trig","engines":["xelatex"]}
	],
	"macros": [
		{"name":"authorname"},
		{"name":"bsc","args":[{"kind":"m","placeholder":"text"}],"doc":"\\bsc means ‘boxed small caps’ and is a non breaking version of \\textsc."},
		{"name":"ccname","if":"german|french|italian|english"},
		{"name":"conc","args":[{"kind":"o","placeholder":"position"},{"kind":"m","placeholder":"object"}]},
		{"name":"datename"},
		{"name":"enclname","if":"german|french|italian|english"},
		{"name":"ier","doc":"\\ier is the formal abbreviation of french “premier”."},
		{"name":"no","doc":"\\no is the formal abreviation of french “numéro”."},
		{"name":"rmosfamily","doc":"\\rmosfamily, \\sfosfamily and ttosfamily are the respective oldstyle numbers counterparts of \\rmfamily, sffamily and ttfamily."},
		{"name":"sfosfamily"},
		{"name":"sishape","doc":"The macros \\sishape and \\textsi are defined for direct output of slanted small caps."},
		{"name":"textrmos","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"textsfos","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"textsi","args":[{"kind":"m","placeholder":"text"}],"doc":"The macros \\sishape and \\textsi are defined for direct output of slanted small caps."},
		{"name":"textttos","args":[{"kind":"m","placeholder":"text"}]},
		{"name":"titlename"},
		{"name":"ttosfamily"},
		{"name":"up","args":[{"kind":"m","placeholder":"text"}],"doc":"\\up is a shortcut for \\textsuperscript."}
	],
	"keys": {
		"packages/chextras#options": [{"key":"black","bare":true},{"key":"color","bare":true},{"key":"english","bare":true},{"key":"french","bare":true},{"key":"german","bare":true},{"key":"gray","bare":true},{"key":"italian","bare":true},{"key":"lighttt","bare":true},{"key":"nomath","bare":true},{"key":"oldstyle","bare":true},{"key":"stddimen","bare":true},{"key":"stdfield","bare":true},{"key":"stditems","bare":true},{"key":"stdlabel","bare":true},{"key":"stdlists","bare":true},{"key":"stdmgpar","bare":true},{"key":"stdnotes","bare":true},{"key":"stdparis","bare":true},{"key":"stdrules","bare":true},{"key":"stdshape","bare":true},{"key":"stdskips","bare":true},{"key":"stdspace","bare":true},{"key":"variablett","bare":true}]
	}
}
