@top Document { item* }

item { textItem | ParBreak | math }

textItem { Text | ControlWord | ControlSymbol | Group | OpenBracket | CloseBracket | Comment | Environment | VerbatimEnvironment | Verb | UrlArgument | StrayEnd | StrayClose | StrayMath | Skipped }

math { InlineMath | DisplayMath | BracketMath | ParenMath | OwnMath }

InlineMath { Dollar textItem* (Dollar | MathEnd) }
DisplayMath { DoubleDollar textItem* (DoubleDollar | MathEnd) }
BracketMath { OpenDisplay textItem* (CloseDisplay | MathEnd) }
ParenMath { OpenInline textItem* (CloseInline | MathEnd) }
OwnMath { OwnMathOpen item* (OwnMathClose | MathEnd) }

Group { "{" item* ("}" | GroupEnd) }

Environment { BeginEnv item* (EndEnv | EnvEnd) }

VerbatimEnvironment { VerbatimBegin (Text | ParBreak | Group | OpenBracket | CloseBracket | ControlWord | ControlSymbol | Comment)* VerbatimBody? (EndEnv | EnvEnd) }

@context openConstructs from "./tokens/openConstructs"

@external tokens structureTokens from "./tokens/structureTokens" { VerbatimBegin, VerbatimBody, Verb, UrlArgument, OwnMathOpen, OwnMathClose, DoubleDollar, Dollar, BeginEnv, EndEnv, EnvEnd, GroupEnd, StrayEnd, StrayClose, OpenDisplay, CloseDisplay, OpenInline, CloseInline, MathEnd, StrayMath, ControlWord, Skipped }

@tokens {
	ControlSymbol { "\\" ![a-zA-Z] }
	Comment { "%" ![\n]* }
	ParBreak { "\n" $[ \t]* "\n" $[ \t\n]* }
	Text { ![\\{}$%[\]\n]+ | "\n" }
	OpenBracket { "[" }
	CloseBracket { "]" }
	"{" "}"
	@precedence { ParBreak, Text }
}

@detectDelim
