{
	"deps": [{"name":"class-book"},{"name":"natbib","if":"natbib"}],
	"macros": [
		{"name":"abstract","arg":{"format":"{}","snippet":"abstract{${1:abstract text}}"},"doc":"Print the abstract with \\abstract."},
		{"name":"acknowledgments","arg":{"format":"{}","snippet":"acknowledgments{${1:acknowledgments text}}"},"doc":"Use the \\acknowledgments macro to format the acknowledgments page."},
		{"name":"Author","arg":{"format":"{}","snippet":"Author{${1:author name}}"}},
		{"name":"caption","arg":{"format":"()[]{}","snippet":"caption(${1:part letter})[${2:toc entry}]{${3:text}}"}},
		{"name":"caption","arg":{"format":"(){}","snippet":"caption(${1:part letter}){${2:text}}"}},
		{"name":"captiontotocfalse","unusual":true},
		{"name":"captiontotoctrue","unusual":true},
		{"name":"Chair","arg":{"format":"{}{}{}","snippet":"Chair{${1:chair name}}{${2:chair title}}{${3:chair department}}"}},
		{"name":"chapternotesfalse","unusual":true},
		{"name":"chapternotestrue","unusual":true},
		{"name":"dedication","arg":{"format":"{}","snippet":"dedication{${1:dedication text}}"},"doc":"Use the \\dedication macro to format the dedication page."},
		{"name":"Degree","arg":{"format":"{}","snippet":"Degree{${1:degree name}}"}},
		{"name":"Degreetext","arg":{"format":"{}","snippet":"Degreetext{${1:degree text}}"}},
		{"name":"doctoralabstractquoteslip","doc":"Use one of the “quoteslip” macros to format your quote slip: • \\thesisquoteslip, for a master’s thesis; • \\doctoralquoteslip, for a doctoral dissertation; or • \\doctoralabstractquoteslip, for a the ‘abstract only’ form of the doctoral dissertation."},
		{"name":"doctoralquoteslip"},
		{"name":"doctorialabstractquoteslip","unusual":true},
		{"name":"doctorialquoteslip","unusual":true},
		{"name":"endnotesfalse","unusual":true},
		{"name":"endnotestrue","unusual":true},
		{"name":"GSchool","arg":{"format":"{}","snippet":"GSchool{${1}}"},"unusual":true},
		{"name":"ifcaptiontotoc","unusual":true},
		{"name":"ifchapternotes","unusual":true},
		{"name":"ifendnotes","unusual":true},
		{"name":"prelimpages"},
		{"name":"printendnotes","if":"endnotes"},
		{"name":"Program","arg":{"format":"{}","snippet":"Program{${1:program name}}"}},
		{"name":"Programtext","arg":{"format":"{}","snippet":"Programtext{${1}}"},"unusual":true},
		{"name":"quoteslip","arg":{"format":"{}","snippet":"quoteslip{${1:quote slip text}}"}},
		{"name":"School","arg":{"format":"{}","snippet":"School{${1:school name}}"}},
		{"name":"Signature","arg":{"format":"{}","snippet":"Signature{${1:committee member name}}"}},
		{"name":"signaturepage"},
		{"name":"textofAbstract","arg":{"format":"{}","snippet":"textofAbstract{${1}}"},"unusual":true},
		{"name":"textofAck","arg":{"format":"{}","snippet":"textofAck{${1}}"},"unusual":true},
		{"name":"textofAppendix","arg":{"format":"{}","snippet":"textofAppendix{${1}}"},"unusual":true},
		{"name":"textofBIB","arg":{"format":"{}","snippet":"textofBIB{${1}}"},"unusual":true},
		{"name":"textofChair","arg":{"format":"{}","snippet":"textofChair{${1}}"},"unusual":true},
		{"name":"textofChapter","arg":{"format":"{}","snippet":"textofChapter{${1}}"},"unusual":true},
		{"name":"textofDate","arg":{"format":"{}","snippet":"textofDate{${1}}"},"unusual":true},
		{"name":"textofDed","arg":{"format":"{}","snippet":"textofDed{${1}}"},"unusual":true},
		{"name":"textofLoF","arg":{"format":"{}","snippet":"textofLoF{${1}}"},"unusual":true},
		{"name":"textofLoT","arg":{"format":"{}","snippet":"textofLoT{${1}}"},"unusual":true},
		{"name":"textofSignature","arg":{"format":"{}","snippet":"textofSignature{${1}}"},"unusual":true},
		{"name":"textofToC","arg":{"format":"{}","snippet":"textofToC{${1}}"},"unusual":true},
		{"name":"textofVita","arg":{"format":"{}","snippet":"textofVita{${1}}"},"unusual":true},
		{"name":"textpages"},
		{"name":"thesisquoteslip","doc":"Use one of the “quoteslip” macros to format your quote slip: • \\thesisquoteslip, for a master’s thesis; • \\doctoralquoteslip, for a doctoral dissertation; or • \\doctoralabstractquoteslip, for a the ‘abstract only’ form of the doctoral dissertation."},
		{"name":"thesissignaturepage"},
		{"name":"Title","arg":{"format":"{}","snippet":"Title{${1:title}}"}},
		{"name":"titlepage"},
		{"name":"vita","arg":{"format":"{}","snippet":"vita{${1:vita text}}"},"doc":"Use the \\vita macro to format the curriculum vitae."},
		{"name":"Year","arg":{"format":"{}","snippet":"Year{${1:year}}"}}
	],
	"envs": [
		{"name":"fullpage","doc":"If you want a figure or table to occupy a full page enclose the contents in a fullpage environment."},
		{"name":"leftfullpage"},
		{"name":"xtrafullpage","doc":"Enclose your figure’s text in an xtrafullpage environment, which will cause the page numbers to come out right."}
	],
	"keys": {
		"\\documentclass/uwthesis#c": ["10pt","11pt","12pt","chapternotes","endnotes","footnotes","natbib"]
	},
	"args": ["\\documentclass/uwthesis#c"]
}
