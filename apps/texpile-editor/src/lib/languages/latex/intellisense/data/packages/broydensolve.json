{
	"macros": [
		{"name":"ang","arg":{"format":"()","snippet":"ang(${1:coordinates})"}},
		{"name":"BroydenIterations","doc":"This command gives the total number of iterations after the command \\BroydenSolve is executed."},
		{"name":"BroydenRoot","arg":{"format":"[]{}","snippet":"BroydenRoot[${1:iteration}]{${2:variable}}"}},
		{"name":"BroydenRoot","arg":{"format":"{}","snippet":"BroydenRoot{${1:variable}}"}},
		{"name":"BroydenRoots","doc":"This command gives the approximation(s) for the root(s) for the variable(s) as a comma separated list after the command \\BroydenSolve is executed."},
		{"name":"BroydenSetup","arg":{"format":"{}","snippet":"BroydenSetup{${1:keys}}","keys":["l3keys:broydensolve"],"keyPos":0}},
		{"name":"BroydenSolve","arg":{"format":"{}","snippet":"BroydenSolve{${1:keys}}","keys":["l3keys:broydensolve"],"keyPos":0}},
		{"name":"col","arg":{"format":"()","snippet":"col(${1:coordinate1,coordinate2,coordinate3})"}},
		{"name":"dis","arg":{"format":"()","snippet":"dis(${1:coordinates})"}}
	],
	"envs": [],
	"keys": {
		"l3keys:broydensolve": ["abs-approx-error=","func-error=","func=","init=","iterations=","rel-approx-error=","var=","coordinates=${1|true,false|}","stop-crit=${1|abs-approx-error,func-error,iterations,rel-approx-error|}"]
	}
}
