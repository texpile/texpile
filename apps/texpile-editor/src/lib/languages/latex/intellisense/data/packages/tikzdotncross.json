{
	"deps": [{"name":"pkginfograb"},{"name":"etoolbox"}],
	"macros": [
		{"name":"dotcoord","arg":{"format":"()","snippet":"dotcoord(${1:coord})"}},
		{"name":"dotpincoord","arg":{"format":"()","snippet":"dotpincoord(${1:coord, color, angle, length})"}},
		{"name":"ncoord","arg":{"format":"()","snippet":"ncoord(${1:coord})"},"doc":"The \\ncoord always expects a single parameter ⟨coord⟩. A coordinate named ⟨coord⟩ and node named n⟨coord⟩ (a “n” is added as a prefix) will be created for later use/reference."},
		{"name":"odotcoord","arg":{"format":"()","snippet":"odotcoord(${1:coord})"}},
		{"name":"odotpincoord","arg":{"format":"()","snippet":"odotpincoord(${1:coord, color, angle, length})"}},
		{"name":"pathcross","arg":{"format":"[]{}{}{}[]","snippet":"pathcross[${1:cross-name}]{${2:coordA}}{${3:coordB}}{${4:path-name}}[${5:width}]"}},
		{"name":"pathcross","arg":{"format":"{}{}{}","snippet":"pathcross{${1:coordA}}{${2:coordB}}{${3:path-name}}"}},
		{"name":"pathcross*","arg":{"format":"[]{}{}{}[]","snippet":"pathcross*[${1:cross-name}]{${2:coordA}}{${3:coordB}}{${4:path-name}}[${5:width}]"}},
		{"name":"pathcross*","arg":{"format":"{}{}{}","snippet":"pathcross*{${1:coordA}}{${2:coordB}}{${3:path-name}}"}},
		{"name":"pincoord","arg":{"format":"()","snippet":"pincoord(${1:coord, color, angle, length})"},"doc":"The \\pincoord always draws a pin, besides declaring a coordinate and node as \\ncoord."},
		{"name":"setpindefaults","arg":{"format":"{}","snippet":"setpindefaults{${1:options}}","keys":["l3keys:tikzdotncross"],"keyPos":0}},
		{"name":"showcoords","arg":{"format":"{}","snippet":"showcoords{${1:on or off}}"}},
		{"name":"showcoordsfalse"},
		{"name":"showcoordstrue"}
	],
	"envs": [],
	"keys": {
		"l3keys:tikzdotncross": ["coordcolor=","pinang=","pincolor=","pinlength=","pinsize="],
		"\\usepackage/tikzdotncross#c": ["coordcolor=","pinang=","pincolor=","pinlength=","pinsize="]
	},
	"args": ["\\usepackage/tikzdotncross#c"]
}
