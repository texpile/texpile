{
	"deps": [{"name":"kvoptions"},{"name":"keyval"},{"name":"kvsetkeys"},{"name":"glossaries-extra"},{"name":"xkeyval"},{"name":"etoolbox"},{"name":"glossaries"},{"name":"ifthen"},{"name":"mfirstuc"},{"name":"xfor"},{"name":"datatool-base"},{"name":"amsmath"},{"name":"amstext"},{"name":"amsbsy"},{"name":"amsopn"},{"name":"tracklang"},{"name":"glossary-hypernav"},{"name":"titlesec"},{"name":"everyhook"},{"name":"svn-prov"},{"name":"enumitem"},{"name":"xparse"},{"name":"xspace"}],
	"macros": [
		{"name":"acronym","arg":{"format":"[]{}{}[]","snippet":"acronym[${1:typeset abbreviation}]{${2:abbreviation}}{${3:definition}}[${4:plural definition}]"}},
		{"name":"acronym","arg":{"format":"{}{}","snippet":"acronym{${1:abbreviation}}{${2:definition}}"}},
		{"name":"acronym*","arg":{"format":"[]{}{}[]","snippet":"acronym*[${1:typeset abbreviation}]{${2:abbreviation}}{${3:definition}}[${4:plural definition}]"}},
		{"name":"acronym*","arg":{"format":"{}{}","snippet":"acronym*{${1:abbreviation}}{${2:definition}}"}},
		{"name":"acronymalternative","arg":{"format":"{}{}{}","snippet":"acronymalternative{${1:acronym}}{${2:name}}{${3:alternative long form}}"}},
		{"name":"acronyms","arg":{"format":"[]{}","snippet":"acronyms[${1:key}]{${2:title}}"}},
		{"name":"acronyms","arg":{"format":"{}","snippet":"acronyms{${1:title}}"}},
		{"name":"descriptionsitem","unusual":true},
		{"name":"dummyacronym","arg":{"format":"{}","snippet":"dummyacronym{${1:key}}"},"doc":"Placing a \\dummyacronym{⟨key⟩} at the end of the document ensures that the short form is introduced."},
		{"name":"longacronym","arg":{"format":"[]{}{}[]","snippet":"longacronym[${1:typeset abbreviation}]{${2:abbreviation}}{${3:definition}}[${4:plural definition}]"}},
		{"name":"longacronym","arg":{"format":"{}{}","snippet":"longacronym{${1:abbreviation}}{${2:definition}}"}},
		{"name":"longacronym*","arg":{"format":"[]{}{}[]","snippet":"longacronym*[${1:typeset abbreviation}]{${2:abbreviation}}{${3:definition}}[${4:plural definition}]"}},
		{"name":"longacronym*","arg":{"format":"{}{}","snippet":"longacronym*{${1:abbreviation}}{${2:definition}}"}},
		{"name":"mathdef","arg":{"format":"{}[]{}","snippet":"mathdef{${1}}[${2}]{${3}}"},"unusual":true},
		{"name":"mathdef","arg":{"format":"{}{}","snippet":"mathdef{${1}}{${2}}"},"unusual":true},
		{"name":"resetacronym","arg":{"format":"{}","snippet":"resetacronym{${1:key}}"}},
		{"name":"sentence","doc":"The \\sentence macro ensures that the directly following abbreviation is capitalised."},
		{"name":"shortacronym","arg":{"format":"[]{}{}[]","snippet":"shortacronym[${1:typeset abbreviation}]{${2:abbreviation}}{${3:definition}}[${4:plural definition}]"},"doc":"The \\shortacronym never expands into the long form."},
		{"name":"shortacronym","arg":{"format":"{}{}","snippet":"shortacronym{${1:abbreviation}}{${2:definition}}"},"doc":"The \\shortacronym never expands into the long form."},
		{"name":"shortacronym*","arg":{"format":"[]{}{}[]","snippet":"shortacronym*[${1:typeset abbreviation}]{${2:abbreviation}}{${3:definition}}[${4:plural definition}]"},"doc":"The \\shortacronym never expands into the long form."},
		{"name":"shortacronym*","arg":{"format":"{}{}","snippet":"shortacronym*{${1:abbreviation}}{${2:definition}}"},"doc":"The \\shortacronym never expands into the long form."}
	],
	"envs": [],
	"keys": {}
}
