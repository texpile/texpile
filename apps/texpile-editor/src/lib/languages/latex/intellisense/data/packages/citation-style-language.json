{
	"deps": [{"name":"xparse"},{"name":"url"},{"name":"citation-style-language-init"},{"name":"citation-style-language-data"},{"name":"citation-style-language-cite"}],
	"macros": [
		{"name":"addbibresource","arg":{"format":"[]{}","snippet":"addbibresource[${1:options}]{${2:resource}}"},"doc":"The \\addbibresource command loads bibliographic data from ⟨resource⟩ file."},
		{"name":"addbibresource","arg":{"format":"{}","snippet":"addbibresource{${1:resource}}"},"doc":"The \\addbibresource command loads bibliographic data from ⟨resource⟩ file."},
		{"name":"addtocategory","arg":{"format":"{}{}","snippet":"addtocategory{${1:category}}{${2:keys}}"}},
		{"name":"autocite","arg":{"format":"[][]{}","snippet":"autocite[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"autocite","arg":{"format":"{}","snippet":"autocite{${1:keys}}"}},
		{"name":"autocite*","arg":{"format":"[][]{}","snippet":"autocite*[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"autocite*","arg":{"format":"{}","snippet":"autocite*{${1:keys}}"}},
		{"name":"backref","arg":{"format":"{}","snippet":"backref{${1}}"},"unusual":true},
		{"name":"bibsection","unusual":true},
		{"name":"cite","arg":{"format":"[][]{}","snippet":"cite[${1:prenote}][${2:postnote}]{${3:keys}}"},"doc":"The citation command is similar to the one in standard LaTeX except that the prefix ⟨options⟩ is in key-value style."},
		{"name":"cite","arg":{"format":"{}","snippet":"cite{${1:keys}}"},"doc":"The citation command is similar to the one in standard LaTeX except that the prefix ⟨options⟩ is in key-value style."},
		{"name":"cite*","arg":{"format":"[][]{}","snippet":"cite*[${1:prenote}][${2:postnote}]{${3:keys}}"},"doc":"The citation command is similar to the one in standard LaTeX except that the prefix ⟨options⟩ is in key-value style."},
		{"name":"cite*","arg":{"format":"{}","snippet":"cite*{${1:keys}}"},"doc":"The citation command is similar to the one in standard LaTeX except that the prefix ⟨options⟩ is in key-value style."},
		{"name":"citeauthor","arg":{"format":"[][]{}","snippet":"citeauthor[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"citeauthor","arg":{"format":"{}","snippet":"citeauthor{${1:keys}}"}},
		{"name":"citep","arg":{"format":"[][]{}","snippet":"citep[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"citep","arg":{"format":"{}","snippet":"citep{${1:keys}}"}},
		{"name":"cites","arg":{"format":"[][]{}","snippet":"cites[${1:prenote}][${2:postnote}]{${3:keys}}"},"doc":"The \\cites accepts multiple cite items in a single citation."},
		{"name":"cites","arg":{"format":"{}","snippet":"cites{${1:keys}}"},"doc":"The \\cites accepts multiple cite items in a single citation."},
		{"name":"citet","arg":{"format":"[][]{}","snippet":"citet[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"citet","arg":{"format":"{}","snippet":"citet{${1:keys}}"}},
		{"name":"citeyear","arg":{"format":"[][]{}","snippet":"citeyear[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"citeyear","arg":{"format":"{}","snippet":"citeyear{${1:keys}}"}},
		{"name":"citeyearpar","arg":{"format":"[][]{}","snippet":"citeyearpar[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"citeyearpar","arg":{"format":"{}","snippet":"citeyearpar{${1:keys}}"}},
		{"name":"cslblock","arg":{"format":"{}","snippet":"cslblock{${1}}"},"unusual":true},
		{"name":"cslcitation","arg":{"format":"{}{}","snippet":"cslcitation{${1}}{${2}}"},"unusual":true},
		{"name":"cslcite","arg":{"format":"{}{}","snippet":"cslcite{${1}}{${2}}"},"unusual":true},
		{"name":"csloptions","arg":{"format":"{}{}","snippet":"csloptions{${1}}{${2}}"},"unusual":true},
		{"name":"cslsetup","arg":{"format":"{}","snippet":"cslsetup{${1:options}}","keys":["l3keys:csl"],"keyPos":0},"doc":"Package options may be set when the package is loaded or at any later stage with the \\cslsetup command."},
		{"name":"cslundefinedcite","arg":{"format":"{}","snippet":"cslundefinedcite{${1}}"},"unusual":true},
		{"name":"DeclareBibliographyCategory","arg":{"format":"{}","snippet":"DeclareBibliographyCategory{${1:category}}"}},
		{"name":"defbibenvironment","arg":{"format":"{}{}{}{}","snippet":"defbibenvironment{${1:name}}{${2:begin code}}{${3:end code}}{${4:item code}}"}},
		{"name":"defbibheading","arg":{"format":"{}[]{}","snippet":"defbibheading{${1:name}}[${2:title}]{${3:code}}"}},
		{"name":"defbibheading","arg":{"format":"{}{}","snippet":"defbibheading{${1:name}}{${2:code}}"}},
		{"name":"defbibnote","arg":{"format":"{}{}","snippet":"defbibnote{${1:name}}{${2:text}}"}},
		{"name":"endrefsection","doc":"The \\endrefsection command terminates the current reference section and restores the global section."},
		{"name":"footcite","arg":{"format":"[][]{}","snippet":"footcite[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"footcite","arg":{"format":"{}","snippet":"footcite{${1:keys}}"}},
		{"name":"fullcite","arg":{"format":"[][]{}","snippet":"fullcite[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"fullcite","arg":{"format":"{}","snippet":"fullcite{${1:keys}}"}},
		{"name":"newrefsection","arg":{"format":"[]","snippet":"newrefsection[${1:options}]"},"doc":"The \\newrefsection command is similar to the refsection environment except that it is a standalone command rather than an environment. It automatically ends the previous reference section (if any) and immediately starts a new one."},
		{"name":"newrefsection","doc":"The \\newrefsection command is similar to the refsection environment except that it is a standalone command rather than an environment. It automatically ends the previous reference section (if any) and immediately starts a new one."},
		{"name":"parencite","arg":{"format":"[][]{}","snippet":"parencite[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"parencite","arg":{"format":"{}","snippet":"parencite{${1:keys}}"}},
		{"name":"parencite*","arg":{"format":"[][]{}","snippet":"parencite*[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"parencite*","arg":{"format":"{}","snippet":"parencite*{${1:keys}}"}},
		{"name":"parencites","arg":{"format":"[][]{}","snippet":"parencites[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"parencites","arg":{"format":"{}","snippet":"parencites{${1:keys}}"}},
		{"name":"printbibheading","arg":{"format":"[]","snippet":"printbibheading[${1:options}]"}},
		{"name":"printbibheading"},
		{"name":"printbibliography","arg":{"format":"[]","snippet":"printbibliography[${1:options}]"}},
		{"name":"printbibliography"},
		{"name":"textcite","arg":{"format":"[][]{}","snippet":"textcite[${1:prenote}][${2:postnote}]{${3:keys}}"}},
		{"name":"textcite","arg":{"format":"{}","snippet":"textcite{${1:keys}}"}}
	],
	"envs": [
		{"name":"refsection","arg":{"format":"[]","snippet":"[${1:options}]"},"doc":"The refsection environment is used in the document body to mark a reference section."},
		{"name":"refsection","doc":"The refsection environment is used in the document body to mark a reference section."}
	],
	"keys": {
		"l3keys:csl": ["bib-after-name-sep=","bib-font=","bib-hang=","bib-item-sep=","bib-label-sep=","bib-name-sep=","bib-par-indent=","locale=","style=","use-bbl=${1|true,false|}","backref=${1|true,page,section,false|}","ref-section=${1|none,part,chapter,chapter+,section,section+,subsection,subsection+|}"],
		"\\usepackage/citation-style-language#c": ["backref=${1|true,page,section,false|}","bib-after-name-sep=","bib-font=","bib-hang=","bib-item-sep=","bib-label-sep=","bib-name-sep=","bib-par-indent=","locale=","ref-section=${1|none,part,chapter,chapter+,section,section+,subsection,subsection+|}","style=","use-bbl=${1|true,false|}"]
	},
	"args": ["\\usepackage/citation-style-language#c"]
}
