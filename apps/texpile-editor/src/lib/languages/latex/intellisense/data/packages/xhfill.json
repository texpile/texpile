		{"name":"xhrulefill","arg":{"format":"{}{}","snippet":"xhrulefill{${1:color}}{${2:height}}"}},
		{"name":"xrfill","arg":{"format":"[]{}[]","snippet":"xrfill[${1:raise}]{${2:rule height}}[${3:color}]"}},
		{"name":"xrfill","arg":{"format":"{}","snippet":"xrfill{${1:rule height}}"}}
	],
