{
	"deps": [{"name":"marginnote"},{"name":"setspace"},{"name":"soul"},{"name":"soul-ori"},{"name":"etexcmds"},{"name":"iftex"},{"name":"tikz"},{"name":"pgf"},{"name":"pgfrcs"},{"name":"pgfcore"},{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"},{"name":"pgfsys"},{"name":"xcolor"},{"name":"pgfcomp-version-0-65"},{"name":"pgfcomp-version-1-18"},{"name":"pgffor"},{"name":"pgfkeys"},{"name":"pgfmath"}],
	"macros": [
		{"name":"add","arg":{"format":"{}","snippet":"add{${1:phrase}}"},"doc":"\\add{phrase} displays phrase and places n: add in the margin."},
		{"name":"com","arg":{"format":"{}","snippet":"com{${1:comment}}"}},
		{"name":"del","arg":{"format":"{}","snippet":"del{${1:phrase}}"},"doc":"\\del{phrase} displays phrase and places n: delete in the margin."},
		{"name":"hilite","arg":{"format":"[]{}","snippet":"hilite[${1:options}]{${2:phrase}}"}},
		{"name":"hilite","arg":{"format":"{}","snippet":"hilite{${1:phrase}}"}},
		{"name":"rep","arg":{"format":"{}{}","snippet":"rep{${1:phrase}}{${2:replacement}}"},"doc":"\\rep{phrase}{replacement} displays replacement and places n: was: phrase in the margin."},
		{"name":"skp","arg":{"format":"[]","snippet":"skp[${1:lines}]"}},
		{"name":"skp"},
		{"name":"yel","arg":{"format":"[]{}","snippet":"yel[${1:comment}]{${2:phrase}}"}},
		{"name":"yel","arg":{"format":"{}","snippet":"yel{${1:phrase}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/proofread#c": ["corrected","doublespacing","frame","onehalfspacing","uncorrected"]
	},
	"args": ["\\usepackage/proofread#c"]
}
