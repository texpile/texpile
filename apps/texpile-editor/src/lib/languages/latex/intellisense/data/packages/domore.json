{
	"deps": [{"name":"stacklet"}],
	"macros": [
		{"name":"DoSeparateWith","arg":{"format":"{}{}{}","snippet":"DoSeparateWith{${1}}{${2}}{${3}}"}},
		{"name":"DoSeparateWithMore","arg":{"format":"{}{}{}","snippet":"DoSeparateWithMore{${1:do}}{${2:separator}}{${3:arglist item}}"}},
		{"name":"DoWith","arg":{"format":"{}{}","snippet":"DoWith{${1}}{${2}}"}},
		{"name":"DoWithAllIn","arg":{"format":"{}{}","snippet":"DoWithAllIn{${1}}{${2}}"}},
		{"name":"DoWithAllOf","arg":{"format":"{}{}","snippet":"DoWithAllOf{${1}}{${2}}"}},
		{"name":"DoWithMore","arg":{"format":"{}{}","snippet":"DoWithMore{${1:repeat}}{${2:arglist item}}"}},
		{"name":"setdo","arg":{"format":"[][]{}","snippet":"setdo[${1:digit}][${2:default}]{${3:replacement}}"}},
		{"name":"setdo","arg":{"format":"{}","snippet":"setdo{${1:replacement}}"}},
		{"name":"StopDoing"}
	],
	"envs": [],
	"keys": {}
}
