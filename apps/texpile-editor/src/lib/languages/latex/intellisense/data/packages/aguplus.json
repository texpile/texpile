		{"name":"doublecaption","arg":{"format":"{}","snippet":"doublecaption{${1:width}}"},"doc":"\\doublecaption{35pc} enables the printing of all figure and plate captions in two widths: once in the single column width and again in the width specified, here 35 pc; JGR requires that all captions be provided in two sizes."},
		{"name":"extraabstract","doc":"\\extraabstract prints a supplemental abstract at the end of the camera-ready version, as required by JGR; this may be invoked anywhere in the paper, for it only enables the output which always comes at the end."},
		{"name":"figbox","arg":{"format":"{}{}{}","snippet":"figbox{${1:width}}{${2:height}}{${3:contents}}"},"doc":"The \\figbox command reserves a framed box of the specified size and centers the contents both horizontally and vertically."},
