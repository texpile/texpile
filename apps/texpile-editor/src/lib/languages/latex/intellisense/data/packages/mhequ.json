{
	"macros": [
		{"name":"intertext","arg":{"format":"{}","snippet":"intertext{${1}}"}},
		{"name":"minilab","arg":{"format":"{}","snippet":"minilab{${1:label name}}"}},
		{"name":"multicol","arg":{"format":"{}{}","snippet":"multicol{${1:columns}}{${2:material}}"}},
		{"name":"notag"},
		{"name":"setlabtype","arg":{"format":"{}","snippet":"setlabtype{${1}}"}},
		{"name":"tag","arg":{"format":"{}","snippet":"tag{${1:tag}}"}},
		{"name":"text","arg":{"format":"{}","snippet":"text{${1:material}}"},"math":true}
	],
	"envs": [
		{"name":"equ","arg":{"format":"[]","snippet":"[${1:label}]"}},
		{"name":"equ"},
		{"name":"equa","arg":{"format":"[][]","snippet":"[${1}][${2}]"},"unusual":true},
		{"name":"equa","unusual":true},
		{"name":"equs","arg":{"format":"[][]","snippet":"[${1:columns}][${2:label}]"}},
		{"name":"equs"}
	],
	"keys": {
		"\\usepackage/mhequ#c": ["fleqn","lefttag","leqno","numberall","righttag"]
	},
	"args": ["\\usepackage/mhequ#c"]
}
