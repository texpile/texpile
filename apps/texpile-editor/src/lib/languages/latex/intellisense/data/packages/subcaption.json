{
	"deps": [{"name":"caption"},{"name":"caption3"},{"name":"keyval"}],
	"macros": [
		{"name":"phantomsubcaption"},
		{"name":"subcaption","arg":{"format":"[]{}","snippet":"subcaption[${1:list entry}]{${2:heading}}"}},
		{"name":"subcaption","arg":{"format":"{}","snippet":"subcaption{${1:heading}}"}},
		{"name":"subcaption*","arg":{"format":"[]{}","snippet":"subcaption*[${1:list entry}]{${2:heading}}"}},
		{"name":"subcaption*","arg":{"format":"{}","snippet":"subcaption*{${1:heading}}"}},
		{"name":"subcaptionbox","arg":{"format":"[]{}[][]{}","snippet":"subcaptionbox[${1:list entry}]{${2:heading}}[${3:width}][${4:inner-pos}]{${5:contents}}"},"doc":"The \\subcaptionbox command typesets given content and caption."},
		{"name":"subcaptionbox","arg":{"format":"{}{}","snippet":"subcaptionbox{${1:heading}}{${2:contents}}"},"doc":"The \\subcaptionbox command typesets given content and caption."},
		{"name":"subcaptionbox*","arg":{"format":"[]{}[][]{}","snippet":"subcaptionbox*[${1:list entry}]{${2:heading}}[${3:width}][${4:inner-pos}]{${5:contents}}"},"doc":"The \\subcaptionbox command typesets given content and caption."},
		{"name":"subcaptionbox*","arg":{"format":"{}{}","snippet":"subcaptionbox*{${1:heading}}{${2:contents}}"},"doc":"The \\subcaptionbox command typesets given content and caption."},
		{"name":"subcaptionlistentry","arg":{"format":"[]{}","snippet":"subcaptionlistentry[${1:float type}]{${2:list entry}}"}},
		{"name":"subcaptionlistentry","arg":{"format":"{}","snippet":"subcaptionlistentry{${1:list entry}}"}},
		{"name":"subcaptionlistentry*","arg":{"format":"[]{}","snippet":"subcaptionlistentry*[${1:float type}]{${2:list entry}}"}},
		{"name":"subcaptionlistentry*","arg":{"format":"{}","snippet":"subcaptionlistentry*{${1:list entry}}"}},
		{"name":"subcaptiontext","arg":{"format":"[]{}","snippet":"subcaptiontext[${1:number}]{${2:text}}"}},
		{"name":"subcaptiontext","arg":{"format":"{}","snippet":"subcaptiontext{${1:text}}"}},
		{"name":"subcaptiontext*","arg":{"format":"[]{}","snippet":"subcaptiontext*[${1:number}]{${2:text}}"}},
		{"name":"subcaptiontext*","arg":{"format":"{}","snippet":"subcaptiontext*{${1:text}}"}},
		{"name":"subfloat","arg":{"format":"[][]{}","snippet":"subfloat[${1:list entry}][${2:sub-caption}]{${3:body}}"}},
		{"name":"subfloat","arg":{"format":"{}","snippet":"subfloat{${1:body}}"}},
		{"name":"subref","arg":{"format":"{}","snippet":"subref{${1:key}}"}},
		{"name":"subref*","arg":{"format":"{}","snippet":"subref*{${1:key}}"}}
	],
	"envs": [
		{"name":"subcaptionblock","arg":{"format":"[][][]{}","snippet":"[${1:outer-pos}][${2:height}][${3:inner-pos}]{${4:width}}"},"doc":"The subcaptionblock environment makes a box with given width."},
		{"name":"subcaptionblock","arg":{"format":"{}","snippet":"{${1:width}}"},"doc":"The subcaptionblock environment makes a box with given width."},
		{"name":"subcaptiongroup"},
		{"name":"subcaptiongroup*"},
		{"name":"subfigure","arg":{"format":"[][][]{}","snippet":"[${1:outer-pos}][${2:height}][${3:inner-pos}]{${4:width}}"}},
		{"name":"subfigure","arg":{"format":"{}","snippet":"{${1:width}}"}},
		{"name":"subtable","arg":{"format":"[][][]{}","snippet":"[${1:outer-pos}][${2:height}][${3:inner-pos}]{${4:width}}"}},
		{"name":"subtable","arg":{"format":"{}","snippet":"{${1:width}}"}}
	],
	"keys": {
		"\\usepackage/subcaption#c": ["aboveskip=","belowskip=","figureposition=${1|top,above,bottom,below,auto|}","font+=${4|scriptsize,footnotesize,small,normalsize,large,Large,smaller,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,{stretch=${1:factor}},normalcolor,{color=${2:color}},normal|}","font=${4|scriptsize,footnotesize,small,normalsize,large,Large,smaller,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,{stretch=${1:factor}},normalcolor,{color=${2:color}},normal|}","format=${1|plain,hang|}","hangindent=","hypcap","hypcapspace=","indention=","justification=${1|justified,centering,centerlast,centerfirst,raggedright,RaggedRight,raggedleft|}","labelfont+=${4|scriptsize,footnotesize,small,normalsize,large,Large,smaller,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,{stretch=${1:factor}},normalcolor,{color=${2:color}},normal|}","labelfont=${4|scriptsize,footnotesize,small,normalsize,large,Large,smaller,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,{stretch=${1:factor}},normalcolor,{color=${2:color}},normal|}","labelformat=${1|original,empty,simple,brace,parens|}","labelsep=${1|none,colon,period,space,quad,newline,endash|}","list=${1|on,off,true,false|}","listformat=${1|empty,simple,parens,subsimple,subparens|}","margin*=","margin=","maxmargin=","minmargin=","name=${1:name}","oneside","parindent=","parskip=","position=${1|top,above,bottom,below,auto|}","singlelinecheck","skip=","strut=${1|on,off|}","style=","subrefformat=${1|original,empty,simple,brace,parens|}","tableposition=${1|top,above,bottom,below,auto|}","textfont+=${4|scriptsize,footnotesize,small,normalsize,large,Large,smaller,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,{stretch=${1:factor}},normalcolor,{color=${2:color}},normal|}","textfont=${4|scriptsize,footnotesize,small,normalsize,large,Large,smaller,normalfont,up,it,sl,sc,md,bf,rm,sf,tt,singlespacing,onehalfspacing,doublespacing,{stretch=${1:factor}},normalcolor,{color=${2:color}},normal|}","textformat=${1|empty,simple,period|}","twoside","width="]
	},
	"args": ["\\usepackage/subcaption#c"]
}
