{
	"deps": [{"name":"etex"},{"name":"kvsetkeys"},{"name":"xkeyval"},{"name":"etoolbox"}],
	"macros": [
		{"name":"commandkey","arg":{"format":"{}","snippet":"commandkey{${1:key name}}"}},
		{"name":"getcommandkey","arg":{"format":"{}","snippet":"getcommandkey{${1:key name}}"},"unusual":true},
		{"name":"ifcommandkey","arg":{"format":"{}{}{}","snippet":"ifcommandkey{${1:key name}}{${2:commands if key is not blank}}{${3:commands if key is blank}}"}},
		{"name":"newkeycommand","arg":{"format":"[]{}[][][]{}","snippet":"newkeycommand[${1:short-unexpand}]{${2:command}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:definition}}"},"doc":"\\newkeycommand will define \\command as a new key-command!"},
		{"name":"newkeycommand","arg":{"format":"{}{}","snippet":"newkeycommand{${1:command}}{${2:definition}}"},"doc":"\\newkeycommand will define \\command as a new key-command!"},
		{"name":"newkeycommand*","arg":{"format":"[]{}[][][]{}","snippet":"newkeycommand*[${1:short-unexpand}]{${2:command}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:definition}}"},"doc":"\\newkeycommand will define \\command as a new key-command!"},
		{"name":"newkeycommand*","arg":{"format":"{}{}","snippet":"newkeycommand*{${1:command}}{${2:definition}}"},"doc":"\\newkeycommand will define \\command as a new key-command!"},
		{"name":"newkeyenvironment","arg":{"format":"[]{}[][][]{}{}","snippet":"newkeyenvironment[${1:short-unexpand}]{${2:environment name}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:begin}}{${7:end}}"}},
		{"name":"newkeyenvironment","arg":{"format":"{}{}{}","snippet":"newkeyenvironment{${1:environment name}}{${2:begin}}{${3:end}}"}},
		{"name":"newkeyenvironment*","arg":{"format":"[]{}[][][]{}{}","snippet":"newkeyenvironment*[${1:short-unexpand}]{${2:environment name}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:begin}}{${7:end}}"}},
		{"name":"newkeyenvironment*","arg":{"format":"{}{}{}","snippet":"newkeyenvironment*{${1:environment name}}{${2:begin}}{${3:end}}"}},
		{"name":"providekeycommand","arg":{"format":"[]{}[][][]{}","snippet":"providekeycommand[${1:short-unexpand}]{${2:command}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:definition}}"}},
		{"name":"providekeycommand","arg":{"format":"{}{}","snippet":"providekeycommand{${1:command}}{${2:definition}}"}},
		{"name":"providekeycommand*","arg":{"format":"[]{}[][][]{}","snippet":"providekeycommand*[${1:short-unexpand}]{${2:command}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:definition}}"}},
		{"name":"providekeycommand*","arg":{"format":"{}{}","snippet":"providekeycommand*{${1:command}}{${2:definition}}"}},
		{"name":"renewkeycommand","arg":{"format":"[]{}[][][]{}","snippet":"renewkeycommand[${1:short-unexpand}]{${2:command}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:definition}}"}},
		{"name":"renewkeycommand","arg":{"format":"{}{}","snippet":"renewkeycommand{${1:command}}{${2:definition}}"}},
		{"name":"renewkeycommand*","arg":{"format":"[]{}[][][]{}","snippet":"renewkeycommand*[${1:short-unexpand}]{${2:command}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:definition}}"}},
		{"name":"renewkeycommand*","arg":{"format":"{}{}","snippet":"renewkeycommand*{${1:command}}{${2:definition}}"}},
		{"name":"renewkeyenvironment","arg":{"format":"[]{}[][][]{}{}","snippet":"renewkeyenvironment[${1:short-unexpand}]{${2:environment name}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:begin}}{${7:end}}"}},
		{"name":"renewkeyenvironment","arg":{"format":"{}{}{}","snippet":"renewkeyenvironment{${1:environment name}}{${2:begin}}{${3:end}}"}},
		{"name":"renewkeyenvironment*","arg":{"format":"[]{}[][][]{}{}","snippet":"renewkeyenvironment*[${1:short-unexpand}]{${2:environment name}}[${3:keys=defaults}][${4:OptKey}][${5:n}]{${6:begin}}{${7:end}}"}},
		{"name":"renewkeyenvironment*","arg":{"format":"{}{}{}","snippet":"renewkeyenvironment*{${1:environment name}}{${2:begin}}{${3:end}}"}},
		{"name":"showcommandkey","arg":{"format":"{}","snippet":"showcommandkey{${1}}"},"unusual":true},
		{"name":"showcommandkeys","arg":{"format":"{}","snippet":"showcommandkeys{${1}}"},"unusual":true}
	],
	"envs": [],
	"keys": {}
}
