{
	"deps": [{"name":"luacode"},{"name":"ifluatex"},{"name":"iftex"},{"name":"luatexbase"},{"name":"etoolbox"},{"name":"luakeys"},{"name":"penlightplus"},{"name":"penlight"},{"name":"tokcycle"}],
	"macros": [
		{"name":"AllowUndeclaredYV"},
		{"name":"declareYAMLvarsFile","arg":{"format":"{}","snippet":"declareYAMLvarsFile{${1}}"}},
		{"name":"ForbidUndeclaredYV"},
		{"name":"lowercasevarYVoff"},
		{"name":"lowercasevarYVon"},
		{"name":"parseYAMLvarsFile","arg":{"format":"{}","snippet":"parseYAMLvarsFile{${1}}"}},
		{"name":"resetYAMLvarsspec","unusual":true},
		{"name":"setdefYAMLvars","arg":{"format":"{}","snippet":"setdefYAMLvars{${1}}"},"doc":"\\setdefYAMLvars {kv} changes the default settings of key-vals."},
		{"name":"setYAMLvars","arg":{"format":"{}","snippet":"setYAMLvars{${1}}"},"doc":"\\setYAMLvars *{kv} changes the current settings from key-vals."},
		{"name":"setYAMLvars*","arg":{"format":"{}","snippet":"setYAMLvars*{${1}}"},"doc":"\\setYAMLvars *{kv} changes the current settings from key-vals."},
		{"name":"TextualYV","unusual":true},
		{"name":"yamlvarsdebugoff"},
		{"name":"yamlvarsdebugon"},
		{"name":"yv","arg":{"format":"{}","snippet":"yv{${1:variable}}"},"if":"useyv"}
	],
	"envs": [
		{"name":"declareYAMLvars"},
		{"name":"parseYAMLpdfdata","unusual":true},
		{"name":"parseYAMLvars"}
	],
	"keys": {
		"\\usepackage/yamlvars#c": ["allowundeclared","debug","overwritedefs","parseCLI","useyv"]
	},
	"args": ["\\usepackage/yamlvars#c"]
}
