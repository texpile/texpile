{
	"deps": [{"name":"xparse"},{"name":"cleveref"}],
	"macros": [
		{"name":"cref","arg":{"format":"[]{}","snippet":"cref[${1:option}]{${2:label}}"}},
		{"name":"cref","arg":{"format":"{}","snippet":"cref{${1:label}}"}},
		{"name":"cref*","arg":{"format":"[]{}","snippet":"cref*[${1:option}]{${2:label}}"}},
		{"name":"cref*","arg":{"format":"{}","snippet":"cref*{${1:label}}"}},
		{"name":"Cref","arg":{"format":"[]{}","snippet":"Cref[${1:option}]{${2:label}}"}},
		{"name":"Cref","arg":{"format":"{}","snippet":"Cref{${1:label}}"}},
		{"name":"Cref*","arg":{"format":"[]{}","snippet":"Cref*[${1:option}]{${2:label}}"}},
		{"name":"Cref*","arg":{"format":"{}","snippet":"Cref*{${1:label}}"}},
		{"name":"UsedByAndOnMessage","arg":{"format":"{}{}","snippet":"UsedByAndOnMessage{${1}}{${2}}"}},
		{"name":"UsedByMessage","arg":{"format":"{}","snippet":"UsedByMessage{${1}}"}},
		{"name":"UsedOnMessage","arg":{"format":"{}","snippet":"UsedOnMessage{${1}}"}},
		{"name":"UsedOnPackageDate","unusual":true},
		{"name":"UsedOnPackageVersion","unusual":true}
	],
	"envs": [],
	"keys": {
		"\\usepackage/cleveref-usedon#c": ["notusedon","usedon"]
	},
	"args": ["\\usepackage/cleveref-usedon#c"]
