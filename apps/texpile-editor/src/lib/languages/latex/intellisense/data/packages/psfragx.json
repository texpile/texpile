{
	"deps": [{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"},{"name":"psfrag"},{"name":"overpic","if":"!noovp"},{"name":"epic","if":"!noovp"}],
	"macros": [
		{"name":"Afterovpinput","unusual":true},
		{"name":"Afterpfxinput","unusual":true},
		{"name":"allmetacomments","unusual":true},
		{"name":"Beforeovpinput","unusual":true},
		{"name":"Beforepfxinput","unusual":true},
		{"name":"copypfxfromto","arg":{"format":"{}{}","snippet":"copypfxfromto{${1}}{${2}}"},"unusual":true},
		{"name":"copypfxlines","unusual":true},
		{"name":"endonlylanguage"},
		{"name":"includegraphicx","arg":{"format":"[]()<>[]{}","snippet":"includegraphicx[${1:keys}](${2:psfrag commands})<${3:foreground overpic commands}>[${4:background overpic commands}]{${5:file}}"},"doc":"This command differs from \\includegraphics in the fact that it inputs \\psfrag replacements contained into the included eps file itself."},
		{"name":"includegraphicx","arg":{"format":"()<>{}","snippet":"includegraphicx(${1:psfrag commands})<${2:foreground overpic commands}>{${3:file}}"},"doc":"This command differs from \\includegraphics in the fact that it inputs \\psfrag replacements contained into the included eps file itself."},
		{"name":"onlylanguage","arg":{"format":"{}","snippet":"onlylanguage{${1:language}}"}},
		{"name":"ovpinput","arg":{"format":"{}","snippet":"ovpinput{${1}}"},"unusual":true},
		{"name":"pfxinput","arg":{"format":"{}","snippet":"pfxinput{${1}}"},"unusual":true},
		{"name":"providecolorcommands","unusual":true},
		{"name":"selectedmetacomments","unusual":true},
		{"name":"setpfxinput","arg":{"format":"{}","snippet":"setpfxinput{${1}}"},"unusual":true},
		{"name":"setpfxoutput","arg":{"format":"{}","snippet":"setpfxoutput{${1}}"},"unusual":true}
	],
	"envs": [
		{"name":"overpix","arg":{"format":"[]<>[]{}","snippet":"[${1:keys}]<${2:foreground overpic commands}>[${3:background overpic commands}]{${4:file}}"}},
		{"name":"overpix","arg":{"format":"<>{}","snippet":"<${1:foreground overpic commands}>{${2:file}}"}}
	],
	"keys": {
		"\\usepackage/psfragx#c": ["allcom","noovp","nosub","ovp","selcom","sub"]
	},
	"args": ["\\usepackage/psfragx#c"]
}
