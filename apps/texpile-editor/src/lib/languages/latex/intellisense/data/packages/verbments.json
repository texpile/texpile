{
	"deps": [{"name":"xkeyval"},{"name":"fancyvrb"},{"name":"framed"},{"name":"xcolor"},{"name":"calc"}],
	"macros": [
		{"name":"listofpyglistings","doc":"If source code listings in a document are decorated with captions, their list can be produced with the \\listofpyglistings command."},
		{"name":"listofpyglistingsname","arg":{"format":"{}","snippet":"listofpyglistingsname{${1}}"}},
		{"name":"plset","arg":{"format":"{}","snippet":"plset{${1}}","keys":["keyval:pyglist"],"keyPos":0}},
		{"name":"thepllisting","unusual":true}
	],
	"envs": [
		{"name":"pyglist","arg":{"format":"[]","snippet":"[${1}]","keys":["keyval:pyglist"],"keyPos":0}},
		{"name":"pyglist"}
	],
	"keys": {
		"keyval:pyglist": ["caption=","captionbgcolor=","fontsize=","fvset=","label=","numbersep=","abovecaptionskip=","belowcaptionskip=","bgcolor=","captionfont=","encoding=","gobble=","language=","listingname=","listingnamefont=","mathescape=${1|false,true|}","numbers=${1|left,none,right|}","showspaces=${1|false,true|}","style=","texcl=${1|false,true|}"]
	}
}
