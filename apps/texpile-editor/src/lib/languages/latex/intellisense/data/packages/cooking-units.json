{
	"deps": [{"name":"xparse"},{"name":"translations"},{"name":"etoolbox"},{"name":"iftex"},{"name":"xfrac"},{"name":"amstext"},{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"},{"name":"l3keys2e"},{"name":"fmtcount","if":"use-fmtcount-numerals=true|use-numerals=true"},{"name":"ifthen","if":"use-fmtcount-numerals=true|use-numerals=true"},{"name":"xkeyval","if":"use-fmtcount-numerals=true|use-numerals=true"},{"name":"fcprefix","if":"use-fmtcount-numerals=true|use-numerals=true"}],
	"macros": [
		{"name":"cuaddkeys","arg":{"format":"{}{}","snippet":"cuaddkeys{${1}}{${2}}"},"doc":"\\cuaddkeys takes the already defined key {⟨unit-key-1⟩} as a “basis”, and adds ⟨unit-key-2⟩, ⟨unit-key-3⟩, etc. to its values."},
		{"name":"cuaddoptionfor","arg":{"format":"{}{}","snippet":"cuaddoptionfor{${1:unit-list}}{${2:options}}","keys":["l3keys:cooking-units"],"keyPos":1},"doc":"\\cuaddoptionfor adds ⟨options⟩ to each unit in ⟨unit-list⟩."},
		{"name":"cuaddsinglekeys","arg":{"format":"{}{}","snippet":"cuaddsinglekeys{${1}}{${2}}"},"doc":"If the conversion is more complicated use \\cuaddsinglekeys. It adds ⟨unit-key-2⟩, etc. as values to ⟨unit-key-1⟩."},
		{"name":"cuaddtokeychain","arg":{"format":"{}","snippet":"cuaddtokeychain{${1}}"},"doc":"\\cuaddtokeychain first parses through its unit-list and searches for a base unit key which is already in a key-chain (aka. was defined by \\cudefinekeychain). The other units, not yet part of a key-chain, are added to the same key-chain as the base unit."},
		{"name":"cuaddtokeys","arg":{"format":"{}{}{}","snippet":"cuaddtokeys{${1}}{${2}}{${3}}"}},
		{"name":"cuaddtounitgroup","arg":{"format":"{}{}","snippet":"cuaddtounitgroup{${1:group-name}}{${2:unit-list}}"},"doc":"Adds ⟨unit-list⟩ to an already existing ⟨group⟩ (both need to exist)."},
		{"name":"cuam","arg":{"format":"<>[]{}","snippet":"cuam<${1:label}>[${2:options}]{${3:amount}}","keys":["l3keys:cooking-units"],"keyPos":1},"doc":"\\cuam works like \\cunum, but without a unit, so changing units doesn’t affect it."},
		{"name":"cuam","arg":{"format":"<>{}","snippet":"cuam<${1:label}>{${2:amount}}"},"doc":"\\cuam works like \\cunum, but without a unit, so changing units doesn’t affect it."},
		{"name":"cuclearoptionfor","arg":{"format":"{}","snippet":"cuclearoptionfor{${1:unit-list}}"},"doc":"\\cuclearoptionfor clears all options given to each unit in ⟨unit-list⟩."},
		{"name":"cuclearunitgroup","arg":{"format":"{}","snippet":"cuclearunitgroup{${1}}"}},
		{"name":"cudeclareunitgroup","arg":{"format":"{}{}","snippet":"cudeclareunitgroup{${1:group-name}}{${2:unit-list}}"},"doc":"Defines the group ⟨group-name⟩ containing the list ⟨unit-list⟩."},
		{"name":"cudefinekeychain","arg":{"format":"{}","snippet":"cudefinekeychain{${1}}"},"doc":"\\cudefinekeychain collects the unit-key’s given and defines a key-chain."},
		{"name":"cudefinekeys","arg":{"format":"{}{}","snippet":"cudefinekeys{${1}}{${2}}"},"doc":"\\cudefinekeys takes {⟨unit-key-1⟩} as a “basis”, defines a key with the name ⟨unit-key-1⟩ and adds the values ⟨unit-key-1⟩, ⟨unit-key-2⟩, ⟨unit-key-3⟩, etc. Furthermore this command also defines the keys ⟨unit-key-2⟩, ⟨unit-key-3⟩, etc. with the same values as ⟨unit-key-1⟩."},
		{"name":"cudefinename","arg":{"format":"{}{}","snippet":"cudefinename{${1:language}}{${2:definitions}}"}},
		{"name":"cudefinephrase","arg":{"format":"{}{}","snippet":"cudefinephrase{${1:language}}{${2:definitions}}"}},
		{"name":"cudefinesinglekey","arg":{"format":"{}{}","snippet":"cudefinesinglekey{${1}}{${2}}"}},
		{"name":"cudefinesymbol","arg":{"format":"{}{}","snippet":"cudefinesymbol{${1:language}}{${2:definitions}}"}},
		{"name":"cufrac","arg":{"format":"[]{}","snippet":"cufrac[${1}]{${2}}"},"unusual":true},
		{"name":"cufrac","arg":{"format":"{}","snippet":"cufrac{${1}}"},"unusual":true},
		{"name":"culabel","arg":{"format":"{}{}","snippet":"culabel{${1:label}}{${2:number of persons}}"}},
		{"name":"cunum","arg":{"format":"<>[]{}[]{}","snippet":"cunum<${1:label}>[${2:options}]{${3:amount}}[${4:space}]{${5:unit-key}}","keys":["l3keys:cooking-units"],"keyPos":1},"doc":"Numbers and units are printed using \\cunum."},
		{"name":"cunum","arg":{"format":"<>{}{}","snippet":"cunum<${1:label}>{${2:amount}}{${3:unit-key}}"},"doc":"Numbers and units are printed using \\cunum."},
		{"name":"curef","arg":{"format":"{}","snippet":"curef{${1:label}}"}},
		{"name":"cusetoptionfor","arg":{"format":"{}{}","snippet":"cusetoptionfor{${1:unit-list}}{${2:options}}","keys":["l3keys:cooking-units"],"keyPos":1},"doc":"\\cusetoptionfor sets ⟨options⟩ to each unit in ⟨unit-list⟩ overwriting the old ones."},
		{"name":"cusetup","arg":{"format":"{}","snippet":"cusetup{${1:options}}","keys":["l3keys:cooking-units"],"keyPos":0},"doc":"Options can be set using \\cusetup{⟨options⟩}."},
		{"name":"cutext","arg":{"format":"<>[]{}{}","snippet":"cutext<${1:label}>[${2:options}]{${3:amount}}{${4:unit-key}}","keys":["l3keys:cooking-units"],"keyPos":1}},
		{"name":"cutext","arg":{"format":"<>{}{}","snippet":"cutext<${1:label}>{${2:amount}}{${3:unit-key}}"}},
		{"name":"Cutext","arg":{"format":"<>[]{}{}","snippet":"Cutext<${1:label}>[${2:options}]{${3:amount}}{${4:unit-key}}","keys":["l3keys:cooking-units"],"keyPos":1}},
		{"name":"Cutext","arg":{"format":"<>{}{}","snippet":"Cutext<${1:label}>{${2:amount}}{${3:unit-key}}"}},
		{"name":"declarecookingderivatives","arg":{"format":"{}{}{}{}","snippet":"declarecookingderivatives{${1}}{${2}}{${3}}{${4}}"}},
		{"name":"declarecookingunit","arg":{"format":"[]{}","snippet":"declarecookingunit[${1:symbol/key-val-list}]{${2:unit-key}}"}},
		{"name":"declarecookingunit","arg":{"format":"{}","snippet":"declarecookingunit{${1:unit-key}}"}},
		{"name":"newcookingunit","arg":{"format":"[]{}","snippet":"newcookingunit[${1:symbol/key-val-list}]{${2:unit-key}}"},"doc":"\\newcookingunit raises an error if the unit is already defined, \\declarecookingunit creates or (if given) overwrites ⟨symbol⟩ and \\providecookingunit does nothing if the unit is already defined."},
		{"name":"newcookingunit","arg":{"format":"{}","snippet":"newcookingunit{${1:unit-key}}"},"doc":"\\newcookingunit raises an error if the unit is already defined, \\declarecookingunit creates or (if given) overwrites ⟨symbol⟩ and \\providecookingunit does nothing if the unit is already defined."},
		{"name":"providecookingunit","arg":{"format":"[]{}","snippet":"providecookingunit[${1:symbol/key-val-list}]{${2:unit-key}}"}},
		{"name":"providecookingunit","arg":{"format":"{}","snippet":"providecookingunit{${1:unit-key}}"}}
	],
