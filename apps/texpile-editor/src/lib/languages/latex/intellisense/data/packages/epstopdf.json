{
	"deps": [{"name":"grfext"},{"name":"kvoptions"},{"name":"keyval"},{"name":"kvsetkeys"},{"name":"iftex"},{"name":"epstopdf-base"}],
	"macros": [
		{"name":"epstopdfcall","arg":{"format":"{}","snippet":"epstopdfcall{${1:command}}"}},
		{"name":"epstopdfDeclareGraphicsRule","arg":{"format":"{}{}{}{}","snippet":"epstopdfDeclareGraphicsRule{${1:extension}}{${2:type}}{${3:read file}}{${4:command}}"}},
		{"name":"epstopdfsetup","arg":{"format":"{}","snippet":"epstopdfsetup{${1}}","keys":["epstopdf:setup"],"keyPos":0}},
		{"name":"OutputFile"},
		{"name":"SourceExt"},
		{"name":"SourceFile"}
	],
	"envs": [],
	"keys": {
		"epstopdf:setup": ["update","append","prepend","outdir=${1:directory}","suffix=${1:string}","prefersuffix","program@epstopdf=${1:program}","verbose"],
		"\\usepackage/epstopdf#c": ["update","append","prepend","outdir=${1:directory}","suffix=${1:string}","prefersuffix","program@epstopdf=${1:program}","verbose"]
	},
	"args": ["\\usepackage/epstopdf#c"]
}
