{
	"deps": [{"name":"ifthen"}],
	"macros": [
		{"name":"alnumsecstyle","arg":{"format":"{}","snippet":"alnumsecstyle{${1:list of one-letter specifiers}}"},"doc":"\\alnumsecstyle is the macro with which the user specifies the numbering scheme and, implicitly, the level of the last numbered section."},
		{"name":"alnumsectionlevels","arg":{"format":"{}{}","snippet":"alnumsectionlevels{${1:first level}}{${2:list of sectioning commands}}"},"doc":"\\alnumsectionlevels is the command for users that have more or different than the usual section names."},
		{"name":"ifusepreviouslevels","unusual":true},
		{"name":"otherseparators","arg":{"format":"{}","snippet":"otherseparators{${1:level}}"}},
		{"name":"surroundarabic","arg":{"format":"[][]{}{}","snippet":"surroundarabic[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surroundarabic","arg":{"format":"{}{}","snippet":"surroundarabic{${1:before}}{${2:after}}"}},
		{"name":"surrounddoublegreek","arg":{"format":"[][]{}{}","snippet":"surrounddoublegreek[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surrounddoublegreek","arg":{"format":"{}{}","snippet":"surrounddoublegreek{${1:before}}{${2:after}}"}},
		{"name":"surrounddoubleletter","arg":{"format":"[][]{}{}","snippet":"surrounddoubleletter[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surrounddoubleletter","arg":{"format":"{}{}","snippet":"surrounddoubleletter{${1:before}}{${2:after}}"}},
		{"name":"surroundgreek","arg":{"format":"[][]{}{}","snippet":"surroundgreek[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surroundgreek","arg":{"format":"{}{}","snippet":"surroundgreek{${1:before}}{${2:after}}"}},
		{"name":"surroundletter","arg":{"format":"[][]{}{}","snippet":"surroundletter[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surroundletter","arg":{"format":"{}{}","snippet":"surroundletter{${1:before}}{${2:after}}"}},
		{"name":"surroundLetter","arg":{"format":"[][]{}{}","snippet":"surroundLetter[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surroundLetter","arg":{"format":"{}{}","snippet":"surroundLetter{${1:before}}{${2:after}}"}},
		{"name":"surroundroman","arg":{"format":"[][]{}{}","snippet":"surroundroman[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surroundroman","arg":{"format":"{}{}","snippet":"surroundroman{${1:before}}{${2:after}}"}},
		{"name":"surroundRoman","arg":{"format":"[][]{}{}","snippet":"surroundRoman[${1:lower before}][${2:lower after}]{${3:before}}{${4:after}}"}},
		{"name":"surroundRoman","arg":{"format":"{}{}","snippet":"surroundRoman{${1:before}}{${2:after}}"}},
		{"name":"usepreviouslevelsfalse","unusual":true},
		{"name":"usepreviouslevelstrue","unusual":true}
	],
	"envs": [],
	"keys": {
		"\\usepackage/alnumsec#c": ["usehighlevels"]
	},
	"args": ["\\usepackage/alnumsec#c"]
}
