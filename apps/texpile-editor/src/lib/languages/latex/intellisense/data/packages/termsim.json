		{"name":"termfile","arg":{"format":"{}{}","snippet":"termfile{${1:terminal title}}{${2:contents file}}"},"doc":"Typesetting terminal from a file."},
		{"name":"termfile*","arg":{"format":"[][]{}{}","snippet":"termfile*[${1:options}][${2:comments}]{${3:terminal title}}{${4:contents file}}","keys":["l3keys:termsim"],"keyPos":0},"doc":"Typesetting terminal from a file."},
		{"name":"termfile*","arg":{"format":"{}{}","snippet":"termfile*{${1:terminal title}}{${2:contents file}}"},"doc":"Typesetting terminal from a file."},
		{"name":"termset","arg":{"format":"{}","snippet":"termset{${1:key-values}}","keys":["l3keys:termsim"],"keyPos":0},"doc":"The arguments to \\termset are a set of options separated by commas in the form ⟨key⟩ = ⟨value⟩."}
	],
	"envs": [
		{"name":"terminal","arg":{"format":"[][]{}","snippet":"[${1:options}][${2:comments}]{${3:terminal title}}","keys":["l3keys:termsim"],"keyPos":0},"doc":"Typesetting terminal with environment body."},
		{"name":"terminal","arg":{"format":"{}","snippet":"{${1:terminal title}}"},"doc":"Typesetting terminal with environment body."},
		{"name":"terminal*","arg":{"format":"[][]{}","snippet":"[${1:options}][${2:comments}]{${3:terminal title}}","keys":["l3keys:termsim"],"keyPos":0},"doc":"Typesetting terminal with environment body."},
		{"name":"terminal*","arg":{"format":"{}","snippet":"{${1:terminal title}}"},"doc":"Typesetting terminal with environment body."}
