{
	"deps": [{"name":"verbatim"}],
	"macros": [
		{"name":"bxx","arg":{"format":"()[]","snippet":"bxx(${1:env})[${2:thm}]"}},
		{"name":"bxx","arg":{"format":"()","snippet":"bxx(${1:env})"}},
		{"name":"exx"},
		{"name":"xdetailoff"},
		{"name":"xdetailon"},
		{"name":"xdisablesection"},
		{"name":"xenablesection"},
		{"name":"xenv","arg":{"format":"()","snippet":"xenv(${1:env})"},"doc":"This macro specifies the default environment used for the macros ‘bxx’, ‘\\xget’, ‘\\xgetall’, etc. Here #env is any predefined environment."},
		{"name":"xget","arg":{"format":"(){}","snippet":"xget(${1:env}){${2:ID list}}"}},
		{"name":"xgetall"},
		{"name":"xgetallbut","arg":{"format":"(){}","snippet":"xgetallbut(${1:env}){${2:ID list}}"},"doc":"The macro \\xgetallbut means that you want to get all the data items but the data items specified in the #ID-list."},
		{"name":"xhintready","unusual":true},
		{"name":"xkill","arg":{"format":"(){}","snippet":"xkill(${1:env}){${2:ID list}}"}},
		{"name":"xkillall"},
		{"name":"xkillallbut","arg":{"format":"(){}","snippet":"xkillallbut(${1:env}){${2:ID list}}"}},
		{"name":"xlib","doc":"\\xlib specifies the data file."},
		{"name":"xopenhint"},
		{"name":"xopenlib"},
		{"name":"xspec","arg":{"format":"(){}","snippet":"xspec(${1:env}){${2:ID list}}"}}
	],
	"envs": [
		{"name":"hint"}
	],
	"keys": {
		"\\usepackage/ktv-texdata#c": ["detailon"]
	},
	"args": ["\\usepackage/ktv-texdata#c"]
}
