{
	"macros": [
		{"name":"bm","arg":{"format":"{}","snippet":"bm{${1:math expression}}"},"math":true},
		{"name":"bmdefine","arg":{"format":"{}{}","snippet":"bmdefine{${1:cmd}}{${2:math expression}}"},"doc":"\\bmdefine Shorthand for \\DeclareBoldMathCommand[bold]."},
		{"name":"bmmax"},
		{"name":"boldsymbol","arg":{"format":"{}","snippet":"boldsymbol{${1:math expression}}"},"math":true},
		{"name":"DeclareBoldMathCommand","arg":{"format":"[]{}{}","snippet":"DeclareBoldMathCommand[${1:math version}]{${2:cmd}}{${3:math expression}}","keys":["bm:version"],"keyPos":0},"doc":"Defines \\cmd to be the bold form of the math expression."},
		{"name":"DeclareBoldMathCommand","arg":{"format":"{}{}","snippet":"DeclareBoldMathCommand{${1:cmd}}{${2:math expression}}"},"doc":"Defines \\cmd to be the bold form of the math expression."},
		{"name":"heavymath"},
		{"name":"heavysymbol","arg":{"format":"{}","snippet":"heavysymbol{${1:math expression}}"}},
		{"name":"hm","arg":{"format":"{}","snippet":"hm{${1:math expression}}"}},
		{"name":"hmdefine","arg":{"format":"{}{}","snippet":"hmdefine{${1:cmd}}{${2:math expression}}"}},
		{"name":"hmmax"}
	],
	"envs": [],
	"keys": {
		"\\usepackage/bm#c": ["info","nopmb","silent","warn"],
		"bm:version": ["bold","heavy"]
	},
	"args": ["\\usepackage/bm#c"]
