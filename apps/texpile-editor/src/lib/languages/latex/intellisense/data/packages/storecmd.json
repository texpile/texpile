{
	"deps": [{"name":"catoptions"},{"name":"ltxtools"},{"name":"ltxtools-base"},{"name":"ltxkeys"},{"name":"atveryend-ltx"},{"name":"pdftexcmds","engines":["lualatex"]},{"name":"iftex","engines":["lualatex"]}],
	"macros": [
		{"name":"defsavecmd","arg":{"format":"{}{}","snippet":"defsavecmd{${1:command}}{${2:definition}}"},"doc":"\\defsavecmd will overwrite an existing command; both \\newsavecmd and \\renewsavecmd will not do so."},
		{"name":"defsavecmd*","arg":{"format":"{}{}","snippet":"defsavecmd*{${1:command}}{${2:definition}}"},"doc":"\\defsavecmd will overwrite an existing command; both \\newsavecmd and \\renewsavecmd will not do so."},
		{"name":"globalcmd","doc":"The commands \\defsavecmd, \\newsavecmd and \\renewsavecmd may be prefixed by \\globalcmd and/or \\protectedcmd to yield global or robust definitions, respectively."},
		{"name":"longcmd"},
		{"name":"newsavecmd","arg":{"format":"{}[][](){}","snippet":"newsavecmd{${1:command}}[${2:number of arguments}][${3:default}](${4:delimiters}){${5:definition}}"}},
		{"name":"newsavecmd","arg":{"format":"{}(){}","snippet":"newsavecmd{${1:command}}(${2:delimiters}){${3:definition}}"}},
		{"name":"newsavecmd*","arg":{"format":"{}[][](){}","snippet":"newsavecmd*{${1:command}}[${2:number of arguments}][${3:default}](${4:delimiters}){${5:definition}}"}},
		{"name":"newsavecmd*","arg":{"format":"{}(){}","snippet":"newsavecmd*{${1:command}}(${2:delimiters}){${3:definition}}"}},
		{"name":"protectedcmd","doc":"The commands \\defsavecmd, \\newsavecmd and \\renewsavecmd may be prefixed by \\globalcmd and/or \\protectedcmd to yield global or robust definitions, respectively."},
		{"name":"renewsavecmd","arg":{"format":"{}[][](){}","snippet":"renewsavecmd{${1:command}}[${2:number of arguments}][${3:default}](${4:delimiters}){${5:definition}}"}},
		{"name":"renewsavecmd","arg":{"format":"{}(){}","snippet":"renewsavecmd{${1:command}}(${2:delimiters}){${3:definition}}"}},
		{"name":"renewsavecmd*","arg":{"format":"{}[][](){}","snippet":"renewsavecmd*{${1:command}}[${2:number of arguments}][${3:default}](${4:delimiters}){${5:definition}}"}},
		{"name":"renewsavecmd*","arg":{"format":"{}(){}","snippet":"renewsavecmd*{${1:command}}(${2:delimiters}){${3:definition}}"}}
	],
	"envs": [],
	"keys": {}
}
