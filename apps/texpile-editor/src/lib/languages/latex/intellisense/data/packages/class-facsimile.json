{
	"deps": [{"name":"class-article","if":"!koma"},{"name":"fancyhdr"},{"name":"class-scrartcl","if":"koma"},{"name":"scrkbase","if":"koma"},{"name":"scrbase","if":"koma"},{"name":"scrlfile","if":"koma"},{"name":"scrlfile-hook","if":"koma"},{"name":"scrlogo","if":"koma"},{"name":"keyval","if":"koma"},{"name":"tocbasic","if":"koma"},{"name":"typearea","if":"koma"}],
	"macros": [
		{"name":"closing","arg":{"format":"{}","snippet":"closing{${1:closing phrase}}"}},
		{"name":"closinghook"},
		{"name":"datename","unusual":true},
		{"name":"faxfrom","arg":{"format":"{}","snippet":"faxfrom{${1:sender}}"},"doc":"The macro \\faxfrom{⟨sender⟩} takes as the only parameter LaTeX code that produces information about the sender of the fax."},
		{"name":"faxheaderfont"},
		{"name":"faxnotetext","doc":"If this macro contains text, it is printed as a note on the cover page."},
		{"name":"faxsubject","arg":{"format":"[]{}","snippet":"faxsubject[${1}]{${2}}"}},
		{"name":"faxsubject","arg":{"format":"{}","snippet":"faxsubject{${1}}"}},
		{"name":"faxto","arg":{"format":"{}","snippet":"faxto{${1:recipient}}"},"doc":"The counterpart of \\faxfrom for the recipient is \\faxto{⟨recipient⟩}."},
		{"name":"fromname","unusual":true},
		{"name":"fromsig","doc":"By default, the author’s name is printed below the empty space where you can insert your signature. If you set \\fromsig, its contents is used instead."},
		{"name":"makefaxtitle"},
		{"name":"notename","unusual":true},
		{"name":"ofname","unusual":true},
		{"name":"onepagename","unusual":true},
		{"name":"opening","arg":{"format":"{}","snippet":"opening{${1:greeting phrase}}"}},
		{"name":"pagesname","unusual":true}
	],
	"envs": [],
	"keys": {
		"\\documentclass/facsimile#c": ["10pt","11pt","12pt","UKenglish","USenglish","afrikaans","american","austrian","brazil","brazilian","british","canadian","dutch","english","french","frenchb","german","germanb","italian","koma","naustrian","ngerman","portuges","portuguese","spanish","swedish"]
