{
	"deps": [{"name":"soul-ori"},{"name":"etexcmds"},{"name":"iftex"}],
	"macros": [
		{"name":"caps","arg":{"format":"{}","snippet":"caps{${1:text}}"}},
		{"name":"capsdef","arg":{"format":"{}{}{}{}{}","snippet":"capsdef{${1}}{${2}}{${3}}{${4}}{${5}}"}},
		{"name":"capsfont"},
		{"name":"capsreset","doc":"\\capsreset clears the database and inserts a default rule."},
		{"name":"capssave","arg":{"format":"{}","snippet":"capssave{${1}}"},"doc":"Save the current database in a macro within the SOUL@ namespace and let \\capsselect restore this database."},
		{"name":"capsselect","arg":{"format":"{}","snippet":"capsselect{${1}}"}},
		{"name":"hl","arg":{"format":"{}","snippet":"hl{${1:text}}"}},
		{"name":"resetso","doc":"Let \\resetso define reasonable default values for letterspacing."},
		{"name":"resetul","doc":"Set reasonable default values that fit most latin fonts."},
		{"name":"sethlcolor","arg":{"format":"{}","snippet":"sethlcolor{${1}}"}},
		{"name":"setstcolor","arg":{"format":"{}","snippet":"setstcolor{${1}}"}},
		{"name":"setul","arg":{"format":"{}{}","snippet":"setul{${1}}{${2}}"},"doc":"Set the underlining dimensions."},
		{"name":"setulcolor","arg":{"format":"{}","snippet":"setulcolor{${1}}"}},
		{"name":"setuldepth","arg":{"format":"{}","snippet":"setuldepth{${1}}"}},
		{"name":"setuloverlap","arg":{"format":"{}","snippet":"setuloverlap{${1}}"},"doc":"Set the overlap amount, that helps to avoid gaps on sloppy output devices."},
		{"name":"sloppyword","arg":{"format":"{}","snippet":"sloppyword{${1:text}}"}},
		{"name":"so","arg":{"format":"{}","snippet":"so{${1:text}}"}},
		{"name":"sodef","arg":{"format":"{}{}{}{}{}","snippet":"sodef{${1}}{${2}}{${3}}{${4}}{${5}}"}},
		{"name":"soulaccent","arg":{"format":"{}","snippet":"soulaccent{${1}}"}},
		{"name":"soulfont","arg":{"format":"{}{}","snippet":"soulfont{${1}}{${2}}"},"unusual":true},
		{"name":"soulomit","arg":{"format":"{}","snippet":"soulomit{${1}}"}},
		{"name":"soulregister","arg":{"format":"{}{}","snippet":"soulregister{${1}}{${2}}"},"doc":"Register a font switching command (or some other command) for the scanner."},
		{"name":"st","arg":{"format":"{}","snippet":"st{${1:text}}"}},
		{"name":"textcaps","arg":{"format":"{}","snippet":"textcaps{${1:text}}"},"unusual":true},
		{"name":"texthl","arg":{"format":"{}","snippet":"texthl{${1:text}}"},"unusual":true},
		{"name":"textso","arg":{"format":"{}","snippet":"textso{${1:text}}"},"unusual":true},
		{"name":"textst","arg":{"format":"{}","snippet":"textst{${1:text}}"},"unusual":true},
		{"name":"textul","arg":{"format":"{}","snippet":"textul{${1:text}}"},"unusual":true},
		{"name":"ul","arg":{"format":"{}","snippet":"ul{${1:text}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/soul#c": ["capsdefault"]
	},
	"args": ["\\usepackage/soul#c"]
}
