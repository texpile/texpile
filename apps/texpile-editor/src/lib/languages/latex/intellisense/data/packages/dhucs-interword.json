{
	"deps": [{"name":"dhucs"},{"name":"kotexutf","engines":["pdflatex"]},{"name":"inputenc","engines":["pdflatex"]},{"name":"kolabels-utf"},{"name":"verbatim"},{"name":"luatexko","engines":["lualatex"]},{"name":"fontspec","engines":["lualatex","xelatex"]},{"name":"fontspec-luatex","engines":["lualatex"]},{"name":"xetexko","engines":["xelatex"]},{"name":"fontspec-xetex","engines":["xelatex"]}],
