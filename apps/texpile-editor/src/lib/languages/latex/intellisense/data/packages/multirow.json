{
	"macros": [
		{"name":"bigstrutjot"},
		{"name":"ifmultirowdebug","unusual":true},
		{"name":"multirow","arg":{"format":"[]{}[]{}[]{}","snippet":"multirow[${1:vpos}]{${2:number of rows}}[${3:bigstruts}]{${4:width or *}}[${5:vmove}]{${6:text}}","keys":["multirow:vpos"],"keyPos":0}},
		{"name":"multirow","arg":{"format":"{}{}{}","snippet":"multirow{${1:number of rows}}{${2:width or *}}{${3:text}}"}},
		{"name":"multirowdebugfalse"},
		{"name":"multirowdebugtrue"},
		{"name":"multirowsetup","doc":"Just before ⟨text⟩ is expanded, the \\multirowsetup macro is expanded to set up any special environment."},
		{"name":"STneed","arg":{"format":"{}","snippet":"STneed{${1:length}}"},"if":"supertabular"}
	],
	"envs": [],
	"keys": {
		"\\usepackage/multirow#c": ["debug","longtable","supertabular"],
		"multirow:vpos": ["c","t","b"]
	},
	"args": ["\\usepackage/multirow#c"]
