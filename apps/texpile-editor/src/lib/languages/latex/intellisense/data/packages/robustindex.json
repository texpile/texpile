{
	"deps": [{"name":"makeidx"}],
	"macros": [
		{"name":"altsort","unusual":true},
		{"name":"extraheaders","unusual":true},
		{"name":"gobblepageref"},
		{"name":"indexcapstyle","arg":{"format":"{}","snippet":"indexcapstyle{${1}}"}},
		{"name":"indexincontents"},
		{"name":"indstring","unusual":true},
		{"name":"multindpreamble","unusual":true},
		{"name":"setindex","arg":{"format":"{}","snippet":"setindex{${1:index tag}}"},"doc":"With the \\setindex command we activate an index."},
		{"name":"sindex","arg":{"format":"[]{}","snippet":"sindex[${1:index tag}]{${2:entry}}"}},
		{"name":"sindex","arg":{"format":"{}","snippet":"sindex{${1:entry}}"}},
		{"name":"theindexctr","unusual":true},
		{"name":"setindex","arg":{"format":"{}","snippet":"setindex{${1}}"},"if":"multind"}
	],
	"envs": [],
	"keys": {
		"\\usepackage/robustindex#c": ["multind"]
	},
	"args": ["\\usepackage/robustindex#c"]
