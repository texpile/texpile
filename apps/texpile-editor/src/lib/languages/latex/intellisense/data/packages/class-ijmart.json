{
	"deps": [{"name":"class-amsart"},{"name":"amsmath"},{"name":"amstext"},{"name":"amsbsy"},{"name":"amsopn"},{"name":"amsfonts"},{"name":"ifpdf"},{"name":"iftex"},{"name":"fancyhdr"}],
	"macros": [
		{"name":"author","arg":{"format":"[]{}","snippet":"author[${1:abbreviated name}]{${2:full name}}"}},
		{"name":"author","arg":{"format":"{}","snippet":"author{${1:full name}}"}},
		{"name":"centeredsection","arg":{"format":"[]{}","snippet":"centeredsection[${1:short title}]{${2:title}}"},"unusual":true},
		{"name":"centeredsection","arg":{"format":"{}","snippet":"centeredsection{${1:title}}"},"unusual":true},
		{"name":"centeredsection*","arg":{"format":"[]{}","snippet":"centeredsection*[${1:short title}]{${2:title}}"},"unusual":true},
		{"name":"centeredsection*","arg":{"format":"{}","snippet":"centeredsection*{${1:title}}"},"unusual":true},
		{"name":"doiinfo","arg":{"format":"{}","snippet":"doiinfo{${1}}"},"unusual":true},
		{"name":"mqedhere"},
		{"name":"thanks","arg":{"format":"{}","snippet":"thanks{${1:note}}"}},
		{"name":"title","arg":{"format":"[]{}","snippet":"title[${1:short title}]{${2:full title}}"},"doc":"The mandatory argument is the full title of the article. The optional argument, if present, defines the shorter version of the title for running heads."},
		{"name":"title","arg":{"format":"{}","snippet":"title{${1:full title}}"},"doc":"The mandatory argument is the full title of the article. The optional argument, if present, defines the shorter version of the title for running heads."}
	],
	"envs": [
		{"name":"namedprop","arg":{"format":"{}{}{}[]","snippet":"{${1:style}}{${2:numbered as}}{${3:name}}[${4:note}]"}},
		{"name":"namedprop","arg":{"format":"{}{}{}","snippet":"{${1:style}}{${2:numbered as}}{${3:name}}"}},
		{"name":"namedprop*","arg":{"format":"{}{}[]","snippet":"{${1:style}}{${2:name}}[${3:note}]"}},
		{"name":"namedprop*","arg":{"format":"{}{}","snippet":"{${1:style}}{${2:name}}"}}
	],
	"keys": {
		"\\documentclass/ijmart#c": ["10pt","11pt","12pt","8pt","9pt","french"]
	},
	"args": ["\\documentclass/ijmart#c"]
}
