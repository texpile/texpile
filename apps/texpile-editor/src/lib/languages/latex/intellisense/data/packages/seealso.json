{
	"deps": [{"name":"etoolbox"},{"name":"kvoptions"},{"name":"keyval"},{"name":"kvsetkeys"}],
	"macros": [
		{"name":"alsoname"},
		{"name":"DeclareSeealsoMacro","arg":{"format":"{}{}{}","snippet":"DeclareSeealsoMacro{${1:macro}}{${2:see list}}{${3:name}}"},"doc":"Using \\DeclareSeealsoMacro, two macros will be defined, the one is \\⟨macro⟩, the other is \\⟨macro⟩name."},
		{"name":"see","arg":{"format":"{}{}","snippet":"see{${1:target}}{${2:page}}"}},
		{"name":"seealso","arg":{"format":"{}{}","snippet":"seealso{${1:target}}{${2:page}}"}},
		{"name":"SeealsoGobble","arg":{"format":"{}","snippet":"SeealsoGobble{${1:character}}"}},
		{"name":"seealsonopage","arg":{"format":"{}{}","snippet":"seealsonopage{${1:target}}{${2:page}}"}},
		{"name":"seealsopage","arg":{"format":"{}{}","snippet":"seealsopage{${1:target}}{${2:page}}"}},
		{"name":"SeealsoPrintList"},
		{"name":"seealsosetup","arg":{"format":"[]{}","snippet":"seealsosetup[${1:see lists}]{${2:options}}","keys":["keyval:seealso"],"keyPos":1},"doc":"The macro \\seealsosetup is used to configure the output style of see lists."},
		{"name":"seealsosetup","arg":{"format":"{}","snippet":"seealsosetup{${1:options}}","keys":["keyval:seealso"],"keyPos":0},"doc":"The macro \\seealsosetup is used to configure the output style of see lists."},
		{"name":"seename"},
		{"name":"seenopage","arg":{"format":"{}{}","snippet":"seenopage{${1:target}}{${2:page}}"}},
		{"name":"seepage","arg":{"format":"{}{}","snippet":"seepage{${1:target}}{${2:page}}"}}
	],
	"envs": [],
	"keys": {
		"keyval:seealso": ["enditem+=","enditem=","itemformat=","itemsep=","listsep=","nameformat=","pageformat=","name="]
	}
}
