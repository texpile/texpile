{
	"deps": [{"name":"babel"},{"name":"etoolbox"},{"name":"scalefnt","if":"!BR+!Brazilian+!CN+!Chinese+!DE+!EN+!ES+!English+!German+!IT+!Italian+!JP+!Japanese+!PT+!Portuguese+!RU+!Russian+!SC+!SChinese+!Simplified-Chinese+!SimplifiedChinese+!Spanish+!TC+!TChinese+!Traditional-Chinese+!TraditionalChinese+!brazilian+!chinese+!english+!german+!italian+!japanese+!ngerman+!portuguese+!russian+!schinese+!simplified-chinese+!simplifiedchinese+!spanish+!tchinese+!traditional-chinese+!traditionalchinese"},{"name":"silence"},{"name":"setspaceenhanced"},{"name":"setspace"},{"name":"csquotes"},{"name":"keyval"}],
	"macros": [
		{"name":"AddLanguageSetting","arg":{"format":"[]{}","snippet":"AddLanguageSetting[${1:language}]{${2:code}}"}},
		{"name":"AddLanguageSetting","arg":{"format":"{}","snippet":"AddLanguageSetting{${1:code}}"}},
		{"name":"DefineMultilingualText","arg":{"format":"{}{}","snippet":"DefineMultilingualText{${1:command}}{${2:translations}}"}},
		{"name":"keywordname","unusual":true},
		{"name":"LocallyUseLanguage","arg":{"format":"{}{}","snippet":"LocallyUseLanguage{${1:language}}{${2:text}}"}},
		{"name":"ProjLibLanguageSet","arg":{"format":"{}{}{}","snippet":"ProjLibLanguageSet{${1:setting}}{${2:language or type}}{${3:value}}"}},
		{"name":"today","arg":{"format":"[]","snippet":"today[${1:options}]"}},
		{"name":"today"},
		{"name":"UseLanguage","arg":{"format":"{}","snippet":"UseLanguage{${1:language}}"}},
		{"name":"UseLanguageLocally","arg":{"format":"{}{}","snippet":"UseLanguageLocally{${1:language}}{${2:text}}"}},
		{"name":"UseOtherLanguage","arg":{"format":"{}{}","snippet":"UseOtherLanguage{${1:language}}{${2:text}}"}}
	],
	"envs": [
		{"name":"OtherLanguage","arg":{"format":"{}","snippet":"{${1:language}}"}}
	],
	"keys": {}
}
