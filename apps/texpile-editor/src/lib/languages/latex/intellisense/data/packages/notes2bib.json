{
	"deps": [{"name":"xparse"},{"name":"l3keys2e"}],
	"macros": [
		{"name":"bibnote","arg":{"format":"[]{}","snippet":"bibnote[${1:name}]{${2:text}}"}},
		{"name":"bibnote","arg":{"format":"{}","snippet":"bibnote{${1:text}}"}},
		{"name":"bibnotemark","arg":{"format":"[]","snippet":"bibnotemark[${1:name}]"}},
		{"name":"bibnotemark"},
		{"name":"bibnotesetup","arg":{"format":"{}","snippet":"bibnotesetup{${1:key-value list}}","keys":["l3keys:notes2bib"],"keyPos":0}},
		{"name":"bibnotetext","arg":{"format":"[]{}","snippet":"bibnotetext[${1:name}]{${2:text}}"}},
		{"name":"bibnotetext","arg":{"format":"{}","snippet":"bibnotetext{${1:text}}"}},
		{"name":"citenote","arg":{"format":"{}","snippet":"citenote{${1}}"},"unusual":true},
		{"name":"flushnotestack","unusual":true},
		{"name":"niibsetup","arg":{"format":"{}","snippet":"niibsetup{${1:key-value list}}"},"unusual":true},
		{"name":"NotesAfterCitations","arg":{"format":"{}","snippet":"NotesAfterCitations{${1}}"},"unusual":true},
		{"name":"NotesBeforeCitations","arg":{"format":"{}","snippet":"NotesBeforeCitations{${1}}"},"unusual":true},
		{"name":"printbibnotes"},
		{"name":"recordnotes","doc":"To force notes2bib to write the current out-of-order notes to the aux file, the macro \\recordnotes is available."},
		{"name":"TotalNotes","arg":{"format":"{}","snippet":"TotalNotes{${1}}"},"unusual":true}
	],
	"envs": [],
	"keys": {
		"l3keys:notes2bib": ["cite-function=","file-name=","keyword-entry=","note-field=","note-name=","presort-after=","presort-before=","presort-mixed=","record-type=","refsection-name=","refsection-separator=","sort-key-after=","sort-key-before=","sort-key-mixed=","convert-endnotes=${1|false,true|}","convert-footnotes=${1|false,true|}","placement=${1|after,before,mixed|}","use-sort-key=${1|false,true|}"],
		"\\usepackage/notes2bib#c": ["cite-function=","convert-endnotes=${1|false,true|}","convert-footnotes=${1|false,true|}","file-name=","keyword-entry=","note-field=","note-name=","placement=${1|after,before,mixed|}","presort-after=","presort-before=","presort-mixed=","record-type=","refsection-name=","refsection-separator=","sort-key-after=","sort-key-before=","sort-key-mixed=","use-sort-key=${1|false,true|}"]
	},
	"args": ["\\usepackage/notes2bib#c"]
}
