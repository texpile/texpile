{
	"deps": [{"name":"catoptions"},{"name":"iftex","engines":["lualatex"]}],
	"macros": [
		{"name":"currfam"},
		{"name":"currkey"},
		{"name":"currkeyval"},
		{"name":"currpref"},
		{"name":"currval"},
		{"name":"kve@checkbool","arg":{"format":"{}{}{}","snippet":"kve@checkbool{${1:value}}{${2:true text}}{${3:false text}}"}},
		{"name":"kve@checkchoice","arg":{"format":"{}{}{}","snippet":"kve@checkchoice{${1:test string}}{${2:nominations}}{${3:no match}}"},"doc":"The expandable command \\kve@checkchoice can be used to create choice keys as command keys."},
		{"name":"kve@definekeys","arg":{"format":"[]{}[]{}","snippet":"kve@definekeys[${1:prefix}]{${2:family}}[${3:macro prefix}]{${4:keys}}"},"doc":"In the keyval2e package, command, boolean, and choice keys can be created using only one command (\\kve@definekeys)."},
		{"name":"kve@definekeys","arg":{"format":"{}{}","snippet":"kve@definekeys{${1:family}}{${2:keys}}"},"doc":"In the keyval2e package, command, boolean, and choice keys can be created using only one command (\\kve@definekeys)."},
		{"name":"kve@definekeys*","arg":{"format":"[]{}[]{}","snippet":"kve@definekeys*[${1:prefix}]{${2:family}}[${3:macro prefix}]{${4:keys}}"},"doc":"In the keyval2e package, command, boolean, and choice keys can be created using only one command (\\kve@definekeys)."},
		{"name":"kve@definekeys*","arg":{"format":"{}{}","snippet":"kve@definekeys*{${1:family}}{${2:keys}}"},"doc":"In the keyval2e package, command, boolean, and choice keys can be created using only one command (\\kve@definekeys)."},
		{"name":"kve@keyvalerr"},
		{"name":"kve@setafterdefaults","arg":{"format":"[]{}[]{}","snippet":"kve@setafterdefaults[${1:prefix}]{${2:family}}[${3:keys to ignore}]{${4:key=value list}}"}},
		{"name":"kve@setafterdefaults","arg":{"format":"{}{}","snippet":"kve@setafterdefaults{${1:family}}{${2:key=value list}}"}},
		{"name":"kve@setdefaults","arg":{"format":"[]{}[]","snippet":"kve@setdefaults[${1:prefix}]{${2:family}}[${3:keys to ignore}]"}},
		{"name":"kve@setdefaults","arg":{"format":"{}","snippet":"kve@setdefaults{${1:family}}"}},
		{"name":"kve@setkeys","arg":{"format":"[]{}[]{}","snippet":"kve@setkeys[${1:prefix}]{${2:family}}[${3:keys to ignore}]{${4:key=value list}}"}},
		{"name":"kve@setkeys","arg":{"format":"{}{}","snippet":"kve@setkeys{${1:family}}{${2:key=value list}}"}},
		{"name":"kve@setwithdefaults","arg":{"format":"[]{}[]","snippet":"kve@setwithdefaults[${1:prefix}]{${2:family}}[${3:keys to ignore}]"}},
		{"name":"kve@setwithdefaults","arg":{"format":"{}","snippet":"kve@setwithdefaults{${1:family}}"}}
	],
	"envs": [],
	"keys": {}
}
