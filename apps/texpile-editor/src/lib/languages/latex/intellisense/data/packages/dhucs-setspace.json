{
	"deps": [{"name":"setspace"}],
	"macros": [
		{"name":"filedate","unusual":true},
		{"name":"filename","unusual":true},
		{"name":"fileversion","unusual":true},
		{"name":"hangulfspacing","unusual":true},
		{"name":"hangulspacing","unusual":true},
		{"name":"hangulverbspacing","unusual":true},
		{"name":"SetHangulspace","arg":{"format":"{}{}","snippet":"SetHangulspace{${1:main stretch}}{${2:narrow stretch}}"},"doc":"\\SetHangulspace 매크로 두 개의 인자를 취하여 첫번째 것을 기본 행간, 두번째 것을 좁은 행간 간격으로 한다. 인자는 모두 stretch 값이어야 한다. 예를 들면 \\SetHangulspace{1.3}{1.1}과 같은 방법으로 사용하며, 전처리부(preamble)에서만 사용한다."},
		{"name":"SetHangulVerbatimSpace","arg":{"format":"{}","snippet":"SetHangulVerbatimSpace{${1}}"},"unusual":true}
	],
	"envs": [],
	"keys": {
		"\\usepackage/dhucs-setspace#c": ["adjustfootnotesep","adjustverbatim","hangul","nofloatspacing","noquotespacing"]
	},
	"args": ["\\usepackage/dhucs-setspace#c"]
}
