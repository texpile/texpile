{
	"deps": [{"name":"xspace"},{"name":"fancybox","if":"framed|grey"},{"name":"color","if":"grey"},{"name":"bbding","if":"hand"}],
	"macros": [
		{"name":"filedate","unusual":true},
		{"name":"fileversion","unusual":true},
		{"name":"ifmenuoptionframed","unusual":true},
		{"name":"ifmenuoptiongrey","unusual":true},
		{"name":"ifmenuoptionhand","unusual":true},
		{"name":"menu","arg":{"format":"{}","snippet":"menu{${1:menu path}}"},"doc":"Menu.sty define a command \\menu{Programm!!Menu1!Command} and expand it to something like Programm=>Menu1->Command."},
		{"name":"menufolderentry","arg":{"format":"[]{}","snippet":"menufolderentry[${1:length}]{${2:text}}"}},
		{"name":"menufolderentry","arg":{"format":"{}","snippet":"menufolderentry{${1:text}}"}},
		{"name":"menuitem","arg":{"format":"[]{}","snippet":"menuitem[${1:length}]{${2:text}}"}},
		{"name":"menuitem","arg":{"format":"{}","snippet":"menuitem{${1:text}}"}},
		{"name":"menuitemactive","arg":{"format":"[]{}","snippet":"menuitemactive[${1:length}]{${2:text}}"}},
		{"name":"menuitemactive","arg":{"format":"{}","snippet":"menuitemactive{${1:text}}"}},
		{"name":"menuitemactivesymbol"},
		{"name":"menuitemlength"},
		{"name":"menumathsymbols","arg":{"format":"[]{}{}","snippet":"menumathsymbols[${1}]{${2}}{${3}}"}},
		{"name":"menumathsymbols","arg":{"format":"{}{}","snippet":"menumathsymbols{${1}}{${2}}"}},
		{"name":"menuoptionframedfalse","unusual":true},
		{"name":"menuoptionframedtrue","unusual":true},
		{"name":"menuoptiongreyfalse","unusual":true},
		{"name":"menuoptiongreytrue","unusual":true},
		{"name":"menuoptionhandfalse","unusual":true},
		{"name":"menuoptionhandtrue","unusual":true},
		{"name":"menusep"},
		{"name":"menuseparator","arg":{"format":"[]","snippet":"menuseparator[${1:length}]"}},
		{"name":"menuseparator"},
		{"name":"menusymbols","arg":{"format":"[]{}{}[]","snippet":"menusymbols[${1:start}]{${2:symbol for !}}{${3:symbol for !!}}[${4:end}]"},"doc":"If you want to replace the symbols, you can use \\menusymbols."},
		{"name":"menusymbols","arg":{"format":"{}{}","snippet":"menusymbols{${1:symbol for !}}{${2:symbol for !!}}"},"doc":"If you want to replace the symbols, you can use \\menusymbols."},
		{"name":"menutext","arg":{"format":"{}","snippet":"menutext{${1:text}}"}}
	],
	"envs": [
		{"name":"menufolder","arg":{"format":"[]{}","snippet":"[${1:length}]{${2:text}}"}},
		{"name":"menufolder","arg":{"format":"{}","snippet":"{${1:text}}"}}
	],
	"keys": {
		"\\usepackage/menu#c": ["framed","grey","hand"]
	},
	"args": ["\\usepackage/menu#c"]
}
