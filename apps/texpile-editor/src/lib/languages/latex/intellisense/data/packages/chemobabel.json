{
	"deps": [{"name":"verbatim"},{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"}],
	"macros": [
		{"name":"chemobabel","arg":{"format":"[]{}{}","snippet":"chemobabel[${1:options}]{${2:filename}}{${3:obabel options}}"}},
		{"name":"chemobabel","arg":{"format":"{}{}","snippet":"chemobabel{${1:filename}}{${2:obabel options}}"}},
		{"name":"chemobabel*","arg":{"format":"[]{}{}","snippet":"chemobabel*[${1:options}]{${2:filename}}{${3:obabel options}}"}},
		{"name":"chemobabel*","arg":{"format":"{}{}","snippet":"chemobabel*{${1:filename}}{${2:obabel options}}"}},
		{"name":"chemobabelimgdir","unusual":true},
		{"name":"smilesobabel","arg":{"format":"[]{}{}","snippet":"smilesobabel[${1:options}]{${2:SMILES notation}}{${3:obabel options}}"}},
		{"name":"smilesobabel","arg":{"format":"{}{}","snippet":"smilesobabel{${1:SMILES notation}}{${2:obabel options}}"}},
		{"name":"smilesobabel*","arg":{"format":"[]{}{}","snippet":"smilesobabel*[${1:options}]{${2:SMILES notation}}{${3:obabel options}}"}},
		{"name":"smilesobabel*","arg":{"format":"{}{}","snippet":"smilesobabel*{${1:SMILES notation}}{${2:obabel options}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/chemobabel#c": ["eps","extract","inkscape","inkscape-old","librsvg","nocrop","pdf"]
	},
	"args": ["\\usepackage/chemobabel#c"]
}
