{
	"macros": [
		{"name":"inserttocsection"},
		{"name":"inserttocsectionnumber"},
		{"name":"inserttocsubsection","doc":"\\inserttocsubsection inserts the table of contents version of the current subsection name. • \\inserttocsubsectionnumber inserts the number of the current subsection (in the table of contents)."},
		{"name":"inserttocsubsectionnumber"},
		{"name":"inserttocsubsubsection"},
		{"name":"inserttocsubsubsectionnumber"},
		{"name":"tableofcontents","arg":{"format":"[]","snippet":"tableofcontents[${1:options}]","keys":["beamerbasetoc:toc"],"keyPos":0}},
		{"name":"tableofcontents"}
	],
	"envs": [],
	"keys": {
		"beamerbasetoc:toc": ["currentsection","currentsubsection","firstsection=${1:section number}","hideallsubsections","hideothersubsections","lastsection=${1:section number}","part=${1:part number}","pausesections","pausesubsections","sections={${1:overlay specification}}","sectionstyle=${1:current}/${2:other}","subsectionstyle=${1:current}/${2:other in current}/${3:other}","subsubsectionstyle=${1:current}/${2:other in current}/${3:other in other}/${4:other}"]
	}
}
