{
	"deps": [{"name":"ifthen"}],
	"macros": [
		{"name":"nicefrac","arg":{"format":"[]{}{}","snippet":"nicefrac[${1:font command}]{${2:numerator}}{${3:denominator}}"}},
		{"name":"nicefrac","arg":{"format":"{}{}","snippet":"nicefrac{${1:numerator}}{${2:denominator}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/nicefrac#c": ["nice","ugly"]
	},
	"args": ["\\usepackage/nicefrac#c"]
}
