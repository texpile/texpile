{
	"macros": [
		{"name":"currentfontbaselineskip"},
		{"name":"currentfontsize"},
		{"name":"currentnormalsize"},
		{"name":"fontscalesetup","arg":{"format":"{}","snippet":"fontscalesetup{${1:key-value list}}","keys":["l3keys:fontscale"],"keyPos":0}},
