		{"name":"printsampletext*","arg":{"format":"{}","snippet":"printsampletext*{${1:text}}"},"doc":"Prints ⟨text⟩ in each font size ordered from \\tiny to \\Huge each followed by \\par. ⟨text⟩ can contain \\par tokens."},
		{"name":"setfontbaselineskip","arg":{"format":"{}","snippet":"setfontbaselineskip{${1:skip}}"},"doc":"Sets the font baselineskip to ⟨skip⟩."},
		{"name":"setfontsize","arg":{"format":"[]{}","snippet":"setfontsize[${1:skip}]{${2:dimen}}"},"doc":"Sets the font size to ⟨dimen⟩."},
		{"name":"setfontsize","arg":{"format":"{}","snippet":"setfontsize{${1:dimen}}"},"doc":"Sets the font size to ⟨dimen⟩."},
