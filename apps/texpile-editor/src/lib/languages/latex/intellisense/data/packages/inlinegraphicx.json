{
	"deps": [{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"}],
	"macros": [
		{"name":"inlinegraphics","arg":{"format":"[]<>{}","snippet":"inlinegraphics[${1:options}]<${2:includegraphics options}>{${3:image}}","keys":["l3keys:inlinegraphics"],"keyPos":0}},
		{"name":"inlinegraphics","arg":{"format":"<>{}","snippet":"inlinegraphics<${1:includegraphics options}>{${2:image}}"}},
		{"name":"inlinegraphics*","arg":{"format":"[]<>{}","snippet":"inlinegraphics*[${1:options}]<${2:includegraphics options}>{${3:image}}","keys":["l3keys:inlinegraphics"],"keyPos":0}},
		{"name":"inlinegraphics*","arg":{"format":"<>{}","snippet":"inlinegraphics*<${1:includegraphics options}>{${2:image}}"}},
		{"name":"inlinegraphicspath","arg":{"format":"{}","snippet":"inlinegraphicspath{${1:paths}}"},"doc":"\\inlinegraphicspath uses the same syntax as \\graphicspath and configures both simultaneously: the internal existence test and \\graphicspath from graphicx ."},
		{"name":"inlinegraphicxsetup","arg":{"format":"{}","snippet":"inlinegraphicxsetup{${1:options}}","keys":["l3keys:inlinegraphics"],"keyPos":0},"doc":"\\inlinegraphicxsetup configures only the internal existence test, without touching \\graphicspath ."},
		{"name":"safeincludegraphics","arg":{"format":"[]{}","snippet":"safeincludegraphics[${1:options}]{${2:file}}"}},
		{"name":"safeincludegraphics","arg":{"format":"{}","snippet":"safeincludegraphics{${1:file}}"}}
	],
	"envs": [],
	"keys": {
		"l3keys:inlinegraphics": ["dummy=","extensions=","scale","searchpath=","strut"],
		"\\usepackage/inlinegraphicx#c": ["inherit=${1|false,true|}","inherit=${1|true,false|}"]
	},
	"args": ["\\usepackage/inlinegraphicx#c"]
}
