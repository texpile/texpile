{
	"deps": [{"name":"ctib"},{"name":"rotating"},{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"},{"name":"ifthen"}],
	"macros": [
		{"name":"chapter","arg":{"format":"{}","snippet":"chapter{${1}}"}},
		{"name":"evenleft","arg":{"format":"{}","snippet":"evenleft{${1:text}}"}},
		{"name":"evenright","arg":{"format":"{}","snippet":"evenright{${1:text}}"}},
		{"name":"maketitle","doc":"This adds a title page with the contents defined in the \\title macro."},
		{"name":"newsheet","doc":"Begin a new sheet."},
		{"name":"oddleft","arg":{"format":"{}{}","snippet":"oddleft{${1:text left of sheet number}}{${2:text right of sheet number}}"},"doc":"\\oddleft is used with two parameters, which contain the text left and right of the sheet number."},
		{"name":"oddright","arg":{"format":"{}","snippet":"oddright{${1:text}}"}},
		{"name":"paragraph","arg":{"format":"{}","snippet":"paragraph{${1}}"}},
		{"name":"part","arg":{"format":"{}","snippet":"part{${1}}"}},
		{"name":"section","arg":{"format":"{}","snippet":"section{${1}}"}},
		{"name":"subparagraph","arg":{"format":"{}","snippet":"subparagraph{${1}}"}},
		{"name":"subsection","arg":{"format":"{}","snippet":"subsection{${1}}"}},
		{"name":"subsubsection","arg":{"format":"{}","snippet":"subsubsection{${1}}"}},
		{"name":"thepage"},
		{"name":"thepechasheet","unusual":true},
		{"name":"tibnumeral","arg":{"format":"{}","snippet":"tibnumeral{${1}}"}},
		{"name":"tibsmall","arg":{"format":"{}","snippet":"tibsmall{${1:text}}"},"doc":"Comments can be printed in footnotesize using this simple makro."}
	],
	"envs": [
		{"name":"titlepage","unusual":true}
	],
	"keys": {
		"\\documentclass/pecha#c": ["10pt","11pt","12pt","8pt","9pt","a4paper","a4pecha2","a4pecha3","a5paper","a5pecha2","a5pecha3","b5paper","b5pecha2","b5pecha3","doubleframe","executivepaper","extrawide","fancyframe","legalpaper","legalpecha2","legalpecha3","letterpaper","letterpecha2","letterpecha3","mediumpage","narrowpage","rotate","septitle","simplefram","widepage"]
	},
	"args": ["\\documentclass/pecha#c"]
}
