		{"name":"delimiterprefix","arg":{"format":"{}","snippet":"delimiterprefix{${1:prefix}}"}},
		{"name":"delimiterscale"},
		{"name":"ignorelimits"},
		{"name":"includelimits"},
		{"name":"lleft"},
		{"name":"longmathlinesep"},
		{"name":"mleft"},
		{"name":"mmbin"},
		{"name":"mmiddle"},
		{"name":"mmop"},
		{"name":"mmord"},
		{"name":"mmpunct"},
		{"name":"mmrel"},
