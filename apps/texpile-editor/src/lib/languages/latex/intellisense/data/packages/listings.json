		{"name":"lstMakeShortInline","arg":{"format":"[]","snippet":"lstMakeShortInline[${1:options}]","keys":["keyval:lst"],"keyPos":0},"doc":"defines ⟨character⟩ to be an equivalent of \\lstinline[[⟨options⟩]]⟨character⟩, allowing for a convenient syntax when using lots of inline listings."},
		{"name":"lstMakeShortInline","doc":"defines ⟨character⟩ to be an equivalent of \\lstinline[[⟨options⟩]]⟨character⟩, allowing for a convenient syntax when using lots of inline listings."},
		{"name":"lstname","doc":"prints the name of the current listing which is either the file name or the name defined by the name key."},
		{"name":"lstnewenvironment","arg":{"format":"{}[][]{}{}","snippet":"lstnewenvironment{${1:name}}[${2:number}][${3:default of first argument}]{${4:starting code}}{${5:ending code}}"}},
		{"name":"lstnewenvironment","arg":{"format":"{}{}{}","snippet":"lstnewenvironment{${1:name}}{${2:starting code}}{${3:ending code}}"}},
		{"name":"lstset","arg":{"format":"{}","snippet":"lstset{${1:key=value list}}","keys":["keyval:lst"],"keyPos":0}},
		{"name":"lststylefiles","unusual":true},
		{"name":"thelstlisting","unusual":true}
	],
