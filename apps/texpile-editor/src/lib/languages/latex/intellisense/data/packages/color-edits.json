{
	"deps": [{"name":"color"},{"name":"etoolbox"},{"name":"pdfcol"},{"name":"iftex"}],
	"macros": [
		{"name":"addauthor","arg":{"format":"[]{}{}","snippet":"addauthor[${1:auth-name}]{${2:auth}}{${3:auth-color}}"}},
		{"name":"addauthor","arg":{"format":"{}{}","snippet":"addauthor{${1:auth}}{${2:auth-color}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/color-edits#c": ["inlinedeletions","revert","showdeletions","suppress"]
	},
	"args": ["\\usepackage/color-edits#c"]
}
