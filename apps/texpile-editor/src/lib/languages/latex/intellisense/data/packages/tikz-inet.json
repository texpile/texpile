{
	"deps": [{"name":"tikz"},{"name":"pgf"},{"name":"pgfrcs"},{"name":"pgfcore"},{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"},{"name":"pgfsys"},{"name":"xcolor"},{"name":"pgfcomp-version-0-65"},{"name":"pgfcomp-version-1-18"},{"name":"pgffor"},{"name":"pgfkeys"},{"name":"pgfmath"},{"name":"ifthen"}],
	"macros": [
		{"name":"inetbox","arg":{"format":"[]{}()","snippet":"inetbox[${1:tikz extra display keys}]{${2:cells}}(${3:box node name})","keys":["pgfkeys:/tikz"],"keyPos":0}},
		{"name":"inetbox","arg":{"format":"{}()","snippet":"inetbox{${1:cells}}(${2:box node name})"}},
		{"name":"inetboxstyle"},
		{"name":"inetcell","arg":{"format":"[](){}[]","snippet":"inetcell[${1:tikz display keys}](${2:node name}){${3:symbol}}[${4:angle}]","keys":["pgfkeys:/tikz"],"keyPos":0}},
		{"name":"inetcell","arg":{"format":"(){}","snippet":"inetcell(${1:node name}){${2:symbol}}"}},
		{"name":"inetcellstyle"},
		{"name":"inetcolor"},
		{"name":"inetfancy"},
		{"name":"inetloop","arg":{"format":"[]","snippet":"inetloop[${1:tikz extra display keys}]","keys":["pgfkeys:/tikz"],"keyPos":0}},
		{"name":"inetloop"},
		{"name":"inetnofancy"},
		{"name":"inetoptions","arg":{"format":"{}","snippet":"inetoptions{${1:key list}}","keys":["keyval:inet"],"keyPos":0},"unusual":true},
		{"name":"inetprombox","arg":{"format":"[]{}()","snippet":"inetprombox[${1:tikz extra display keys}]{${2:cells}}(${3:promotion cell node name})","keys":["pgfkeys:/tikz"],"keyPos":0}},
		{"name":"inetprombox","arg":{"format":"{}()","snippet":"inetprombox{${1:cells}}(${2:promotion cell node name})"}},
		{"name":"inetsetfancycellstyle","arg":{"format":"{}","snippet":"inetsetfancycellstyle{${1}}"},"unusual":true},
		{"name":"inetsetfancywirestyle","arg":{"format":"{}","snippet":"inetsetfancywirestyle{${1}}"},"unusual":true},
		{"name":"inetwire","arg":{"format":"[]()()","snippet":"inetwire[${1:tikz extra display keys}](${2:cell1.port1})(${3:cell2.port2})","keys":["pgfkeys:/tikz"],"keyPos":0},"doc":"The arguments are self-explanatory: this wire will connect the port port1 of cell1 with the port port2 of cell2."},
		{"name":"inetwire","arg":{"format":"()()","snippet":"inetwire(${1:cell1.port1})(${2:cell2.port2})"},"doc":"The arguments are self-explanatory: this wire will connect the port port1 of cell1 with the port port2 of cell2."},
		{"name":"inetwirecoords","arg":{"format":"()()","snippet":"inetwirecoords(${1:node A})(${2:node B})"},"doc":"draws a wire from node A to node B with the current wire style."},
		{"name":"inetwirefree","arg":{"format":"[]()","snippet":"inetwirefree[${1:tikz extra display keys}](${2:cell.port})","keys":["pgfkeys:/tikz"],"keyPos":0},"doc":"draws a wire from port of cell to above port of the same cell, with the current wire style."},
		{"name":"inetwirefree","arg":{"format":"()","snippet":"inetwirefree(${1:cell.port})"},"doc":"draws a wire from port of cell to above port of the same cell, with the current wire style."},
		{"name":"inetwirestyle"}
	],
	"envs": [],
	"keys": {
		"keyval:inet": ["color=","defaultangle="],
		"pgfkeys:/pgf": ["arity="],
		"pgfkeys:/tikz": ["boxstyle=","cellstyle=","fancyboxstyle=","fancycellstyle=","fancywirestyle=","wirestyle="],
		"\\usepackage/tikz-inet#c": ["color=","defaultangle=","fancy","nofancy"]
	},
	"args": ["\\usepackage/tikz-inet#c"]
}
