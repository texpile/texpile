{
	"deps": [{"name":"array"}],
	"macros": [
		{"name":"botstrut"},
		{"name":"bottopstrut"},
		{"name":"cellalign"},
		{"name":"cellgape"},
		{"name":"cellrotangle","doc":"The angle for rotated cells and column heads."},
		{"name":"cellset","doc":"Spacing settings for cells."},
		{"name":"diaghead","arg":{"format":"(){}{}{}","snippet":"diaghead(${1:H ratio,V ratio}){${2:text for column width}}{${3:first head}}{${4:second head}}"}},
		{"name":"eline","arg":{"format":"{}","snippet":"eline{${1:number of cells}}"}},
		{"name":"erows","arg":{"format":"[]{}{}","snippet":"erows[${1:separator}]{${2:row content}}{${3:number of rows}}"},"doc":"Lazy macros for filling few rows."},
		{"name":"erows","arg":{"format":"{}{}","snippet":"erows{${1:row content}}{${2:number of rows}}"},"doc":"Lazy macros for filling few rows."},
		{"name":"gape","arg":{"format":"[]{}","snippet":"gape[${1:t or b}]{${2:text}}"},"doc":"The \\gape macro allows to change height and/or depth of included box with necessary dimension."},
		{"name":"gape","arg":{"format":"{}","snippet":"gape{${1:text}}"},"doc":"The \\gape macro allows to change height and/or depth of included box with necessary dimension."},
		{"name":"Gape","arg":{"format":"[][]{}","snippet":"Gape[${1:height correction}][${2:depth correction}]{${3:text}}"}},
		{"name":"Gape","arg":{"format":"{}","snippet":"Gape{${1:text}}"}},
		{"name":"makecell","arg":{"format":"[]{}","snippet":"makecell[${1:alignment}]{${2:cell text}}"}},
		{"name":"makecell","arg":{"format":"{}","snippet":"makecell{${1:cell text}}"}},
		{"name":"makecell*","arg":{"format":"[]{}","snippet":"makecell*[${1:alignment}]{${2:cell text}}"}},
		{"name":"makecell*","arg":{"format":"{}","snippet":"makecell*{${1:cell text}}"}},
		{"name":"makecellbox","arg":{"format":"[]{}","snippet":"makecellbox[${1:alignment}]{${2:cell text}}"},"doc":"The \\makecellbox command and mcellbox environment are created for one-column tabulars in the text."},
		{"name":"makecellbox","arg":{"format":"{}","snippet":"makecellbox{${1:cell text}}"},"doc":"The \\makecellbox command and mcellbox environment are created for one-column tabulars in the text."},
		{"name":"makegapedcells","doc":"macro \\makegapedcells, which changes vertical spaces around all cells in tabular, like in tabls package, but uses code of array package."},
		{"name":"multirowcell","arg":{"format":"{}[][]{}","snippet":"multirowcell{${1:number of rows}}[${2:vertical move}][${3:horizontal alignment}]{${4:contents}}"}},
		{"name":"multirowcell","arg":{"format":"{}{}","snippet":"multirowcell{${1:number of rows}}{${2:contents}}"}},
		{"name":"multirowthead","arg":{"format":"{}[][]{}","snippet":"multirowthead{${1:number of rows}}[${2:vertical move}][${3:horizontal alignment}]{${4:contents}}"}},
		{"name":"multirowthead","arg":{"format":"{}{}","snippet":"multirowthead{${1:number of rows}}{${2:contents}}"}},
		{"name":"nline","arg":{"format":"[][]{}","snippet":"nline[${1:numbering type}][${2:start number}]{${3:number of cells}}"}},
		{"name":"nline","arg":{"format":"{}","snippet":"nline{${1:number of cells}}"}},
		{"name":"nomakegapedcells"},
		{"name":"rnline","arg":{"format":"[][]{}","snippet":"rnline[${1:numbering type}][${2:start number}]{${3:number of cells}}"}},
		{"name":"rnline","arg":{"format":"{}","snippet":"rnline{${1:number of cells}}"}},
		{"name":"rotcell","arg":{"format":"[]{}","snippet":"rotcell[${1:alignment}]{${2:cell text}}"}},
		{"name":"rotcell","arg":{"format":"{}","snippet":"rotcell{${1:cell text}}"}},
		{"name":"rothead","arg":{"format":"[]{}","snippet":"rothead[${1:alignment}]{${2:head text}}"}},
		{"name":"rothead","arg":{"format":"{}","snippet":"rothead{${1:head text}}"}},
		{"name":"rotheadgape"},
		{"name":"rotheadsize"},
		{"name":"setcellgapes","arg":{"format":"[]{}","snippet":"setcellgapes[${1:t or b}]{${2:value}}"}},
		{"name":"setcellgapes","arg":{"format":"{}","snippet":"setcellgapes{${1:value}}"}},
		{"name":"thead","arg":{"format":"[]{}","snippet":"thead[${1:alignment}]{${2:head text}}"}},
		{"name":"thead","arg":{"format":"{}","snippet":"thead{${1:head text}}"}},
		{"name":"thead*","arg":{"format":"[]{}","snippet":"thead*[${1:alignment}]{${2:head text}}"}},
		{"name":"thead*","arg":{"format":"{}","snippet":"thead*{${1:head text}}"}},
		{"name":"theadalign"},
		{"name":"theadfont"},
		{"name":"theadgape"},
		{"name":"theadset"},
		{"name":"topstrut"},
		{"name":"Xcline","arg":{"format":"{}{}","snippet":"Xcline{${1:columns}}{${2:thickness}}"}},
		{"name":"Xhline","arg":{"format":"{}","snippet":"Xhline{${1:thickness}}"}},
		{"name":"Xrows","arg":{"format":"{}{}","snippet":"Xrows{${1:row content}}{${2:number of rows}}"}}
	],
	"envs": [
		{"name":"mcellbox","arg":{"format":"[]","snippet":"[${1}]"},"doc":"The \\makecellbox command and mcellbox environment are created for one-column tabulars in the text."},
		{"name":"mcellbox","doc":"The \\makecellbox command and mcellbox environment are created for one-column tabulars in the text."}
	],
	"keys": {}
}
