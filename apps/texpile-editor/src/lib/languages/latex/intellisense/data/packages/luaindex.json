{
	"deps": [{"name":"ifluatex"},{"name":"iftex"},{"name":"luatexbase"},{"name":"scrbase"},{"name":"scrlfile"},{"name":"scrlfile-hook"},{"name":"scrlogo"},{"name":"keyval"}],
	"macros": [
		{"name":"alsoname"},
		{"name":"index","arg":{"format":"[]{}","snippet":"index[${1:options}]{${2:entry}}"}},
		{"name":"index","arg":{"format":"{}","snippet":"index{${1:entry}}"}},
		{"name":"indexgroup","arg":{"format":"{}","snippet":"indexgroup{${1:group}}"}},
		{"name":"indexpagenumber","arg":{"format":"{}","snippet":"indexpagenumber{${1:page number}}"},"doc":"Each single page number is printed as argument of \\indexpagenumber{⟨page number⟩}."},
		{"name":"indexpagenumbers","arg":{"format":"{}","snippet":"indexpagenumbers{${1:page numbers}}"}},
		{"name":"indexpagenumbersep"},
		{"name":"luaindex","arg":{"format":"{}[]{}","snippet":"luaindex{${1:index name}}[${2:options}]{${3:entry}}"}},
		{"name":"luaindex","arg":{"format":"{}{}","snippet":"luaindex{${1:index name}}{${2:entry}}"}},
		{"name":"luasubindex","arg":{"format":"{}[]{}[]{}","snippet":"luasubindex{${1:index name}}[${2:options}]{${3:entry}}[${4:options}]{${5:sub-entry}}"}},
		{"name":"luasubindex","arg":{"format":"{}{}{}","snippet":"luasubindex{${1:index name}}{${2:entry}}{${3:sub-entry}}"}},
		{"name":"luasubsubindex","arg":{"format":"{}[]{}[]{}[]{}","snippet":"luasubsubindex{${1:index name}}[${2:options}]{${3:entry}}[${4:options}]{${5:sub-entry}}[${6:options}]{${7:sub-sub-entry}}"}},
		{"name":"luasubsubindex","arg":{"format":"{}{}{}{}","snippet":"luasubsubindex{${1:index name}}{${2:entry}}{${3:sub-entry}}{${4:sub-sub-entry}}"}},
		{"name":"newindex","arg":{"format":"[]{}","snippet":"newindex[${1:index options}]{${2:index name}}"}},
		{"name":"newindex","arg":{"format":"{}","snippet":"newindex{${1:index name}}"}},
		{"name":"numbersname"},
		{"name":"printindex","arg":{"format":"[]","snippet":"printindex[${1:options}]"}},
		{"name":"printindex"},
		{"name":"see","arg":{"format":"{}{}","snippet":"see{${1:reference}}{${2:page}}"}},
		{"name":"seealso","arg":{"format":"{}{}","snippet":"seealso{${1:reference}}{${2:page}}"}},
		{"name":"seename"},
		{"name":"setupluaindex","arg":{"format":"{}","snippet":"setupluaindex{${1:options}}"},"doc":"This is only an convenience command for run time setup of luadindex options."},
		{"name":"subindex","arg":{"format":"[]{}[]{}","snippet":"subindex[${1:options}]{${2:entry}}[${3:options}]{${4:sub-entry}}"}},
		{"name":"subindex","arg":{"format":"{}{}","snippet":"subindex{${1:entry}}{${2:sub-entry}}"}},
		{"name":"subsubindex","arg":{"format":"[]{}[]{}[]{}","snippet":"subsubindex[${1:options}]{${2:entry}}[${3:options}]{${4:sub-entry}}[${5:options}]{${6:sub-sub-entry}}"}},
		{"name":"subsubindex","arg":{"format":"{}{}{}","snippet":"subsubindex{${1:entry}}{${2:sub-entry}}{${3:sub-sub-entry}}"}},
		{"name":"symbolsname"}
	],
	"envs": [],
	"keys": {}
}
