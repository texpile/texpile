{
	"deps": [{"name":"xkeyval"},{"name":"iftex"},{"name":"xpatch"},{"name":"xparse"},{"name":"etoolbox"},{"name":"multicol","if":"!original"}],
	"macros": [
		{"name":"alsoname"},
		{"name":"index","arg":{"format":"[]{}","snippet":"index[${1:name}]{${2:entry}}"}},
		{"name":"index","arg":{"format":"{}","snippet":"index{${1:entry}}"}},
		{"name":"indexprologue","arg":{"format":"[]{}","snippet":"indexprologue[${1:spacing}]{${2:text}}"}},
		{"name":"indexprologue","arg":{"format":"{}","snippet":"indexprologue{${1:text}}"}},
		{"name":"indexsetup","arg":{"format":"{}","snippet":"indexsetup{${1:key-values}}","keys":["keyval:indtlindex"],"keyPos":0}},
		{"name":"innote","arg":{"format":"{}","snippet":"innote{${1:page}}"}},
		{"name":"innotenumber","arg":{"format":"{}{}","snippet":"innotenumber{${1:note number}}{${2:page}}"}},
		{"name":"makeindex","arg":{"format":"[]","snippet":"makeindex[${1:key-values}]","keys":["keyval:indtl"],"keyPos":0}},
		{"name":"makeindex"},
		{"name":"printindex","arg":{"format":"[]","snippet":"printindex[${1:name}]"}},
		{"name":"printindex"},
		{"name":"see","arg":{"format":"{}{}","snippet":"see{${1}}{${2}}"},"unusual":true},
		{"name":"seealso","arg":{"format":"{}{}","snippet":"seealso{${1}}{${2}}"},"unusual":true},
		{"name":"seename"},
		{"name":"splitindexoptions","arg":{"format":"{}","snippet":"splitindexoptions{${1:options}}"},"doc":"\\splitindexoptions must have as its argument the command line option to splitindex; this might be necessary on some systems."}
	],
	"envs": [],
	"keys": {
		"keyval:indtl": ["columns=","columnsep=","columnseprule","columnseprulefalse=","columnsepruletrue=","intoc","intocfalse=","intoctrue=","name=","noautomatic","noautomaticfalse=","noautomatictrue=","options=","program=","title=","program=${1|makeindex,xindy,texindy,truexindy,upmendex,xindex|}"],
		"keyval:indtlindex": ["firstpagestyle=","headers=","level=","noclearpage","noclearpagefalse=","noclearpagetrue=","othercode=","toclevel="],
		"\\usepackage/indextools#c": ["afterindex","innote","makeindex","noautomatic","nonewpage","notenumber","original","quiet","splitindex","texindy","truexindy","upmendex","xindex","xindy"]
	},
	"args": ["\\usepackage/indextools#c"]
}
