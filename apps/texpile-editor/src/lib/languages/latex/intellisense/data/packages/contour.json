{
	"deps": [{"name":"color"},{"name":"trig"}],
	"macros": [
		{"name":"contour","arg":{"format":"[]{}{}","snippet":"contour[${1:number}]{${2:color}}{${3:text}}"}},
		{"name":"contour","arg":{"format":"{}{}","snippet":"contour{${1:color}}{${2:text}}"}},
		{"name":"contour*","arg":{"format":"[]{}{}","snippet":"contour*[${1:number}]{${2:color}}{${3:text}}"}},
		{"name":"contour*","arg":{"format":"{}{}","snippet":"contour*{${1:color}}{${2:text}}"}},
		{"name":"contourlength","arg":{"format":"{}","snippet":"contourlength{${1:length}}"}},
		{"name":"contournumber","arg":{"format":"{}","snippet":"contournumber{${1:number}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/contour#c": ["auto","copies","dvips","dvipsone","outline","pdftex","vtex","xdvi"]
	},
	"args": ["\\usepackage/contour#c"]
}
