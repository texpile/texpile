{
	"deps": [{"name":"simplekv"}],
	"macros": [
		{"name":"addtok","arg":{"format":"{}","snippet":"addtok{${1:code}}"}},
		{"name":"defpattern","arg":{"format":"{}{}","snippet":"defpattern{${1:pattern name}}{${2:patterns}}"}},
		{"name":"deltok"},
		{"name":"ifpegmatch","arg":{"format":"[]{}{}{}{}","snippet":"ifpegmatch[${1:keys}]{${2:patterns}}{${3:tokens}}{${4:code if match}}{${5:code if no match}}"}},
		{"name":"ifpegmatch","arg":{"format":"{}{}{}{}","snippet":"ifpegmatch{${1:patterns}}{${2:tokens}}{${3:code if match}}{${4:code if no match}}"}},
		{"name":"pegcount","arg":{"format":"[]{}{}","snippet":"pegcount[${1:keys}]{${2:patterns}}{${3:tokens}}"}},
		{"name":"pegcount","arg":{"format":"{}{}","snippet":"pegcount{${1:patterns}}{${2:tokens}}"}},
		{"name":"pegreplace","arg":{"format":"[]{}{}","snippet":"pegreplace[${1:keys}]{${2:patterns and replacements}}{${3:tokens}}"}},
		{"name":"pegreplace","arg":{"format":"{}{}","snippet":"pegreplace{${1:patterns and replacements}}{${2:tokens}}"}},
		{"name":"poscapture","arg":{"format":"{}","snippet":"poscapture{${1:index}}"}},
		{"name":"printtoks","arg":{"format":"[]{}","snippet":"printtoks[${1:keys}]{${2:tokens}}"},"doc":"displays tokens with their charcode and catcode below."},
		{"name":"printtoks","arg":{"format":"{}","snippet":"printtoks{${1:tokens}}"},"doc":"displays tokens with their charcode and catcode below."},
		{"name":"self","doc":"In most cases, \\self represents a single token: the one currently being processed."},
		{"name":"selfcatcode"},
		{"name":"selfcharcode"},
		{"name":"selfindex"},
		{"name":"setcatcode","arg":{"format":"{}","snippet":"setcatcode{${1:expression}}"}},
		{"name":"setcharcode","arg":{"format":"{}","snippet":"setcharcode{${1:expression}}"}},
		{"name":"tktldate","unusual":true},
		{"name":"tktlname","unusual":true},
		{"name":"tktlver","unusual":true},
		{"name":"tokscapture","arg":{"format":"{}","snippet":"tokscapture{${1:index}}"}},
		{"name":"tokscount","arg":{"format":"[]{}{}","snippet":"tokscount[${1:keys}]{${2:patterns}}{${3:tokens}}"}},
		{"name":"tokscount","arg":{"format":"{}{}","snippet":"tokscount{${1:patterns}}{${2:tokens}}"}},
		{"name":"toksdo","arg":{"format":"[]{}{}","snippet":"toksdo[${1:keys}]{${2:patterns and code}}{${3:tokens}}"}},
		{"name":"toksdo","arg":{"format":"{}{}","snippet":"toksdo{${1:patterns and code}}{${2:tokens}}"}},
		{"name":"tokslen"}
	],
	"envs": [],
	"keys": {}
}
