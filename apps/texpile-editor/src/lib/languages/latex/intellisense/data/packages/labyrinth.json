{
	"deps": [{"name":"calc"},{"name":"xkeyval"}],
	"macros": [
		{"name":"autosolution","arg":{"format":"[]()(){}","snippet":"autosolution[${1:options}](${2:xA,yA})(${3:xB,yB}){${4:first direction}}","keys":["keyval:solution"],"keyPos":0}},
		{"name":"autosolution","arg":{"format":"()(){}","snippet":"autosolution(${1:xA,yA})(${2:xB,yB}){${3:first direction}}"}},
		{"name":"h"},
		{"name":"labyrinthset","arg":{"format":"{}","snippet":"labyrinthset{${1:options}}","keys":["keyval:labyrinth"],"keyPos":0}},
		{"name":"labyrinthsolution","arg":{"format":"[](){}","snippet":"labyrinthsolution[${1:options}](${2:x,y}){${3:solution code}}","keys":["keyval:solution"],"keyPos":0}},
		{"name":"labyrinthsolution","arg":{"format":"(){}","snippet":"labyrinthsolution(${1:x,y}){${2:solution code}}"}},
		{"name":"minus","math":true,"detail":"−","doc":"minus sign"},
		{"name":"plus"},
		{"name":"putsymbol","arg":{"format":"(){}","snippet":"putsymbol(${1:h-pos,v-pos}){${2:symbol}}"}},
		{"name":"solutionpath","doc":"The \\autosolution command also defines \\solutionpath, which generates the string of direction-characters that defines the solution path."},
		{"name":"solutionset","arg":{"format":"{}","snippet":"solutionset{${1:options}}","keys":["keyval:solution"],"keyPos":0}},
		{"name":"v"}
	],
	"envs": [
		{"name":"labyrinth","arg":{"format":"[]{}{}","snippet":"[${1:options}]{${2:width}}{${3:height}}","keys":["keyval:labyrinth"],"keyPos":0}},
		{"name":"labyrinth","arg":{"format":"{}{}","snippet":"{${1:width}}{${2:height}}"}}
	],
	"keys": {
		"keyval:labyrinth": ["thickness=","unit=","centered=${1|true,false|}"],
		"keyval:solution": ["down=","font=","hcorr=","left=","right=","up=","vcorr=","hidden=${1|true,false|}","thicklines=${1|true,false|}"]
	}
}
