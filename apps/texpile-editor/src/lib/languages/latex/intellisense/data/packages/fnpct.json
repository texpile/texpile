{
	"deps": [{"name":"l3keys2e"},{"name":"translations"},{"name":"etoolbox"},{"name":"iftex"}],
	"macros": [
		{"name":"AdaptNote","arg":{"format":"{}{}[]{}","snippet":"AdaptNote{${1:\\cs}}{${2:arguments}}[${3:counter name}]{${4:code}}"},"doc":"The command \\AdaptNote can be used multiple times on the same command in order to change a previous redefinition."},
		{"name":"AdaptNote","arg":{"format":"{}{}{}","snippet":"AdaptNote{${1:\\cs}}{${2:arguments}}{${3:code}}"},"doc":"The command \\AdaptNote can be used multiple times on the same command in order to change a previous redefinition."},
		{"name":"AdaptNoteName","arg":{"format":"{}{}[]{}","snippet":"AdaptNoteName{${1:csname}}{${2:arguments}}[${3:counter name}]{${4:code}}"}},
		{"name":"AdaptNoteName","arg":{"format":"{}{}{}","snippet":"AdaptNoteName{${1:csname}}{${2:arguments}}{${3:code}}"}},
		{"name":"AdaptText","arg":{"format":"{}{}{}","snippet":"AdaptText{${1}}{${2}}{${3}}"},"unusual":true},
		{"name":"AddPunctuation","arg":{"format":"[]{}[]{}","snippet":"AddPunctuation[${1:before}]{${2:token}}[${3:after}]{${4:name}}"}},
		{"name":"AddPunctuation","arg":{"format":"{}{}","snippet":"AddPunctuation{${1:token}}{${2:name}}"}},
		{"name":"ifcurrentnoteF","arg":{"format":"{}","snippet":"ifcurrentnoteF{${1}}"},"unusual":true},
		{"name":"ifcurrentnoteT","arg":{"format":"{}","snippet":"ifcurrentnoteT{${1}}"},"unusual":true},
		{"name":"ifcurrentnoteTF","arg":{"format":"{}","snippet":"ifcurrentnoteTF{${1}}"},"unusual":true},
		{"name":"innernote","arg":{"format":"{}","snippet":"innernote{${1}}"},"unusual":true},
		{"name":"multfootnote","arg":{"format":"{}","snippet":"multfootnote{${1:list;of;footnotes}}"},"if":"multiple","doc":"This command splits its content at every occurrence of ; and creates a footnote for each."},
		{"name":"multfootnote*","arg":{"format":"{}","snippet":"multfootnote*{${1:list;of;footnotes}}"},"if":"multiple","doc":"This command splits its content at every occurrence of ; and creates a footnote for each."},
		{"name":"multfootrange","doc":"In its default definition this command simply expands to an endash."},
		{"name":"multfootsep","doc":"In its default definition this command simply expands to a comma."},
		{"name":"MultVariant","arg":{"format":"{}","snippet":"MultVariant{${1:\\cs}}"},"doc":"Defines a command \\multcs which splits is argument at each occurence of the token set by the option mult-fn-delim and turns it into a series of calls of \\cs."},
		{"name":"MultVariantName","arg":{"format":"{}","snippet":"MultVariantName{${1:csname}}"}},
		{"name":"setfnpct","arg":{"format":"{}","snippet":"setfnpct{${1:options}}","keys":["l3keys:fnpct"],"keyPos":0}}
	],
	"envs": [],
	"keys": {
		"l3keys:fnpct": ["activate-trailing-tokens=","add-trailing-token=","after-comma-space=","after-dot-space=","after-punct-space=","before-comma-space=","before-dot-space=","before-footnote-space=","before-punct-space=","deactivate-trailing-tokens=","mult-fn-delim=","mult-variant-prefix=","print-range=","print-separation=","range-symbol=","separation-symbol=","dont-mess-around=${1|true,false|}","keep-ranges=${1|true,false|}","ranges=${1|true,false|}","reverse=${1|true,false|}","unspace=${1|true,false|}"],
		"\\usepackage/fnpct#c": ["dont-mess-around=${1|true,false|}","multiple=${1|true,false|}"]
	},
	"args": ["\\usepackage/fnpct#c"]
}
