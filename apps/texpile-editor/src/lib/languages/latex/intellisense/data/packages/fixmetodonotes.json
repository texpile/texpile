		{"name":"listnotesname"},
		{"name":"listofnotes","doc":"The list of notes will be shown like a table of content or a list of figures."},
		{"name":"TODO","arg":{"format":"{}","snippet":"TODO{${1:text}}"}}
	],
	"envs": [],
