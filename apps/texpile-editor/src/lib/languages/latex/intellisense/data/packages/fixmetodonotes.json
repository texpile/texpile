{
	"deps": [{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"},{"name":"color"},{"name":"transparent"},{"name":"transparent-nometadata"},{"name":"iftex"},{"name":"auxhook","engines":["pdflatex","lualatex"]},{"name":"watermark","if":"!nowatermark"},{"name":"ulem"},{"name":"tocloft"},{"name":"etoolbox"}],
