		{"name":"dmc","arg":{"format":"{}{}","snippet":"dmc{${1:name}}{${2:style}}"}},
		{"name":"dmcformat","arg":{"format":"[]{}{}","snippet":"dmcformat[${1:calendar}]{${2:name}}{${3:pattern}}"}},
