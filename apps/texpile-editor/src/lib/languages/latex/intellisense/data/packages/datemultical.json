		{"name":"dmcnew","arg":{"format":"[]{}{}","snippet":"dmcnew[${1:calendar}]{${2:name}}{${3:key=value}}"},"doc":"The command \\dmcnew is available only with LuaLATEX. It creates and stores a named date using calendar-specific key–value pairs."},
		{"name":"dmcnew","arg":{"format":"{}{}","snippet":"dmcnew{${1:name}}{${2:key=value}}"},"doc":"The command \\dmcnew is available only with LuaLATEX. It creates and stores a named date using calendar-specific key–value pairs."},
		{"name":"dmcset","arg":{"format":"[]{}{}{}{}","snippet":"dmcset[${1:calendar}]{${2:name}}{${3:year}}{${4:month}}{${5:day}}"}},
