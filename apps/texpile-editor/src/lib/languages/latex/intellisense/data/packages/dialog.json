{
	"deps": [{"name":"grabhedr"}],
	"macros": [
		{"name":"actively","arg":{"format":"{}{}","snippet":"actively{${1}}{${2}}"},"unusual":true},
		{"name":"changecase","arg":{"format":"{}{}","snippet":"changecase{${1:case cmd}}{${2:cmd}}"}},
		{"name":"checkdimen","arg":{"format":"{}{}","snippet":"checkdimen{${1:reply}}{${2:dimen register}}"}},
		{"name":"checkinteger","arg":{"format":"{}{}","snippet":"checkinteger{${1:reply}}{${2:count register}}"}},
		{"name":"controlchars","unusual":true},
		{"name":"fmesj","arg":{"format":"{}{}","snippet":"fmesj{${1:cmd and parameters}}{${2:text}}"}},
		{"name":"fxmesj","arg":{"format":"{}{}","snippet":"fxmesj{${1:cmd and parameters}}{${2:text}}"}},
		{"name":"highchars","unusual":true},
		{"name":"mesj","arg":{"format":"{}","snippet":"mesj{${1:text}}"},"doc":"Sends the message verbatim: category 12 for all special characters except braces, tab characters, and carriage returns: { } ^^I ^^M Naturally, the catcode changes are effective only if \\mesj is used directly, not inside a macro argument or definition replacement text."},
		{"name":"mesjsetup","unusual":true},
		{"name":"otherchars","unusual":true},
		{"name":"promptmesj","arg":{"format":"{}","snippet":"promptmesj{${1:text}}"}},
		{"name":"promptxmesj","arg":{"format":"{}","snippet":"promptxmesj{${1:text}}"}},
		{"name":"readchar","arg":{"format":"{}{}","snippet":"readchar{${1:default}}{${2:cmd}}"}},
		{"name":"readChar","arg":{"format":"{}{}","snippet":"readChar{${1:default}}{${2:cmd}}"}},
		{"name":"readline","arg":{"format":"{}{}","snippet":"readline{${1:default}}{${2:cmd}}"}},
		{"name":"sendmesj","unusual":true},
		{"name":"sendprompt","unusual":true},
		{"name":"storemesj","arg":{"format":"{}{}","snippet":"storemesj{${1:cmd}}{${2:text}}"}},
		{"name":"storexmesj","arg":{"format":"{}{}","snippet":"storexmesj{${1:cmd and parameters}}{${2:text}}"}},
		{"name":"xmesj","arg":{"format":"{}","snippet":"xmesj{${1:text}}"},"doc":"This is like \\mesj but expands embedded control sequences instead of printing them verbatim."},
		{"name":"xmesjsetup","unusual":true},
		{"name":"xreadline","arg":{"format":"{}{}","snippet":"xreadline{${1:default}}{${2:cmd}}"},"doc":"\\xreadline is like \\readline except that it leaves almost all catcodes unchanged so that the return value is executable tokens instead of strictly character tokens of category 11 or 12."}
	],
	"envs": [],
	"keys": {}
}
