{
	"macros": [
		{"name":"CurrentEncoding","doc":"The \\CurrentEncoding macro expands to the current encoding."},
		{"name":"CurrentMetaFamily","doc":"The \\CurrentMetaFamily macro expands to the current meta family."},
		{"name":"CurrentSeries","doc":"The \\CurrentSeries macro expands to the current series."},
		{"name":"CurrentShape","doc":"The \\CurrentShape macro expands to the current shape."},
		{"name":"CurrentSuperFamily","doc":"The \\CurrentSuperFamily macro expands to the current super family."},
		{"name":"IfEncodingF","arg":{"format":"{}{}","snippet":"IfEncodingF{${1:encoding}}{${2:false code}}"}},
		{"name":"IfEncodingT","arg":{"format":"{}{}","snippet":"IfEncodingT{${1:encoding}}{${2:true code}}"}},
		{"name":"IfEncodingTF","arg":{"format":"{}{}{}","snippet":"IfEncodingTF{${1:encoding}}{${2:true code}}{${3:false code}}"}},
		{"name":"IfMetaFamilyF","arg":{"format":"{}{}","snippet":"IfMetaFamilyF{${1:meta family}}{${2:false code}}"}},
		{"name":"IfMetaFamilyT","arg":{"format":"{}{}","snippet":"IfMetaFamilyT{${1:meta family}}{${2:true code}}"},"doc":"User-facing conditionals for meta family."},
		{"name":"IfMetaFamilyTF","arg":{"format":"{}{}{}","snippet":"IfMetaFamilyTF{${1:meta family}}{${2:true code}}{${3:false code}}"}},
		{"name":"IfSeriesF","arg":{"format":"{}{}","snippet":"IfSeriesF{${1:series}}{${2:false code}}"}},
		{"name":"IfSeriesT","arg":{"format":"{}{}","snippet":"IfSeriesT{${1:series}}{${2:true code}}"}},
		{"name":"IfSeriesTF","arg":{"format":"{}{}{}","snippet":"IfSeriesTF{${1:series}}{${2:true code}}{${3:false code}}"}},
		{"name":"IfShapeF","arg":{"format":"{}{}","snippet":"IfShapeF{${1:shape}}{${2:false code}}"}},
		{"name":"IfShapeT","arg":{"format":"{}{}","snippet":"IfShapeT{${1:shape}}{${2:true code}}"}},
		{"name":"IfShapeTF","arg":{"format":"{}{}{}","snippet":"IfShapeTF{${1:shape}}{${2:true code}}{${3:false code}}"}},
		{"name":"IfSuperFamilyF","arg":{"format":"{}{}","snippet":"IfSuperFamilyF{${1:super family}}{${2:false code}}"}},
		{"name":"IfSuperFamilyT","arg":{"format":"{}{}","snippet":"IfSuperFamilyT{${1:super family}}{${2:true code}}"}},
		{"name":"IfSuperFamilyTF","arg":{"format":"{}{}{}","snippet":"IfSuperFamilyTF{${1:super family}}{${2:true code}}{${3:false code}}"}},
		{"name":"softernormalfont","doc":"The \\softernormalfont command excludes encoding and reactivates all the other attributes, whereas the \\softestnormalfont command reactivates all of them."},
		{"name":"softersuperfontfamily","arg":{"format":"{}","snippet":"softersuperfontfamily{${1:ID}}"}},
		{"name":"softestnormalfont"},
		{"name":"softestsuperfontfamily","arg":{"format":"{}","snippet":"softestsuperfontfamily{${1:ID}}"}},
		{"name":"softnormalfont","arg":{"format":"{}","snippet":"softnormalfont{${1:attributes}}"}},
		{"name":"softsuperfontfamily","arg":{"format":"{}{}","snippet":"softsuperfontfamily{${1:ID}}{${2:attributes}}"}},
		{"name":"superfontfamily","arg":{"format":"{}{}","snippet":"superfontfamily{${1:family ID}}{${2:meta family keys}}"}}
	],
	"envs": [],
	"keys": {}
}
