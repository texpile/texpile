{
	"deps": [{"name":"inputenc"},{"name":"kolabels-utf"},{"name":"kosections-utf","if":"hangul|hanja"},{"name":"konames-utf","if":"hangul|hanja"}],
	"macros": [
		{"name":"breakafterasciichar"},
		{"name":"breakafterinlinemath"},
		{"name":"breakbeforeasciichar"},
		{"name":"BreakBeforeAsciiOParen","arg":{"format":"{}","snippet":"BreakBeforeAsciiOParen{${1}}"},"unusual":true},
		{"name":"dhucsPrerenderUnicode","arg":{"format":"{}","snippet":"dhucsPrerenderUnicode{${1}}"},"unusual":true},
		{"name":"dotemph","arg":{"format":"{}","snippet":"dotemph{${1:text}}"},"doc":"\\dotemph가 드러냄표를 식자하는 명령이다."},
		{"name":"jong"},
		{"name":"jung"},
		{"name":"kernbeforeasciichar"},
		{"name":"makejosa","arg":{"format":"{}{}","snippet":"makejosa{${1}}{${2}}"},"unusual":true},
		{"name":"nobreakafterasciichar"},
		{"name":"nobreakafterinlinemath"},
		{"name":"PrerenderUnicode","arg":{"format":"{}","snippet":"PrerenderUnicode{${1}}"},"unusual":true},
		{"name":"rieul"},
		{"name":"SetAdhocFonts","arg":{"format":"{}{}","snippet":"SetAdhocFonts{${1:hangul font}}{${2:hanja font}}"}},
		{"name":"SetHangulFonts","arg":{"format":"{}{}{}","snippet":"SetHangulFonts{${1:serif font}}{${2:sans font}}{${3:mono font}}"},"doc":"기본 글꼴을 설정한다. 세 개의 인자는 각각 명조/고딕/타자에 해당한다."},
		{"name":"SetHanjaFonts","arg":{"format":"{}{}{}","snippet":"SetHanjaFonts{${1:serif font}}{${2:sans font}}{${3:mono font}}"},"doc":"기본 글꼴을 설정한다. 세 개의 인자는 각각 명조/고딕/타자에 해당한다."},
		{"name":"setInterHangulSkip","arg":{"format":"{}","snippet":"setInterHangulSkip{${1:skip}}"}},
		{"name":"SetSansFonts","arg":{"format":"{}{}","snippet":"SetSansFonts{${1:hangul font}}{${2:hanja font}}"}},
		{"name":"SetSerifFonts","arg":{"format":"{}{}","snippet":"SetSerifFonts{${1:hangul font}}{${2:hanja font}}"}},
		{"name":"unichar","arg":{"format":"{}","snippet":"unichar{${1}}"},"unusual":true},
		{"name":"unihangulchar","arg":{"format":"{}","snippet":"unihangulchar{${1}}"},"unusual":true},
		{"name":"usehangulfontspec","arg":{"format":"{}","snippet":"usehangulfontspec{${1:font spec name}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/kotexutf#c": ["finemath","hangul","hanja","nojosa","nonfrench","strictcharcheck"]
	},
	"args": ["\\usepackage/kotexutf#c"]
}
