{
	"deps": [{"name":"luatexbase"},{"name":"luacode"},{"name":"ifluatex"},{"name":"iftex"},{"name":"atbegshi-ltx"},{"name":"xparse"}],
	"macros": [
		{"name":"placearrowat","arg":{"format":"[]()()","snippet":"placearrowat[${1:color}](${2:start x,y})(${3:end x,y})"}},
		{"name":"placearrowat","arg":{"format":"()()","snippet":"placearrowat(${1:start x,y})(${2:end x,y})"}},
		{"name":"placeat","arg":{"format":"()<>[]{}[]","snippet":"placeat(${1:x,y})<${2:grid cell}>[${3:content left}]{${4:content}}[${5:name}]"}},
		{"name":"placeat","arg":{"format":"()<>{}","snippet":"placeat(${1:x,y})<${2:grid cell}>{${3:content}}"}},
		{"name":"placeatsetup","arg":{"format":"{}","snippet":"placeatsetup{${1:options}}","keys":["l3keys:placeat"],"keyPos":0}},
		{"name":"placecircleat","arg":{"format":"[]()()","snippet":"placecircleat[${1:color}](${2:x,y})(${3:diameter})"}},
		{"name":"placecircleat","arg":{"format":"()()","snippet":"placecircleat(${1:x,y})(${2:diameter})"}},
		{"name":"placecurveat","arg":{"format":"[]()()()()","snippet":"placecurveat[${1}](${2})(${3})(${4})(${5})"}},
		{"name":"placecurveat","arg":{"format":"()()()()","snippet":"placecurveat(${1})(${2})(${3})(${4})"}},
		{"name":"placefilledcircleat","arg":{"format":"[]()()","snippet":"placefilledcircleat[${1:color}](${2:x,y})(${3:diameter})"}},
		{"name":"placefilledcircleat","arg":{"format":"()()","snippet":"placefilledcircleat(${1:x,y})(${2:diameter})"}},
		{"name":"placefilledrectangleat","arg":{"format":"[]()()","snippet":"placefilledrectangleat[${1:color}](${2:corner x1,y1})(${3:corner x2,y2})"},"doc":"draws a filled rectangle."},
		{"name":"placefilledrectangleat","arg":{"format":"()()","snippet":"placefilledrectangleat(${1:corner x1,y1})(${2:corner x2,y2})"},"doc":"draws a filled rectangle."},
		{"name":"placelineat","arg":{"format":"[]()()","snippet":"placelineat[${1:color}](${2:start x,y})(${3:end x,y})"}},
		{"name":"placelineat","arg":{"format":"()()","snippet":"placelineat(${1:start x,y})(${2:end x,y})"}},
		{"name":"placeminipageat","arg":{"format":"()[]{}","snippet":"placeminipageat(${1:x,y})[${2:width}]{${3:content}}"},"doc":"Using \\placeminipageat is the same as using \\placeat{}{}{content} where content is packed into a minipage."},
		{"name":"placeminipageat","arg":{"format":"(){}","snippet":"placeminipageat(${1:x,y}){${2:content}}"},"doc":"Using \\placeminipageat is the same as using \\placeat{}{}{content} where content is packed into a minipage."},
		{"name":"placerectangleat","arg":{"format":"[]()()","snippet":"placerectangleat[${1:color}](${2:corner x1,y1})(${3:corner x2,y2})"},"doc":"draws a rectangle from the (upper left) corner (x1,y1) to the (lower right) corner (x2,y2)."},
		{"name":"placerectangleat","arg":{"format":"()()","snippet":"placerectangleat(${1:corner x1,y1})(${2:corner x2,y2})"},"doc":"draws a rectangle from the (upper left) corner (x1,y1) to the (lower right) corner (x2,y2)."},
		{"name":"placerelto","arg":{"format":"[]()<>[]{}[]","snippet":"placerelto[${1:reference name}](${2:x,y})<${3:grid cell}>[${4:content left}]{${5:content}}[${6:name}]"}},
		{"name":"placerelto","arg":{"format":"()<>{}","snippet":"placerelto(${1:x,y})<${2:grid cell}>{${3:content}}"}},
		{"name":"placeroundedat","arg":{"format":"[]()()<>","snippet":"placeroundedat[${1}](${2})(${3})<${4}>"}},
		{"name":"placeroundedat","arg":{"format":"()()<>","snippet":"placeroundedat(${1})(${2})<${3}>"}},
		{"name":"placeroundedat*","arg":{"format":"[]()()<>","snippet":"placeroundedat*[${1}](${2})(${3})<${4}>"}},
		{"name":"placeroundedat*","arg":{"format":"()()<>","snippet":"placeroundedat*(${1})(${2})<${3}>"}},
		{"name":"placesquareat","arg":{"format":"[](){}","snippet":"placesquareat[${1:color}](${2:x,y}){${3:size}}"}},
		{"name":"placesquareat","arg":{"format":"(){}","snippet":"placesquareat(${1:x,y}){${2:size}}"}}
	],
	"envs": [],
	"keys": {
		"l3keys:placeat": ["arrowheadlength=","gridlinewidth=","gridnumber=","gridnumberx=","gridnumbery=","linewidth=","offsetx=","offsety=","alphanumgrid","drawgrid","final","nogrid","numnumgrid","startzero"]
	}
}
