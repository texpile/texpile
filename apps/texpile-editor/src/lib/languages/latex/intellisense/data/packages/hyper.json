		{"name":"hypernoref","arg":{"format":"{}","snippet":"hypernoref{${1:label}}"},"unusual":true},
		{"name":"hyperpageref","arg":{"format":"[]{}","snippet":"hyperpageref[${1:text}]{${2:label}}"},"unusual":true},
