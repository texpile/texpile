{
	"deps": [{"name":"hxt-bc","if":"backcitepages|backcitesections"},{"name":"color","if":"color|gray"},{"name":"defpattern","if":"indexcmds","engines":["pdflatex"]},{"name":"defpattern","if":"cweb|indexcmds","engines":["lualatex","xelatex"]}],
	"macros": [
		{"name":"blindhyperanchor","arg":{"format":"{}","snippet":"blindhyperanchor{${1:anchor}}"}},
