		{"name":"hyperpagereference","arg":{"format":"{}{}","snippet":"hyperpagereference{${1:anchor}}{${2:text}}"},"doc":"The macros \\hyperreference \\hyperpagereference and insert a html-reference to an internal label except when the first parameter begins with [. Then the parameter must have the form [#1][#2] where #1 is an external URL and #2 an anchor within this URL."},
		{"name":"hyperref","arg":{"format":"[]{}","snippet":"hyperref[${1:text}]{${2:label}}"},"unusual":true},
		{"name":"hyperref","arg":{"format":"{}","snippet":"hyperref{${1:label}}"},"unusual":true},
		{"name":"hyperreference","arg":{"format":"{}{}","snippet":"hyperreference{${1:anchor}}{${2:text}}"},"doc":"The macros \\hyperreference \\hyperpagereference and insert a html-reference to an internal label except when the first parameter begins with [. Then the parameter must have the form [#1][#2] where #1 is an external URL and #2 an anchor within this URL."},
		{"name":"hyperURL","arg":{"format":"{}{}{}{}","snippet":"hyperURL{${1:type}}{${2:domain}}{${3:document}}{${4:text}}"}},
		{"name":"labeltext","arg":{"format":"{}{}","snippet":"labeltext{${1}}{${2}}"}},
		{"name":"nohyper","unusual":true},
