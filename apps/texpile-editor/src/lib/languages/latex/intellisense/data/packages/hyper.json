		{"name":"externaldocument","arg":{"format":"()[]{}","snippet":"externaldocument(${1:URL})[${2:prefix}]{${3:file}}"},"if":"xr"},
		{"name":"externaldocument","arg":{"format":"(){}","snippet":"externaldocument(${1:URL}){${2:file}}"},"if":"xr"},
		{"name":"filedate","unusual":true},
		{"name":"fileversion","unusual":true},
		{"name":"hyper","unusual":true},
