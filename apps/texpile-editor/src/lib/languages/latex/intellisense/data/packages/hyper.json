		{"name":"noref","arg":{"format":"{}","snippet":"noref{${1:label}}"}},
		{"name":"pageref","arg":{"format":"[]{}","snippet":"pageref[${1:text}]{${2:label}}"}},
		{"name":"pageref","arg":{"format":"{}","snippet":"pageref{${1:label}}"}},
		{"name":"ref","arg":{"format":"[]{}","snippet":"ref[${1:text}]{${2:label}}"}},
		{"name":"ref","arg":{"format":"{}","snippet":"ref{${1:label}}"}},
		{"name":"refcurrent","arg":{"format":"{}","snippet":"refcurrent{${1}}"}},
		{"name":"refnext","arg":{"format":"{}","snippet":"refnext{${1}}"}}
