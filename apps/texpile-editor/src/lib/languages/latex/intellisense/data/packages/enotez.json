		{"name":"endnote","arg":{"format":"[]{}","snippet":"endnote[${1:mark}]{${2:text}}"},"doc":"Add an endnote in the text."},
		{"name":"endnote","arg":{"format":"{}","snippet":"endnote{${1:text}}"},"doc":"Add an endnote in the text."},
		{"name":"endnotemark","arg":{"format":"[]","snippet":"endnotemark[${1:mark}]"}},
