{
	"deps": [{"name":"xkeyval"},{"name":"kvoptions"},{"name":"kvsetkeys"},{"name":"etoolbox"},{"name":"xparse"},{"name":"xcolor"},{"name":"marginnote"}],
	"macros": [
		{"name":"newphfccmarginnote","arg":{"format":"{}","snippet":"newphfccmarginnote{${1}}"},"unusual":true},
		{"name":"phfCCChangesBy"},
		{"name":"phfccfootcommenttextstyle"},
		{"name":"phfccfootcommentwrapfnmark","arg":{"format":"{}","snippet":"phfccfootcommentwrapfnmark{${1:footnote mark}}"},"doc":"You can redefine \\phfccfootcommentwrapfnmark{..} to customize the appearance of the footnote mark, and \\phfccfootcommenttextstyle to get some handle on the commands issued within the footnote contents."},
		{"name":"phfccformatboxinitials","arg":{"format":"{}","snippet":"phfccformatboxinitials{${1:initials}}"}},
		{"name":"phfccformatmargininitials","arg":{"format":"{}","snippet":"phfccformatmargininitials{${1:initials}}"},"doc":"The \\phfccformatmargininitials is used to format the initials in the margin."},
		{"name":"phfccmargininitialssep","doc":"The \\phfccmargininitialssep length is the minimal vertical separation between two initials labels."},
		{"name":"phfCommentingDefaultBegin","unusual":true},
		{"name":"phfCommentingDefaultCBegin","unusual":true},
		{"name":"phfCommentingDefaultCEnd","unusual":true},
		{"name":"phfCommentingDefaultCFont","unusual":true},
		{"name":"phfCommentingDefaultCSpacing","unusual":true},
		{"name":"phfCommentingDefaultEnd","unusual":true},
		{"name":"phfCommentingDefaultEndCmds","unusual":true},
		{"name":"phfCommentingDefaultFont","unusual":true},
		{"name":"phfCommentingDefaultIBegin","unusual":true},
		{"name":"phfCommentingDefaultIEnd","unusual":true},
		{"name":"phfCommentingDefaultIFont","unusual":true},
		{"name":"phfCommentingDefaultISpacing","unusual":true},
		{"name":"phfCommentingDefaultRmBegin","unusual":true},
		{"name":"phfCommentingDefaultRmEnd","unusual":true},
		{"name":"phfCommentingDefaultRmFont","unusual":true},
		{"name":"phfCommentingDefaultRmSpacing","unusual":true},
		{"name":"phfCommentingDefaultSpacing","unusual":true},
		{"name":"phfCommentingDefaultStartCmds","unusual":true},
		{"name":"phfDefineCommentingStyle","arg":{"format":"{}{}","snippet":"phfDefineCommentingStyle{${1:style name}}{${2:keys}}","keys":["keyval:phfmkcc"],"keyPos":1},"doc":"User interface for defining custom comment styles."},
		{"name":"phfDisableCommentingCommands","doc":"The command \\phfDisableCommentingCommands disables all commenting commands, and causes them to emit an error."},
		{"name":"phfMakeCommentingCommand","arg":{"format":"[]{}","snippet":"phfMakeCommentingCommand[${1:keys}]{${2:command name}}","keys":["keyval:phfmkcc"],"keyPos":0}},
		{"name":"phfMakeCommentingCommand","arg":{"format":"{}","snippet":"phfMakeCommentingCommand{${1:command name}}"}},
		{"name":"phfSetDefaultCommentingStyle","arg":{"format":"{}","snippet":"phfSetDefaultCommentingStyle{${1:keys}}","keys":["keyval:phfmkcc"],"keyPos":0},"doc":"Instead of defining named styles which have to be invoked explicitly, you can also preset the style of all future calls of \\phfMakeCommentingCommand."}
	],
	"envs": [],
	"keys": {
		"keyval:phfmkcc": ["begin=","cbegin=","cend=","cfont=","color=","cspacing=","end=","font=","ibegin=","iend=","ifont=","initials=","ispacing=","rmbegin=","rmend=","rmfont=","rmspacing=","spacing=","formatinitials=${1|default,margin,box,nobox,hide,footnote|}","style=${1|footcomments,rmstrikethrough|}"],
		"\\usepackage/phfcc#c": ["usemarginnote=${1|true,false|}"]
	},
	"args": ["\\usepackage/phfcc#c"]
}
