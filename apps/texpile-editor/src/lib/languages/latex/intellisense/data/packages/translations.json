		{"name":"definetranslation","arg":{"format":"{}{}{}","snippet":"definetranslation{${1}}{${2}}{${3}}"}},
		{"name":"definetranslationfallback","arg":{"format":"{}{}","snippet":"definetranslationfallback{${1:key}}{${2:translation}}"}},
