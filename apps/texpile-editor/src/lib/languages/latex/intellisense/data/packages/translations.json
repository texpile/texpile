		{"name":"ProvideDictTranslation","arg":{"format":"{}{}","snippet":"ProvideDictTranslation{${1}}{${2}}"}},
		{"name":"ProvideTranslation","arg":{"format":"{}{}{}","snippet":"ProvideTranslation{${1}}{${2}}{${3}}"}},
		{"name":"ProvideTranslationFallback","arg":{"format":"{}{}","snippet":"ProvideTranslationFallback{${1:key}}{${2:translation}}"}},
		{"name":"redefinetranslation","arg":{"format":"{}{}{}","snippet":"redefinetranslation{${1}}{${2}}{${3}}"}},
		{"name":"redefinetranslationfallback","arg":{"format":"{}{}","snippet":"redefinetranslationfallback{${1:key}}{${2:translation}}"}},
		{"name":"RenewDictTranslation","arg":{"format":"{}{}","snippet":"RenewDictTranslation{${1}}{${2}}"}},
		{"name":"RenewTranslation","arg":{"format":"{}{}{}","snippet":"RenewTranslation{${1}}{${2}}{${3}}"},"doc":"Redefines a translation of key ⟨key⟩ for the language ⟨lang⟩."},
		{"name":"RenewTranslationFallback","arg":{"format":"{}{}","snippet":"RenewTranslationFallback{${1:key}}{${2:translation}}"}},
		{"name":"SaveTranslation","arg":{"format":"{}{}","snippet":"SaveTranslation{${1}}{${2}}"},"doc":"Fetches and saves the translation of ⟨key⟩ for the currently active language (as for example set by babel) in the macro ⟨cmd⟩."},
		{"name":"SaveTranslationFor","arg":{"format":"{}{}{}","snippet":"SaveTranslationFor{${1}}{${2}}{${3}}"},"doc":"Fetches and saves the translation of ⟨key⟩ for the language ⟨lang⟩ in the macro ⟨cmd⟩."}
