		{"name":"ifcurrentlang","arg":{"format":"{}","snippet":"ifcurrentlang{${1}}"}},
		{"name":"ifcurrentlanguage","arg":{"format":"{}{}{}","snippet":"ifcurrentlanguage{${1:lang}}{${2:true}}{${3:false}}"},"doc":"Places ⟨true⟩ in the input stream if the current language is ⟨lang⟩."},
		{"name":"IfTranslation","arg":{"format":"{}{}{}{}","snippet":"IfTranslation{${1:lang}}{${2:key}}{${3:true}}{${4:false}}"}},
