		{"name":"LoadDictionaryFor","arg":{"format":"{}{}","snippet":"LoadDictionaryFor{${1}}{${2}}"},"doc":"Loads a file named ⟨name⟩-⟨lang⟩.trsl."},
		{"name":"LoadDictionaryForDialect","arg":{"format":"{}{}","snippet":"LoadDictionaryForDialect{${1}}{${2}}"}},
		{"name":"NewDictTranslation","arg":{"format":"{}{}","snippet":"NewDictTranslation{${1}}{${2}}"}},
		{"name":"NewTranslation","arg":{"format":"{}{}{}","snippet":"NewTranslation{${1}}{${2}}{${3}}"},"doc":"Defines a translation of key ⟨key⟩ for the language ⟨lang⟩."},
		{"name":"NewTranslationFallback","arg":{"format":"{}{}","snippet":"NewTranslationFallback{${1:key}}{${2:translation}}"}},
		{"name":"PrintDictionaryFor","arg":{"format":"{}{}{}{}{}","snippet":"PrintDictionaryFor{${1}}{${2}}{${3}}{${4}}{${5}}"},"doc":"Prints all entries of dictionary ⟨name⟩ in language ⟨lang⟩ in the order the entries have been declared."},
