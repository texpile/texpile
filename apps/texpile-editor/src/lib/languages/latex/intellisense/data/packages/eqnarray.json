{
	"deps": [{"name":"array"}],
	"macros": [
		{"name":"docdate","unusual":true},
		{"name":"eqnnum","arg":{"format":"{}","snippet":"eqnnum{${1:number}}"},"doc":"Inside the equationarray and equationarray* environments, there is also the macro \\eqnnum available. It takes one argument that is used as the equation number for the current line."},
		{"name":"filedate","unusual":true},
		{"name":"fileversion","unusual":true},
		{"name":"yesnumber"}
	],
	"envs": [
		{"name":"equationarray","arg":{"format":"[]{}","snippet":"[${1:l|c|r}]{${2:column spec}}"}},
		{"name":"equationarray","arg":{"format":"{}","snippet":"{${1:column spec}}"}},
		{"name":"equationarray*","arg":{"format":"[]{}","snippet":"[${1:l|c|r}]{${2:column spec}}"}},
		{"name":"equationarray*","arg":{"format":"{}","snippet":"{${1:column spec}}"}}
	],
	"keys": {
		"\\usepackage/eqnarray#c": ["fleqn"]
	},
	"args": ["\\usepackage/eqnarray#c"]
}
