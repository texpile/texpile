		{"name":"parencite","arg":{"format":"[][]{}","snippet":"parencite[${1:prefix}][${2:postfix}]{${3:keys}}"}},
		{"name":"parencite","arg":{"format":"{}","snippet":"parencite{${1:keys}}"}},
		{"name":"parencite*","arg":{"format":"[][]{}","snippet":"parencite*[${1:prefix}][${2:postfix}]{${3:keys}}"}},
		{"name":"parencite*","arg":{"format":"{}","snippet":"parencite*{${1:keys}}"}},
		{"name":"shortcite","arg":{"format":"[][]{}","snippet":"shortcite[${1:prefix}][${2:postfix}]{${3:keys}}"}},
		{"name":"shortcite","arg":{"format":"{}","snippet":"shortcite{${1:keys}}"}},
		{"name":"shortcite*","arg":{"format":"[][]{}","snippet":"shortcite*[${1:prefix}][${2:postfix}]{${3:keys}}"}},
		{"name":"shortcite*","arg":{"format":"{}","snippet":"shortcite*{${1:keys}}"}}
