{
	"deps": [{"name":"catoptions"},{"name":"ltxtools"},{"name":"ltxtools-base"},{"name":"ltxkeys"},{"name":"atveryend-ltx"},{"name":"iftex","engines":["lualatex"]}],
	"macros": [
		{"name":"AlwaysTrimEnvEntries"},
		{"name":"envbody"},
		{"name":"everyeoenv","arg":{"format":"{}","snippet":"everyeoenv{${1}}"}},
		{"name":"newenviron","arg":{"format":"{}[][]{}{}","snippet":"newenviron{${1:name}}[${2:number of arguments}][${3:default of first argument}]{${4:start code}}{${5:end code}}"}},
		{"name":"newenviron","arg":{"format":"{}{}{}","snippet":"newenviron{${1:name}}{${2:start code}}{${3:end code}}"}},
		{"name":"newenviron*","arg":{"format":"{}[][]{}{}","snippet":"newenviron*{${1:name}}[${2:number of arguments}][${3:default of first argument}]{${4:start code}}{${5:end code}}"}},
		{"name":"newenviron*","arg":{"format":"{}{}{}","snippet":"newenviron*{${1:name}}{${2:start code}}{${3:end code}}"}},
		{"name":"renewenviron","arg":{"format":"{}[][]{}{}","snippet":"renewenviron{${1:name}}[${2:number of arguments}][${3:default of first argument}]{${4:start code}}{${5:end code}}"}},
		{"name":"renewenviron","arg":{"format":"{}{}{}","snippet":"renewenviron{${1:name}}{${2:start code}}{${3:end code}}"}},
		{"name":"renewenviron*","arg":{"format":"{}[][]{}{}","snippet":"renewenviron*{${1:name}}[${2:number of arguments}][${3:default of first argument}]{${4:start code}}{${5:end code}}"}},
		{"name":"renewenviron*","arg":{"format":"{}{}{}","snippet":"renewenviron*{${1:name}}{${2:start code}}{${3:end code}}"}},
		{"name":"trimenvspaces","arg":{"format":"{}","snippet":"trimenvspaces{${1:text}}"},"unusual":true}
	],
	"envs": [],
	"keys": {}
}
