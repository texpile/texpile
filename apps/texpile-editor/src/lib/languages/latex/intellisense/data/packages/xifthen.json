{
	"deps": [{"name":"calc"},{"name":"ifthen"}],
	"macros": [
		{"name":"cnttest","arg":{"format":"{}{}{}","snippet":"cnttest{${1:counter expression 1}}{${2:comparison}}{${3:counter expression 2}}"}},
		{"name":"dimtest","arg":{"format":"{}{}{}","snippet":"dimtest{${1:dimen expression 1}}{${2:comparison}}{${3:dimen expression 2}}"}},
		{"name":"endswith","arg":{"format":"{}{}","snippet":"endswith{${1:string}}{${2:substring}}"}},
		{"name":"filedate","unusual":true},
		{"name":"fileversion","unusual":true},
		{"name":"isempty","arg":{"format":"{}","snippet":"isempty{${1:content}}"},"doc":"Returns true if 〈content〉 is empty."},
		{"name":"isequivalentto","arg":{"format":"{}{}","snippet":"isequivalentto{${1:command 1}}{${2:command 2}}"},"doc":"Corresponds to the \\ifx test: it returns true when the two commands are exactly equivalent (same definition, same number of arguments, same prefixes, etc., otherwise false is returned)."},
		{"name":"isin","arg":{"format":"{}{}","snippet":"isin{${1:substring}}{${2:string}}"}},
		{"name":"isnamedefined","arg":{"format":"{}","snippet":"isnamedefined{${1:command name}}"}},
		{"name":"newtest","arg":{"format":"{}[]{}","snippet":"newtest{${1:command}}[${2:number of arguments}]{${3:test expression}}"}},
		{"name":"newtest","arg":{"format":"{}{}","snippet":"newtest{${1:command}}{${2:test expression}}"}},
		{"name":"terminateswith","arg":{"format":"{}{}","snippet":"terminateswith{${1:string}}{${2:substring}}"},"unusual":true}
	],
	"envs": [],
	"keys": {}
}
