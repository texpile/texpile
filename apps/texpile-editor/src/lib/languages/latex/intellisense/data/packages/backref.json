	"envs": [],
	"keys": {
		"keyval:backref": ["disable","enable","verbose=${1|false,true|}"],
		"\\usepackage/backref#c": ["UKenglish","USenglish","acadian","afrikaans","american","australian","austrian","brazil","brazilian","british","canadian","canadien","disable","enable","english","francais","french","frenchb","german","hyperpageref","hyperref","italian","naustrian","newzealand","ngerman","pageref","ref","spanish","verbose=${1|false,true|}"]
	},
	"args": ["\\usepackage/backref#c"]
}
