{
	"deps": [{"name":"kvoptions"},{"name":"keyval"},{"name":"kvsetkeys"},{"name":"rerunfilecheck"},{"name":"iftex"},{"name":"uniquecounter"},{"name":"bigintcalc"}],
	"macros": [
		{"name":"backref","arg":{"format":"{}","snippet":"backref{${1:list}}"}},
		{"name":"backrefafrikaans"},
		{"name":"backrefalt","arg":{"format":"{}{}{}{}","snippet":"backrefalt{${1}}{${2}}{${3}}{${4}}"}},
		{"name":"backrefbrazil"},
		{"name":"backrefenglish"},
		{"name":"backrefentrycount","arg":{"format":"{}{}","snippet":"backrefentrycount{${1}}{${2}}"}},
		{"name":"backreffrench"},
		{"name":"backrefgerman"},
		{"name":"backrefitalian"},
		{"name":"backreflastsep"},
		{"name":"backrefpagesname","doc":"Without hyperref there is an introductory text, controlled by macros \\backrefpagesname or \\backrefsectionsname."},
		{"name":"backrefparscanfalse"},
		{"name":"backrefparscantrue"},
		{"name":"backrefprint","doc":"The list is printed by the macro \\backrefprint, thus just call it at the right place."},
		{"name":"backrefsectionsname"},
		{"name":"backrefsep"},
		{"name":"backrefsetup","arg":{"format":"{}","snippet":"backrefsetup{${1:options}}","keys":["keyval:backref"],"keyPos":0}},
		{"name":"backrefspanish"},
		{"name":"backreftwosep"},
		{"name":"backrefxxx","arg":{"format":"{}{}{}","snippet":"backrefxxx{${1}}{${2}}{${3}}"},"unusual":true},
		{"name":"ifbackrefparscan","unusual":true}
