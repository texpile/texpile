		{"name":"sign","arg":{"format":"[]{}","snippet":"sign[${1:height}]{${2:signature file}}"},"doc":"Define the file with the command \\sign[ht]{file} and if ht is not specified then it will be 15 mm high."},
		{"name":"sign","arg":{"format":"{}","snippet":"sign{${1:signature file}}"},"doc":"Define the file with the command \\sign[ht]{file} and if ht is not specified then it will be 15 mm high."},
