		{"name":"closingtwo","arg":{"format":"{}","snippet":"closingtwo{${1:closing text}}"},"doc":"Supplies the closing which is centred above two signatures."},
		{"name":"extraA","arg":{"format":"{}","snippet":"extraA{${1:extra line 1}}"}},
		{"name":"extraB","arg":{"format":"{}","snippet":"extraB{${1:extra line 2}}"}},
		{"name":"extraC","arg":{"format":"{}","snippet":"extraC{${1:extra line 3}}"}},
		{"name":"hletfalse","unusual":true},
		{"name":"hlettrue","unusual":true},
		{"name":"hltype","unusual":true},
		{"name":"ifhlet","unusual":true},
		{"name":"logo","arg":{"format":"[]{}","snippet":"logo[${1:height}]{${2:logo file}}"}},
		{"name":"logo","arg":{"format":"{}","snippet":"logo{${1:logo file}}"}},
