		{"name":"centreA","arg":{"format":"{}","snippet":"centreA{${1:centre line 1}}"}},
		{"name":"centreB","arg":{"format":"{}","snippet":"centreB{${1:centre line 2}}"}},
		{"name":"centreC","arg":{"format":"{}","snippet":"centreC{${1:centre line 3}}"}},
		{"name":"centreD","arg":{"format":"{}","snippet":"centreD{${1:centre line 4}}"}},
		{"name":"centreE","arg":{"format":"{}","snippet":"centreE{${1:centre line 5}}"}},
