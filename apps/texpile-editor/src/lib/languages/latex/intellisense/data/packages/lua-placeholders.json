{
	"deps": [{"name":"textcomp"},{"name":"xspace"}],
	"macros": [
		{"name":"curnamespace","doc":"The active namespace is whatever \\curnamespace expands to at call time — defaulting to \\jobname and adjustable with \\setnamespace."},
		{"name":"forlistitem","arg":{"format":"[]{}{}","snippet":"forlistitem[${1:namespace}]{${2:name}}{${3:code}}"}},
		{"name":"forlistitem","arg":{"format":"{}{}","snippet":"forlistitem{${1:name}}{${2:code}}"}},
		{"name":"fortablerow","arg":{"format":"[]{}{}","snippet":"fortablerow[${1:namespace}]{${2:name}}{${3:code}}"}},
		{"name":"fortablerow","arg":{"format":"{}{}","snippet":"fortablerow{${1:name}}{${2:code}}"}},
		{"name":"hasparam","arg":{"format":"[]{}{}{}","snippet":"hasparam[${1:namespace}]{${2:key}}{${3:true case}}{${4:false case}}"}},
		{"name":"hasparam","arg":{"format":"{}{}{}","snippet":"hasparam{${1:key}}{${2:true case}}{${3:false case}}"}},
		{"name":"ifparam","arg":{"format":"[]{}{}{}","snippet":"ifparam[${1:namespace}]{${2:key}}{${3:true code}}{${4:false code}}"}},
		{"name":"ifparam","arg":{"format":"{}{}{}","snippet":"ifparam{${1:key}}{${2:true code}}{${3:false code}}"}},
		{"name":"loadpayload","arg":{"format":"[]{}","snippet":"loadpayload[${1:namespace}]{${2:file name}}"}},
		{"name":"loadpayload","arg":{"format":"{}","snippet":"loadpayload{${1:file name}}"}},
		{"name":"loadrecipe","arg":{"format":"[]{}","snippet":"loadrecipe[${1:namespace}]{${2:file name}}"}},
		{"name":"loadrecipe","arg":{"format":"{}","snippet":"loadrecipe{${1:file name}}"}},
		{"name":"numparam","arg":{"format":"[]{}","snippet":"numparam[${1}]{${2}}"},"unusual":true},
		{"name":"numparam","arg":{"format":"{}","snippet":"numparam{${1}}"},"unusual":true},
		{"name":"param","arg":{"format":"[]{}","snippet":"param[${1:namespace}]{${2:key}}"}},
		{"name":"param","arg":{"format":"{}","snippet":"param{${1:key}}"}},
		{"name":"PARAM","arg":{"format":"[]{}","snippet":"PARAM[${1:namespace}]{${2:key}}"}},
		{"name":"PARAM","arg":{"format":"{}","snippet":"PARAM{${1:key}}"}},
		{"name":"paramdateformat","arg":{"format":"{}{}{}","snippet":"paramdateformat{${1}}{${2}}{${3}}"}},
		{"name":"paramfield","arg":{"format":"[]{}{}","snippet":"paramfield[${1:namespace}]{${2:name}}{${3:field}}"}},
		{"name":"paramfield","arg":{"format":"{}{}","snippet":"paramfield{${1:name}}{${2:field}}"}},
		{"name":"paramfieldterm"},
		{"name":"paramlistconjunction"},
		{"name":"paramnewbool","arg":{"format":"{}","snippet":"paramnewbool{${1}}"},"unusual":true},
		{"name":"paramnotfound","arg":{"format":"{}","snippet":"paramnotfound{${1}}"},"unusual":true},
		{"name":"paramnumberformat","arg":{"format":"{}","snippet":"paramnumberformat{${1}}"}},
		{"name":"paramplaceholder","arg":{"format":"{}","snippet":"paramplaceholder{${1}}"}},
		{"name":"paramsetbool","arg":{"format":"{}{}","snippet":"paramsetbool{${1}}{${2}}"},"unusual":true},
		{"name":"paramsetboolfalse","arg":{"format":"{}","snippet":"paramsetboolfalse{${1}}"},"unusual":true},
		{"name":"paramsetbooltrue","arg":{"format":"{}","snippet":"paramsetbooltrue{${1}}"},"unusual":true},
		{"name":"rawparam","arg":{"format":"{}{}","snippet":"rawparam{${1:namespace}}{${2:key}}"}},
		{"name":"setnamespace","arg":{"format":"{}","snippet":"setnamespace{${1:namespace}}"}},
		{"name":"strictparams"}
	],
	"envs": [
		{"name":"paramobject","arg":{"format":"[]{}","snippet":"[${1:namespace}]{${2:object name}}"}},
		{"name":"paramobject","arg":{"format":"{}","snippet":"{${1:object name}}"}}
	],
	"keys": {}
}
