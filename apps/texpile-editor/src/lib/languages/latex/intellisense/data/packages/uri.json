{
	"deps": [{"name":"kvoptions"},{"name":"keyval"},{"name":"kvsetkeys"},{"name":"url"}],
	"macros": [
		{"name":"arxiv","arg":{"format":"{}","snippet":"arxiv{${1:arXiv identifier}}"}},
		{"name":"asin","arg":{"format":"{}","snippet":"asin{${1:ASIN}}"}},
		{"name":"citeurl","arg":{"format":"{}","snippet":"citeurl{${1:url}}"}},
		{"name":"doi","arg":{"format":"{}","snippet":"doi{${1:DOI}}"}},
		{"name":"hdl","arg":{"format":"{}","snippet":"hdl{${1:handle}}"}},
		{"name":"mailto","arg":{"format":"[]{}","snippet":"mailto[${1:subject}]{${2:address}}"}},
		{"name":"mailto","arg":{"format":"{}","snippet":"mailto{${1:address}}"}},
		{"name":"nbn","arg":{"format":"{}","snippet":"nbn{${1:URN}}"}},
		{"name":"oclc","arg":{"format":"{}","snippet":"oclc{${1:OCLC number}}"}},
		{"name":"oid","arg":{"format":"{}","snippet":"oid{${1:OID}}"}},
		{"name":"pubmed","arg":{"format":"{}","snippet":"pubmed{${1:PubMed ID}}"}},
		{"name":"tinypuri","arg":{"format":"{}","snippet":"tinypuri{${1:TinyURL code}}"}},
		{"name":"tinyuri","arg":{"format":"{}","snippet":"tinyuri{${1:TinyURL code}}"}},
		{"name":"ukoeln","arg":{"format":"{}","snippet":"ukoeln{${1:code}}"}},
		{"name":"uref","arg":{"format":"{}{}","snippet":"uref{${1:url}}{${2:text}}"}},
		{"name":"urisetup","arg":{"format":"{}","snippet":"urisetup{${1:options}}","keys":["keyval:uri"],"keyPos":0},"doc":"To set options with more complicated/problematic content, \\urisetup is needed."},
		{"name":"wc","arg":{"format":"{}","snippet":"wc{${1:WebCite ID}}"}},
		{"name":"xmpp","arg":{"format":"{}","snippet":"xmpp{${1:url}}"},"unusual":true}
	],
	"envs": [],
	"keys": {
		"keyval:uri": ["arxivpost=","arxivpre=","asinpost=","asinpre=","citeurlpost=","citeurlpre=","doipost=","doipre=","hdlpost=","hdlpre=","mailtopost=","mailtopre=","nbnpost=","nbnpre=","oclcpost=","oclcpre=","oidpost=","oidpre=","pubmedpost=","pubmedpre=","tinypuripost=","tinypuripre=","tinyuripost=","tinyuripre=","ukoelnpost=","ukoelnpre=","wcpost=","wcpre="],
		"\\usepackage/uri#c": ["arxivpost=","arxivpre=","asinpost=","asinpre=","citeurlpost=","citeurlpre=","doipost=","doipre=","hdlpost=","hdlpre=","mailtopost=","mailtopre=","nbnpost=","nbnpre=","oclcpost=","oclcpre=","oidpost=","oidpre=","pubmedpost=","pubmedpre=","tinypuripost=","tinypuripre=","tinyuripost=","tinyuripre=","ukoelnpost=","ukoelnpre=","wcpost=","wcpre="]
	},
	"args": ["\\usepackage/uri#c"]
}
