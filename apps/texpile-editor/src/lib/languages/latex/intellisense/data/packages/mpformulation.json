{
	"deps": [{"name":"keyval"},{"name":"amsmath"},{"name":"amstext"},{"name":"amsbsy"},{"name":"amsopn"}],
	"macros": [
		{"name":"constraint","arg":{"format":"[]{}{}","snippet":"constraint[${1:label}]{${2:expression}}{${3:quantifier}}"},"doc":"\\constraint[⟨label⟩]{⟨expression⟩}{⟨quantifier⟩} writes one constraint; the quantifier may be empty."},
		{"name":"constraint","arg":{"format":"{}{}","snippet":"constraint{${1:expression}}{${2:quantifier}}"},"doc":"\\constraint[⟨label⟩]{⟨expression⟩}{⟨quantifier⟩} writes one constraint; the quantifier may be empty."},
		{"name":"constraintBottomsep"},
		{"name":"constraintEqspace"},
		{"name":"constraintExprContIndent"},
		{"name":"constraintExprSuffix"},
		{"name":"constraintlast","arg":{"format":"[]{}{}","snippet":"constraintlast[${1}]{${2}}{${3}}"},"unusual":true},
		{"name":"constraintlast","arg":{"format":"{}{}","snippet":"constraintlast{${1}}{${2}}"},"unusual":true},
		{"name":"constraintLastSuffix"},
		{"name":"constraintLeftmargin"},
		{"name":"constraintLHScontIndent","unusual":true},
		{"name":"constraintLHSsuffix","unusual":true},
		{"name":"constraintMinIndent"},
		{"name":"constraintNameFormat","arg":{"format":"{}","snippet":"constraintNameFormat{${1:name}}"},"doc":"The model name is formatted by \\constraintNameFormat{⟨name⟩}, which defaults to (#1)."},
		{"name":"constraintNameSep"},
		{"name":"constraintQuantColMax","unusual":true},
		{"name":"constraintQuantGap"},
		{"name":"constraintQuantSuffix"},
		{"name":"constraintRHSgap","unusual":true},
		{"name":"constraintRHSlastsuffix","unusual":true},
		{"name":"constraintRHSsuffix","unusual":true},
		{"name":"constraintSenseSep"},
		{"name":"constraintSep"},
		{"name":"constraintsetup","arg":{"format":"{}","snippet":"constraintsetup{${1}}"},"unusual":true},
		{"name":"constraintSubjecttoIndent"},
		{"name":"constraintSubjecttoText"},
		{"name":"constraintTopsep"},
		{"name":"ifLastConstraint","unusual":true},
		{"name":"lastconstraint","arg":{"format":"[]{}{}","snippet":"lastconstraint[${1:label}]{${2:expression}}{${3:quantifier}}"}},
		{"name":"lastconstraint","arg":{"format":"{}{}","snippet":"lastconstraint{${1:expression}}{${2:quantifier}}"}},
		{"name":"LastConstraintfalse","unusual":true},
		{"name":"LastConstrainttrue","unusual":true},
		{"name":"mpsetup","arg":{"format":"{}","snippet":"mpsetup{${1:options}}","keys":["keyval:constraints"],"keyPos":0},"doc":"Sets options for the rest of the document (or the current group)."},
		{"name":"objective","arg":{"format":"[]{}{}{}","snippet":"objective[${1:label}]{${2:name}}{${3:sense}}{${4:expression}}"},"doc":"Objective line at the constraints indent: formatted ⟨name⟩ (omitted if empty), ⟨sense⟩ in text, ⟨expression⟩ in display style."},
		{"name":"objective","arg":{"format":"{}{}{}","snippet":"objective{${1:name}}{${2:sense}}{${3:expression}}"},"doc":"Objective line at the constraints indent: formatted ⟨name⟩ (omitted if empty), ⟨sense⟩ in text, ⟨expression⟩ in display style."},
		{"name":"subjectto"}
	],
	"envs": [
		{"name":"constraints","arg":{"format":"[]","snippet":"[${1}]"},"unusual":true},
		{"name":"constraints","unusual":true},
		{"name":"mpformulation","arg":{"format":"[]","snippet":"[${1:options}]","keys":["keyval:constraints"],"keyPos":0},"doc":"A model is written inside a mpformulation environment."},
		{"name":"mpformulation","doc":"A model is written inside a mpformulation environment."}
	],
	"keys": {
		"keyval:constraints": ["bottomsep=","expr_cont_indent=","expr_suffix=","indent=","keep_last","label=","last_auto","last_suffix=","min_indent=","name_label=","name_sep=","numsep=","quant_col=","quant_col_max=","quant_gap=","quant_suffix=","rel_align","rowsep=","sense_sep=","st_auto","st_indent=","st_inline","st_text=","topsep=","quant_break=${1|auto,manual,always|}","expr_break=${1|auto,always|}","obj_break=${1|auto,always|}","numbering=${1|line,sub,model|}","quant_align=${1|right,left|}","quant_overflow=${1|below,wrap|}"]
	}
}
