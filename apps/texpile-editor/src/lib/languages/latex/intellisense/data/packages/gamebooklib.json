{
	"deps": [{"name":"environ"},{"name":"macroswap"},{"name":"ifthen"},{"name":"lcg"},{"name":"keyval"},{"name":"silence"}],
	"macros": [
		{"name":"gentryfooter"},
		{"name":"gentryheader","arg":{"format":"{}{}{}{}","snippet":"gentryheader{${1:counterIdx}}{${2:fixedIdx}}{${3:code}}{${4:title}}"}},
		{"name":"gentryshouldoutput"},
		{"name":"noentryfoot"},
		{"name":"outputfootnotes","arg":{"format":"{}","snippet":"outputfootnotes{${1:maxIdx}}"},"doc":"Command to output the footnotes, which are just in \\footnotetoksN for now."},
		{"name":"thegentries","doc":"This macro shuffles the entries as required, then expands to them in the correct order."}
	],
	"envs": [
		{"name":"gentry","arg":{"format":"[]{}[]","snippet":"[${1:fixed index}]{${2:code}}[${3:title}]"}},
		{"name":"gentry","arg":{"format":"{}","snippet":"{${1:code}}"}}
	],
	"keys": {
		"\\usepackage/gamebooklib#c": ["endpage","footnote","jukebox","noshuffle","verbose"]
	},
	"args": ["\\usepackage/gamebooklib#c"]
}
