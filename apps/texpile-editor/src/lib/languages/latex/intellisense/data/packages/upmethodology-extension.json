{
	"deps": [{"name":"upmethodology-p-common"},{"name":"ifthen"},{"name":"xspace"},{"name":"xcolor"},{"name":"ifpdf"},{"name":"iftex"}],
	"macros": [
		{"name":"Append","arg":{"format":"[]{}{}","snippet":"Append[${1:lang}]{${2:variable name}}{${3:text to append}}"}},
		{"name":"Append","arg":{"format":"{}{}","snippet":"Append{${1:variable name}}{${2:text to append}}"}},
		{"name":"DeclareCopyright","arg":{"format":"[]{}{}{}{}","snippet":"DeclareCopyright[${1:lang}]{${2:extension name}}{${3:year}}{${4:copyrighter}}{${5:trademark and copyright information}}"}},
		{"name":"DeclareCopyright","arg":{"format":"{}{}{}{}","snippet":"DeclareCopyright{${1:extension name}}{${2:year}}{${3:copyrighter}}{${4:trademark and copyright information}}"}},
		{"name":"Get","arg":{"format":"{}","snippet":"Get{${1:variable name}}"}},
		{"name":"GetLang","arg":{"format":"{}{}","snippet":"GetLang{${1:language}}{${2:variable name}}"}},
		{"name":"Ifdefined","arg":{"format":"{}{}","snippet":"Ifdefined{${1}}{${2}}"},"unusual":true},
		{"name":"Ifelsedefined","arg":{"format":"{}{}{}","snippet":"Ifelsedefined{${1:value name}}{${2:then code}}{${3:else code}}"}},
		{"name":"Ifelseundefined","arg":{"format":"{}{}{}","snippet":"Ifelseundefined{${1}}{${2}}{${3}}"},"unusual":true},
		{"name":"Ifundefined","arg":{"format":"{}{}","snippet":"Ifundefined{${1}}{${2}}"},"unusual":true},
		{"name":"Put","arg":{"format":"(){}","snippet":"Put(${1:x,y}){${2:commands}}"}},
		{"name":"Set","arg":{"format":"[]{}{}","snippet":"Set[${1:lang}]{${2:variable name}}{${3:value}}"}},
		{"name":"Set","arg":{"format":"{}{}","snippet":"Set{${1:variable name}}{${2:value}}"}},
		{"name":"SetLangDefault","arg":{"format":"{}{}{}","snippet":"SetLangDefault{${1:language}}{${2:variable name}}{${3:text}}"},"doc":"The \\SetLangDefault command allows you to define a value for a specific language."},
		{"name":"Unset","arg":{"format":"[]{}","snippet":"Unset[${1:lang}]{${2:variable name}}"}},
		{"name":"Unset","arg":{"format":"{}","snippet":"Unset{${1:variable name}}"}},
		{"name":"UseExtension","arg":{"format":"{}","snippet":"UseExtension{${1:extension name}}"}}
	],
