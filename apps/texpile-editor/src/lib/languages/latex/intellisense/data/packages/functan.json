		{"name":"Leftconv","arg":{"format":"{}{}","snippet":"Leftconv{${1:name}}{${2:below}}"},"doc":"The commands \\Conv, \\Conv*, \\Leftconv, \\Leftconv*, \\Leftrightconv and \\Leftrightconv* use ⇒ = instead of → − ."},
		{"name":"Leftconv*","arg":{"format":"{}{}","snippet":"Leftconv*{${1:name}}{${2:below}}"},"doc":"The commands \\Conv, \\Conv*, \\Leftconv, \\Leftconv*, \\Leftrightconv and \\Leftrightconv* use ⇒ = instead of → − ."},
