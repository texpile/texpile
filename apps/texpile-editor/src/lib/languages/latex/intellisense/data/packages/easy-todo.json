{
	"deps": [{"name":"color"},{"name":"tocloft"},{"name":"etoolbox"},{"name":"ifthen"},{"name":"ifdraft"}],
	"macros": [
		{"name":"listoftodos","doc":"Creates the list of notes."},
		{"name":"listoftodosname","unusual":true},
		{"name":"thetodos","unusual":true},
		{"name":"todo","arg":{"format":"{}","snippet":"todo{${1:note}}"},"doc":"Creates a note that shows the text “note”."},
		{"name":"todocolor","unusual":true},
		{"name":"todoenable","arg":{"format":"{}","snippet":"todoenable{${1}}"},"unusual":true},
		{"name":"todoi","arg":{"format":"{}","snippet":"todoi{${1:note}}"},"doc":"Creates a note that only shows an automatically generated number."},
		{"name":"todoii","arg":{"format":"{}{}","snippet":"todoii{${1:note}}{${2:information}}"},"doc":"Creates a note that shows the text “note”. The text “information” appears at the index."},
		{"name":"todoindexas","arg":{"format":"{}","snippet":"todoindexas{${1}}"},"unusual":true},
		{"name":"todoindexpagetitle","unusual":true},
		{"name":"todoindextitle","unusual":true},
		{"name":"todoobeyfinal","arg":{"format":"{}","snippet":"todoobeyfinal{${1}}"},"unusual":true}
	],
	"envs": [],
	"keys": {
		"\\usepackage/easy-todo#c": ["chapter","disable","enable","obeyFinal","section"]
	},
	"args": ["\\usepackage/easy-todo#c"]
}
