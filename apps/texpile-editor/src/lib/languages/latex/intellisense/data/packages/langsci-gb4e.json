		{"name":"thexnumii","unusual":true},
		{"name":"thexnumiii","unusual":true},
		{"name":"thexnumiv","unusual":true},
		{"name":"threedigitexamples"},
		{"name":"trans"},
		{"name":"transfont"},
		{"name":"twodigitexamples"},
		{"name":"xbox","arg":{"format":"{}{}","snippet":"xbox{${1:width}}{${2:text}}"}},
		{"name":"xref","arg":{"format":"{}","snippet":"xref{${1:label}}"},"doc":"You can refer to examples with \\xref{ex:original}, which will give you the example number in parentheses as in (18), and with \\xxref{ex:original}{ex:firstmat}, which will give you (18–19)."},
		{"name":"xxref","arg":{"format":"{}{}","snippet":"xxref{${1:first label}}{${2:last label}}"}},
		{"name":"z"},
		{"name":"zl"},
		{"name":"zlast"},
		{"name":"zllast"},
		{"name":"zs"}
	],
	"envs": [
		{"name":"exe","arg":{"format":"[]","snippet":"[${1:widest identifier}]"}},
		{"name":"exe"},
		{"name":"xlist","arg":{"format":"[]","snippet":"[${1:widest label}]"}},
		{"name":"xlist"},
		{"name":"xlista","arg":{"format":"[]","snippet":"[${1:widest label}]"}},
		{"name":"xlista"},
		{"name":"xlistA","arg":{"format":"[]","snippet":"[${1:widest label}]"}},
		{"name":"xlistA"},
		{"name":"xlistabr","arg":{"format":"[]","snippet":"[${1:widest label}]"}},
		{"name":"xlistabr"},
		{"name":"xlisti","arg":{"format":"[]","snippet":"[${1:widest label}]"}},
		{"name":"xlisti"},
		{"name":"xlistI","arg":{"format":"[]","snippet":"[${1:widest label}]"}},
		{"name":"xlistI"},
		{"name":"xlistn","arg":{"format":"[]","snippet":"[${1:widest label}]"}},
		{"name":"xlistn"}
	],
	"keys": {
		"\\usepackage/langsci-gb4e#c": ["lowerpenalty","manualexewidth","nocgloss","nojambox"]
	},
	"args": ["\\usepackage/langsci-gb4e#c"]
}
