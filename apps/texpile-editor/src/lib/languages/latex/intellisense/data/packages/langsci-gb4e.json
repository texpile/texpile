{
	"deps": [{"name":"etoolbox"}],
	"macros": [
		{"name":"atcenter","arg":{"format":"{}","snippet":"atcenter{${1:example}}"}},
		{"name":"attop","arg":{"format":"{}","snippet":"attop{${1:example}}"}},
		{"name":"ea","arg":{"format":"[]{}","snippet":"ea[${1:judgment}]{${2:sentence}}"},"doc":"\\ea opens a new level and prints the first identifier; \\z closes the last level."},
		{"name":"ea","arg":{"format":"{}","snippet":"ea{${1:sentence}}"},"doc":"\\ea opens a new level and prints the first identifier; \\z closes the last level."},
		{"name":"eachwordeight"},
		{"name":"eachwordfive"},
		{"name":"eachwordfour"},
		{"name":"eachwordone"},
		{"name":"eachwordseven"},
		{"name":"eachwordsix"},
		{"name":"eachwordthree"},
		{"name":"eachwordtwo"},
		{"name":"eafirst","arg":{"format":"[]{}","snippet":"eafirst[${1:judgment}]{${2:sentence}}"}},
		{"name":"eafirst","arg":{"format":"{}","snippet":"eafirst{${1:sentence}}"}},
		{"name":"eal"},
		{"name":"ealnoraggedright"},
		{"name":"eanoraggedright","arg":{"format":"[]{}","snippet":"eanoraggedright[${1:judgment}]{${2:sentence}}"}},
		{"name":"eanoraggedright","arg":{"format":"{}","snippet":"eanoraggedright{${1:sentence}}"}},
		{"name":"eas"},
		{"name":"ex","arg":{"format":"[]{}","snippet":"ex[${1:judgment}]{${2:sentence}}"},"doc":"\\ex adds a further example but does not change levels."},
		{"name":"ex","arg":{"format":"{}","snippet":"ex{${1:sentence}}"},"doc":"\\ex adds a further example but does not change levels."},
		{"name":"examplesitalics"},
		{"name":"examplesroman"},
		{"name":"exewidth","arg":{"format":"{}","snippet":"exewidth{${1:widest identifier}}"},"doc":"Use \\exewidth{(222)} to set the width reserved for identifiers to three-digits."},
		{"name":"exfont"},
		{"name":"exi","arg":{"format":"{}[]{}","snippet":"exi{${1:identifier}}[${2:judgment}]{${3:sentence}}"}},
		{"name":"exi","arg":{"format":"{}{}","snippet":"exi{${1:identifier}}{${2:sentence}}"}},
		{"name":"exnrfont"},
		{"name":"exp","arg":{"format":"{}[]{}","snippet":"exp{${1:label}}[${2:judgment}]{${3:sentence}}"},"doc":"To repeat an example with a prime, give the original example a \\label and use that label in conjuction with the command \\exp."},
		{"name":"exp","arg":{"format":"{}{}","snippet":"exp{${1:label}}{${2:sentence}}"},"doc":"To repeat an example with a prime, give the original example a \\label and use that label in conjuction with the command \\exp."},
		{"name":"exr","arg":{"format":"{}[]{}","snippet":"exr{${1:label}}[${2:judgment}]{${3:sentence}}"}},
		{"name":"exr","arg":{"format":"{}{}","snippet":"exr{${1:label}}{${2:sentence}}"}},
		{"name":"fnexfont"},
		{"name":"fnexnrfont"},
		{"name":"fnglossfont"},
		{"name":"fntransfont"},
		{"name":"footexindent"},
		{"name":"fourdigitexamples"},
		{"name":"gblabelsep","arg":{"format":"{}","snippet":"gblabelsep{${1:length}}"}},
		{"name":"gll","doc":"\\gll aligns the items of the first and the second line."},
		{"name":"glll"},
		{"name":"gllll"},
		{"name":"glllll"},
		{"name":"gllllll"},
		{"name":"glllllll"},
		{"name":"gllllllll"},
		{"name":"glossfont"},
		{"name":"glossglue","unusual":true},
		{"name":"glt"},
		{"name":"gltoffset"},
		{"name":"jambox","arg":{"format":"[]{}","snippet":"jambox[${1:width}]{${2:text}}"},"doc":"To add annotations to examples, use \\jambox."},
		{"name":"jambox","arg":{"format":"{}","snippet":"jambox{${1:text}}"},"doc":"To add annotations to examples, use \\jambox."},
		{"name":"jambox*","arg":{"format":"[]{}","snippet":"jambox*[${1:width}]{${2:text}}"},"doc":"To add annotations to examples, use \\jambox."},
		{"name":"jambox*","arg":{"format":"{}","snippet":"jambox*{${1:text}}"},"doc":"To add annotations to examples, use \\jambox."},
		{"name":"jamwidth"},
		{"name":"judgewidth","arg":{"format":"{}","snippet":"judgewidth{${1:widest judgment}}"},"doc":"Use \\judgewidth{??} to reserve space of the width of ?? for judgements."},
		{"name":"nobreakbox","arg":{"format":"{}","snippet":"nobreakbox{${1:text}}"}},
		{"name":"nogltOffset"},
		{"name":"nosinglegloss"},
		{"name":"resetgltOffset"},
		{"name":"singlegloss"},
		{"name":"sn","arg":{"format":"[]{}","snippet":"sn[${1:judgment}]{${2:sentence}}"},"doc":"Use \\sn for examples without identifiers."},
		{"name":"sn","arg":{"format":"{}","snippet":"sn{${1:sentence}}"},"doc":"Use \\sn for examples without identifiers."},
		{"name":"subexsep","arg":{"format":"{}","snippet":"subexsep{${1:length}}"}},
