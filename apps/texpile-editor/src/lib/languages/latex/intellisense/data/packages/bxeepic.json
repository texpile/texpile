{
	"deps": [{"name":"pict2e"},{"name":"trig"}],
	"macros": [
		{"name":"allinethickness","arg":{"format":"{}","snippet":"allinethickness{${1}}"}},
		{"name":"arc","arg":{"format":"{}{}{}","snippet":"arc{${1:diameter}}{${2:start angle}}{${3:end angle}}"}},
		{"name":"arc*","arg":{"format":"{}{}{}","snippet":"arc*{${1:diameter}}{${2:start angle}}{${3:end angle}}"}},
		{"name":"bxGridLabelForm","arg":{"format":"{}","snippet":"bxGridLabelForm{${1}}"},"unusual":true},
		{"name":"dashline","arg":{"format":"[]{}[]()()","snippet":"dashline[${1:stretch}]{${2:dash-length}}[${3:dotgap}](${4:x1,y1})(${5:x2,y2})"}},
		{"name":"dashline","arg":{"format":"{}()()","snippet":"dashline{${1:dash-length}}(${2:x1,y1})(${3:x2,y2})"}},
		{"name":"dashlines","arg":{"format":"[]{}[]","snippet":"dashlines[${1:stretch}]{${2:dash-length}}[${3:dotgap}]"}},
		{"name":"dashlines","arg":{"format":"{}","snippet":"dashlines{${1:dash-length}}"}},
		{"name":"dashlinestretch"},
		{"name":"dottedline","arg":{"format":"[]{}()()","snippet":"dottedline[${1:dot character}]{${2:dotgap}}(${3:x1,y1})(${4:x2,y2})"}},
		{"name":"dottedline","arg":{"format":"{}()()","snippet":"dottedline{${1:dotgap}}(${2:x1,y1})(${3:x2,y2})"}},
		{"name":"dottedlines","arg":{"format":"[]{}","snippet":"dottedlines[${1}]{${2}}"}},
		{"name":"dottedlines","arg":{"format":"{}","snippet":"dottedlines{${1}}"}},
		{"name":"drawline","arg":{"format":"[]()()","snippet":"drawline[${1:stretch}](${2:x1,y1})(${3:x2,y2})"}},
		{"name":"drawline","arg":{"format":"()()","snippet":"drawline(${1:x1,y1})(${2:x2,y2})"}},
		{"name":"drawlines","arg":{"format":"[]","snippet":"drawlines[${1}]"}},
		{"name":"drawlines"},
		{"name":"drawlinestretch"},
		{"name":"eepicdottedlines"},
		{"name":"ellipse","arg":{"format":"{}{}","snippet":"ellipse{${1:x-diameter}}{${2:y-diameter}}"}},
		{"name":"ellipse*","arg":{"format":"{}{}","snippet":"ellipse*{${1:x-diameter}}{${2:y-diameter}}"}},
		{"name":"epicbottomgridlabelsep","unusual":true},
		{"name":"epicsidegridlabelsep","unusual":true},
		{"name":"epictopgridlabelsep","unusual":true},
		{"name":"flushjoin","unusual":true},
		{"name":"grid","arg":{"format":"()()[]","snippet":"grid(${1:wd,ht})(${2:delta-wd,delta-ht})[${3:initial-X,initial-Y}]"}},
		{"name":"grid","arg":{"format":"()()","snippet":"grid(${1:wd,ht})(${2:delta-wd,delta-ht})"}},
		{"name":"jput","arg":{"format":"(){}","snippet":"jput(${1:x,y}){${2:item}}"}},
		{"name":"matrixput","arg":{"format":"()(){}(){}{}","snippet":"matrixput(${1:x,y})(${2:delta-x1,delta-y1}){${3:n1}}(${4:delta-x2,delta-y2}){${5:n2}}{${6:object}}"}},
		{"name":"maxovaldiam"},
		{"name":"multiputlist","arg":{"format":"()()[]{}","snippet":"multiputlist(${1:x,y})(${2:delta-x,delta-y})[${3:tbrl}]{${4:item1,item2,...}}"}},
		{"name":"multiputlist","arg":{"format":"()(){}","snippet":"multiputlist(${1:x,y})(${2:delta-x,delta-y}){${3:item1,item2,...}}"}},
		{"name":"noeepicdottedlines"},
		{"name":"path","arg":{"format":"()()","snippet":"path(${1:x1,y1})(${2:x2,y2})"}},
		{"name":"picsquare"},
		{"name":"putfile","arg":{"format":"{}{}","snippet":"putfile{${1}}{${2}}"}},
		{"name":"spline","arg":{"format":"()()","snippet":"spline(${1:x1,y1})(${2:x2,y2})"}},
		{"name":"Thicklines"}
	],
	"envs": [
		{"name":"dashjoin","arg":{"format":"[]{}[]","snippet":"[${1:stretch}]{${2:dash-length}}[${3:dotgap}]"}},
		{"name":"dashjoin","arg":{"format":"{}","snippet":"{${1:dash-length}}"}},
		{"name":"dottedjoin","arg":{"format":"[]{}","snippet":"[${1}]{${2}}"}},
		{"name":"dottedjoin","arg":{"format":"{}","snippet":"{${1}}"}},
		{"name":"drawjoin","arg":{"format":"[]","snippet":"[${1}]"}},
		{"name":"drawjoin"}
	],
	"keys": {
		"\\usepackage/bxeepic#c": ["nosafe","safe"]
	},
	"args": ["\\usepackage/bxeepic#c"]
}
