		{"name":"extraheaders","unusual":true},
		{"name":"gobblepageref"},
		{"name":"indexcapstyle","arg":{"format":"{}","snippet":"indexcapstyle{${1:letter}}"}},
		{"name":"indexincontents"},
		{"name":"indexpreamble","unusual":true},
		{"name":"multindpreamble","unusual":true},
		{"name":"printindex","arg":{"format":"[][]","snippet":"printindex[${1:index tag}][${2:index title}]"}},
		{"name":"printindex"},
		{"name":"setindex","arg":{"format":"{}","snippet":"setindex{${1:index tag}}"},"doc":"With the \\setindex command we activate an index."},
		{"name":"sindex","arg":{"format":"[]{}","snippet":"sindex[${1:index tag}]{${2:entry}}"}},
		{"name":"sindex","arg":{"format":"{}","snippet":"sindex{${1:entry}}"}}
