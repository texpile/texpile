{
	"deps": [{"name":"class-article"},{"name":"doc"},{"name":"multicol"},{"name":"hypdoc","if":"!doc2"},{"name":"atveryend-ltx","if":"!doc2"},{"name":"hyperref","if":"!doc2"},{"name":"iftex","if":"!doc2"},{"name":"keyval","if":"!doc2"},{"name":"kvsetkeys","if":"!doc2"},{"name":"pdfescape","if":"!doc2"},{"name":"pdftexcmds","if":"!doc2"},{"name":"nameref","if":"!doc2"},{"name":"refcount","if":"!doc2"},{"name":"gettitlestring","if":"!doc2"},{"name":"kvoptions","if":"!doc2"},{"name":"etoolbox","if":"!doc2"},{"name":"stringenc","if":"!doc2"},{"name":"intcalc","if":"!doc2"},{"name":"url","if":"!doc2"},{"name":"bitset","if":"!doc2"},{"name":"bigintcalc","if":"!doc2"},{"name":"rerunfilecheck","if":"!doc2"},{"name":"uniquecounter","if":"!doc2"}],
	"macros": [
		{"name":"aalph","arg":{"format":"{}","snippet":"aalph{${1}}"},"unusual":true},
		{"name":"cls","arg":{"format":"{}","snippet":"cls{${1:class name}}"}},
		{"name":"cmd","arg":{"format":"{}","snippet":"cmd{${1:command}}"}},
		{"name":"DocInclude","arg":{"format":"{}","snippet":"DocInclude{${1:file name without extension}}"}},
		{"name":"enquote","arg":{"format":"{}","snippet":"enquote{${1:text}}"}},
		{"name":"LuaTeX"},
		{"name":"MaintainedBy","arg":{"format":"{}","snippet":"MaintainedBy{${1:maintainer text}}"}},
		{"name":"MaintainedByLaTeXTeam","arg":{"format":"{}","snippet":"MaintainedByLaTeXTeam{${1:bug category}}"},"doc":"Generate boilerplate reference to bug database."},
		{"name":"marg","arg":{"format":"{}","snippet":"marg{${1:text}}"},"doc":"\\marg{text} prints {⟨text⟩}, ‘mandatory argument’."},
		{"name":"oarg","arg":{"format":"{}","snippet":"oarg{${1:text}}"},"doc":"\\oarg{text} prints [⟨text⟩], ‘optional argument’."},
		{"name":"parg","arg":{"format":"{}","snippet":"parg{${1:text}}"},"doc":"\\parg{te,xt} prints (⟨te,xt⟩), ‘picture mode argument’."},
		{"name":"pkg","arg":{"format":"{}","snippet":"pkg{${1:package name}}"}}
	],
	"envs": [
		{"name":"oldcomments"}
	],
	"keys": {
		"\\documentclass/ltxdoc#c": ["a5paper","doc2","nocfg"]
	},
	"args": ["\\documentclass/ltxdoc#c"]
}
