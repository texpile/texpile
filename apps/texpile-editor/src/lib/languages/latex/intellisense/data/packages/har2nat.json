{
	"deps": [{"name":"suffix"},{"name":"natbib"}],
	"macros": [
		{"name":"citeaffixed","arg":{"format":"{}{}","snippet":"citeaffixed{${1:key}}{${2:prefix}}"}},
		{"name":"citeasnoun","arg":{"format":"[][]{}","snippet":"citeasnoun[${1:pre-note}][${2:post-note}]{${3:key}}"}},
		{"name":"citeasnoun","arg":{"format":"{}","snippet":"citeasnoun{${1:key}}"}},
		{"name":"citeasnoun*","arg":{"format":"[][]{}","snippet":"citeasnoun*[${1:pre-note}][${2:post-note}]{${3:key}}"}},
		{"name":"citeasnoun*","arg":{"format":"{}","snippet":"citeasnoun*{${1:key}}"}},
		{"name":"citename","arg":{"format":"[][]{}","snippet":"citename[${1:pre-note}][${2:post-note}]{${3:key}}"}},
		{"name":"citename","arg":{"format":"{}","snippet":"citename{${1:key}}"}},
		{"name":"citename*","arg":{"format":"[][]{}","snippet":"citename*[${1:pre-note}][${2:post-note}]{${3:key}}"}},
		{"name":"citename*","arg":{"format":"{}","snippet":"citename*{${1:key}}"}},
		{"name":"citeyear","arg":{"format":"[][]{}","snippet":"citeyear[${1:pre-note}][${2:post-note}]{${3:key}}"}},
		{"name":"citeyear","arg":{"format":"{}","snippet":"citeyear{${1:key}}"}},
		{"name":"citeyear*","arg":{"format":"[][]{}","snippet":"citeyear*[${1:pre-note}][${2:post-note}]{${3:key}}"}},
		{"name":"citeyear*","arg":{"format":"{}","snippet":"citeyear*{${1:key}}"}}
	],
	"envs": [],
	"keys": {}
}
