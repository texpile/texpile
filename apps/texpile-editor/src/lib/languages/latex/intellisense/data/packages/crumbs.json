		{"name":"crumbection","arg":{"format":"{}","snippet":"crumbection{${1:title}}"}},
		{"name":"crumbs"},
		{"name":"subcrumb","arg":{"format":"{}{}","snippet":"subcrumb{${1:short name}}{${2:full name}}"}},
		{"name":"subcrumbection","arg":{"format":"[]{}","snippet":"subcrumbection[${1:short title}]{${2:title}}"}},
		{"name":"subcrumbection","arg":{"format":"{}","snippet":"subcrumbection{${1:title}}"}},
		{"name":"subcrumbs"}
	],
