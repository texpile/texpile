	"deps": [{"name":"xkeyval"},{"name":"etoolbox"},{"name":"catchfile"},{"name":"iftex"}],
	"macros": [
		{"name":"crumb","arg":{"format":"{}{}","snippet":"crumb{${1:short name}}{${2:full name}}"}},
