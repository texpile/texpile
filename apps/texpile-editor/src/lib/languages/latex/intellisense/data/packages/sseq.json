		{"name":"ssdrop","arg":{"format":"{}","snippet":"ssdrop{${1:mathcode}}"},"doc":"The command \\ssdrop[⟨optios⟩]{⟨mathcode⟩} will display mathcode at the current cursor position."},
		{"name":"ssdropboxed","arg":{"format":"{}","snippet":"ssdropboxed{${1:mathcode}}"}},
