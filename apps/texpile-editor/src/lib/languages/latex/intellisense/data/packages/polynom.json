{
	"deps": [{"name":"keyval"}],
	"macros": [
		{"name":"polyadd","arg":{"format":"{}{}{}","snippet":"polyadd{${1:a+b}}{${2:polynomial a}}{${3:polynomial b}}"}},
		{"name":"polydiv","arg":{"format":"{}{}{}","snippet":"polydiv{${1:a/b}}{${2:polynomial a}}{${3:polynomial b}}"}},
		{"name":"polyfactorize","arg":{"format":"{}","snippet":"polyfactorize{${1:polynomial}}"},"doc":"The command prints a factorization of the polynomial as long as all except two roots are rational, see figure 3."},
		{"name":"polygcd","arg":{"format":"{}{}{}","snippet":"polygcd{${1:gcd}}{${2:polynomial a}}{${3:polynomial b}}"}},
		{"name":"polyhornerscheme","arg":{"format":"[]{}","snippet":"polyhornerscheme[${1:key=value list}]{${2:polynomial}}","keys":["keyval:pld"],"keyPos":0},"doc":"The command prints Horner’s scheme for the given polynomial with respect to the specified evaluation point."},
		{"name":"polyhornerscheme","arg":{"format":"{}","snippet":"polyhornerscheme{${1:polynomial}}"},"doc":"The command prints Horner’s scheme for the given polynomial with respect to the specified evaluation point."},
		{"name":"polylongdiv","arg":{"format":"[]{}{}","snippet":"polylongdiv[${1:key=value list}]{${2:polynomial a}}{${3:polynomial b}}","keys":["keyval:pld"],"keyPos":0}},
		{"name":"polylongdiv","arg":{"format":"{}{}","snippet":"polylongdiv{${1:polynomial a}}{${2:polynomial b}}"}},
		{"name":"polylonggcd","arg":{"format":"[]{}{}","snippet":"polylonggcd[${1:key=value list}]{${2:polynomial a}}{${3:polynomial b}}","keys":["keyval:pld"],"keyPos":0}},
		{"name":"polylonggcd","arg":{"format":"{}{}","snippet":"polylonggcd{${1:polynomial a}}{${2:polynomial b}}"}},
		{"name":"polymul","arg":{"format":"{}{}{}","snippet":"polymul{${1:ab}}{${2:polynomial a}}{${3:polynomial b}}"}},
		{"name":"polyprint","arg":{"format":"{}","snippet":"polyprint{${1:polynomial}}"}},
		{"name":"polyremainder"},
		{"name":"polyset","arg":{"format":"{}","snippet":"polyset{${1:key=value list}}","keys":["keyval:pld"],"keyPos":0},"doc":"\\polyset changes the settings for the rest of the current environment or group."},
		{"name":"polysub","arg":{"format":"{}{}{}","snippet":"polysub{${1:a-b}}{${2:polynomial a}}{${3:polynomial b}}"}}
	],
	"envs": [],
	"keys": {
		"keyval:pld": ["X=","arraycolsep=","arrayrowsep=","delims=","div=","resultstyle=","stage=","tutorlimit=","tutorstyle=","vars=","x=","style=${1|A,B,C,D|}","showbase=${1|false,top,middle,bottom|}","showvar=${1|true,false|}","showbasesep=${1|true,false|}","showmiddlerow=${1|true,false|}","resultleftrule=${1|true,false|}","resultrightrule=${1|true,false|}","resultbottomrule=${1|true,false|}","equalcolwidths=${1|true,false|}","tutor=${1|true,false|}"]
	}
}
