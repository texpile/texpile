{
	"deps": [{"name":"makematch"},{"name":"verbatim"}],
	"macros": [
		{"name":"CalledName","arg":{"format":"{}","snippet":"CalledName{${1}}"}},
		{"name":"CloseValueFile"},
		{"name":"Expect","arg":{"format":"[]{}{}","snippet":"Expect[${1:label}]{${2:value}}{${3:expected value}}"}},
		{"name":"Expect","arg":{"format":"{}{}","snippet":"Expect{${1:value}}{${2:expected value}}"}},
		{"name":"ExpectIfThen","arg":{"format":"{}","snippet":"ExpectIfThen{${1}}"}},
		{"name":"IncludeTests","arg":{"format":"{}","snippet":"IncludeTests{${1:pattern list}}"}},
		{"name":"InRange","arg":{"format":"{}{}","snippet":"InRange{${1}}{${2}}"}},
		{"name":"InternalSetValue","unusual":true},
		{"name":"LogClose","arg":{"format":"{}","snippet":"LogClose{${1}}"},"doc":"You can explicitly close a log file if you want to reread it in the course of processing, or call an executable that would process it."},
		{"name":"LogTests","arg":{"format":"{}{}{}","snippet":"LogTests{${1}}{${2}}{${3}}"}},
		{"name":"NearTo","arg":{"format":"[]{}","snippet":"NearTo[${1:tolerance}]{${2:value}}"}},
		{"name":"NearTo","arg":{"format":"{}","snippet":"NearTo{${1:value}}"}},
		{"name":"SavedValue","arg":{"format":"{}","snippet":"SavedValue{${1}}"}},
		{"name":"SaveValue","arg":{"format":"{}{}","snippet":"SaveValue{${1:label}}{${2:value}}"}},
		{"name":"SaveValueFile","arg":{"format":"{}","snippet":"SaveValueFile{${1}}"},"doc":"This gets one argument specifying which file name to use for saving results."},
		{"name":"TestErrors","arg":{"format":"{}","snippet":"TestErrors{${1:pattern list}}"}}
	],
	"envs": [
		{"name":"ExpectCallSequence","arg":{"format":"{}","snippet":"{${1}}"},"doc":"The environment ExpectCallSequence tells the test system that macros are going to be called in a certain order and with particular types of arguments."},
		{"name":"qstest","arg":{"format":"{}{}","snippet":"{${1}}{${2}}"}}
	],
	"keys": {}
}
