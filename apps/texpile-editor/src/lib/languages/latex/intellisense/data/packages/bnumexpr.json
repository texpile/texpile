{
	"deps": [{"name":"xintkernel"},{"name":"xintcore","if":"!custom+!customcore"},{"name":"xintbinhex","if":"!custom+!custombinhex"}],
	"macros": [
		{"name":"bnethe","doc":"The \\bnethe prefix converts from some private format (using braces and other things)."},
		{"name":"bnumdefinfix","arg":{"format":"{}{}{}{}","snippet":"bnumdefinfix{${1:operator}}{${2:macro}}{${3:L-prec}}{${4:R-prec}}"}},
		{"name":"bnumdefpostfix","arg":{"format":"{}{}{}","snippet":"bnumdefpostfix{${1:operator}}{${2:macro}}{${3:L-prec}}"}},
		{"name":"bnumeval","arg":{"format":"[]{}","snippet":"bnumeval[${1:h|ha|o|b}]{${2:expression}}"}},
		{"name":"bnumeval","arg":{"format":"{}","snippet":"bnumeval{${1:expression}}"}},
		{"name":"bnumexpr"},
		{"name":"bnumexpro","unusual":true},
		{"name":"bnumprintone","arg":{"format":"{}","snippet":"bnumprintone{${1}}"}},
		{"name":"bnumprintonebin","arg":{"format":"{}","snippet":"bnumprintonebin{${1}}"}},
		{"name":"bnumprintonehex","arg":{"format":"{}","snippet":"bnumprintonehex{${1}}"}},
		{"name":"bnumprintonelowerhex","arg":{"format":"{}","snippet":"bnumprintonelowerhex{${1}}"}},
		{"name":"bnumprintoneoct","arg":{"format":"{}","snippet":"bnumprintoneoct{${1}}"}},
		{"name":"bnumprintonesep"},
		{"name":"bnumsetup","arg":{"format":"{}","snippet":"bnumsetup{${1:key=macro list}}"}},
		{"name":"thebnumexpr"}
	],
	"envs": [],
	"keys": {
		"\\usepackage/bnumexpr#c": ["custom","custombinhex","customcore"]
	},
	"args": ["\\usepackage/bnumexpr#c"]
}
