{
	"deps": [{"name":"class-article"},{"name":"makeidx","if":"index"}],
	"macros": [
		{"name":"AddBlankLine"},
		{"name":"BoxTolerance","arg":{"format":"{}","snippet":"BoxTolerance{${1:dimension}}"},"doc":"Verbatim lines often go into the right margin. This is the threshold above which TeX reports an overfull box."},
		{"name":"bslash","doc":"Everybody needs a backslash. This one is meant to print equally well in usual contexts and in PDF bookmarks created by hyperref, if any."},
		{"name":"CloseFile","arg":{"format":"{}","snippet":"CloseFile{${1:file}}"}},
		{"name":"CodeEscape","arg":{"format":"{}","snippet":"CodeEscape{${1:character}}"}},
		{"name":"CodeFont","arg":{"format":"{}","snippet":"CodeFont{${1:font specifications}}"},"doc":"The font of the code environment may be changed with \\CodeFont (by default, it's \\ttfamily)."},
		{"name":"CodeInput"},
		{"name":"CodeOutput"},
		{"name":"DangerousEnvironment","arg":{"format":"{}","snippet":"DangerousEnvironment{${1:list of environments}}"},"doc":"Whenever you want CodeDoc to skip an environment in produce mode, for instance because it's a verbatim environment designed by yourself, you can add its name to \\DangerousEnvironment."},
		{"name":"DefineEnvironment","arg":{"format":"{}","snippet":"DefineEnvironment{${1:environment}}"}},
		{"name":"DefineIndexFont","arg":{"format":"{}","snippet":"DefineIndexFont{${1:font specifications}}"}},
		{"name":"DefineMacro","arg":{"format":"{}","snippet":"DefineMacro{${1:macro}}"}},
		{"name":"DescribeEnvironment","arg":{"format":"{}","snippet":"DescribeEnvironment{${1:environment}}"}},
		{"name":"DescribeIndexFont","arg":{"format":"{}","snippet":"DescribeIndexFont{${1:font specifications}}"}},
		{"name":"DescribeMacro","arg":{"format":"{}","snippet":"DescribeMacro{${1:macro}}"}},
		{"name":"DocStripMarginpar","doc":"This reverses marginpar and sets the right value for \\marginparpush and \\marginparwidth."},
		{"name":"eTeXOff"},
		{"name":"eTeXOn"},
		{"name":"FileDate"},
		{"name":"FileName"},
		{"name":"FileSource"},
		{"name":"FileVersion"},
		{"name":"Gobble","arg":{"format":"{}","snippet":"Gobble{${1:number}}"},"doc":"The number of characters that will be gobbled at the beginning of each line."},
		{"name":"Header","arg":{"format":"{}","snippet":"Header{${1:text}}"}},
		{"name":"IgnorePrefix","arg":{"format":"{}","snippet":"IgnorePrefix{${1:macro prefix}}"}},
		{"name":"LineNumber","arg":{"format":"{}{}{}[]","snippet":"LineNumber{${1:name}}{${2:font specifications}}{${3:width}}[${4:number}]"}},
		{"name":"LineNumber","arg":{"format":"{}{}{}","snippet":"LineNumber{${1:name}}{${2:font specifications}}{${3:width}}"}},
		{"name":"marg","arg":{"format":"{}","snippet":"marg{${1:argument}}"}},
		{"name":"meta","arg":{"format":"{}","snippet":"meta{${1:argument}}"}},
		{"name":"NewExample","arg":{"format":"[]{}{}{}{}","snippet":"NewExample[${1:options}]{${2:name}}{${3:code input}}{${4:code output}}{${5:immediate execution}}"}},
		{"name":"NewExample","arg":{"format":"{}{}{}{}","snippet":"NewExample{${1:name}}{${2:code input}}{${3:code output}}{${4:immediate execution}}"}},
		{"name":"oarg","arg":{"format":"{}","snippet":"oarg{${1:argument}}"}},
		{"name":"parg","arg":{"format":"{}","snippet":"parg{${1:argument}}"}},
		{"name":"PrintMacro","arg":{"format":"{}","snippet":"PrintMacro{${1:macro or environment}}"}},
		{"name":"PrintPrefix","arg":{"format":"{}","snippet":"PrintPrefix{${1:macro prefix}}"}},
		{"name":"ProduceFile","arg":{"format":"{}[][][]","snippet":"ProduceFile{${1:file}}[${2:file name}][${3:file version}][${4:file date}]"}},
		{"name":"ProduceFile","arg":{"format":"{}","snippet":"ProduceFile{${1:file}}"}},
		{"name":"RenewExample","arg":{"format":"[]{}{}{}{}","snippet":"RenewExample[${1:options}]{${2:name}}{${3:code input}}{${4:code output}}{${5:immediate execution}}"}},
		{"name":"RenewExample","arg":{"format":"{}{}{}{}","snippet":"RenewExample{${1:name}}{${2:code input}}{${3:code output}}{${4:immediate execution}}"}},
		{"name":"ShortCode","arg":{"format":"[]{}","snippet":"ShortCode[${1:example name}]{${2:character}}"}},
		{"name":"ShortCode","arg":{"format":"{}","snippet":"ShortCode{${1:character}}"}},
		{"name":"ShortVerb","arg":{"format":"{}","snippet":"ShortVerb{${1:character}}"}},
		{"name":"StartIgnore","doc":"In produce mode, when CodeDoc encouters \\StartIgnore, everything is skipped until \\StopIgnore is found."},
		{"name":"StopHere","arg":{"format":"{}","snippet":"StopHere{${1:code}}"}},
		{"name":"StopIgnore"},
		{"name":"TabSize","arg":{"format":"{}","snippet":"TabSize{${1:number}}"},"doc":"This is the number of spaces by which a tabulation will be represented in verbatim context."},
		{"name":"UndoCodeEscape"},
		{"name":"UndoShortCode"},
		{"name":"UndoShortVerb"},
		{"name":"UndoVerbBreak"},
		{"name":"UndoVerbCommand"},
		{"name":"VerbBreak","arg":{"format":"{}","snippet":"VerbBreak{${1:character}}"}},
		{"name":"VerbCommand","arg":{"format":"{}{}{}","snippet":"VerbCommand{${1:escape}}{${2:left brace}}{${3:right brace}}"}}
	],
	"envs": [
		{"name":"code"},
		{"name":"code*"},
		{"name":"example"},
		{"name":"example*"},
		{"name":"invisible","doc":"This material will be written to codedoc.cls but not typeset in the documentation."}
	],
	"keys": {
		"\\documentclass/codedoc#c": ["autoclose","index","noheader","obeystop","produce","tracing0","tracing1","tracing2"]
	},
	"args": ["\\documentclass/codedoc#c"]
}
