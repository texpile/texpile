{
	"deps": [{"name":"ifthen"},{"name":"nicefrac"}],
	"macros": [
		{"name":"unit","arg":{"format":"[]{}","snippet":"unit[${1:value}]{${2:unit}}"}},
		{"name":"unit","arg":{"format":"{}","snippet":"unit{${1:unit}}"}},
		{"name":"unitfrac","arg":{"format":"[]{}{}","snippet":"unitfrac[${1:value}]{${2:numerator unit}}{${3:denominator unit}}"}},
		{"name":"unitfrac","arg":{"format":"{}{}","snippet":"unitfrac{${1:numerator unit}}{${2:denominator unit}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/units#c": ["loose","nice","tight","ugly"]
	},
	"args": ["\\usepackage/units#c"]
}
