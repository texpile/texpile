{
	"deps": [{"name":"makeidx"},{"name":"xesearch"}],
	"macros": [
		{"name":"IndexList","arg":{"format":"{}{}","snippet":"IndexList{${1:list name}}{${2:list of entries}}"}},
		{"name":"IndexList*","arg":{"format":"{}{}","snippet":"IndexList*{${1:list name}}{${2:list of entries}}"}},
		{"name":"NoIndex","arg":{"format":"{}","snippet":"NoIndex{${1:text}}"},"doc":"\\NoIndex{⟨text⟩} simply prevents ⟨text⟩ from being indexed."},
		{"name":"StopIndex","doc":"\\StopIndex turns off all lists."},
		{"name":"StopIndexList","arg":{"format":"{}","snippet":"StopIndexList{${1:lists}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/xeindex#c": ["mark"]
	},
	"args": ["\\usepackage/xeindex#c"]
}
