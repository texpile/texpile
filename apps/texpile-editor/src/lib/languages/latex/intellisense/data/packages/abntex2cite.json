		{"name":"AfterTheBibliography","arg":{"format":"{}","snippet":"AfterTheBibliography{${1}}"},"unusual":true},
		{"name":"apud","arg":{"format":"[]{}{}","snippet":"apud[${1:page}]{${2:key}}{${3:source key}}"},"doc":"Para citar uma referência que é citada dentro de outra referência, pode-se usar as macros \\apud e \\apudonline, como nos exemplos abaixo."},
		{"name":"apud","arg":{"format":"{}{}","snippet":"apud{${1:key}}{${2:source key}}"},"doc":"Para citar uma referência que é citada dentro de outra referência, pode-se usar as macros \\apud e \\apudonline, como nos exemplos abaixo."},
		{"name":"apudname","unusual":true},
		{"name":"apudonline","arg":{"format":"[]{}{}","snippet":"apudonline[${1:page}]{${2:key}}{${3:source key}}"},"doc":"Para citar uma referência que é citada dentro de outra referência, pode-se usar as macros \\apud e \\apudonline, como nos exemplos abaixo."},
		{"name":"apudonline","arg":{"format":"{}{}","snippet":"apudonline{${1:key}}{${2:source key}}"},"doc":"Para citar uma referência que é citada dentro de outra referência, pode-se usar as macros \\apud e \\apudonline, como nos exemplos abaixo."},
		{"name":"authorcapstyle"},
		{"name":"authorstyle"},
