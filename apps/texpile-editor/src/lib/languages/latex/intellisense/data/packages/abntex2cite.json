		{"name":"citenum","arg":{"format":"[]{}","snippet":"citenum[${1}]{${2}}"},"unusual":true,"if":"alf"},
		{"name":"citenum","arg":{"format":"{}","snippet":"citenum{${1}}"},"unusual":true,"if":"alf"}
