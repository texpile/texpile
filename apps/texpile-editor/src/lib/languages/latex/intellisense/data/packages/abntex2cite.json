		{"name":"etseqname","unusual":true},
		{"name":"footciteref","arg":{"format":"{}","snippet":"footciteref{${1:keys}}"}},
		{"name":"hiddenbibitem","arg":{"format":"[]{}","snippet":"hiddenbibitem[${1}]{${2}}"},"unusual":true},
		{"name":"hiddenbibitem","arg":{"format":"{}","snippet":"hiddenbibitem{${1}}"},"unusual":true},
		{"name":"Ibidem","arg":{"format":"[]{}","snippet":"Ibidem[${1:page}]{${2:key}}"}},
