		{"name":"loccit","arg":{"format":"[]{}","snippet":"loccit[${1:page}]{${2:key}}"}},
		{"name":"loccit","arg":{"format":"{}","snippet":"loccit{${1:key}}"}},
		{"name":"loccitname","unusual":true},
		{"name":"minimumbiblabelwidth","unusual":true},
		{"name":"opcit","arg":{"format":"[]{}","snippet":"opcit[${1:page}]{${2:key}}"}},
		{"name":"opcit","arg":{"format":"{}","snippet":"opcit{${1:key}}"}},
		{"name":"opcitname","unusual":true},
		{"name":"optionaltextstyle","unusual":true},
