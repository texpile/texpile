		{"name":"citeifnotcited","arg":{"format":"{}","snippet":"citeifnotcited{${1}}"},"unusual":true},
		{"name":"citenumstyle","unusual":true},
		{"name":"citeonline","arg":{"format":"[]{}","snippet":"citeonline[${1:page}]{${2:keys}}"}},
