	"envs": [],
	"keys": {
		"\\usepackage/abntex2cite#c": ["abnt-option-file","abnt-substyle=COPPE","alf","alfantigo","bibjustif","biblabel-not-on-margin","biblabel-on-margin","bibleftalign","experimental","foot","indent","inlinecite","load-text","load-text-on-demand","no-abnt-option-file","not-foot","num","overcite","recuo","versalete"]
