{
	"macros": [
		{"name":"appendixref","arg":{"format":"{}","snippet":"appendixref{${1:label keys}}"}},
		{"name":"chapterref","arg":{"format":"{}","snippet":"chapterref{${1:label keys}}"}},
		{"name":"docdate","unusual":true},
		{"name":"eqname","arg":{"format":"{}","snippet":"eqname{${1}}"},"unusual":true},
		{"name":"eqref","arg":{"format":"{}","snippet":"eqref{${1:label key}}"},"doc":"\\eqref is based on the command of the same name provided by AMS-LaTeX. It is used to reference labels of the equation type and it produces the equation numbers as displayed with the referenced equation(s)."},
		{"name":"equationref","arg":{"format":"{}","snippet":"equationref{${1:label keys}}"}},
		{"name":"figureref","arg":{"format":"{}","snippet":"figureref{${1:label keys}}"}},
		{"name":"filedate","unusual":true},
		{"name":"fileversion","unusual":true},
		{"name":"footnoteref","arg":{"format":"{}","snippet":"footnoteref{${1:label keys}}"}},
		{"name":"itemname","arg":{"format":"{}","snippet":"itemname{${1:label type}}"},"doc":"The \\itemname command can be used to cause items to be of arbitrary type, e.g., if you were using an enumerate environment to list problems, then then \\itemname{problem} would require them to be referenced like \\problemref{key}."},
		{"name":"itemref","arg":{"format":"{}","snippet":"itemref{${1:label keys}}"}},
		{"name":"newtheorem","arg":{"format":"{}[]{}{}[]","snippet":"newtheorem{${1:name}}[${2:numbered like}]{${3:singular}}{${4:plural}}[${5:within}]"}},
		{"name":"newtheorem","arg":{"format":"{}{}{}","snippet":"newtheorem{${1:name}}{${2:singular}}{${3:plural}}"}},
		{"name":"newtheorem*","arg":{"format":"{}[]{}{}[]","snippet":"newtheorem*{${1:name}}[${2:numbered like}]{${3:singular}}{${4:plural}}[${5:within}]"}},
		{"name":"newtheorem*","arg":{"format":"{}{}{}","snippet":"newtheorem*{${1:name}}{${2:singular}}{${3:plural}}"}},
		{"name":"paragraphref","arg":{"format":"{}","snippet":"paragraphref{${1:label keys}}"}},
		{"name":"partref","arg":{"format":"{}","snippet":"partref{${1:label keys}}"}},
		{"name":"refname","arg":{"format":"{}{}{}","snippet":"refname{${1:label type}}{${2:singular}}{${3:plural}}"}},
		{"name":"sectionref","arg":{"format":"{}","snippet":"sectionref{${1:label keys}}"}},
		{"name":"tableref","arg":{"format":"{}","snippet":"tableref{${1:label keys}}"}}
	],
	"envs": [],
	"keys": {}
}
