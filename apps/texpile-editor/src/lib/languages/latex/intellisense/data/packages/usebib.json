{
	"deps": [{"name":"url"},{"name":"keyval"}],
	"macros": [
		{"name":"bibinput","arg":{"format":"{}","snippet":"bibinput{${1:bib file name}}"},"doc":"The macro that starts the reading of a .bib file."},
		{"name":"newbibfield","arg":{"format":"{}","snippet":"newbibfield{${1:field}}"},"doc":"\\newbibfield{type} defines a new key."},
		{"name":"newbibignore","arg":{"format":"{}","snippet":"newbibignore{${1:entry type}}"}},
		{"name":"usebibentry","arg":{"format":"{}{}","snippet":"usebibentry{${1:key}}{${2:field}}"}},
		{"name":"usebibentryurl","arg":{"format":"[]{}","snippet":"usebibentryurl[${1:delimiter}]{${2:key}}"}},
		{"name":"usebibentryurl","arg":{"format":"{}","snippet":"usebibentryurl{${1:key}}"}}
	],
	"envs": [],
	"keys": {}
}
