{
	"macros": [
		{"name":"bibname"},
		{"name":"cbinput","arg":{"format":"{}","snippet":"cbinput{${1:file}}"}},
		{"name":"CBMainSectioning"},
		{"name":"CitationPrefix","arg":{"format":"{}","snippet":"CitationPrefix{${1:prefix}}"}},
		{"name":"citeform","arg":{"format":"{}","snippet":"citeform{${1:citation}}"},"doc":"Normally, the citations are formatted as given, but you can define \\citeform (with one parameter) to reformat every citation."},
		{"name":"citepunct","doc":"The \\citepunct command gives the punctuation (comma-penalty-space) between items in the \\cite list, and you can redefine it."},
		{"name":"FinalBibPrefix"},
		{"name":"FinalBibTitles"},
		{"name":"sectionbib","arg":{"format":"{}{}","snippet":"sectionbib{${1:sectioning command}}{${2:level name}}"}},
		{"name":"StartFinalBibs","if":"sectionbib|duplicate|gather"},
		{"name":"StartFinalBibs","if":"sectionbib"},
		{"name":"StartFinalBibs","if":"duplicate"},
		{"name":"StartFinalBibs","if":"gather"}
	],
	"envs": [
		{"name":"cbunit"}
	],
	"keys": {
		"\\usepackage/chapterbib#c": ["draft","duplicate","gather","rootbib","sectionbib"]
	},
	"args": ["\\usepackage/chapterbib#c"]
}
