		{"name":"grammarfalse","unusual":true},
		{"name":"grammartrue","unusual":true},
		{"name":"ifgrammar","unusual":true},
		{"name":"ifinvertlanguages","unusual":true},
		{"name":"ifkeywordonly","unusual":true},
		{"name":"ifphonetic","unusual":true},
		{"name":"ifsinglelanguage","unusual":true},
		{"name":"invertlanguagesfalse","unusual":true},
		{"name":"invertlanguagestrue","unusual":true},
		{"name":"keywordonlyfalse","unusual":true},
		{"name":"keywordonlytrue","unusual":true},
		{"name":"leftfield","unusual":true},
		{"name":"phoneticfalse","unusual":true},
		{"name":"phonetictrue","unusual":true},
		{"name":"rightfield","unusual":true},
		{"name":"singlelanguagefalse","unusual":true},
		{"name":"singlelanguagetrue","unusual":true}
	],
	"envs": [],
	"keys": {
		"\\usepackage/lexikon#c": ["duallanguage","fullentry","grammar","invertlanguages","keywordonly","nogrammar","noinvertlanguages","nophonetic","phonetic","singlelanguage"]
	},
	"args": ["\\usepackage/lexikon#c"]
}
