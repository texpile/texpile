{
	"deps": [{"name":"xparse"},{"name":"newfloat"},{"name":"keyval"},{"name":"xcolor"},{"name":"colortbl"},{"name":"array"}],
	"macros": [
		{"name":"downplay"},
		{"name":"firstcase","arg":{"format":"{}{}{}","snippet":"firstcase{${1:non-terminal}}{${2:rule}}{${3:comment}}"}},
		{"name":"firstcasesubtil","arg":{"format":"{}{}{}","snippet":"firstcasesubtil{${1:non-terminal}}{${2:rule}}{${3:comment}}"}},
		{"name":"gralt","doc":"\\gralt is simply a pipe surrounded by large spaces."},
		{"name":"highlight","doc":"\\highlight highlights a whole line, \\loghighlight highlights a part of a line, while \\downplay downplays a line."},
		{"name":"listoffloatgrammars","unusual":true},
		{"name":"lochighlight","arg":{"format":"{}","snippet":"lochighlight{${1:text}}"},"doc":"For more local highlighting, it is possible to use \\lochighlight, which prints some part of a rule in red."},
		{"name":"nonterm","arg":{"format":"{}","snippet":"nonterm{${1:symbol}}"}},
		{"name":"nontermsubtil","arg":{"format":"{}","snippet":"nontermsubtil{${1:symbol}}"}},
		{"name":"otherform","arg":{"format":"{}{}","snippet":"otherform{${1:rule}}{${2:comment}}"},"doc":"Adds a line with an empty first cell, and which second cell is just a pipe."},
		{"name":"rowstyle","arg":{"format":"{}","snippet":"rowstyle{${1}}"},"unusual":true}
	],
	"envs": [
		{"name":"floatgrammar","arg":{"format":"[]","snippet":"[${1:placement}]"},"unusual":true},
		{"name":"floatgrammar","unusual":true},
		{"name":"grammar","arg":{"format":"[][][]","snippet":"[${1:caption}][${2:placement}][${3:label}]"}},
		{"name":"grammar"}
	],
	"keys": {
		"\\usepackage/formal-grammar#c": ["center"]
	},
	"args": ["\\usepackage/formal-grammar#c"]
}
