{
	"deps": [{"name":"crefthe"},{"name":"cleveref"},{"name":"regexpatch"},{"name":"xparse"},{"name":"amsfonts"}],
	"macros": [
		{"name":"CreateTheorem","arg":{"format":"{}{}","snippet":"CreateTheorem{${1:list of the name of environments}}{${2:key-value configuration}}","keys":["l3keys:create-theorem-creating"],"keyPos":1}},
		{"name":"CreateTheoremAddLanguage","arg":{"format":"{}","snippet":"CreateTheoremAddLanguage{${1}}"},"unusual":true},
		{"name":"NameTheorem","arg":{"format":"{}{}","snippet":"NameTheorem{${1:name of environment}}{${2:key-value configuration}}","keys":["l3keys:create-theorem-naming"],"keyPos":1}},
		{"name":"NameTheorems","arg":{"format":"{}{}","snippet":"NameTheorems{${1:language name}}{${2:key-value configuration}}","keys":["l3keys:create-theorem-naming-per-language"],"keyPos":1}},
		{"name":"SetTheorem","arg":{"format":"{}{}","snippet":"SetTheorem{${1:list of the name of environments}}{${2:key-value configuration}}","keys":["l3keys:create-theorem-setting"],"keyPos":1}},
		{"name":"SetTheoremBinding","arg":{"format":"{}{}","snippet":"SetTheoremBinding{${1:list of the name of environments}}{${2:the environment to bind with}}"}}
	],
	"envs": [],
	"keys": {
		"l3keys:create-theorem-creating": ["apply style=","apply-style=","applystyle=","combined=","copy existed=","copy-existed=","copyexisted=","name style=","name-style=","name=","namestyle=","qed","qed symbol","qed-symbol","qedsymbol","style=","use name=","use-name=","usename=","create numberless version","create starred version","create-numberless-version","create-starred-version","createnumberlessversion","createstarredversion","numberless","parent counter=","parent-counter=","parentcounter=","number within=","number-within=","numberwithin=","shared counter=","shared-counter=","sharedcounter=","number like=","number-like=","numberlike="],
		"l3keys:create-theorem-naming-per-language": ["Crefname=","crefname=","heading="],
		"l3keys:create-theorem-naming": ["Crefname style=","Crefname-style=","Crefname=","Crefnamestyle=","combined=","crefname style=","crefname-style=","crefname=","crefnamestyle=","heading style=","heading-style=","heading=","headingstyle=","numbering style=","numbering-style=","numberingstyle=","use name=","use-name=","usename="],
		"l3keys:create-theorem-setting": ["name style=","name-style=","name=","namestyle=","number like=","number within=","number-like=","number-within=","numberlike=","numberwithin=","parent counter=","parent-counter=","parentcounter=","qed","qed symbol","qed-symbol","qedsymbol","shared counter=","shared-counter=","sharedcounter="],
		"\\usepackage/create-theorem#c": ["name as context","name as is","name in link","name-as-context","name-as-is","name-in-link","nameascontext","nameasis","nameinlink","no preset names","no-preset-names","nopresetnames","originalref","regionalref"]
	},
	"args": ["\\usepackage/create-theorem#c"]
}
