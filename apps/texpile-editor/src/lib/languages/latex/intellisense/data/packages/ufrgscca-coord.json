{
	"deps": [{"name":"longtable"},{"name":"multirow"},{"name":"pgfcalendar"},{"name":"pgfrcs"},{"name":"pgfkeys"},{"name":"ufrgscca-core"},{"name":"ufrgscca-forms"},{"name":"amsfonts"}],
	"macros": [
		{"name":"ActivitySetEventDay","arg":{"format":"[]{}{}{}","snippet":"ActivitySetEventDay[${1:act-hash}]{${2:event-hash}}{${3:day}}{${4:week}}"}},
		{"name":"ActivitySetEventDay","arg":{"format":"{}{}{}","snippet":"ActivitySetEventDay{${1:event-hash}}{${2:day}}{${3:week}}"}},
