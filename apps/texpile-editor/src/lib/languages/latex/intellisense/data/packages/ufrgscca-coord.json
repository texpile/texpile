		{"name":"advisorprof","arg":{"format":"{}","snippet":"advisorprof{${1:prof-ref}}"},"doc":"\\advisorprof expands to a call for \\advisor and \\advisorinfo using the properties stored by \\professor."},
		{"name":"altexaminerprof","arg":{"format":"{}","snippet":"altexaminerprof{${1:prof-ref}}"}},
		{"name":"boardobs","arg":{"format":"{}","snippet":"boardobs{${1:obs}}"},"doc":"\\boardobs allows to add an observation (⟨obs⟩) for the ’boards schedule report’, and \\semester sets the current semester value."},
		{"name":"boardtitle","arg":{"format":"{}","snippet":"boardtitle{${1:title}}"}},
		{"name":"checkdef","arg":{"format":"{}{}{}","snippet":"checkdef{${1:LxCy}}{${2:check-item}}{${3:check-text}}"}},
		{"name":"checklist","arg":{"format":"[]{}","snippet":"checklist[${1:act-hash}]{${2:check-items-list}}"}},
		{"name":"checklist","arg":{"format":"{}","snippet":"checklist{${1:check-items-list}}"}},
		{"name":"coadvisorprof","arg":{"format":"{}","snippet":"coadvisorprof{${1:prof-ref}}"}},
		{"name":"examinergrades","arg":{"format":"{}{}{}[]","snippet":"examinergrades{${1:N1}}{${2:N2}}{${3:N3}}[${4:N4}]"}},
		{"name":"examinergrades","arg":{"format":"{}{}{}","snippet":"examinergrades{${1:N1}}{${2:N2}}{${3:N3}}"}},
		{"name":"examinerprof","arg":{"format":"{}","snippet":"examinerprof{${1:prof-ref}}"}},
		{"name":"professor","arg":{"format":"[]{}{}{}{}[]","snippet":"professor[${1:prof-ref}]{${2:last}}{${3:first}}{${4:email}}{${5:phone}}[${6:gender}]"},"doc":"\\professor creates a ⟨prof-ref⟩ alias to a person’s full name."},
		{"name":"professor","arg":{"format":"{}{}{}{}","snippet":"professor{${1:last}}{${2:first}}{${3:email}}{${4:phone}}"},"doc":"\\professor creates a ⟨prof-ref⟩ alias to a person’s full name."},
		{"name":"semester","arg":{"format":"{}","snippet":"semester{${1:semester}}"}},
		{"name":"setstudentlist","arg":{"format":"{}{}","snippet":"setstudentlist{${1:listID}}{${2:list}}"}},
		{"name":"sortstudentlist","arg":{"format":"{}","snippet":"sortstudentlist{${1:listID}}"}},
		{"name":"sortstudentlist*","arg":{"format":"{}","snippet":"sortstudentlist*{${1:listID}}"}},
		{"name":"studentaddtolist","arg":{"format":"{}","snippet":"studentaddtolist{${1:listID}}"}},
		{"name":"studentfate","arg":{"format":"[]","snippet":"studentfate[${1:fate}]"}},
		{"name":"studentfate"},
		{"name":"suppresschecklist"},
		{"name":"tcreports","arg":{"format":"[]{}","snippet":"tcreports[${1:report-list}]{${2:listID}}"}},
		{"name":"tcreports","arg":{"format":"{}","snippet":"tcreports{${1:listID}}"}},
		{"name":"timeslot","arg":{"format":"[]{}{}","snippet":"timeslot[${1:local}]{${2:date}}{${3:time}}"}},
		{"name":"timeslot","arg":{"format":"{}{}","snippet":"timeslot{${1:date}}{${2:time}}"}}
	],
	"envs": [],
	"keys": {}
}
