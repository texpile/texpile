{
	"deps": [{"name":"xcolor"},{"name":"calc"}],
	"macros": [
		{"name":"currentchapter","arg":{"format":"{}","snippet":"currentchapter{${1:chapter name}}"}},
		{"name":"currentsections","arg":{"format":"{}","snippet":"currentsections{${1:section name}}"}},
		{"name":"currentsubsections","arg":{"format":"{}","snippet":"currentsubsections{${1:subsection name}}"}},
		{"name":"newchapter","arg":{"format":"{}{}{}","snippet":"newchapter{${1:chapter name}}{${2:number of sections}}{${3:completed sections}}"}},
		{"name":"newsection","arg":{"format":"{}{}{}","snippet":"newsection{${1:section name}}{${2:number of subsections}}{${3:completed subsections}}"}},
		{"name":"newsubsection","arg":{"format":"{}","snippet":"newsubsection{${1:subsection name}}"},"doc":"It give you a subsection {⟨subsection name⟩}: The name of the subsection."},
		{"name":"newtitle","arg":{"format":"{}{}{}","snippet":"newtitle{${1:title name}}{${2:number of chapters}}{${3:completed chapters}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/unifront#c": ["blue","help","red","yellow"]
	},
	"args": ["\\usepackage/unifront#c"]
}
