{
	"deps": [{"name":"zhspacing"},{"name":"zhsusefulmacros"},{"name":"zhsmyclass"},{"name":"fontspec"},{"name":"fontspec-luatex"},{"name":"zhulem"},{"name":"ulem"}],
	"macros": [
		{"name":"filedate","unusual":true},
		{"name":"newfontfamilywithslant","arg":{"format":"{}{}","snippet":"newfontfamilywithslant{${1}}{${2}}"},"doc":"Create a font family with fake slant."},
		{"name":"newfontfamilywithslantandbold","arg":{"format":"{}{}{}","snippet":"newfontfamilywithslantandbold{${1}}{${2}}{${3}}"},"doc":"Create a font family with fake slant, and specify another font for its boldface."},
		{"name":"setzhmainfont","arg":{"format":"[]{}[]","snippet":"setzhmainfont[${1:font features}]{${2:font name}}[${3:font features}]"}},
		{"name":"setzhmainfont","arg":{"format":"{}","snippet":"setzhmainfont{${1:font name}}"}},
		{"name":"setzhmonofont","arg":{"format":"[]{}[]","snippet":"setzhmonofont[${1:font features}]{${2:font name}}[${3:font features}]"}},
		{"name":"setzhmonofont","arg":{"format":"{}","snippet":"setzhmonofont{${1:font name}}"}},
		{"name":"setzhsansfont","arg":{"format":"[]{}[]","snippet":"setzhsansfont[${1:font features}]{${2:font name}}[${3:font features}]"}},
		{"name":"setzhsansfont","arg":{"format":"{}","snippet":"setzhsansfont{${1:font name}}"}},
		{"name":"underdot","arg":{"format":"{}","snippet":"underdot{${1:text}}"}},
		{"name":"zhrmfont","doc":"The font commands to be executed according to the current font family."},
		{"name":"zhsffont"},
		{"name":"zhttfont"}
	],
	"envs": [],
	"keys": {
		"\\usepackage/zhfont#c": ["fakebold"]
	},
	"args": ["\\usepackage/zhfont#c"]
}
