{
	"deps": [{"name":"etex"}],
	"macros": [
		{"name":"getthebotmarks","arg":{"format":"{}{}","snippet":"getthebotmarks{${1:named-mark}}{${2:\\control-sequence}}"}},
		{"name":"getthefirstmarks","arg":{"format":"{}{}","snippet":"getthefirstmarks{${1:named-mark}}{${2:\\control-sequence}}"}},
		{"name":"getthemarks","arg":{"format":"{}{}{}","snippet":"getthemarks{${1:\\firstmarks}}{${2:named-mark}}{${3:\\control-sequence}}"},"doc":"Extract the marks and store in a parameterless macro."},
		{"name":"getthetopmarks","arg":{"format":"{}{}","snippet":"getthetopmarks{${1:named-mark}}{${2:\\control-sequence}}"}},
		{"name":"ifmarksequal","arg":{"format":"{}{}{}{}{}","snippet":"ifmarksequal{${1:\\firstmarks}}{${2:\\topmarks}}{${3:named-mark}}{${4:true}}{${5:false}}"}},
		{"name":"ifmarksvoid","arg":{"format":"{}{}{}{}","snippet":"ifmarksvoid{${1:\\firstmarks}}{${2:named-mark}}{${3:true}}{${4:false}}"},"doc":"Test if a marks is defined, not empty and not \\relax."},
		{"name":"marksthe","arg":{"format":"{}{}","snippet":"marksthe{${1:named-mark}}{${2:content}}"}},
		{"name":"marksthe*","arg":{"format":"{}{}","snippet":"marksthe*{${1:named-mark}}{${2:content}}"}},
		{"name":"marksthecs","arg":{"format":"{}{}","snippet":"marksthecs{${1:named-mark}}{${2:cs-name}}"}},
		{"name":"marksthecs*","arg":{"format":"{}{}","snippet":"marksthecs*{${1:named-mark}}{${2:cs-name}}"}},
		{"name":"showthemarks","arg":{"format":"{}","snippet":"showthemarks{${1:named-mark}}"}},
		{"name":"thebotmarks","arg":{"format":"{}","snippet":"thebotmarks{${1:named-mark}}"},"doc":"\\thefirstmarks, \\thebotmarks and \\thetopmarks expand the content of the mark."},
		{"name":"thefirstmarks","arg":{"format":"{}","snippet":"thefirstmarks{${1:named-mark}}"},"doc":"\\thefirstmarks extract the \\firstmarks from a named mark register."},
		{"name":"thetopmarks","arg":{"format":"{}","snippet":"thetopmarks{${1:named-mark}}"},"doc":"\\thefirstmarks, \\thebotmarks and \\thetopmarks expand the content of the mark."}
	],
	"envs": [],
	"keys": {}
}
