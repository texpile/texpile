{
	"macros": [
		{"name":"esindex","arg":{"format":"[]{}","snippet":"esindex[${1:index name}]{${2:entry}}"},"doc":"This package defines the command \\esindex, which adds sort keys to the index entries for you."},
		{"name":"esindex","arg":{"format":"{}","snippet":"esindex{${1:entry}}"},"doc":"This package defines the command \\esindex, which adds sort keys to the index entries for you."},
		{"name":"esindexactual","arg":{"format":"{}{}","snippet":"esindexactual{${1:entry}}{${2:actual}}"}},
		{"name":"esindexexpandkey","doc":"You may force protected expansion at any point inside \\everyesindex with \\esindexexpandkey."},
		{"name":"esindexexpandkeys","doc":"With \\esindexexpandkeys the three levels are expanded."},
		{"name":"esindexexpandsubkey","unusual":true},
		{"name":"esindexexpandsubsubkey","unusual":true},
		{"name":"esindexkey"},
		{"name":"esindexlanguage","arg":{"format":"{}{}","snippet":"esindexlanguage{${1:language}}{${2:text}}"},"unusual":true,"if":"babel"},
		{"name":"esindexlastchar"},
		{"name":"esindexreplace","arg":{"format":"{}{}","snippet":"esindexreplace{${1}}{${2}}"}},
		{"name":"esindexreplacesub","arg":{"format":"{}{}{}","snippet":"esindexreplacesub{${1}}{${2}}{${3}}"}},
		{"name":"esindexreplacesubsub","arg":{"format":"{}{}{}{}","snippet":"esindexreplacesubsub{${1}}{${2}}{${3}}{${4}}"}},
		{"name":"esindexsort","arg":{"format":"{}{}","snippet":"esindexsort{${1:entry}}{${2:sort key}}"}},
		{"name":"everyesindex","arg":{"format":"{}","snippet":"everyesindex{${1:code}}"}},
		{"name":"ignorewords","arg":{"format":"{}","snippet":"ignorewords{${1}}"}}
	],
	"envs": [],
	"keys": {
		"\\usepackage/esindex#c": ["babel","ignorespaces","nospanish","replaceindex"]
	},
	"args": ["\\usepackage/esindex#c"]
}
