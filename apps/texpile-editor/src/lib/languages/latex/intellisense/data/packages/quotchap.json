{
	"deps": [{"name":"color","if":"!nogrey"}],
	"macros": [
		{"name":"chapnumfont","unusual":true},
		{"name":"chapter","arg":{"format":"[]{}","snippet":"chapter[${1:short title}]{${2:title}}"}},
		{"name":"chapter","arg":{"format":"{}","snippet":"chapter{${1:title}}"}},
		{"name":"chapter*","arg":{"format":"[]{}","snippet":"chapter*[${1:short title}]{${2:title}}"}},
		{"name":"chapter*","arg":{"format":"{}","snippet":"chapter*{${1:title}}"}},
		{"name":"chapterheadendvskip","unusual":true},
		{"name":"chapterheadstartvskip","unusual":true},
		{"name":"qauthor","arg":{"format":"{}","snippet":"qauthor{${1:author}}"}},
		{"name":"qauthorfont","doc":"The font for the author of the quote can be set globally with \\qauthorfont."},
		{"name":"qsetcnfont","arg":{"format":"{}","snippet":"qsetcnfont{${1:family}}"},"doc":"You can choose any font for the chapter number by using the command \\qsetcnfont."},
		{"name":"quotefont","doc":"The font for quotations can be set globally with \\quotefont."},
		{"name":"sectfont","unusual":true}
	],
	"envs": [
		{"name":"savequote","arg":{"format":"[]","snippet":"[${1:width}]"}},
		{"name":"savequote"}
	],
	"keys": {
		"\\usepackage/quotchap#c": ["avantgarde","beramono","berasans","beraserif","biolinum","bookman","charter","courier","grey","helvetica","kpfonts","libertine","lmodern","newcentury","nogrey","palatino","times","utopia"]
	},
	"args": ["\\usepackage/quotchap#c"]
}
