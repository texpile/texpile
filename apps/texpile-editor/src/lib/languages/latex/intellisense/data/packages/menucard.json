		{"name":"menugroupsc","arg":{"format":"{}{}","snippet":"{${1:first heading}}{${2:second heading}}"}},
		{"name":"menugroupsc*","arg":{"format":"{}{}","snippet":"{${1:first heading}}{${2:second heading}}"}}
