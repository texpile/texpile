{
	"deps": [{"name":"mboxfill"}],
	"macros": [
		{"name":"dashrule","arg":{"format":"[]{}{}","snippet":"dashrule[${1}]{${2}}{${3}}"}},
		{"name":"dashrule","arg":{"format":"{}{}","snippet":"dashrule{${1}}{${2}}"}},
		{"name":"dashrulefill","arg":{"format":"[][]{}{}","snippet":"dashrulefill[${1:raise}][${2:leader type}]{${3:h-pattern}}{${4:v-pattern}}"}},
		{"name":"dashrulefill","arg":{"format":"{}{}","snippet":"dashrulefill{${1:h-pattern}}{${2:v-pattern}}"}},
		{"name":"newfootnotedashrule","arg":{"format":"{}[]{}{}","snippet":"newfootnotedashrule{${1:prefix}}[${2:width}]{${3:h-pattern}}{${4:v-pattern}}"}},
		{"name":"newfootnotedashrule","arg":{"format":"{}{}{}","snippet":"newfootnotedashrule{${1:prefix}}{${2:h-pattern}}{${3:v-pattern}}"}},
		{"name":"newfootnoterule","arg":{"format":"{}[]{}","snippet":"newfootnoterule{${1:prefix}}[${2:width}]{${3:rule code}}"}},
		{"name":"newfootnoterule","arg":{"format":"{}{}","snippet":"newfootnoterule{${1:prefix}}{${2:rule code}}"}}
	],
	"envs": [],
	"keys": {}
}
