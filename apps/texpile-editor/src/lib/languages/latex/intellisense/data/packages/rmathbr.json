{
	"deps": [{"name":"ifetex"},{"name":"iftex"},{"name":"ifluatex"},{"name":"xkeyval"}],
	"macros": [
		{"name":"brokenbin","arg":{"format":"{}","snippet":"brokenbin{${1:operator}}"},"doc":"Makes argument as breakable binary operation."},
		{"name":"BrokenBinOff","doc":"Disables break on binary operations."},
		{"name":"BrokenBinOn","doc":"Enables break on binary operations."},
		{"name":"brokeninner","arg":{"format":"{}","snippet":"brokeninner{${1:expression}}"},"doc":"Makes argument as breakable inner."},
		{"name":"brokenrel","arg":{"format":"{}","snippet":"brokenrel{${1:relation}}"}},
		{"name":"cdott","doc":"This command displays \\cdot (·) that is changed to \\times (×) at the break."},
		{"name":"nobr","doc":"Makes next symbol nonbreakable."},
		{"name":"SetBreakableBin","arg":{"format":"{}","snippet":"SetBreakableBin{${1:operator}}"},"doc":"Declares breakable binary operator, e.g. \\SetBreakableBin{\\MyPlus}."},
		{"name":"SetBreakableInner","arg":{"format":"{}","snippet":"SetBreakableInner{${1:expression}}"},"doc":"Declares breakable “inner” expression, e.g. \\SetBreakableInner{\\ldots}."},
		{"name":"SetBreakableRel","arg":{"format":"{}","snippet":"SetBreakableRel{${1:relation}}"},"doc":"Declares breakable relation operator, e.g. \\SetBreakableRel{\\MyEqual}."},
		{"name":"SetMathOperator","arg":{"format":"{}","snippet":"SetMathOperator{${1:operator}}"},"doc":"Disables breaks after math operator."},
		{"name":"SetOpenBracket","arg":{"format":"{}","snippet":"SetOpenBracket{${1:bracket}}"},"doc":"Disables breaks after open bracket."},
		{"name":"SetPunctuation","arg":{"format":"{}","snippet":"SetPunctuation{${1:punctuation}}"},"doc":"Disables breaks after punctuation sign."},
		{"name":"UnsetBrokenCmd","arg":{"format":"{}","snippet":"UnsetBrokenCmd{${1:command}}"},"doc":"Restores original command."}
	],
	"envs": [],
	"keys": {}
}
