{
	"macros": [
		{"name":"currentleftquote","doc":"This macro keeps track of the left quote for the current level."},
		{"name":"currentrightquote","doc":"This macro keeps track of the right quote for the current level."},
		{"name":"elq"},
		{"name":"elqq","doc":"Left double quote."},
		{"name":"erq","doc":"Right single quote."},
		{"name":"erqq","doc":"Right double quote."},
		{"name":"flq","doc":"French left single quote."},
		{"name":"flqq","doc":"French left double quote."},
		{"name":"frq","doc":"French right single quote."},
		{"name":"frqq","doc":"French right double quote."},
		{"name":"glq","doc":"German left single quote."},
		{"name":"glqq","doc":"German left double quote."},
		{"name":"grq","doc":"German right single quote."},
		{"name":"grqq","doc":"German right double quote."},
		{"name":"setlanguagequotemarks","arg":{"format":"{}","snippet":"setlanguagequotemarks{${1:language}}"},"unusual":true},
		{"name":"setparquotemarks","arg":{"format":"{}{}","snippet":"setparquotemarks{${1:before}}{${2:after}}"}},
		{"name":"setquotemarks","arg":{"format":"{}","snippet":"setquotemarks{${1:list}}"},"doc":"sets the quote mark lists, e.g. \\setquotemarks{{‘}{’},{‘‘}{’’}} will set the first level to single inverted commas, and the second level to double inverted commas."},
		{"name":"textormath","arg":{"format":"{}{}","snippet":"textormath{${1}}{${2}}"},"unusual":true},
		{"name":"tqt","arg":{"format":"{}","snippet":"tqt{${1:text}}"}}
	],
	"envs": [
		{"name":"qt"}
	],
	"keys": {
		"\\usepackage/quotmark#c": ["UKenglish","USenglish","acadian","afrikaans","american","austrian","brazil","brazilian","british","bulgarian","canadian","canadien","catalan","conformance","croatian","czech","danish","dutch","english","estonian","finnish","francais","french","frenchb","german","germanb","greek","hebrew","hungarian","icelandic","irish","italian","lowersorbian","magyar","naustrian","ngerman","nonconformance","norsk","nynorsk","polish","polutonikogreek","portuges","portuguese","romanian","russian","scottish","serbian","slovak","slovene","spanish","swedish","swiss","turkish","ukrainian","uppersorbian","welsh"]
	},
	"args": ["\\usepackage/quotmark#c"]
}
