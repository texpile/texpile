{
	"deps": [{"name":"tikz"},{"name":"pgf"},{"name":"pgfrcs"},{"name":"pgfcore"},{"name":"graphicx"},{"name":"keyval"},{"name":"graphics"},{"name":"trig"},{"name":"pgfsys"},{"name":"xcolor"},{"name":"pgfcomp-version-0-65"},{"name":"pgfcomp-version-1-18"},{"name":"pgffor"},{"name":"pgfkeys"},{"name":"pgfmath"},{"name":"xparse"},{"name":"float"}],
	"macros": [
		{"name":"annotate","arg":{"format":"{}{}{}","snippet":"annotate{${1:process}}{${2:time}}{${3:text}}"}},
		{"name":"annotatexplicit","arg":{"format":"{}{}{}{}","snippet":"annotatexplicit{${1:process}}{${2:time}}{${3:text}}{${4:name}}"}},
		{"name":"checkpoint","arg":{"format":"{}{}{}","snippet":"checkpoint{${1:process}}{${2:time}}{${3:name}}"},"doc":"A checkpoint can be added with \\checkpoint{⟨process⟩}{⟨time⟩}{⟨name⟩}, where process is the name of the process which takes a checkpoint, time is the time at which the checkpoint is taken, and name is the name of the checkpoint, that is printed next to it, and can be used as a coordinate."},
		{"name":"checkpointspecial","arg":{"format":"{}{}{}{}","snippet":"checkpointspecial{${1:process}}{${2:time}}{${3:name}}{${4:label}}"}},
		{"name":"colouredbox","arg":{"format":"{}{}{}{}{}","snippet":"colouredbox{${1:first process}}{${2:second process}}{${3:begin}}{${4:end}}{${5:caption}}"}},
		{"name":"colouredboxcolour","arg":{"format":"{}","snippet":"colouredboxcolour{${1:colour}}"},"doc":"\\colouredboxcolour{⟨colour⟩} changes the colour used for colouredboxes."},
		{"name":"crash","arg":{"format":"{}{}{}","snippet":"crash{${1:process name}}{${2:time}}{${3:crash name}}"},"doc":"The crash of a process can be represented using \\crash{⟨process name⟩}{⟨time⟩}{⟨crash name⟩}."},
		{"name":"drawtimeline","arg":{"format":"{}","snippet":"drawtimeline{${1:length}}"}},
		{"name":"iftimeline","unusual":true},
		{"name":"newprocess","arg":{"format":"{}[]","snippet":"newprocess{${1:name}}[${2:display name}]"}},
		{"name":"newprocess","arg":{"format":"{}","snippet":"newprocess{${1:name}}"}},
		{"name":"newprocesswithcrash","arg":{"format":"{}[]{}{}","snippet":"newprocesswithcrash{${1}}[${2}]{${3}}{${4}}"}},
		{"name":"newprocesswithcrash","arg":{"format":"{}{}{}","snippet":"newprocesswithcrash{${1}}{${2}}{${3}}"}},
		{"name":"newprocesswithlength","arg":{"format":"{}[]{}","snippet":"newprocesswithlength{${1}}[${2}]{${3}}"}},
		{"name":"newprocesswithlength","arg":{"format":"{}{}","snippet":"newprocesswithlength{${1}}{${2}}"}},
		{"name":"newprocesswithstateinterval","arg":{"format":"{}[]{}","snippet":"newprocesswithstateinterval{${1}}[${2}]{${3}}"}},
		{"name":"newprocesswithstateinterval","arg":{"format":"{}{}","snippet":"newprocesswithstateinterval{${1}}{${2}}"}},
		{"name":"oobcolour","arg":{"format":"{}","snippet":"oobcolour{${1:colour}}"},"doc":"\\oobcolour{⟨colour⟩} changes the colour used for out-of-band messages."},
		{"name":"processlength","arg":{"format":"{}{}","snippet":"processlength{${1:name}}{${2:lifetime}}"}},
		{"name":"restart","arg":{"format":"{}{}{}","snippet":"restart{${1:name}}{${2:date}}{${3:duration}}"},"doc":"To restart the timeline, we provide the command \\restart{⟨name⟩}{⟨date⟩}{⟨duration⟩}. name specifies which process is to be restarted; date specifies when the process should be restarted, and duration specifies how long the process shoud be alive (i.e. what is the length of the timeline) after the restart."},
		{"name":"send","arg":{"format":"{}{}{}{}","snippet":"send{${1:sender}}{${2:send time}}{${3:receiver}}{${4:receive time}}"}},
		{"name":"sendoutofband","arg":{"format":"{}{}{}{}{}[]","snippet":"sendoutofband{${1:sender}}{${2:send time}}{${3:receiver}}{${4:receive time}}{${5:label}}[${6:label options}]"}},
		{"name":"sendoutofband","arg":{"format":"{}{}{}{}{}","snippet":"sendoutofband{${1:sender}}{${2:send time}}{${3:receiver}}{${4:receive time}}{${5:label}}"}},
		{"name":"sendwithname","arg":{"format":"{}{}{}{}{}[]","snippet":"sendwithname{${1:sender}}{${2:send time}}{${3:receiver}}{${4:receive time}}{${5:label}}[${6:label options}]"}},
		{"name":"sendwithname","arg":{"format":"{}{}{}{}{}","snippet":"sendwithname{${1:sender}}{${2:send time}}{${3:receiver}}{${4:receive time}}{${5:label}}"}},
		{"name":"sendwithstateinterval","arg":{"format":"{}{}{}{}{}","snippet":"sendwithstateinterval{${1}}{${2}}{${3}}{${4}}{${5}}"}},
		{"name":"sendwithstateintervalandname","arg":{"format":"{}{}{}{}{}{}[]","snippet":"sendwithstateintervalandname{${1}}{${2}}{${3}}{${4}}{${5}}{${6}}[${7}]"}},
		{"name":"sendwithstateintervalandname","arg":{"format":"{}{}{}{}{}{}","snippet":"sendwithstateintervalandname{${1}}{${2}}{${3}}{${4}}{${5}}{${6}}"}},
		{"name":"stateinterval","arg":{"format":"{}{}{}","snippet":"stateinterval{${1:process}}{${2:time}}{${3:name}}"}},
		{"name":"stateintervalspecial","arg":{"format":"{}{}{}{}","snippet":"stateintervalspecial{${1:process}}{${2:time}}{${3:name}}{${4:label}}"}},
		{"name":"timelinefalse","unusual":true},
		{"name":"timelinetrue","unusual":true}
	],
	"envs": [
		{"name":"messagepassing","arg":{"format":"[][][][]","snippet":"[${1}][${2}][${3}][${4}]"},"doc":"A diagram can easily be created using the messagepassing environment."},
		{"name":"messagepassing","doc":"A diagram can easily be created using the messagepassing environment."}
	],
	"keys": {
		"\\usepackage/messagepassing#c": ["annotatevertical","vertical"]
	},
	"args": ["\\usepackage/messagepassing#c"]
}
