{
	"deps": [{"name":"dialog"},{"name":"grabhedr"}],
	"macros": [
		{"name":"curmenu","unusual":true},
		{"name":"endmenuline"},
		{"name":"fmenu","arg":{"format":"{}{}{}{}","snippet":"fmenu{${1:cmd}}{${2:preliminary text}}{${3:menu lines}}{${4:following text}}"}},
		{"name":"fxmenu","arg":{"format":"{}{}{}{}","snippet":"fxmenu{${1:cmd}}{${2:preliminary text}}{${3:menu lines}}{${4:following text}}"}},
		{"name":"inmenuA"},
		{"name":"inmenuB"},
		{"name":"lettermenu","arg":{"format":"{}","snippet":"lettermenu{${1:menu name}}"},"doc":"\\lettermenu is a high-level function from menus.sty that prints \\menuF on screen (given the argument F), reads a line of input from the user, extracts the first character and forces it to uppercase, then branches to the next menu as determined by that character."},
		{"name":"menubotline"},
		{"name":"menuhelpmesj","unusual":true},
		{"name":"menuline"},
		{"name":"menunumber","arg":{"format":"{}","snippet":"menunumber{${1:number}}"}},
		{"name":"menuprefix"},
		{"name":"menuprompt"},
		{"name":"menusuffix"},
		{"name":"menutopline"},
		{"name":"moptionhelp","unusual":true},
		{"name":"moptionQ","unusual":true},
		{"name":"moptionX","unusual":true},
		{"name":"nmenu","arg":{"format":"{}{}{}{}{}","snippet":"nmenu{${1}}{${2}}{${3}}{${4}}{${5}}"},"unusual":true},
		{"name":"nxmenu","arg":{"format":"{}{}{}{}{}","snippet":"nxmenu{${1}}{${2}}{${3}}{${4}}{${5}}"},"unusual":true},
		{"name":"optionexec","arg":{"format":"{}","snippet":"optionexec{${1:answer}}"}},
		{"name":"optionfileexec","arg":{"format":"{}","snippet":"optionfileexec{${1}}"},"unusual":true},
		{"name":"specialhelp","arg":{"format":"{}{}","snippet":"specialhelp{${1:answer}}{${2:message}}"}},
		{"name":"xoptiontest","arg":{"format":"{}","snippet":"xoptiontest{${1:answer}}"}}
	],
	"envs": [],
	"keys": {}
