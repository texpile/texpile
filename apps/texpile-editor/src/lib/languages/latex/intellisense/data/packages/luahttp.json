{
	"deps": [{"name":"ifluatex"},{"name":"iftex"},{"name":"url"},{"name":"xparse"},{"name":"luapackageloader"}],
	"macros": [
		{"name":"fetchImage","arg":{"format":"{}[][]","snippet":"fetchImage{${1:URL}}[${2:width}][${3:height}]"}},
		{"name":"fetchImage","arg":{"format":"{}","snippet":"fetchImage{${1:URL}}"}},
		{"name":"fetchJson","arg":{"format":"{}[]","snippet":"fetchJson{${1:URL}}[${2:keys}]"}},
		{"name":"fetchJson","arg":{"format":"{}","snippet":"fetchJson{${1:URL}}"}},
		{"name":"fetchJsonUsingFile","arg":{"format":"{}[]","snippet":"fetchJsonUsingFile{${1:JSON file}}[${2:keys}]"}},
		{"name":"fetchJsonUsingFile","arg":{"format":"{}","snippet":"fetchJsonUsingFile{${1:JSON file}}"}},
		{"name":"fetchJsonUsingQuery","arg":{"format":"{}{}[][][][][]","snippet":"fetchJsonUsingQuery{${1:URL}}{${2:keys}}[${3:query parameter 1}][${4:query parameter 2}][${5:query parameter 3}][${6:query parameter 4}][${7:query parameter 5}]"}},
		{"name":"fetchJsonUsingQuery","arg":{"format":"{}{}","snippet":"fetchJsonUsingQuery{${1:URL}}{${2:keys}}"}},
		{"name":"fetchRss","arg":{"format":"{}{}[][]","snippet":"fetchRss{${1:URL}}{${2:limit}}[${3:feed info keys}][${4:entry keys}]"}},
		{"name":"fetchRss","arg":{"format":"{}{}","snippet":"fetchRss{${1:URL}}{${2:limit}}"}}
	],
	"envs": [],
	"keys": {}
}
