{
	"macros": [
		{"name":"themainequation","unusual":true},
		{"name":"thesubequation"}
	],
	"envs": [
		{"name":"numcases","arg":{"format":"{}","snippet":"{${1}}"},"doc":"This package provides a LaTeX environment \"numcases\" to produce multi-case equations with a separate equation number for each case."},
		{"name":"subeqnarray"},
		{"name":"subequations"},
		{"name":"subnumcases","arg":{"format":"{}","snippet":"{${1:left side}}"}},
		{"name":"cases","if":"casesstyle"}
	],
	"keys": {
		"\\usepackage/cases#c": ["amsstyle","cases","casesstyle","fleqn","leqno","subnum"]
	},
	"args": ["\\usepackage/cases#c"]
}
