{
	"macros": [
		{"name":"bibliography","arg":{"format":"{}{}{}","snippet":"bibliography{${1:auxiliary file}}{${2:bib files}}{${3:section title}}"}},
		{"name":"bibliographystyle","arg":{"format":"{}{}","snippet":"bibliographystyle{${1:auxiliary file}}{${2:style}}"},"doc":"The \\bibliographystyle command has two arguments: the name of an auxiliary file and the name of a bibliographic style. With this command one can specify the bibliographic style each bibliography section will have."},
		{"name":"cite","arg":{"format":"[]{}{}","snippet":"cite[${1:note}]{${2:auxiliary file}}{${3:keys}}"}},
		{"name":"cite","arg":{"format":"{}{}","snippet":"cite{${1:auxiliary file}}{${2:keys}}"}},
		{"name":"newbibliography","arg":{"format":"{}","snippet":"newbibliography{${1}}"}},
		{"name":"nocite","arg":{"format":"{}{}","snippet":"nocite{${1:auxiliary file}}{${2:keys}}"}}
	],
	"envs": [],
	"keys": {}
}
