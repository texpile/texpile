{
	"deps": [{"name":"calc"}],
	"macros": [
		{"name":"Aitoliamonth","arg":{"format":"{}","snippet":"Aitoliamonth{${1:number}}"}},
		{"name":"Athensmonth","arg":{"format":"{}","snippet":"Athensmonth{${1:number}}"}},
		{"name":"Biotiamonth","arg":{"format":"{}","snippet":"Biotiamonth{${1:number}}"}},
		{"name":"Delphimonth","arg":{"format":"{}","snippet":"Delphimonth{${1:number}}"}},
		{"name":"Dilosmonth","arg":{"format":"{}","snippet":"Dilosmonth{${1:number}}"}},
		{"name":"Epidavrosmonth","arg":{"format":"{}","snippet":"Epidavrosmonth{${1:number}}"}},
		{"name":"fullgreekday","arg":{"format":"{}","snippet":"fullgreekday{${1:number}}"},"doc":"The command \\fullgreekday is used to produce the name of the week’s day using a phrase like “the day of the Sun” in Greek (this is \\fullgreekday{1})."},
		{"name":"Grshortdategreek","if":"fullconversion"},
		{"name":"Lamiamonth","arg":{"format":"{}","snippet":"Lamiamonth{${1:number}}"}},
		{"name":"Macedoniamonth","arg":{"format":"{}","snippet":"Macedoniamonth{${1:number}}"}},
		{"name":"Militosmonth","arg":{"format":"{}","snippet":"Militosmonth{${1:number}}"}},
		{"name":"Rhodesmonth","arg":{"format":"{}","snippet":"Rhodesmonth{${1:number}}"}},
		{"name":"Samosmonth","arg":{"format":"{}","snippet":"Samosmonth{${1:number}}"}},
		{"name":"shortdategreek","if":"fullconversion"},
		{"name":"shortgreekday","arg":{"format":"{}","snippet":"shortgreekday{${1:number}}"},"doc":"The \\shortgreekday macro gives a shorter form for the name of the day."},
		{"name":"sshortgreekday","arg":{"format":"{}","snippet":"sshortgreekday{${1:number}}"}},
		{"name":"Tinosmonth","arg":{"format":"{}","snippet":"Tinosmonth{${1:number}}"}},
		{"name":"theolympiad","unusual":true,"if":"fullconversion"},
		{"name":"theolympicyear","unusual":true,"if":"fullconversion"}
	],
	"envs": [],
	"keys": {
		"\\usepackage/greekdates#c": ["Aitoliamonths","Athensmonths","Biotiamonths","Delphimonths","Dilosmonths","Epidavrosmonths","Lamiamonths","Macedoniamonths","Militosmonths","Rhodesmonths","Samosmonths","Tinosmonths","fullconversion"]
	},
	"args": ["\\usepackage/greekdates#c"]
}
