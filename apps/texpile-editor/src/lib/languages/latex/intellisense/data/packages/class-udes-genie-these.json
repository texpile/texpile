{
	"deps": [{"name":"class-book"},{"name":"babel"},{"name":"scalefnt"},{"name":"caption"},{"name":"caption3"},{"name":"keyval"},{"name":"fancyhdr"},{"name":"geometry"},{"name":"ifvtex"},{"name":"iftex"},{"name":"parskip"},{"name":"kvoptions"},{"name":"kvsetkeys"},{"name":"etoolbox"},{"name":"setspace"}],
	"macros": [
		{"name":"Auteur","arg":{"format":"{}{}","snippet":"Auteur{${1:first name}}{${2:last name}}"},"doc":"L’auteure ou l’auteur du document sur la page titre est spécifié avec cette macro."},
		{"name":"Codirecteur","arg":{"format":"{}{}","snippet":"Codirecteur{${1:first name}}{${2:last name}}"}},
		{"name":"Codirectrice","arg":{"format":"{}{}","snippet":"Codirectrice{${1:first name}}{${2:last name}}"},"doc":"Les codirectrices et les codirecteurs de recherche sont spécifiés avec ces macros."},
		{"name":"ConfigurationDocument","arg":{"format":"{}","snippet":"ConfigurationDocument{${1:configuration keys}}"}},
		{"name":"Date","arg":{"format":"{}{}","snippet":"Date{${1:month}}{${2:year}}"},"doc":"La date sur la page titre est spécifiée avec cette macro."},
		{"name":"Dedicace","arg":{"format":"{}","snippet":"Dedicace{${1:text}}"},"doc":"Le texte de la dédicace est spécifié avec cette macro."},
		{"name":"Directeur","arg":{"format":"{}{}","snippet":"Directeur{${1:first name}}{${2:last name}}"}},
		{"name":"Directrice","arg":{"format":"{}{}","snippet":"Directrice{${1:first name}}{${2:last name}}"},"doc":"La directrice principale ou le directeur principal de recherche est spécifié avec cette macro."},
		{"name":"Evaluateur","arg":{"format":"{}{}","snippet":"Evaluateur{${1:first name}}{${2:last name}}"}},
		{"name":"Evaluatrice","arg":{"format":"{}{}","snippet":"Evaluatrice{${1:first name}}{${2:last name}}"},"doc":"Les évaluatrices et les évaluateurs du jury sont spécifiés avec ces macros."},
		{"name":"MotsClesAnglais","arg":{"format":"{}","snippet":"MotsClesAnglais{${1:keywords}}"}},
		{"name":"MotsClesFrancais","arg":{"format":"{}","snippet":"MotsClesFrancais{${1:keywords}}"}},
		{"name":"TitreAnglais","arg":{"format":"{}","snippet":"TitreAnglais{${1:title}}"}},
		{"name":"TitreFrancais","arg":{"format":"{}","snippet":"TitreFrancais{${1:title}}"}}
	],
	"envs": [],
	"keys": {}
}
