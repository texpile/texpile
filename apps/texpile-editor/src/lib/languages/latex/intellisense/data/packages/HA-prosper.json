	"envs": [
		{"name":"enumstep","arg":{"format":"[]","snippet":"[${1:options}]"},"doc":"The itemstep and enumstep environments are based on the itemize and enumerate environments respectively, but with these environments, items will be displayed incrementally."},
		{"name":"enumstep","doc":"The itemstep and enumstep environments are based on the itemize and enumerate environments respectively, but with these environments, items will be displayed incrementally."},
		{"name":"itemstep","arg":{"format":"[]","snippet":"[${1:options}]"},"doc":"The itemstep and enumstep environments are based on the itemize and enumerate environments respectively, but with these environments, items will be displayed incrementally."},
		{"name":"itemstep","doc":"The itemstep and enumstep environments are based on the itemize and enumerate environments respectively, but with these environments, items will be displayed incrementally."},
		{"name":"notes","arg":{"format":"{}","snippet":"{${1:title}}"}},
		{"name":"partslide","arg":{"format":"[]{}","snippet":"[${1:options}]{${2:title}}"},"if":"Lakar"},
		{"name":"partslide","arg":{"format":"{}","snippet":"{${1:title}}"},"if":"Lakar"},
		{"name":"wideslide","arg":{"format":"[]{}","snippet":"[${1:options}]{${2:title}}"}},
		{"name":"wideslide","arg":{"format":"{}","snippet":"{${1:title}}"}}
	],
	"keys": {}
}
