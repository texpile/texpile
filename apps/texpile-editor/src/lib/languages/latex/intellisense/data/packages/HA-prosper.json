		{"name":"dualslide","arg":{"format":"{}{}{}","snippet":"dualslide{${1:options}}{${2:left}}{${3:right}}"},"doc":"The \\dualslide macro allows to split content into two columns."},
		{"name":"fontAuthor","arg":{"format":"{}","snippet":"fontAuthor{${1:text}}"},"unusual":true},
		{"name":"FontAuthor","arg":{"format":"{}{}","snippet":"FontAuthor{${1:color font}}{${2:bw font}}"},"unusual":true},
		{"name":"fontEmail","arg":{"format":"{}","snippet":"fontEmail{${1:text}}"},"unusual":true},
		{"name":"FontEmail","arg":{"format":"{}{}","snippet":"FontEmail{${1:color font}}{${2:bw font}}"},"unusual":true},
		{"name":"fontInst","arg":{"format":"{}","snippet":"fontInst{${1:text}}"},"unusual":true},
		{"name":"FontInst","arg":{"format":"{}{}","snippet":"FontInst{${1:color font}}{${2:bw font}}"},"unusual":true},
		{"name":"fontLeftFoot","arg":{"format":"{}","snippet":"fontLeftFoot{${1:text}}"},"unusual":true},
		{"name":"FontLeftFoot","arg":{"format":"{}{}","snippet":"FontLeftFoot{${1:color font}}{${2:bw font}}"},"unusual":true},
		{"name":"fontRightFoot","arg":{"format":"{}","snippet":"fontRightFoot{${1:text}}"},"unusual":true},
		{"name":"FontRightFoot","arg":{"format":"{}{}","snippet":"FontRightFoot{${1:color font}}{${2:bw font}}"},"unusual":true},
		{"name":"fontToc","arg":{"format":"{}","snippet":"fontToc{${1:text}}"},"unusual":true},
		{"name":"FontToc","arg":{"format":"{}{}","snippet":"FontToc{${1:color font}}{${2:bw font}}"},"unusual":true},
		{"name":"HAPsetup","arg":{"format":"{}","snippet":"HAPsetup{${1:options}}"}},
		{"name":"LeftFoot","arg":{"format":"{}","snippet":"LeftFoot{${1}}"},"unusual":true},
		{"name":"maketitle","arg":{"format":"[]","snippet":"maketitle[${1:options}]"}},
		{"name":"maketitle"},
		{"name":"NormalSlideNav","arg":{"format":"{}","snippet":"NormalSlideNav{${1}}"},"unusual":true},
		{"name":"onSlide","arg":{"format":"{}{}","snippet":"onSlide{${1:overlays}}{${2:material}}"}},
		{"name":"onSlide*","arg":{"format":"{}{}","snippet":"onSlide*{${1:overlays}}{${2:material}}"}},
		{"name":"OnSlide","arg":{"format":"{}","snippet":"OnSlide{${1:overlays}}"},"doc":"The macro \\OnSlide{overlays} also accepts the same syntax as the \\onSlide macro and can be used to display or not all of the following material on a slide after the \\OnSlide macro."},
		{"name":"RightFoot","arg":{"format":"{}","snippet":"RightFoot{${1}}"},"unusual":true},
		{"name":"SlideSound","arg":{"format":"{}","snippet":"SlideSound{${1:sound file}}"}},
		{"name":"TitleSlideNav","arg":{"format":"{}","snippet":"TitleSlideNav{${1}}"},"unusual":true},
		{"name":"totalpages"},
		{"name":"tsection","arg":{"format":"[]{}","snippet":"tsection[${1:bookmark}]{${2:title}}"}},
		{"name":"tsection","arg":{"format":"{}","snippet":"tsection{${1:title}}"}},
		{"name":"tsection*","arg":{"format":"[]{}","snippet":"tsection*[${1:bookmark}]{${2:title}}"}},
		{"name":"tsection*","arg":{"format":"{}","snippet":"tsection*{${1:title}}"}},
		{"name":"tsectionandpart","arg":{"format":"[]{}","snippet":"tsectionandpart[${1:options}]{${2:title}}"}},
		{"name":"tsectionandpart","arg":{"format":"{}","snippet":"tsectionandpart{${1:title}}"}},
		{"name":"tsectionandpart*","arg":{"format":"[]{}","snippet":"tsectionandpart*[${1:options}]{${2:title}}"}},
		{"name":"tsectionandpart*","arg":{"format":"{}","snippet":"tsectionandpart*{${1:title}}"}},
		{"name":"xitem","arg":{"format":"<>[]","snippet":"xitem<${1:extra overlays}>[${2:label}]"}},
		{"name":"xitem","arg":{"format":"<>","snippet":"xitem<${1:extra overlays}>"}},
		{"name":"xitemwait","arg":{"format":"[]","snippet":"xitemwait[${1:overlays}]"}},
		{"name":"xitemwait"}
