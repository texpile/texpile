{
	"deps": [{"name":"easy"}],
	"macros": [
		{"name":"abs","arg":{"format":"{}","snippet":"abs{${1:expression}}"},"if":"math"},
		{"name":"binom","arg":{"format":"{}{}","snippet":"binom{${1:top}}{${2:bottom}}"},"if":"math","math":true},
		{"name":"boxed","arg":{"format":"{}","snippet":"boxed{${1:expression}}"},"if":"math"},
		{"name":"dfrac","arg":{"format":"[]{}{}","snippet":"dfrac[${1:rule thickness}]{${2:numerator}}{${3:denominator}}"},"if":"math","math":true},
		{"name":"dfrac","arg":{"format":"{}{}","snippet":"dfrac{${1:numerator}}{${2:denominator}}"},"if":"math","math":true},
		{"name":"DIV","arg":{"format":"{}","snippet":"DIV{${1:field}}"},"if":"math"},
		{"name":"eqbox","arg":{"format":"(){}","snippet":"eqbox(${1:rule,sep}){${2:expression}}"},"if":"math"},
		{"name":"eqcolumnsep","arg":{"format":"{}","snippet":"eqcolumnsep{${1:spacing}}"}},
		{"name":"eqlabel","arg":{"format":"[]{}","snippet":"eqlabel[${1:eqnum}]{${2:label name}}"},"unusual":true},
		{"name":"eqlabel","arg":{"format":"{}","snippet":"eqlabel{${1:label name}}"},"unusual":true},
		{"name":"eqlabelbot"},
		{"name":"eqlabelcenter"},
		{"name":"eqlabeltop"},
		{"name":"eqleftmargin","arg":{"format":"{}","snippet":"eqleftmargin{${1:indent}}"}},
		{"name":"eqmulticol","arg":{"format":"{}{}{}","snippet":"eqmulticol{${1:ncol}}{${2:align}}{${3:body}}"}},
		{"name":"eqref","arg":{"format":"{}","snippet":"eqref{${1:label}}"}},
		{"name":"eqrowsep","arg":{"format":"{}","snippet":"eqrowsep{${1:spacing}}"}},
		{"name":"eqspacing","arg":{"format":"{}","snippet":"eqspacing{${1:spacing}}"}},
		{"name":"equationcenter"},
		{"name":"equationleft"},
		{"name":"filedate","unusual":true},
		{"name":"fileversion","unusual":true},
		{"name":"GRAD","arg":{"format":"{}","snippet":"GRAD{${1:field}}"},"if":"math"},
		{"name":"LAPLA","arg":{"format":"{}","snippet":"LAPLA{${1:field}}"},"if":"math"},
		{"name":"norm","arg":{"format":"{}","snippet":"norm{${1:expression}}"},"if":"math"},
		{"name":"numberleft"},
		{"name":"numberright"},
		{"name":"ParDer","arg":{"format":"[]{}","snippet":"ParDer[${1:variables}]{${2:function}}"},"if":"math"},
		{"name":"ParDer","arg":{"format":"{}","snippet":"ParDer{${1:function}}"},"if":"math"},
		{"name":"PROD","arg":{"format":"[]{}{}","snippet":"PROD[${1:order}]{${2:from}}{${3:to}}"},"if":"math"},
		{"name":"PROD","arg":{"format":"{}{}","snippet":"PROD{${1:from}}{${2:to}}"},"if":"math"},
		{"name":"refeq","arg":{"format":"{}","snippet":"refeq{${1:label}}"}},
		{"name":"SUM","arg":{"format":"[]{}{}","snippet":"SUM[${1:order}]{${2:from}}{${3:to}}"},"if":"math"},
		{"name":"SUM","arg":{"format":"{}{}","snippet":"SUM{${1:from}}{${2:to}}"},"if":"math"},
		{"name":"tfrac","arg":{"format":"[]{}{}","snippet":"tfrac[${1:rule thickness}]{${2:numerator}}{${3:denominator}}"},"if":"math","math":true},
		{"name":"tfrac","arg":{"format":"{}{}","snippet":"tfrac{${1:numerator}}{${2:denominator}}"},"if":"math","math":true},
		{"name":"yesnumber"},
		{"name":"frac","arg":{"format":"[]{}{}","snippet":"frac[${1:rule thickness}]{${2:numerator}}{${3:denominator}}"},"if":"math","math":true},
		{"name":"frac","arg":{"format":"{}{}","snippet":"frac{${1:numerator}}{${2:denominator}}"},"if":"math","math":true}
	],
	"envs": [
		{"name":"ARRAY","arg":{"format":"{}","snippet":"{${1:column spec}}"},"if":"math"},
		{"name":"EQ","arg":{"format":"[]","snippet":"[${1}]"}},
		{"name":"EQ"},
		{"name":"EQA","arg":{"format":"[]","snippet":"[${1}]"}},
		{"name":"EQA"},
		{"name":"MATRIX","if":"math"},
		{"name":"EQS","arg":{"format":"[]","snippet":"[${1}]"},"unusual":true,"if":"easyold"},
		{"name":"EQS","unusual":true,"if":"easyold"}
	],
	"keys": {
		"\\usepackage/easyeqn#c": ["allnumber","easyold","fleqn","leqno","math","warning"]
	},
	"args": ["\\usepackage/easyeqn#c"]
}
