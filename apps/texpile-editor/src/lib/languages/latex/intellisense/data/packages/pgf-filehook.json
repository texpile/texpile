{
	"deps": [{"name":"filehook"},{"name":"filehook-2020"},{"name":"pgfkeys"}],
	"macros": [
		{"name":"pgffilehook","arg":{"format":"{}","snippet":"pgffilehook{${1:key=value,...}}","keys":["pgfkeys:/filehook"],"keyPos":0},"doc":"This macro is like \\pgfkeys but defaults to the ‘/filehook’ directory, so that it can be dropped from the 〈key〉."}
	],
	"envs": [],
	"keys": {
		"pgfkeys:/filehook": ["EveryFile/AtBegin=","EveryFile/AtEnd=","Files/AtBegin=","Files/AtEnd=","File/AtBegin=","File/AtEnd=","Inputs/AtBegin=","Inputs/AtEnd=","InputFile/AtBegin=","InputFile/AtEnd=","Includes/AtBegin=","Includes/AtEnd=","Includes/After=","IncludeFile/AtBegin=","IncludeFile/AtEnd=","IncludeFile/After=","ClassFile/AtBegin=","ClassFile/AtEnd=","PackageFile/AtBegin=","PackageFile/AtEnd="]
	}
}
