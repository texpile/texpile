{
	"macros": [
		{"name":"toolboxAppend","arg":{"format":"{}{}","snippet":"toolboxAppend{${1:macro}}{${2:argument list}}"}},
		{"name":"toolboxDef","arg":{"format":"{}{}","snippet":"toolboxDef{${1:macro}}{${2:argument list}}"}},
		{"name":"toolboxDropBrace","arg":{"format":"{}","snippet":"toolboxDropBrace{${1:macro}}"},"doc":"drops possible outer braces of \\macro."},
		{"name":"toolboxEmpty","doc":"expands to nothing (usually, this is the same as \\empty)."},
		{"name":"toolboxFirstOfTwo","arg":{"format":"{}{}","snippet":"toolboxFirstOfTwo{${1:first}}{${2:second}}"}},
		{"name":"toolboxFreeDef","arg":{"format":"[]{}","snippet":"toolboxFreeDef[${1:prefix}]{${2:name}}"}},
		{"name":"toolboxFreeDef","arg":{"format":"{}","snippet":"toolboxFreeDef{${1:name}}"}},
		{"name":"toolboxFreeDef*","arg":{"format":"[]{}","snippet":"toolboxFreeDef*[${1:prefix}]{${2:name}}"}},
		{"name":"toolboxFreeDef*","arg":{"format":"{}","snippet":"toolboxFreeDef*{${1:name}}"}},
		{"name":"toolboxFreeSplit","arg":{"format":"{}","snippet":"toolboxFreeSplit{${1:command}}"},"doc":"frees the memory used by a previous \\toolboxMakeSplit (and lets \\command again be undefined)."},
		{"name":"toolboxFuturelet","arg":{"format":"{}{}","snippet":"toolboxFuturelet{${1:token macro}}{${2:command}}"},"doc":"The call \\toolboxFuturelet\\token{\\command} has precisely the same effect as \\futurelet\\token\\command."},
		{"name":"toolboxGobbleArg","arg":{"format":"{}","snippet":"toolboxGobbleArg{${1:argument}}"},"doc":"just reads its argument and expands to nothing."},
		{"name":"toolboxGobbleNext","arg":{"format":"{}","snippet":"toolboxGobbleNext{${1:command}}"}},
		{"name":"toolboxIf","arg":{"format":"{}{}{}","snippet":"toolboxIf{${1:comparison}}{${2:definition command}}{${3:macro}}"},"doc":"allows conditional definitions."},
		{"name":"toolboxIfElse","arg":{"format":"{}{}{}","snippet":"toolboxIfElse{${1:if command}}{${2:if}}{${3:else}}"}},
		{"name":"toolboxIfEmpty","arg":{"format":"{}{}{}","snippet":"toolboxIfEmpty{${1:arg}}{${2:if}}{${3:else}}"}},
		{"name":"toolboxIfNextGobbling","arg":{"format":"{}{}{}","snippet":"toolboxIfNextGobbling{${1:token}}{${2:if}}{${3:else}}"}},
		{"name":"toolboxIfNextToken","arg":{"format":"{}{}{}","snippet":"toolboxIfNextToken{${1:token}}{${2:if}}{${3:else}}"}},
		{"name":"toolboxIfx","arg":{"format":"{}{}{}{}","snippet":"toolboxIfx{${1:arg}}{${2:macro}}{${3:if}}{${4:else}}"}},
		{"name":"toolboxIfX","arg":{"format":"{}{}{}{}","snippet":"toolboxIfX{${1:arg 1}}{${2:arg 2}}{${3:if}}{${4:else}}"}},
		{"name":"toolboxLet","arg":{"format":"{}{}","snippet":"toolboxLet{${1:variable}}{${2:macro name}}"}},
		{"name":"toolboxLoop","arg":{"format":"{}{}","snippet":"toolboxLoop{${1:items}}{${2:action}}"}},
		{"name":"toolboxLoopName","arg":{"format":"{}{}{}","snippet":"toolboxLoopName{${1:name}}{${2:items}}{${3:action}}"}},
		{"name":"toolboxMakeDef","arg":{"format":"[]{}{}","snippet":"toolboxMakeDef[${1:prefix}]{${2:name}}{${3:replacement mask}}"}},
		{"name":"toolboxMakeDef","arg":{"format":"{}{}","snippet":"toolboxMakeDef{${1:name}}{${2:replacement mask}}"}},
		{"name":"toolboxMakeHarmless","arg":{"format":"{}","snippet":"toolboxMakeHarmless{${1:macro}}"}},
		{"name":"toolboxMakeSplit","arg":{"format":"{}{}","snippet":"toolboxMakeSplit{${1:search}}{${2:command name}}"}},
		{"name":"toolboxMakeSplit*","arg":{"format":"{}{}","snippet":"toolboxMakeSplit*{${1:search}}{${2:command name}}"}},
		{"name":"toolboxNewiffalse","arg":{"format":"{}","snippet":"toolboxNewiffalse{${1:name}}"}},
		{"name":"toolboxNewifFalse","arg":{"format":"{}","snippet":"toolboxNewifFalse{${1:name}}"}},
		{"name":"toolboxNewiftrue","arg":{"format":"{}","snippet":"toolboxNewiftrue{${1:name}}"}},
		{"name":"toolboxNewifTrue","arg":{"format":"{}","snippet":"toolboxNewifTrue{${1:name}}"}},
		{"name":"toolboxReplace","arg":{"format":"{}{}{}","snippet":"toolboxReplace{${1:search}}{${2:replace}}{${3:macro}}"}},
		{"name":"toolboxReplaceSplit","arg":{"format":"{}{}{}","snippet":"toolboxReplaceSplit{${1:replace}}{${2:split command}}{${3:macro}}"}},
		{"name":"toolboxSecondOfTwo","arg":{"format":"{}{}","snippet":"toolboxSecondOfTwo{${1:first}}{${2:second}}"}},
		{"name":"toolboxSpace","doc":"expands to a space symbol (usually, this is the same as \\space)."},
		{"name":"toolboxSpaceToken"},
		{"name":"toolboxSplitAt","arg":{"format":"{}{}{}{}","snippet":"toolboxSplitAt{${1:argument}}{${2:search}}{${3:before macro}}{${4:after macro}}"}},
		{"name":"toolboxSplitAt*","arg":{"format":"{}{}{}{}","snippet":"toolboxSplitAt*{${1:argument}}{${2:search}}{${3:before macro}}{${4:after macro}}"}},
		{"name":"toolboxSurround","arg":{"format":"{}{}{}","snippet":"toolboxSurround{${1:content before}}{${2:content after}}{${3:macro}}"}},
		{"name":"toolboxTokDef","arg":{"format":"{}{}","snippet":"toolboxTokDef{${1:argument list}}{${2:macro}}"}},
		{"name":"toolboxToken"},
		{"name":"toolboxTokenLoop","arg":{"format":"{}{}","snippet":"toolboxTokenLoop{${1:tokens}}{${2:action}}"}},
		{"name":"toolboxTokenLoopName","arg":{"format":"{}{}{}","snippet":"toolboxTokenLoopName{${1:name}}{${2:tokens}}{${3:action}}"}},
		{"name":"toolboxWithNr","arg":{"format":"{}{}{}","snippet":"toolboxWithNr{${1:number}}{${2:command}}{${3:macro}}"}}
	],
	"envs": [],
	"keys": {}
}
