		{"name":"nduMath","arg":{"format":"{}[]{}{}{}","snippet":"nduMath{${1:unit group}}[${2:options}]{${3:variable}}{${4:operator}}{${5:value}}"}},
		{"name":"nduMath","arg":{"format":"{}{}{}{}","snippet":"nduMath{${1:unit group}}{${2:variable}}{${3:operator}}{${4:value}}"}},
