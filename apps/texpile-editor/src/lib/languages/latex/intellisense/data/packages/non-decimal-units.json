		{"name":"nduSymbol","arg":{"format":"{}","snippet":"nduSymbol{${1:unit name}}"},"doc":"Expands to the symbol of the given base unit."},
		{"name":"nduValue","arg":{"format":"{}[]{}","snippet":"nduValue{${1:unit group}}[${2:options}]{${3:value}}"}},
