{
	"deps": [{"name":"xkeyval"},{"name":"iftex"},{"name":"multicol","if":"!original"}],
	"macros": [
		{"name":"alsoname"},
		{"name":"index","arg":{"format":"[]{}","snippet":"index[${1:name}]{${2:entry}}"}},
		{"name":"index","arg":{"format":"{}","snippet":"index{${1:entry}}"}},
		{"name":"indexprologue","arg":{"format":"[]{}","snippet":"indexprologue[${1:spacing}]{${2:text}}"}},
		{"name":"indexprologue","arg":{"format":"{}","snippet":"indexprologue{${1:text}}"}},
		{"name":"indexsetup","arg":{"format":"{}","snippet":"indexsetup{${1:key-values}}","keys":["keyval:imkiindex"],"keyPos":0}},
		{"name":"makeindex","arg":{"format":"[]","snippet":"makeindex[${1:key-values}]","keys":["keyval:imki"],"keyPos":0}},
		{"name":"makeindex"},
		{"name":"printindex","arg":{"format":"[]","snippet":"printindex[${1:name}]"}},
		{"name":"printindex"},
		{"name":"see","arg":{"format":"{}{}","snippet":"see{${1}}{${2}}"},"unusual":true},
		{"name":"seealso","arg":{"format":"{}{}","snippet":"seealso{${1}}{${2}}"},"unusual":true},
		{"name":"seename"},
		{"name":"splitindexoptions","arg":{"format":"{}","snippet":"splitindexoptions{${1:options}}"},"doc":"\\splitindexoptions must have as its argument the command line option to splitindex; this might be necessary on some systems."}
	],
	"envs": [],
	"keys": {
		"keyval:imki": ["columns=","columnsep=","columnseprule","columnseprulefalse=","columnsepruletrue=","intoc","intocfalse=","intoctrue=","name=","noautomatic","noautomaticfalse=","noautomatictrue=","options=","program=","title=","program=${1|makeindex,xindy,texindy,truexindy|}"],
		"keyval:imkiindex": ["firstpagestyle=","headers=","level=","noclearpage","noclearpagefalse=","noclearpagetrue=","othercode=","toclevel="],
		"\\usepackage/imakeidx#c": ["makeindex","noautomatic","nonewpage","original","quiet","splitindex","texindy","truexindy","xindy"]
	},
	"args": ["\\usepackage/imakeidx#c"]
}
