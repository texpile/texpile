{
	"deps": [{"name":"longtable"}],
	"macros": [
		{"name":"jdabstract"},
		{"name":"JDauthor","arg":{"format":"{}","snippet":"JDauthor{${1:authorname}}"}},
		{"name":"JDcategory","arg":{"format":"{}","snippet":"JDcategory{${1:description}}"}},
		{"name":"jdcode","arg":{"format":"{}","snippet":"jdcode{${1:text}}"},"doc":"\\jdcode has one argument and changes the font to TrueType."},
		{"name":"JDdeprecated","arg":{"format":"{}","snippet":"JDdeprecated{${1:description}}"}},
		{"name":"jdfinal"},
		{"name":"jdimplements","arg":{"format":"{}","snippet":"jdimplements{${1:interface}}"}},
		{"name":"jdinh","doc":"\\jdinh draws an arrow for inheritance from right to left."},
		{"name":"jdInhEntry","arg":{"format":"{}{}","snippet":"jdInhEntry{${1:element}}{${2:class}}"},"doc":"The table entries can be produced with the \\jdInhEntry command. It has two arguments, the first one is the element the second the class, that inherited the element."},
		{"name":"jdinherits","arg":{"format":"{}","snippet":"jdinherits{${1:classname}}"}},
		{"name":"jdouterclass","arg":{"format":"{}","snippet":"jdouterclass{${1:classname}}"}},
		{"name":"jdpackage","arg":{"format":"{}","snippet":"jdpackage{${1:packagename}}"}},
		{"name":"JDpara","arg":{"format":"{}{}{}","snippet":"JDpara{${1:datatype}}{${2:name}}{${3:description}}"}},
		{"name":"jdprivate"},
		{"name":"jdprotected"},
		{"name":"jdpublic"},
		{"name":"JDreturn","arg":{"format":"{}","snippet":"JDreturn{${1:description}}"}},
		{"name":"JDsee","arg":{"format":"{}","snippet":"JDsee{${1:description}}"}},
		{"name":"JDserial","arg":{"format":"{}","snippet":"JDserial{${1:description}}"}},
		{"name":"JDserialData","arg":{"format":"{}","snippet":"JDserialData{${1:description}}"}},
		{"name":"JDserialField","arg":{"format":"{}","snippet":"JDserialField{${1:description}}"}},
		{"name":"JDsince","arg":{"format":"{}","snippet":"JDsince{${1:description}}"}},
		{"name":"jdstatic"},
		{"name":"JDtext","arg":{"format":"{}","snippet":"JDtext{${1:description}}"}},
		{"name":"JDthrows","arg":{"format":"{}{}","snippet":"JDthrows{${1:exceptionname}}{${2:description}}"}},
		{"name":"jdtransient"},
		{"name":"jdtype","arg":{"format":"{}","snippet":"jdtype{${1:type}}"}},
		{"name":"jdtypearray","arg":{"format":"{}{}","snippet":"jdtypearray{${1:name}}{${2:dimension}}"}},
		{"name":"jdtypegeneric","arg":{"format":"{}{}","snippet":"jdtypegeneric{${1:name}}{${2:generic}}"}},
		{"name":"jdtypesimple","arg":{"format":"{}","snippet":"jdtypesimple{${1:type}}"}},
		{"name":"JDversion","arg":{"format":"{}","snippet":"JDversion{${1:description}}"}},
		{"name":"jdvolatile"}
	],
	"envs": [
		{"name":"jdclass","arg":{"format":"[]{}","snippet":"[${1:type}]{${2:classname}}"},"doc":"The outer environment for a class is jdclass. jdclass has an argument with the classname."},
		{"name":"jdclass","arg":{"format":"{}","snippet":"{${1:classname}}"},"doc":"The outer environment for a class is jdclass. jdclass has an argument with the classname."},
		{"name":"jdclassheader"},
		{"name":"jdconstructor"},
		{"name":"jdfield","arg":{"format":"{}","snippet":"{${1:fieldname}}"}},
		{"name":"jdinheritancetable"},
		{"name":"jdmethod","arg":{"format":"{}","snippet":"{${1:methodname}}"}}
	],
	"keys": {}
}
