		{"name":"eqn","arg":{"format":"{}[]","snippet":"eqn{${1:equation}}[${2:label}]"}},
		{"name":"eqn","arg":{"format":"{}","snippet":"eqn{${1:equation}}"}},
		{"name":"eqna","arg":{"format":"{}[]","snippet":"eqna{${1:equation}}[${2:label}]"},"doc":"For aligned equations with one number in the vertical middle use the command \\eqna{}[]."},
