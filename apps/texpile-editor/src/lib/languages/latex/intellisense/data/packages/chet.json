		{"name":"subsec","arg":{"format":"{}","snippet":"subsec{${1:title}}"}},
		{"name":"subsubsec","arg":{"format":"{}[]","snippet":"subsubsec{${1:title}}[${2:label}]"}},
		{"name":"subsubsec","arg":{"format":"{}","snippet":"subsubsec{${1:title}}"}},
