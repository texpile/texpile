		{"name":"newsec","arg":{"format":"{}[]","snippet":"newsec{${1:title}}[${2:label}]"},"doc":"Sections start with the command \\newsec{}[]. The first argument is the name of the section, while the second provides the label."},
		{"name":"newsec","arg":{"format":"{}","snippet":"newsec{${1:title}}"},"doc":"Sections start with the command \\newsec{}[]. The first argument is the name of the section, while the second provides the label."},
		{"name":"preprint","arg":{"format":"{}","snippet":"preprint{${1:id}}"}},
