		{"name":"threeseqn","arg":{"format":"{}{}{}","snippet":"threeseqn{${1:equation 1}}{${2:equation 2}}{${3:equation 3}}"}},
		{"name":"titlemath","arg":{"format":"{}","snippet":"titlemath{${1:math}}"}},
		{"name":"toc"},
		{"name":"twoseqn","arg":{"format":"{}[]{}[][]","snippet":"twoseqn{${1:equation 1}}[${2:label 1}]{${3:equation 2}}[${4:label 2}][${5:overall label}]"}},
