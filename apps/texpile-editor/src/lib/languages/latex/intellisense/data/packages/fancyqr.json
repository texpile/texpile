{
	"deps": [{"name":"pict2e"},{"name":"trig"},{"name":"qrcode"},{"name":"xcolor"},{"name":"xkeyval"}],
	"macros": [
		{"name":"fancyqr","arg":{"format":"[]{}","snippet":"fancyqr[${1:qr-options}]{${2:url}}"}},
		{"name":"fancyqr","arg":{"format":"{}","snippet":"fancyqr{${1:url}}"}},
		{"name":"fancyqr*","arg":{"format":"[]{}","snippet":"fancyqr*[${1:qr-options}]{${2:url}}"}},
		{"name":"fancyqr*","arg":{"format":"{}","snippet":"fancyqr*{${1:url}}"}},
		{"name":"FancyQrDoNotPrintRadius","arg":{"format":"{}","snippet":"FancyQrDoNotPrintRadius{${1:factor}}"}},
		{"name":"FancyQrDoNotPrintSquare","arg":{"format":"{}{}","snippet":"FancyQrDoNotPrintSquare{${1:x}}{${2:y}}"}},
		{"name":"FancyQrGlow","arg":{"format":"{}{}{}","snippet":"FancyQrGlow{${1:width}}{${2:strength}}{${3:falloff}}"}},
		{"name":"FancyQrGlowColor","arg":{"format":"{}{}","snippet":"FancyQrGlowColor{${1:from}}{${2:to}}"}},
		{"name":"FancyQrHardCut"},
		{"name":"FancyQrInnerRoundings","unusual":true},
		{"name":"FancyQrLoad","arg":{"format":"{}","snippet":"FancyQrLoad{${1:name}}"},"doc":"Besides the default style there are eight more, all loaded (locally) with \\FancyQrLoad{<name>}; \\FancyQrLoad{default} and \\FancyQrLoadDefault reset to the default."},
		{"name":"FancyQrLoadDefault"},
		{"name":"FancyQrNoInnerRoundings","unusual":true},
		{"name":"FancyQrPasses","arg":{"format":"{}","snippet":"FancyQrPasses{${1}}"},"unusual":true},
		{"name":"FancyQrRoundCut"},
		{"name":"FancyQrRoundedPatterns","arg":{"format":"{}","snippet":"FancyQrRoundedPatterns{${1}}"},"unusual":true},
		{"name":"FancyQrSeed","arg":{"format":"{}","snippet":"FancyQrSeed{${1:n}}"},"doc":"The styles that draw randomized tiles use the random number generator of LaTeX; \\FancyQrSeed{<n>} (or the seed option) fixes its seed and makes them reproducible."},
		{"name":"fancyqrset","arg":{"format":"{}","snippet":"fancyqrset{${1:keys}}"}},
		{"name":"FancyQrSidePatterns","arg":{"format":"{}","snippet":"FancyQrSidePatterns{${1}}"},"unusual":true}
	],
	"envs": [],
	"keys": {}
}
