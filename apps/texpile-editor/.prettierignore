# vendored pdf.js modules keep upstream style (see src/lib/draft/type1/README.md)
src/lib/draft/type1/*.js

# bundled package data, generated in texpile-tools (see the dir's README.md)
src/lib/languages/latex/knowledge/data/**/*.json

# generated by the Paraglide compiler; it writes its own .prettierignore in there, but prettier
# only reads the root one, so it has to be repeated here
src/lib/paraglide/

# captured lualatex output (see the dir's README.md). Regenerated verbatim by
# scripts/capture-lang-fixtures.mjs, so formatting them only creates a diff to undo next capture.
tests/fixtures/lang/*.jsonl
tests/fixtures/lang/*.pages.json

# comment-anchor fuzz corpora: realistic documents kept byte-exact as authored, so the fuzz
# exercises the markup people actually write rather than prettier's normalization of it
tests/fixtures/comments/

# inlang regenerates everything here except settings.json (see project.inlang/.gitignore), in its
# own formatting, so prettier must not police it
project.inlang/*
!project.inlang/settings.json

# local dev harness, untracked; present in working copies but never in the repo
devtyp.html
src/devtyp.ts
public/tmp-fixture/
tests/live/bert-*.mjs
tests/live/matrix-bert*.mjs
tests/live/results/

# vendored unified-latex grammar, generated by scripts/vendor-latex-peg.mjs
src/lib/languages/latex/parser/vendor/*.js

# app test output, see tests/integration/README.md
tests/integration/report/
tests/integration/results/
