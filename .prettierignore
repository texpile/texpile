# vendored pdf.js modules keep upstream style (see the dir's README.md)
apps/texpile-editor/src/lib/draft/type1/*.js

# vendored LaTeX Workshop package data keeps upstream bytes (see data/VENDORED-LICENSES.md)
apps/texpile-editor/src/lib/languages/latex/intellisense/data/packages/*.json

# engine reference sources, not ours to format
scratch/

# captured lualatex output (see the dir's README.md). Regenerated verbatim by
# scripts/capture-lang-fixtures.mjs, so formatting them only creates a diff to undo next capture.
apps/texpile-editor/tests/fixtures/lang/*.jsonl
apps/texpile-editor/tests/fixtures/lang/*.pages.json

# generated by the Paraglide compiler; each outdir also writes its own .prettierignore, but
# prettier only reads the root one
apps/texpile-editor/src/lib/paraglide/
landing/src/lib/paraglide/

# pnpm rewrites the lockfile in its own style on every install, so formatting it just puts a
# ~1700-line diff in front of whoever runs `pnpm format` next, to be undone on the next install
pnpm-lock.yaml

# inlang regenerates everything here except settings.json (see each project.inlang/.gitignore),
# in its own formatting, so prettier must not police it
apps/texpile-editor/project.inlang/*
!apps/texpile-editor/project.inlang/settings.json
landing/project.inlang/*
!landing/project.inlang/settings.json

# Rust build output (wasm-pack/cargo); regenerated, and formatting its fingerprints breaks
# incremental builds
packages/*/target/
packages/*/pkg/

# comment-anchor fuzz corpora: realistic documents kept byte-exact as authored, so the fuzz
# exercises the markup people actually write rather than prettier's normalization of it
apps/texpile-editor/tests/fixtures/comments/

# build and test output
**/build/
**/dist/
**/dist-web/
**/.svelte-kit/
**/test-results/
release/
electron/dist/

# git worktrees checked out under .claude/
.claude/
apps/texpile-editor/public/themes/
